# Copy to .dev.vars for local development only. The real file is gitignored.
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8787/auth/google/callback"
BOOTSTRAP_OWNER_EMAIL="owner@example.com"
ADMIN_TOKEN="generate-a-long-random-emergency-token"
RECOVERY_MODE="false"
OAUTH_RATE_LIMIT_WINDOW_SECONDS="600"
OAUTH_RATE_LIMIT_PER_CLIENT="10"
OAUTH_RATE_LIMIT_GLOBAL="500"
APP_ORIGIN="http://localhost:8787"
ALLOWED_ORIGINS="http://localhost:8787"
CHANNEL_CREDENTIALS_KEY="generate-at-least-32-random-bytes-and-keep-this-private"
VAPID_PUBLIC_KEY="generate-one-P-256-VAPID-public-key"
VAPID_PRIVATE_KEY="keep-the-matching-VAPID-private-key-secret"
VAPID_SUBJECT="mailto:owner@example.com"
