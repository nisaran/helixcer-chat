# Local-development placeholders only. Copy to .dev.vars and replace locally.
ADMIN_TOKEN=replace-with-a-long-random-value

# Example WhatsApp channel with secretKey WA_MAIN:
WA_MAIN_ACCESS_TOKEN=replace-me
WA_MAIN_PHONE_NUMBER_ID=replace-me
WA_MAIN_VERIFY_TOKEN=replace-me
WA_MAIN_APP_SECRET=replace-me

# Example Telegram channel with secretKey TELEGRAM_MAIN:
TELEGRAM_MAIN_BOT_TOKEN=replace-me
TELEGRAM_MAIN_WEBHOOK_TOKEN=replace-me
