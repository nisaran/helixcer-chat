    Fields : Medium Prompt, Hxc Vc F Vch Name
    Local  : Field : Medium Prompt : Set as : "Voucher Type"
    Local  : Field : Medium Prompt : Width  : 22
    Local  : Field : Medium Prompt : Inactive : NOT ##HxcVcFetched

[Field: Hxc Vc F Vch Name]
    Use        : Name Field
    Storage    : HxcVcDraftVchName
    Set as     : $HxcVcDraftVchName
    Table      : Hxc Voucher Type List, End of List
    Show Table : Always
    Width      : 40
    Max        : 80
    Inactive   : NOT ##HxcVcFetched
    ;; End of List must end the list (not store as a voucher type)
    On         : Accept : $Value = "End of List" OR $Value = "Not Applicable" OR $$IsSysName:$Value:EndOfList : SET VALUE : HxcVcDraftVchName : ""
    On         : Accept : Yes : Field Accept

[Line: Hxc Vc F Auto Line]
    Fields : Medium Prompt, Hxc Vc F Auto
    Local  : Field : Medium Prompt : Set as : "Auto Select after save"
