;; Helixcer Chat — TallyPrime TDL
;; BUILD: 358-fix-apply
;; Title must show "(build 358)".
;;
;; Create Config flow:
;;   Config Name → Template → Language Enter (fetch) →
;;   Preview → Header (only if template has header) → Body maps (dynamic count) →
;;   Voucher types → Settings → Ctrl+A

;; ---------------------------------------------------------------------------
;; Company UDFs
;; ---------------------------------------------------------------------------

[System: UDF]
    HxcWorkspaceIdUDF : String : 25101
    HxcChannelIdUDF   : String : 25102
    HxcApiKeyUDF      : String : 25103
    ;; Saved configs
    HxcVoucherConfigs      : Aggregate : 25110
    HxcVcName              : String    : 25111
    HxcVcTemplateName      : String    : 25112
    HxcVcLanguage          : String    : 25113
    HxcVcVoucherTypes      : String    : 25114
    HxcVcMediaExport       : String    : 25115
    HxcVcAutoSend          : Logical   : 25116
    HxcVcConfirmBeforeSend : Logical   : 25117
    HxcVcVarMapsText       : String    : 25118
    ;; Create/Alter draft buffer (one form, not a repeating name list)
    HxcVcDraftName     : String  : 25120
    HxcVcDraftTemplate : String  : 25121
    HxcVcDraftLang     : String  : 25122
    HxcVcDraftMedia    : String  : 25123
    HxcVcDraftAuto     : Logical : 25124
    HxcVcDraftConfirm  : Logical : 25125
    HxcVcDraftEditKey    : String  : 25126
    HxcVcDraftHeaderFld  : String  : 25127
    ;; Dynamic maps — one Aggregate row per template variable
    HxcVcDraftMaps     : Aggregate : 25160
    HxcVcDraftMapKey   : String    : 25161
    HxcVcDraftMapComp  : String    : 25162
    HxcVcDraftMapFld   : String    : 25163
    ;; Dynamic voucher-type picker
    HxcVcDraftVchs    : Aggregate : 25150
    HxcVcDraftVchName : String    : 25151

;; ---------------------------------------------------------------------------
;; Status mirrors + save flag
;; ---------------------------------------------------------------------------

[Variable: HxcSysWorkspaceId]
    Type       : String
    Persistent : Yes

[Variable: HxcSysChannelId]
    Type       : String
    Persistent : Yes

[Variable: HxcSysApiKey]
    Type       : String
    Persistent : Yes

[Variable: HxcWorkspaceName]
    Type       : String
    Persistent : Yes

[Variable: HxcChannelName]
    Type       : String
    Persistent : Yes

[Variable: HxcConnectionStatus]
    Type       : String
    Persistent : Yes

[Variable: HxcVcSaveOk]
    Type : Logical

[Variable: HxcVcFetched]
    Type : Logical

[Variable: HxcVcPreviewText]
    Type : String

[Variable: HxcVcFetchStatus]
    Type : String

[Variable: HxcVcFetchLang]
    Type : String

[Variable: HxcVcFetchName]
    Type : String

[Variable: HxcVcMapsCsv]
    Type : String

[Variable: HxcVcHasHeader]
    Type : Logical

[Variable: HxcVcHeaderKind]
    Type : String

[Variable: HxcVcHeaderFormat]
    Type : String

[Variable: HxcVcHeaderKey]
    Type : String


[System: Variable]
    HxcSysWorkspaceId   : ""
    HxcSysChannelId     : ""
    HxcSysApiKey        : ""
    HxcWorkspaceName    : ""
    HxcChannelName      : ""
    HxcConnectionStatus : ""
    HxcVcSaveOk         : No
    HxcVcFetched        : No
    HxcVcPreviewText    : ""
    HxcVcFetchStatus    : ""
    HxcVcFetchLang      : "en"
    HxcVcFetchName      : ""
    HxcVcMapsCsv        : ""
    HxcVcHasHeader      : No
    HxcVcHeaderKind     : ""
    HxcVcHeaderFormat   : ""
    HxcVcHeaderKey      : ""

[System: Formula]
    Hxc Connection Url : "https://api.chat.helixcer.com/api/v1/connection?channelId=" + ##HxcSysChannelId
    Hxc Sys Summary    : "WS=[" + ##HxcSysWorkspaceId + "] CH=[" + ##HxcSysChannelId + "] KeyChars=" + $$StringLength:##HxcSysApiKey
    ;; Same pattern as working build 347 Status/HTTP, but template name in ## var
    Hxc Template Url   : "https://api.chat.helixcer.com/api/v1/whatsapp/templates/" + ##HxcVcFetchName + "?channelId=" + ##HxcSysChannelId

;; ---------------------------------------------------------------------------
;; Tables
;; ---------------------------------------------------------------------------

[Collection: Hxc Media Export List]
    List : "None", "Voucher PDF", "Voucher HTML", "Voucher XML", "Voucher Excel"

[Collection: Hxc Voucher Type List]
    Type   : Voucher Type
    Format : $Name, 40

[Collection: Hxc Voucher Field List]
    List : "Voucher Number", "Voucher Date", "Amount", "Reference", "Narration", +
           "Party Name", "Party Mobile", "Party Email", "Company Name", "Guid"

[Collection: Hxc Voucher Config Names]
    Type     : HxcVoucherConfigs : Company
    Child Of : ##SVCurrentCompany
    Format   : $HxcVcName, 40
    Fetch    : HxcVcName, HxcVcTemplateName, HxcVcLanguage, HxcVcVoucherTypes, +
               HxcVcMediaExport, HxcVcAutoSend, HxcVcConfirmBeforeSend, HxcVcVarMapsText
    Title    : "Voucher Configs"

;; ---------------------------------------------------------------------------
;; HTTP (Status)
;; ---------------------------------------------------------------------------

[Report: Hxc Connection Request]
    Form          : Hxc Connection Request
    Export Header : "Authorization: Bearer " + ##HxcSysApiKey
    Export Header : "X-Workspace-Id: " + ##HxcSysWorkspaceId
    Export Header : "Accept: application/json"

[Form: Hxc Connection Request]
    Part : Hxc Connection Request

[Part: Hxc Connection Request]
    Lines : Hxc Connection Request

[Line: Hxc Connection Request]
    Fields : Hxc Connection Request

[Field: Hxc Connection Request]
    Use    : Name Field
    Set as : ""
    Skip   : Yes

[Function: Hxc Apply Connection Response]
    Variable : Platform : String
    01 : SET : HxcWorkspaceName : ""
    02 : SET : HxcChannelName : ""
    03 : SET : HxcConnectionStatus : "Could not fetch. Check IDs and API Key."
    04 : WALK COLLECTION : Parameter Collection
    05 :    IF : NOT $$IsEmpty:$workspaceName
    06 :       SET : Platform : $platformLabel
    07 :       IF : $$IsEmpty:##Platform
    08 :          SET : Platform : $connectorType
    09 :       END IF
    10 :       IF : $$IsEmpty:##Platform
    11 :          SET : Platform : "Channel"
    12 :       END IF
    13 :       SET : HxcWorkspaceName : $workspaceName
    14 :       SET : HxcChannelName : $channelName + " (" + ##Platform + ")"
    15 :       SET : HxcConnectionStatus : "Connected"
    16 :    END IF
    17 : END WALK
    18 : RETURN : Yes

[Function: Hxc Sync From Company]
    01 : IF : NOT $$IsEmpty:$HxcWorkspaceIdUDF:Company:##SVCurrentCompany
    02 :    SET : HxcSysWorkspaceId : $HxcWorkspaceIdUDF:Company:##SVCurrentCompany
    03 : END IF
    04 : IF : NOT $$IsEmpty:$HxcChannelIdUDF:Company:##SVCurrentCompany
    05 :    SET : HxcSysChannelId : $HxcChannelIdUDF:Company:##SVCurrentCompany
    06 : END IF
    07 : IF : NOT $$IsEmpty:$HxcApiKeyUDF:Company:##SVCurrentCompany
    08 :    SET : HxcSysApiKey : $HxcApiKeyUDF:Company:##SVCurrentCompany
    09 : END IF
    10 : RETURN : Yes

[Function: Hxc Fetch Connection]
    01 : CALL : Hxc Sync From Company
    02 : IF : $$IsEmpty:##HxcSysWorkspaceId OR $$IsEmpty:##HxcSysChannelId OR $$IsEmpty:##HxcSysApiKey
    03 :    SET : HxcConnectionStatus : "Not ready. " + @@HxcSysSummary + "  Accept API Settings with Ctrl+A first."
    04 :    RETURN : No
    05 : END IF
    06 : SET : HxcWorkspaceName : ""
    07 : SET : HxcChannelName : ""
    08 : SET : HxcConnectionStatus : "Checking..."
    09 : Start Progress : 1 : "Helixcer Chat" : "Connection status" : "Fetching workspace and channel"
    10 : HTTP Request : @@HxcConnectionUrl : GET : JSON : UTF8 : Hxc Connection Request : Hxc Apply Connection Response
    11 : End Progress
    12 : IF : $$IsEmpty:##HxcWorkspaceName
    13 :    IF : ##HxcConnectionStatus = "Checking..."
    14 :       SET : HxcConnectionStatus : "Could not fetch. Check IDs and API Key."
    15 :    END IF
    16 : END IF
    17 : RETURN : Yes

[Function: Hxc Show Status]
    01 : CALL : Hxc Fetch Connection
    02 : Msg Box : "Helixcer Connection Status" : ##HxcConnectionStatus
    03 : IF : NOT $$IsEmpty:##HxcWorkspaceName
    04 :    Msg Box : "Workspace" : ##HxcWorkspaceName
    05 :    Msg Box : "Channel" : ##HxcChannelName
    06 : END IF
    07 : RETURN : Yes

[Function: Hxc Clear Fetch Vars]
    01 : SET : HxcVcFetched : No
    02 : SET : HxcVcPreviewText : ""
    03 : SET : HxcVcFetchStatus : ""
    04 : SET : HxcVcMapsCsv : ""
    05 : SET : HxcVcHasHeader : No
    06 : SET : HxcVcHeaderKind : ""
    07 : SET : HxcVcHeaderFormat : ""
    08 : SET : HxcVcHeaderKey : ""
    09 : RETURN : Yes

[Function: Hxc Clear Draft Maps]
    01 : WALK COLLECTION : HxcVcDraftMaps
    02 :    DELETE OBJECT
    03 : END WALK
    04 : RETURN : Yes

[Function: Hxc Parse Maps Into Draft]
    Parameter : MapsCsv : String
    Variable  : Rest : String
    Variable  : Piece : String
    Variable  : Comp : String
    Variable  : Key : String
    Variable  : Counter : Number
    Variable  : ExpLen : Number
    Variable  : Ch : String
    Variable  : KeyLen : Number
    01 : CALL : Hxc Clear Draft Maps
    02 : SET : Rest : ##MapsCsv
    03 : SET : Piece : ""
    04 : SET : Counter : 0
    05 : SET : ExpLen : $$StringLength:##Rest
    06 : WHILE : ##Counter <= ##ExpLen
    07 :    IF : ##Counter = ##ExpLen
    08 :       SET : Ch : ","
    09 :    ELSE
    10 :       SET : Ch : $$StringPart:##Rest:##Counter:1
    11 :    END IF
    12 :    IF : ##Ch = ","
    13 :       IF : NOT $$IsEmpty:##Piece
    14 :          SET : Comp : "body"
    15 :          SET : Key : ##Piece
    16 :          IF : $$StringPart:##Piece:0:5 = "body:"
    17 :             SET : Comp : "body"
    18 :             SET : KeyLen : $$StringLength:##Piece - 5
    19 :             SET : Key : $$StringPart:##Piece:5:##KeyLen
    20 :          END IF
    21 :          IF : $$StringPart:##Piece:0:7 = "header:"
    22 :             SET : Comp : "header"
    23 :             SET : KeyLen : $$StringLength:##Piece - 7
    24 :             SET : Key : $$StringPart:##Piece:7:##KeyLen
    25 :          END IF
    26 :          IF : $$StringPart:##Piece:0:7 = "button:"
    27 :             SET : Comp : "button"
    28 :             SET : KeyLen : $$StringLength:##Piece - 7
    29 :             SET : Key : $$StringPart:##Piece:7:##KeyLen
    30 :          END IF
    31 :          IF : ##Comp = "header"
    32 :             SET : HxcVcHeaderKey : ##Key
    33 :          ELSE
    34 :             IF : NOT $$IsEmpty:##Key
    35 :                INSERT COLLECTION OBJECT : HxcVcDraftMaps
    36 :                SET VALUE : HxcVcDraftMapComp : ##Comp
    37 :                SET VALUE : HxcVcDraftMapKey : ##Key
    38 :                SET VALUE : HxcVcDraftMapFld : ""
    39 :                SET TARGET : ..
    40 :             END IF
    41 :          END IF
    42 :       END IF
    43 :       SET : Piece : ""
    44 :    ELSE
    45 :       SET : Piece : ##Piece + ##Ch
    46 :    END IF
    47 :    SET : Counter : ##Counter + 1
    48 : END WHILE
    49 : RETURN : Yes

[Function: Hxc Apply Template Response]
    ;; Keep this simple — empty IF branches / $$String break Tally Apply
    Variable : CompType : String
    Variable : Fmt : String
    Variable : VComp : String
    Variable : VKey : String
    Variable : Entry : String
    01 : SET : HxcVcFetched : No
    02 : SET : HxcVcPreviewText : ""
    03 : SET : HxcVcMapsCsv : ""
    04 : SET : HxcVcHasHeader : No
    05 : SET : HxcVcHeaderKind : ""
    06 : SET : HxcVcHeaderFormat : ""
    07 : SET : HxcVcHeaderKey : ""
    08 : SET : HxcVcFetchStatus : "Template not found or empty response."
    09 : WALK COLLECTION : Parameter Collection
    10 :    WALK COLLECTION : items
    11 :       WALK COLLECTION : components
    12 :          SET : CompType : $type
    13 :          IF : ##CompType = "header" OR ##CompType = "HEADER" OR ##CompType = "Header"
    14 :             SET : HxcVcHasHeader : Yes
    15 :             SET : Fmt : $format
    16 :             IF : $$IsEmpty:##Fmt
    17 :                SET : Fmt : "TEXT"
    18 :             END IF
    19 :             SET : HxcVcHeaderFormat : ##Fmt
    20 :             IF : ##Fmt = "IMAGE" OR ##Fmt = "VIDEO" OR ##Fmt = "DOCUMENT" OR ##Fmt = "GIF" OR ##Fmt = "image" OR ##Fmt = "video" OR ##Fmt = "document" OR ##Fmt = "gif"
    21 :                SET : HxcVcHeaderKind : "media"
    22 :             ELSE
    23 :                SET : HxcVcHeaderKind : "text"
    24 :             END IF
    25 :             IF : ##HxcVcHeaderKind = "text"
    26 :                IF : NOT $$IsEmpty:$text
    27 :                   SET : HxcVcPreviewText : "[Header] " + $text + " | "
    28 :                END IF
    29 :             END IF
    30 :          END IF
    31 :          IF : ##CompType = "body" OR ##CompType = "BODY" OR ##CompType = "Body"
    32 :             IF : NOT $$IsEmpty:$text
    33 :                SET : HxcVcPreviewText : ##HxcVcPreviewText + $text
    34 :             END IF
    35 :          END IF
    36 :       END WALK
    37 :       WALK COLLECTION : variables
    38 :          SET : VComp : $component
    39 :          SET : VKey : $key
    40 :          IF : $$IsEmpty:##VComp
    41 :             SET : VComp : "body"
    42 :          END IF
    43 :          IF : ##VComp = "HEADER"
    44 :             SET : VComp : "header"
    45 :          END IF
    46 :          IF : ##VComp = "BODY"
    47 :             SET : VComp : "body"
    48 :          END IF
    49 :          IF : ##VComp = "BUTTON"
    50 :             SET : VComp : "button"
    51 :          END IF
    52 :          IF : NOT $$IsEmpty:##VKey
    53 :             IF : ##VComp = "header"
    54 :                IF : NOT ##HxcVcHeaderKind = "media"
    55 :                   SET : HxcVcHasHeader : Yes
    56 :                   IF : $$IsEmpty:##HxcVcHeaderKind
    57 :                      SET : HxcVcHeaderKind : "text"
    58 :                   END IF
    59 :                   SET : HxcVcHeaderKey : ##VKey
    60 :                   SET : Entry : "header:" + ##VKey
    61 :                   IF : $$IsEmpty:##HxcVcMapsCsv
    62 :                      SET : HxcVcMapsCsv : ##Entry
    63 :                   ELSE
    64 :                      SET : HxcVcMapsCsv : ##HxcVcMapsCsv + "," + ##Entry
    65 :                   END IF
    66 :                END IF
    67 :             ELSE
    68 :                SET : Entry : ##VComp + ":" + ##VKey
    69 :                IF : $$IsEmpty:##HxcVcMapsCsv
    70 :                   SET : HxcVcMapsCsv : ##Entry
    71 :                ELSE
    72 :                   SET : HxcVcMapsCsv : ##HxcVcMapsCsv + "," + ##Entry
    73 :                END IF
    74 :             END IF
    75 :          END IF
    76 :       END WALK
    77 :       SET : HxcVcFetched : Yes
    78 :       SET : HxcVcFetchStatus : "Template loaded."
    79 :    END WALK
    80 : END WALK
    81 : IF : ##HxcVcFetched
    82 :    IF : $$IsEmpty:##HxcVcPreviewText
    83 :       SET : HxcVcPreviewText : "(No body text in template)"
    84 :    END IF
    85 : END IF
    86 : RETURN : Yes

[Function: Hxc Fetch Template]
    01 : CALL : Hxc Sync From Company
    02 : CALL : Hxc Clear Fetch Vars
    03 : CALL : Hxc Clear Draft Maps
    04 : IF : $$IsEmpty:##HxcSysWorkspaceId OR $$IsEmpty:##HxcSysChannelId OR $$IsEmpty:##HxcSysApiKey
    05 :    SET : HxcVcFetchStatus : "Save API Settings (Ctrl+A) before fetching a template."
    06 :    Msg Box : "Helixcer Template" : ##HxcVcFetchStatus
    07 :    RETURN : No
    08 : END IF
    09 : SET : HxcVcFetchName : $HxcVcDraftTemplate
    10 : IF : $$IsEmpty:##HxcVcFetchName
    11 :    SET : HxcVcFetchName : $HxcVcDraftTemplate:Company:##SVCurrentCompany
    12 : END IF
    13 : IF : $$IsEmpty:##HxcVcFetchLang
    14 :    SET : HxcVcFetchLang : $HxcVcDraftLang
    15 : END IF
    16 : IF : $$IsEmpty:##HxcVcFetchLang
    17 :    SET : HxcVcFetchLang : "en"
    18 : END IF
    19 : IF : $$IsEmpty:##HxcVcFetchName
    20 :    SET : HxcVcFetchStatus : "Enter Template Name first."
    21 :    Msg Box : "Helixcer Template" : ##HxcVcFetchStatus
    22 :    RETURN : No
    23 : END IF
    24 : SET : HxcVcFetchStatus : "Fetching..."
    25 : Start Progress : 1 : "Helixcer Chat" : "Template" : "Fetching template details"
    26 : HTTP Request : @@HxcTemplateUrl : GET : JSON : UTF8 : Hxc Connection Request : Hxc Apply Template Response
    27 : End Progress
    28 : IF : NOT ##HxcVcFetched
    29 :    IF : $$IsEmpty:##HxcVcFetchStatus OR ##HxcVcFetchStatus = "Fetching..."
    30 :       SET : HxcVcFetchStatus : "Could not fetch [" + ##HxcVcFetchName + "]. Open Helixcer Chat → Status. If Connected, check the template name on this channel."
    31 :    END IF
    32 :    Msg Box : "Helixcer Template" : ##HxcVcFetchStatus
    33 :    RETURN : No
    34 : END IF
    35 : CALL : Hxc Parse Maps Into Draft : ##HxcVcMapsCsv
    36 : SET VALUE : HxcVcDraftHeaderFld : ""
    37 : IF : ##HxcVcHeaderKind = "media"
    38 :    IF : $$IsEmpty:$HxcVcDraftMedia OR $HxcVcDraftMedia = "None"
    39 :       SET VALUE : HxcVcDraftMedia : "Voucher PDF"
    40 :    END IF
    41 : ELSE
    42 :    SET VALUE : HxcVcDraftMedia : "None"
    43 : END IF
    44 : Msg Box : "Helixcer Template" : ##HxcVcFetchStatus
    45 : RETURN : Yes

;; ---------------------------------------------------------------------------
;; Pack helpers + commit draft → Aggregate config
;; ---------------------------------------------------------------------------

[Function: Hxc Pack Maps]
    Variable : S : String
    01 : SET : S : ""
    02 : IF : ##HxcVcHeaderKind = "text" AND NOT $$IsEmpty:##HxcVcHeaderKey
    03 :    SET : S : ##S + "header:" + ##HxcVcHeaderKey + "=" + $HxcVcDraftHeaderFld + ";"
    04 : END IF
    05 : WALK COLLECTION : HxcVcDraftMaps
    06 :    IF : NOT $$IsEmpty:$HxcVcDraftMapKey
    07 :       SET : S : ##S + $HxcVcDraftMapComp + ":" + $HxcVcDraftMapKey + "=" + $HxcVcDraftMapFld + ";"
    08 :    END IF
    09 : END WALK
    10 : RETURN : ##S

[Function: Hxc Pack Vouchers]
    Variable : S : String
    01 : SET : S : ""
    02 : WALK COLLECTION : HxcVcDraftVchs
    03 :    IF : NOT $$IsEmpty:$HxcVcDraftVchName
    04 :       SET : S : ##S + $HxcVcDraftVchName + ","
    05 :    END IF
    06 : END WALK
    07 : RETURN : ##S

[Function: Hxc Clear Draft Vchs]
    ;; Remove all draft voucher-type rows
    01 : WALK COLLECTION : HxcVcDraftVchs
    02 :    DELETE OBJECT
    03 : END WALK
    04 : RETURN : Yes

[Function: Hxc Seed Draft Vch Row]
    ;; One blank row so Repeat Aggregate is editable
    01 : INSERT COLLECTION OBJECT : HxcVcDraftVchs
    02 : SET VALUE : HxcVcDraftVchName : ""
    03 : SET TARGET : ..
    04 : RETURN : Yes

[Function: Hxc Parse Types Into Draft]
    ;; Split saved CSV (type1,type2,) into Aggregate rows + trailing blank
    Parameter : TypesCsv : String
    Variable  : Piece : String
    Variable  : Counter : Number
    Variable  : ExpLen : Number
    Variable  : Ch : String
    01 : CALL : Hxc Clear Draft Vchs
    02 : SET : Piece : ""
    03 : SET : Counter : 0
    04 : SET : ExpLen : $$StringLength:##TypesCsv
    05 : WHILE : ##Counter < ##ExpLen
    06 :    SET : Ch : $$StringPart:##TypesCsv:##Counter:1
    07 :    IF : ##Ch = ","
    08 :       IF : NOT $$IsEmpty:##Piece
    09 :          INSERT COLLECTION OBJECT : HxcVcDraftVchs
    10 :          SET VALUE : HxcVcDraftVchName : ##Piece
    11 :          SET TARGET : ..
    12 :       END IF
    13 :       SET : Piece : ""
    14 :    ELSE
    15 :       SET : Piece : ##Piece + ##Ch
    16 :    END IF
    17 :    SET : Counter : ##Counter + 1
    18 : END WHILE
    19 : IF : NOT $$IsEmpty:##Piece
    20 :    INSERT COLLECTION OBJECT : HxcVcDraftVchs
    21 :    SET VALUE : HxcVcDraftVchName : ##Piece
    22 :    SET TARGET : ..
    23 : END IF
    24 : CALL : Hxc Seed Draft Vch Row
    25 : RETURN : Yes

[Function: Hxc Vc Clear Draft]
    01 : CALL : Hxc Clear Fetch Vars
    02 : CALL : Hxc Clear Draft Vchs
    03 : CALL : Hxc Seed Draft Vch Row
    04 : CALL : Hxc Clear Draft Maps
    05 : SET VALUE : HxcVcDraftName : ""
    06 : SET VALUE : HxcVcDraftTemplate : ""
    07 : SET VALUE : HxcVcDraftLang : "en"
    08 : SET VALUE : HxcVcDraftMedia : "None"
    09 : SET VALUE : HxcVcDraftAuto : No
    10 : SET VALUE : HxcVcDraftConfirm : No
    11 : SET VALUE : HxcVcDraftEditKey : ""
    12 : SET VALUE : HxcVcDraftHeaderFld : ""
    13 : RETURN : Yes

[Function: Hxc Vc Commit Draft]
    Variable : Maps : String
    Variable : Vchs : String
    Variable : EditKey : String
    01 : SET : HxcVcSaveOk : No
    02 : IF : $$IsEmpty:$HxcVcDraftName
    03 :    Msg Box : "Helixcer Voucher Config" : "Config Name is required."
    04 :    RETURN : No
    05 : END IF
    06 : IF : $$IsEmpty:$HxcVcDraftTemplate
    07 :    Msg Box : "Helixcer Voucher Config" : "Template Name is required."
    08 :    RETURN : No
    09 : END IF
    10 : IF : NOT ##HxcVcFetched
    11 :    Msg Box : "Helixcer Voucher Config" : "Fetch the template first (Enter on Language)."
    12 :    RETURN : No
    13 : END IF
    14 : SET : Maps : $$HxcPackMaps
    15 : SET : Vchs : $$HxcPackVouchers
    16 : SET : EditKey : $HxcVcDraftEditKey
    17 : IF : NOT $$IsEmpty:##EditKey
    18 :    WALK COLLECTION : HxcVoucherConfigs
    19 :       IF : $HxcVcName = ##EditKey
    20 :          SET TARGET
    21 :          SET VALUE : HxcVcName : $HxcVcDraftName
    22 :          SET VALUE : HxcVcTemplateName : $HxcVcDraftTemplate
    23 :          SET VALUE : HxcVcLanguage : $HxcVcDraftLang
    24 :          SET VALUE : HxcVcMediaExport : $HxcVcDraftMedia
    25 :          SET VALUE : HxcVcAutoSend : $HxcVcDraftAuto
    26 :          SET VALUE : HxcVcConfirmBeforeSend : $HxcVcDraftConfirm
    27 :          SET VALUE : HxcVcVarMapsText : ##Maps
    28 :          SET VALUE : HxcVcVoucherTypes : ##Vchs
    29 :          SET TARGET : ..
    30 :       END IF
    31 :    END WALK
    32 : ELSE
    33 :    INSERT COLLECTION OBJECT : HxcVoucherConfigs
    34 :    SET VALUE : HxcVcName : $HxcVcDraftName
    35 :    SET VALUE : HxcVcTemplateName : $HxcVcDraftTemplate
    36 :    SET VALUE : HxcVcLanguage : $HxcVcDraftLang
    37 :    SET VALUE : HxcVcMediaExport : $HxcVcDraftMedia
    38 :    SET VALUE : HxcVcAutoSend : $HxcVcDraftAuto
    39 :    SET VALUE : HxcVcConfirmBeforeSend : $HxcVcDraftConfirm
    40 :    SET VALUE : HxcVcVarMapsText : ##Maps
    41 :    SET VALUE : HxcVcVoucherTypes : ##Vchs
    42 :    SET TARGET : ..
    43 : END IF
    44 : CALL : Hxc Vc Clear Draft
    45 : SET : HxcVcSaveOk : Yes
    46 : Msg Box : "Helixcer Voucher Config" : "Config saved."
    47 : RETURN : Yes

;; ---------------------------------------------------------------------------
;; Menu
;; ---------------------------------------------------------------------------

[#Menu: Gateway of Tally]
    Add : Key Item : Before : @@LOCQuit : Helixcer Chat : H : Menu : Helixcer Chat Menu

[Menu: Helixcer Chat Menu]
    Title    : "Helixcer Chat"
    Key Item : API Settings   : S : Alter : Helixcer API Settings
    Key Item : Voucher Config : V : Menu  : Helixcer Voucher Config Menu
    Key Item : Status         : T : Call  : Hxc Show Status
    Key Item : About          : A : Display : Helixcer Chat About
    Key Item : Back           : B : Menu  : Gateway of Tally

[Menu: Helixcer Voucher Config Menu]
    Title    : "Voucher Config"
    Key Item : Create Config : C : Alter : Helixcer Voucher Config Create
    Key Item : Alter Config  : A : Alter : Helixcer Voucher Config Alter
    Key Item : List Configs  : L : Alter : Helixcer Voucher Config List
    Key Item : Back          : B : Menu  : Helixcer Chat Menu

;; ---------------------------------------------------------------------------
;; API Settings
;; ---------------------------------------------------------------------------

[Report: Helixcer API Settings]
    Form   : Helixcer API Settings
    Title  : "API Settings"
    Object : Company

[Form: Helixcer API Settings]
    Part   : Helixcer API Settings
    Button : Form Accept, Form Cancel

[Part: Helixcer API Settings]
    Lines  : Hxc Api Settings Title, +
             Hxc Workspace Id Line, Hxc Channel Id Line, Hxc Api Key Line, +
             Hxc Save Hint Line
    Scroll : Vertical

[Line: Hxc Api Settings Title]
    Field : Hxc Api Settings Title

[Field: Hxc Api Settings Title]
    Use       : Name Field
    Set as    : "Helixcer Chat — API Settings (build 358)"
    Style     : Bold
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

[Line: Hxc Workspace Id Line]
    Fields : Medium Prompt, HxcWorkspaceIdFld
    Local  : Field : Medium Prompt : Set as : "Workspace ID"
    Local  : Field : Medium Prompt : Width  : 22

[Field: HxcWorkspaceIdFld]
    Use      : Name Field
    Storage  : HxcWorkspaceIdUDF
    Set as   : $HxcWorkspaceIdUDF
    Width    : 50
    Max      : 64
    On       : Accept : Yes : SET : HxcSysWorkspaceId : $Value
    On       : Accept : Yes : Field Accept

[Line: Hxc Channel Id Line]
    Fields : Medium Prompt, HxcChannelIdFld
    Local  : Field : Medium Prompt : Set as : "Channel ID"
    Local  : Field : Medium Prompt : Width  : 22

[Field: HxcChannelIdFld]
    Use      : Name Field
    Storage  : HxcChannelIdUDF
    Set as   : $HxcChannelIdUDF
    Width    : 50
    Max      : 64
    On       : Accept : Yes : SET : HxcSysChannelId : $Value
    On       : Accept : Yes : Field Accept

[Line: Hxc Api Key Line]
    Fields : Medium Prompt, HxcApiKeyFld
    Local  : Field : Medium Prompt : Set as : "API Key"
    Local  : Field : Medium Prompt : Width  : 22

[Field: HxcApiKeyFld]
    Use      : Name Field
    Storage  : HxcApiKeyUDF
    Set as   : $HxcApiKeyUDF
    Width    : 50
    Max      : 200
    On       : Accept : Yes : SET : HxcSysApiKey : $Value
    On       : Accept : Yes : Field Accept

[Line: Hxc Save Hint Line]
    Field : Hxc Save Hint

[Field: Hxc Save Hint]
    Use       : Name Field
    Set as    : "Tab all fields, then Ctrl+A to Accept."
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

;; ---------------------------------------------------------------------------
;; Shared Create/Alter form body (draft fields — single form, not name list)
;; ---------------------------------------------------------------------------

[Part: Hxc Vc Form Body]
    Lines  : Hxc Vc F Name Line, Hxc Vc F Template Line, Hxc Vc F Lang Line, +
             Hxc Vc F Fetch Status Line, Hxc Vc F Fetch Hint Line, +
             Hxc Vc F Prev Head, Hxc Vc F Prev Body
    Scroll : Vertical

[Part: Hxc Vc Form Header Part]
    Lines  : Hxc Vc F Hdr Sect, Hxc Vc F Hdr Media Line, Hxc Vc F Hdr Text Line
    Scroll : Vertical

[Part: Hxc Vc Form Maps Part]
    Lines    : Hxc Vc F Map Head, Hxc Vc F Map Data
    Repeat   : Hxc Vc F Map Data : HxcVcDraftMaps
    Break On : $$IsEmpty:$HxcVcDraftMapKey
    Scroll   : Vertical

;; Dynamic voucher types — add as many rows as needed (blank row to stop)
[Part: Hxc Vc Form Vch Part]
    Lines    : Hxc Vc F Vch Head, Hxc Vc F Vch Data
    Repeat   : Hxc Vc F Vch Data : HxcVcDraftVchs
    Break On : $$IsEmpty:$HxcVcDraftVchName OR $HxcVcDraftVchName = "Not Applicable"
    Scroll   : Vertical

[Part: Hxc Vc Form Settings Part]
    Lines : Hxc Vc F Auto Line, Hxc Vc F Confirm Line

[Line: Hxc Vc F Name Line]
    Fields : Medium Prompt, Hxc Vc F Name
    Local  : Field : Medium Prompt : Set as : "Config Name"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc F Name]
    Use      : Name Field
    Storage  : HxcVcDraftName
    Set as   : $HxcVcDraftName
    Width    : 40
    Max      : 60

[Line: Hxc Vc F Template Line]
    Fields : Medium Prompt, Hxc Vc F Template
    Local  : Field : Medium Prompt : Set as : "Template Name"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc F Template]
    Use      : Name Field
    Storage  : HxcVcDraftTemplate
    Set as   : $HxcVcDraftTemplate
    Width    : 40
    Max      : 80
    On       : Accept : Yes : Field Accept
    On       : Accept : Yes : SET : HxcVcFetchName : $HxcVcDraftTemplate
    On       : Accept : Yes : CALL : Hxc Clear Fetch Vars

[Line: Hxc Vc F Lang Line]
    Fields : Medium Prompt, Hxc Vc F Lang
    Local  : Field : Medium Prompt : Set as : "Language"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc F Lang]
    Use      : Name Field
    Storage  : HxcVcDraftLang
    Set as   : If $$IsEmpty:$HxcVcDraftLang THEN "en" ELSE $HxcVcDraftLang
    Width    : 16
    Max      : 16
    ;; Enter on Language fetches (same as build 347)
    On       : Accept : Yes : Field Accept
    On       : Accept : Yes : SET : HxcVcFetchLang : $HxcVcDraftLang
    On       : Accept : Yes : SET : HxcVcFetchName : $HxcVcDraftTemplate
    On       : Accept : Yes : CALL : Hxc Fetch Template

[Line: Hxc Vc F Fetch Status Line]
    Field : Hxc Vc F Fetch Status

[Field: Hxc Vc F Fetch Status]
    Use        : Name Field
    Set as     : If $$IsEmpty:##HxcVcFetchStatus THEN "Status: Enter on Language to fetch template" ELSE ("Status: " + ##HxcVcFetchStatus)
    Set Always : Yes
    FullWidth  : Yes
    Skip       : Yes

[Line: Hxc Vc F Fetch Hint Line]
    Field : Hxc Vc F Fetch Hint

[Field: Hxc Vc F Fetch Hint]
    Use       : Name Field
    Set as    : "Enter on Language to fetch template preview and variable maps."
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes
    Inactive  : ##HxcVcFetched

[Line: Hxc Vc F Prev Head]
    Field : Hxc Vc F Prev Head Fld

[Field: Hxc Vc F Prev Head Fld]
    Use       : Name Field
    Set as    : "— Template Preview —"
    Style     : Bold
    FullWidth : Yes
    Skip      : Yes
    Inactive  : NOT ##HxcVcFetched

[Line: Hxc Vc F Prev Body]
    Field : Hxc Vc F Prev Body Fld

[Field: Hxc Vc F Prev Body Fld]
    Use        : Name Field
    Set as     : ##HxcVcPreviewText
    Set Always : Yes
    FullWidth  : Yes
    Skip       : Yes
    Inactive   : NOT ##HxcVcFetched

[Line: Hxc Vc F Hdr Sect]
    Field : Hxc Vc F Hdr Sect Fld

[Field: Hxc Vc F Hdr Sect Fld]
    Use       : Name Field
    Set as    : If ##HxcVcHeaderKind = "media" THEN ("— Header (" + ##HxcVcHeaderFormat + " media) —") ELSE ("— Header (text) —")
    Style     : Bold
    FullWidth : Yes
    Skip      : Yes
    Inactive  : NOT ##HxcVcFetched OR NOT ##HxcVcHasHeader

[Line: Hxc Vc F Hdr Media Line]
    Fields : Medium Prompt, Hxc Vc F Media
    Local  : Field : Medium Prompt : Set as : "Media Header"
    Local  : Field : Medium Prompt : Width  : 22
    Local  : Field : Medium Prompt : Inactive : NOT ##HxcVcFetched OR NOT ##HxcVcHeaderKind = "media"

[Field: Hxc Vc F Media]
    Use        : Name Field
    Storage    : HxcVcDraftMedia
    Set as     : If $$IsEmpty:$HxcVcDraftMedia THEN "None" ELSE $HxcVcDraftMedia
    Table      : Hxc Media Export List
    Show Table : Always
    Width      : 40
    Max        : 40
    Inactive   : NOT ##HxcVcFetched OR NOT ##HxcVcHeaderKind = "media"

[Line: Hxc Vc F Hdr Text Line]
    Fields : Hxc Vc F Hdr MP, Hxc Vc F Hdr MK, Hxc Vc F Hdr MF

[Field: Hxc Vc F Hdr MP]
    Use        : Name Field
    Set as     : "Header Var"
    Skip       : Yes
    Width      : 22
    Inactive   : NOT ##HxcVcFetched OR NOT ##HxcVcHeaderKind = "text"

[Field: Hxc Vc F Hdr MK]
    Use        : Name Field
    Set as     : ##HxcVcHeaderKey
    Set Always : Yes
    Skip       : Yes
    Width      : 8
    Inactive   : NOT ##HxcVcFetched OR NOT ##HxcVcHeaderKind = "text"

[Field: Hxc Vc F Hdr MF]
    Use        : Name Field
    Storage    : HxcVcDraftHeaderFld
    Set as     : $HxcVcDraftHeaderFld
    Set Always : Yes
    Table      : Hxc Voucher Field List, Not Applicable
    Width      : 28
    Max        : 40
    Inactive   : NOT ##HxcVcFetched OR NOT ##HxcVcHeaderKind = "text"

[Line: Hxc Vc F Map Head]
    Field : Hxc Vc F Map Head Fld

[Field: Hxc Vc F Map Head Fld]
    Use       : Name Field
    Set as    : "— Body Variables (from template) —"
    Style     : Bold
    FullWidth : Yes
    Skip      : Yes
    Inactive  : NOT ##HxcVcFetched

[Line: Hxc Vc F Map Data]
    Fields : Hxc Vc F Map MP, Hxc Vc F Map MK, Hxc Vc F Map MF

[Field: Hxc Vc F Map MP]
    Use        : Name Field
    Set as     : If $HxcVcDraftMapComp = "button" THEN "Button Var" ELSE "Body Var"
    Skip       : Yes
    Width      : 22
    Inactive   : NOT ##HxcVcFetched OR $$IsEmpty:$HxcVcDraftMapKey

[Field: Hxc Vc F Map MK]
    Use        : Name Field
    Set as     : $HxcVcDraftMapKey
    Set Always : Yes
    Skip       : Yes
    Width      : 8
    Inactive   : NOT ##HxcVcFetched OR $$IsEmpty:$HxcVcDraftMapKey

[Field: Hxc Vc F Map MF]
    Use        : Name Field
    Storage    : HxcVcDraftMapFld
    Set as     : $HxcVcDraftMapFld
    Set Always : Yes
    Table      : Hxc Voucher Field List, Not Applicable
    Width      : 28
    Max        : 40
    Inactive   : NOT ##HxcVcFetched OR $$IsEmpty:$HxcVcDraftMapKey

[Line: Hxc Vc F Vch Head]
    Field : Hxc Vc F Vch Head Fld

[Field: Hxc Vc F Vch Head Fld]
    Use       : Name Field
    Set as    : "— Applicable Voucher Types (add rows; leave blank to end) —"
    Style     : Bold
    FullWidth : Yes
    Skip      : Yes

[Line: Hxc Vc F Vch Data]
    Fields : Medium Prompt, Hxc Vc F Vch Name
    Local  : Field : Medium Prompt : Set as : "Voucher Type"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc F Vch Name]
    Use      : Name Field
    Storage  : HxcVcDraftVchName
    Set as   : $HxcVcDraftVchName
    Table    : Hxc Voucher Type List
    Show Table : Always
    Width    : 40
    Max      : 80

[Line: Hxc Vc F Auto Line]
    Fields : Medium Prompt, Hxc Vc F Auto
    Local  : Field : Medium Prompt : Set as : "Auto Select after save?"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc F Auto]
    Use      : Logical Field
    Storage  : HxcVcDraftAuto
    Set as   : $HxcVcDraftAuto
    Width    : 8

[Line: Hxc Vc F Confirm Line]
    Fields : Medium Prompt, Hxc Vc F Confirm
    Local  : Field : Medium Prompt : Set as : "Confirm before send?"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc F Confirm]
    Use      : Logical Field
    Storage  : HxcVcDraftConfirm
    Set as   : $HxcVcDraftConfirm
    Width    : 8

;; ---------------------------------------------------------------------------
;; CREATE — clear draft, show sequential form
;; ---------------------------------------------------------------------------

[Report: Helixcer Voucher Config Create]
    Form   : Helixcer Voucher Config Create
    Title  : "Create Voucher Config"
    Object : Company

[Form: Helixcer Voucher Config Create]
    Part   : Hxc Vc Cr Title Part, Hxc Vc Form Body, Hxc Vc Form Header Part, Hxc Vc Form Maps Part, Hxc Vc Form Vch Part, Hxc Vc Form Settings Part, Hxc Vc Cr Hint Part
    Button : Form Accept, Form Cancel
    On     : Form Create : Yes : CALL : Hxc Vc Clear Draft
    On     : Form Accept : Yes : CALL : Hxc Vc Commit Draft
    On     : Form Accept : ##HxcVcSaveOk : Form Accept

[Part: Hxc Vc Cr Title Part]
    Lines : Hxc Vc Cr Title Line

[Line: Hxc Vc Cr Title Line]
    Field : Hxc Vc Cr Title

[Field: Hxc Vc Cr Title]
    Use       : Name Field
    Set as    : "Create Voucher Config (build 358)"
    Style     : Bold
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

[Part: Hxc Vc Cr Hint Part]
    Lines : Hxc Vc Cr Hint Line

[Line: Hxc Vc Cr Hint Line]
    Field : Hxc Vc Cr Hint

[Field: Hxc Vc Cr Hint]
    Use       : Name Field
    Set as    : "Name → Template → Language (Enter to fetch) → map → vouchers → Ctrl+A."
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

;; ---------------------------------------------------------------------------
;; ALTER — pick config, load into draft, same form
;; ---------------------------------------------------------------------------

[Function: Hxc Vc Load Draft From Config]
    Variable : EditKey : String
    Variable : TypesRaw : String
    01 : SET : EditKey : $HxcVcDraftEditKey
    02 : IF : $$IsEmpty:##EditKey
    03 :    RETURN : Yes
    04 : END IF
    05 : CALL : Hxc Vc Clear Draft
    06 : SET VALUE : HxcVcDraftEditKey : ##EditKey
    07 : SET : TypesRaw : ""
    08 : WALK COLLECTION : Hxc Voucher Config Names
    09 :    IF : $HxcVcName = ##EditKey
    10 :       SET VALUE : HxcVcDraftName : $HxcVcName
    11 :       SET VALUE : HxcVcDraftTemplate : $HxcVcTemplateName
    12 :       SET VALUE : HxcVcDraftLang : $HxcVcLanguage
    13 :       SET VALUE : HxcVcDraftMedia : $HxcVcMediaExport
    14 :       SET VALUE : HxcVcDraftAuto : $HxcVcAutoSend
    15 :       SET VALUE : HxcVcDraftConfirm : $HxcVcConfirmBeforeSend
    16 :       SET : TypesRaw : $HxcVcVoucherTypes
    17 :    END IF
    18 : END WALK
    19 : CALL : Hxc Parse Types Into Draft : ##TypesRaw
    20 : RETURN : Yes

[Report: Helixcer Voucher Config Alter]
    Form   : Helixcer Voucher Config Alter
    Title  : "Alter Voucher Config"
    Object : Company

[Form: Helixcer Voucher Config Alter]
    Part   : Hxc Vc Al Title Part, Hxc Vc Al Pick Part, Hxc Vc Form Body, Hxc Vc Form Header Part, Hxc Vc Form Maps Part, Hxc Vc Form Vch Part, Hxc Vc Form Settings Part, Hxc Vc Al Hint Part
    Button : Form Accept, Form Cancel
    On     : Form Accept : Yes : CALL : Hxc Vc Commit Draft
    On     : Form Accept : ##HxcVcSaveOk : Form Accept

[Part: Hxc Vc Al Title Part]
    Lines : Hxc Vc Al Title Line

[Line: Hxc Vc Al Title Line]
    Field : Hxc Vc Al Title

[Field: Hxc Vc Al Title]
    Use       : Name Field
    Set as    : "Alter Voucher Config (build 358)"
    Style     : Bold
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

[Part: Hxc Vc Al Pick Part]
    Lines : Hxc Vc Al Pick Line

[Line: Hxc Vc Al Pick Line]
    Fields : Medium Prompt, Hxc Vc Al Pick
    Local  : Field : Medium Prompt : Set as : "Select Config"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc Al Pick]
    Use        : Name Field
    Storage    : HxcVcDraftEditKey
    Set as     : $HxcVcDraftEditKey
    Table      : Hxc Voucher Config Names
    Show Table : Always
    Width      : 40
    Max        : 60
    On         : Accept : Yes : CALL : Hxc Vc Load Draft From Config
    On         : Accept : Yes : Field Accept

[Part: Hxc Vc Al Hint Part]
    Lines : Hxc Vc Al Hint Line

[Line: Hxc Vc Al Hint Line]
    Field : Hxc Vc Al Hint

[Field: Hxc Vc Al Hint]
    Use       : Name Field
    Set as    : "Select config, edit fields below, Ctrl+A."
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

;; ---------------------------------------------------------------------------
;; LIST
;; ---------------------------------------------------------------------------

[Report: Helixcer Voucher Config List]
    Form   : Helixcer Voucher Config List
    Title  : "List Voucher Configs"
    Object : Company

[Form: Helixcer Voucher Config List]
    Part   : Hxc Vc Ls Title Part, Hxc Vc Ls Part, Hxc Vc Ls Hint Part
    Button : Form Cancel

[Part: Hxc Vc Ls Title Part]
    Lines : Hxc Vc Ls Title Line

[Line: Hxc Vc Ls Title Line]
    Field : Hxc Vc Ls Title

[Field: Hxc Vc Ls Title]
    Use       : Name Field
    Set as    : "Voucher Config List (build 358)"
    Style     : Bold
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

[Part: Hxc Vc Ls Part]
    Lines    : Hxc Vc Ls Header Line, Hxc Vc Ls Data Line
    Repeat   : Hxc Vc Ls Data Line : HxcVoucherConfigs
    Break On : $$IsEmpty:$HxcVcName
    Scroll   : Vertical

[Line: Hxc Vc Ls Header Line]
    Fields : Hxc Vc Ls H Name, Hxc Vc Ls H Template, Hxc Vc Ls H Lang, +
             Hxc Vc Ls H Types, Hxc Vc Ls H Media, Hxc Vc Ls H Auto
    Local  : Field : Default : Skip  : Yes
    Local  : Field : Default : Align : Centre
    Local  : Field : Default : Style : Bold

[Field: Hxc Vc Ls H Name]
    Use    : Name Field
    Set as : "Config Name"
    Width  : 16

[Field: Hxc Vc Ls H Template]
    Use    : Name Field
    Set as : "Template"
    Width  : 16

[Field: Hxc Vc Ls H Lang]
    Use    : Name Field
    Set as : "Lang"
    Width  : 6

[Field: Hxc Vc Ls H Types]
    Use    : Name Field
    Set as : "Voucher Types"
    Width  : 24

[Field: Hxc Vc Ls H Media]
    Use    : Name Field
    Set as : "Media"
    Width  : 12

[Field: Hxc Vc Ls H Auto]
    Use    : Name Field
    Set as : "Auto"
    Width  : 6

[Line: Hxc Vc Ls Data Line]
    Fields : Hxc Vc Ls D Name, Hxc Vc Ls D Template, Hxc Vc Ls D Lang, +
             Hxc Vc Ls D Types, Hxc Vc Ls D Media, Hxc Vc Ls D Auto
    Local  : Field : Default : Skip : Yes

[Field: Hxc Vc Ls D Name]
    Use    : Name Field
    Set as : $HxcVcName
    Width  : 16

[Field: Hxc Vc Ls D Template]
    Use    : Name Field
    Set as : $HxcVcTemplateName
    Width  : 16

[Field: Hxc Vc Ls D Lang]
    Use    : Name Field
    Set as : $HxcVcLanguage
    Width  : 6

[Field: Hxc Vc Ls D Types]
    Use    : Name Field
    Set as : $HxcVcVoucherTypes
    Width  : 24

[Field: Hxc Vc Ls D Media]
    Use    : Name Field
    Set as : $HxcVcMediaExport
    Width  : 12

[Field: Hxc Vc Ls D Auto]
    Use    : Name Field
    Set as : If $HxcVcAutoSend THEN "Yes" ELSE "No"
    Width  : 6

[Part: Hxc Vc Ls Hint Part]
    Lines : Hxc Vc Ls Hint Line

[Line: Hxc Vc Ls Hint Line]
    Field : Hxc Vc Ls Hint

[Field: Hxc Vc Ls Hint]
    Use       : Name Field
    Set as    : "Read-only. Esc to leave."
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

;; ---------------------------------------------------------------------------
;; About
;; ---------------------------------------------------------------------------

[Report: Helixcer Chat About]
    Form : Helixcer Chat About

[Form: Helixcer Chat About]
    Part : Helixcer Chat About

[Part: Helixcer Chat About]
    Lines : Helixcer Chat About Title, Helixcer Chat About Body, Helixcer Chat About Status

[Line: Helixcer Chat About Title]
    Field : Helixcer Chat About Title

[Field: Helixcer Chat About Title]
    Use       : Name Field
    Set as    : "Helixcer Chat (build 358)"
    Style     : Bold
    Align     : Centre
    FullWidth : Yes

[Line: Helixcer Chat About Body]
    Field : Helixcer Chat About Body

[Field: Helixcer Chat About Body]
    Use       : Name Field
    Set as    : "Create: enter template+language → fetch → preview + mapping."
    Align     : Centre
    FullWidth : Yes

[Line: Helixcer Chat About Status]
    Field : Helixcer Chat About Status

[Field: Helixcer Chat About Status]
    Use       : Name Field
    Set as    : @@HxcSysSummary
    Align     : Centre
    FullWidth : Yes
