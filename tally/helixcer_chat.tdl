[System: Variable]
    HxcSysWorkspaceId   : ""
    HxcSysChannelId     : ""
    HxcSysApiKey        : ""
    HxcWorkspaceName    : ""
    HxcChannelName      : ""
    HxcConnectionStatus : ""
    HxcVcSaveOk         : No
    HxcVcHasBodyMaps    : No
    HxcVcHasBtnMaps     : No
    HxcVcMoveToMapping  : No
    HxcVcFetched        : No
    HxcVcPreviewText    : ""
    HxcVcFetchStatus    : ""
    HxcVcFetchLang      : "en"
    HxcVcFetchName      : ""
    HxcVcMapsCsv        : ""
    HxcVcHasHeader      : No
    HxcVcHeaderKind     : ""
    HxcVcHeaderFormat   : ""
    HxcVcHeaderKey      : ""
    HxcVcFK1            : ""
    HxcVcFK2            : ""
    HxcVcFK3            : ""
    HxcVcFK4            : ""
    HxcVcFK5            : ""
    HxcVcFK6            : ""
    HxcVcFK7            : ""
    HxcVcFK8            : ""
    HxcVcFK9            : ""
    HxcVcFK10            : ""
    HxcVcFK11            : ""
    HxcVcFK12            : ""
    HxcVcFK13            : ""
    HxcVcFK14            : ""
    HxcVcFK15            : ""
    HxcVcFK16            : ""
    HxcVcFC1            : ""
    HxcVcFC2            : ""
    HxcVcFC3            : ""
    HxcVcFC4            : ""
    HxcVcFC5            : ""
    HxcVcFC6            : ""
    HxcVcFC7            : ""
    HxcVcFC8            : ""
    HxcVcFC9            : ""
    HxcVcFC10            : ""
    HxcVcFC11            : ""
    HxcVcFC12            : ""
    HxcVcFC13            : ""
    HxcVcFC14            : ""
    HxcVcFC15            : ""
    HxcVcFC16            : ""

[System: Formula]
    Hxc Connection Url : "https://api.chat.helixcer.com/api/v1/connection?channelId=" + ##HxcSysChannelId
    Hxc Sys Summary    : "WS=[" + ##HxcSysWorkspaceId + "] CH=[" + ##HxcSysChannelId + "] KeyChars=" + $$StringLength:##HxcSysApiKey
    ;; Same pattern as working build 347 Status/HTTP, but template name in ## var
    Hxc Template Url   : "https://api.chat.helixcer.com/api/v1/whatsapp/templates/" + ##HxcVcFetchName + "?channelId=" + ##HxcSysChannelId + "&language=" + ##HxcVcFetchLang

;; ---------------------------------------------------------------------------
;; Tables
;; ---------------------------------------------------------------------------

[Collection: Hxc Media Export List]
    List : "None", "Voucher PDF", "Voucher HTML", "Voucher XML", "Voucher Excel"

[Collection: Hxc Voucher Type List]
    Type   : Voucher Type
    Format : $Name, 40

;; Dynamic voucher / party / company data labels for mapping (list only)
[Collection: Hxc Voucher Field List]
    Title  : "Voucher Dynamic Data"
    List : "Not Applicable", +
           "Party Ledger Name", "Party Name", "Party Mailing Name", "Party Address", +
           "Party Address 1", "Party Address 2", "Party Address 3", +
           "Party State Name", "Party Country", "Party Pincode", "Party GSTIN/UIN", +
           "Party Mobile", "Party Email", +
           "Buyer Name", "Consignee Name", +
           "Company Name", "Company Mailing Name", "Company GSTIN", "Company State Name", +
           "Voucher Number", "Voucher Date", "Reference", "Narration", "Amount", +
           "Basic Buyer Name", "Basic Buyer Address", "Basic Order Ref", "Basic Order Terms", +
           "Basic Ship Delivery Date", "Basic Due Date", "Basic Base Value", +
           "Sales Person", "Terms of Payment", "Terms of Delivery", "Dispatch Through", +
           "Destination", "Carrier Name", "Bill of Lading", "Eway Bill Number", "IRN", +
           "Guid", "Master ID"

[Collection: Hxc Voucher Config Names]
    Type     : HxcVoucherConfigs : Company
    Child Of : ##SVCurrentCompany
    Format   : $HxcVcName, 40
    Fetch    : HxcVcName, HxcVcTemplateName, HxcVcLanguage, HxcVcVoucherTypes, +
               HxcVcMediaExport, HxcVcAutoSend, HxcVcConfirmBeforeSend, HxcVcVarMapsText
    Title    : "Voucher Configs"

;; ---------------------------------------------------------------------------
;; HTTP (Status)
;; ---------------------------------------------------------------------------

[Report: Hxc Connection Request]
    Form          : Hxc Connection Request
    Export Header : "Authorization: Bearer " + ##HxcSysApiKey
    Export Header : "X-Workspace-Id: " + ##HxcSysWorkspaceId
    Export Header : "Accept: application/json"

[Form: Hxc Connection Request]
    Part : Hxc Connection Request

[Part: Hxc Connection Request]
    Lines : Hxc Connection Request

[Line: Hxc Connection Request]
    Fields : Hxc Connection Request

[Field: Hxc Connection Request]
    Use    : Name Field
    Set as : ""
    Skip   : Yes

[Function: Hxc Apply Connection Response]
    Variable : Platform : String
    01 : SET : HxcWorkspaceName : ""
    02 : SET : HxcChannelName : ""
    03 : SET : HxcConnectionStatus : "Could not fetch. Check IDs and API Key."
    04 : WALK COLLECTION : Parameter Collection
    05 :    IF : NOT $$IsEmpty:$workspaceName
    06 :       SET : Platform : $platformLabel
    07 :       IF : $$IsEmpty:##Platform
    08 :          SET : Platform : $connectorType
    09 :       END IF
    10 :       IF : $$IsEmpty:##Platform
    11 :          SET : Platform : "Channel"
    12 :       END IF
    13 :       SET : HxcWorkspaceName : $workspaceName
    14 :       SET : HxcChannelName : $channelName + " (" + ##Platform + ")"
    15 :       SET : HxcConnectionStatus : "Connected"
    16 :    END IF
    17 : END WALK
    18 : RETURN : Yes

[Function: Hxc Sync From Company]
    01 : IF : NOT $$IsEmpty:$HxcWorkspaceIdUDF:Company:##SVCurrentCompany
    02 :    SET : HxcSysWorkspaceId : $HxcWorkspaceIdUDF:Company:##SVCurrentCompany
    03 : END IF
    04 : IF : NOT $$IsEmpty:$HxcChannelIdUDF:Company:##SVCurrentCompany
    05 :    SET : HxcSysChannelId : $HxcChannelIdUDF:Company:##SVCurrentCompany
    06 : END IF
    07 : IF : NOT $$IsEmpty:$HxcApiKeyUDF:Company:##SVCurrentCompany
    08 :    SET : HxcSysApiKey : $HxcApiKeyUDF:Company:##SVCurrentCompany
    09 : END IF
    10 : RETURN : Yes

[Function: Hxc Fetch Connection]
    01 : CALL : Hxc Sync From Company
    02 : IF : $$IsEmpty:##HxcSysWorkspaceId OR $$IsEmpty:##HxcSysChannelId OR $$IsEmpty:##HxcSysApiKey
    03 :    SET : HxcConnectionStatus : "Not ready. " + @@HxcSysSummary + "  Accept API Settings with Ctrl+A first."
    04 :    RETURN : No
    05 : END IF
    06 : SET : HxcWorkspaceName : ""
    07 : SET : HxcChannelName : ""
    08 : SET : HxcConnectionStatus : "Checking..."
    09 : Start Progress : 1 : "Helixcer Chat" : "Connection status" : "Fetching workspace and channel"
    10 : HTTP Request : @@HxcConnectionUrl : GET : JSON : UTF8 : Hxc Connection Request : Hxc Apply Connection Response
    11 : End Progress
    12 : IF : $$IsEmpty:##HxcWorkspaceName
    13 :    IF : ##HxcConnectionStatus = "Checking..."
    14 :       SET : HxcConnectionStatus : "Could not fetch. Check IDs and API Key."
    15 :    END IF
    16 : END IF
    17 : RETURN : Yes

[Function: Hxc Show Status]
    01 : CALL : Hxc Fetch Connection
    02 : Msg Box : "Helixcer Connection Status" : ##HxcConnectionStatus
    03 : IF : NOT $$IsEmpty:##HxcWorkspaceName
    04 :    Msg Box : "Workspace" : ##HxcWorkspaceName
    05 :    Msg Box : "Channel" : ##HxcChannelName
    06 : END IF
    07 : RETURN : Yes

[Function: Hxc Clear Fetch Vars]
    00 : SET : HxcVcMoveToMapping : No
    01 : SET : HxcVcFetched : No
    02 : SET : HxcVcPreviewText : ""
    03 : SET : HxcVcFetchStatus : ""
    04 : SET : HxcVcMapsCsv : ""
    05 : SET : HxcVcHasHeader : No
    06 : SET : HxcVcHeaderKind : ""
    07 : SET : HxcVcHeaderFormat : ""
    08 : SET : HxcVcHeaderKey : ""
    09 : SET : HxcVcHasBodyMaps : No
    10 : SET : HxcVcHasBtnMaps : No
    11 : SET : HxcVcFK1 : ""
    12 : SET : HxcVcFK2 : ""
    13 : SET : HxcVcFK3 : ""
    14 : SET : HxcVcFK4 : ""
    15 : SET : HxcVcFK5 : ""
    16 : SET : HxcVcFK6 : ""
    17 : SET : HxcVcFK7 : ""
    18 : SET : HxcVcFK8 : ""
    19 : SET : HxcVcFK9 : ""
    20 : SET : HxcVcFK10 : ""
    21 : SET : HxcVcFK11 : ""
    22 : SET : HxcVcFK12 : ""
    23 : SET : HxcVcFK13 : ""
    24 : SET : HxcVcFK14 : ""
    25 : SET : HxcVcFK15 : ""
    26 : SET : HxcVcFK16 : ""
    27 : SET : HxcVcFC1 : ""
    28 : SET : HxcVcFC2 : ""
    29 : SET : HxcVcFC3 : ""
    30 : SET : HxcVcFC4 : ""
    31 : SET : HxcVcFC5 : ""
    32 : SET : HxcVcFC6 : ""
    33 : SET : HxcVcFC7 : ""
    34 : SET : HxcVcFC8 : ""
    35 : SET : HxcVcFC9 : ""
    36 : SET : HxcVcFC10 : ""
    37 : SET : HxcVcFC11 : ""
    38 : SET : HxcVcFC12 : ""
    39 : SET : HxcVcFC13 : ""
    40 : SET : HxcVcFC14 : ""
    41 : SET : HxcVcFC15 : ""
    42 : SET : HxcVcFC16 : ""
    43 : RETURN : Yes

[Function: Hxc Set Map Slot]
    Parameter : Idx : Number
    Parameter : Key : String
    Parameter : Comp : String
    01 : IF : ##Idx = 1
    02 :    SET : HxcVcFK1 : ##Key
    03 :    SET : HxcVcFC1 : ##Comp
    04 : END IF
    05 : IF : ##Idx = 2
    06 :    SET : HxcVcFK2 : ##Key
    07 :    SET : HxcVcFC2 : ##Comp
    08 : END IF
    09 : IF : ##Idx = 3
    10 :    SET : HxcVcFK3 : ##Key
    11 :    SET : HxcVcFC3 : ##Comp
    12 : END IF
    13 : IF : ##Idx = 4
    14 :    SET : HxcVcFK4 : ##Key
    15 :    SET : HxcVcFC4 : ##Comp
    16 : END IF
    17 : IF : ##Idx = 5
    18 :    SET : HxcVcFK5 : ##Key
    19 :    SET : HxcVcFC5 : ##Comp
    20 : END IF
    21 : IF : ##Idx = 6
    22 :    SET : HxcVcFK6 : ##Key
    23 :    SET : HxcVcFC6 : ##Comp
    24 : END IF
    25 : IF : ##Idx = 7
    26 :    SET : HxcVcFK7 : ##Key
    27 :    SET : HxcVcFC7 : ##Comp
    28 : END IF
    29 : IF : ##Idx = 8
    30 :    SET : HxcVcFK8 : ##Key
    31 :    SET : HxcVcFC8 : ##Comp
    32 : END IF
    33 : IF : ##Idx = 9
    34 :    SET : HxcVcFK9 : ##Key
    35 :    SET : HxcVcFC9 : ##Comp
    36 : END IF
    37 : IF : ##Idx = 10
    38 :    SET : HxcVcFK10 : ##Key
    39 :    SET : HxcVcFC10 : ##Comp
    40 : END IF
    41 : IF : ##Idx = 11
    42 :    SET : HxcVcFK11 : ##Key
    43 :    SET : HxcVcFC11 : ##Comp
    44 : END IF
    45 : IF : ##Idx = 12
    46 :    SET : HxcVcFK12 : ##Key
    47 :    SET : HxcVcFC12 : ##Comp
    48 : END IF
    49 : IF : ##Idx = 13
    50 :    SET : HxcVcFK13 : ##Key
    51 :    SET : HxcVcFC13 : ##Comp
    52 : END IF
    53 : IF : ##Idx = 14
    54 :    SET : HxcVcFK14 : ##Key
    55 :    SET : HxcVcFC14 : ##Comp
    56 : END IF
    57 : IF : ##Idx = 15
    58 :    SET : HxcVcFK15 : ##Key
    59 :    SET : HxcVcFC15 : ##Comp
    60 : END IF
    61 : IF : ##Idx = 16
    62 :    SET : HxcVcFK16 : ##Key
    63 :    SET : HxcVcFC16 : ##Comp
    64 : END IF
    65 : IF : ##Comp = "body"
    66 :    SET : HxcVcHasBodyMaps : Yes
    67 : END IF
    68 : IF : ##Comp = "button"
    69 :    SET : HxcVcHasBtnMaps : Yes
    70 : END IF
    71 : RETURN : Yes

[Function: Hxc Write Slot Fld]
    Parameter : Slot : Number
    Parameter : Val : String
    01 : IF : ##Slot = 1
    02 :    SET VALUE : HxcVcDMFld1 : ##Val
    03 : END IF
    04 : IF : ##Slot = 2
    05 :    SET VALUE : HxcVcDMFld2 : ##Val
    06 : END IF
    07 : IF : ##Slot = 3
    08 :    SET VALUE : HxcVcDMFld3 : ##Val
    09 : END IF
    10 : IF : ##Slot = 4
    11 :    SET VALUE : HxcVcDMFld4 : ##Val
    12 : END IF
    13 : IF : ##Slot = 5
    14 :    SET VALUE : HxcVcDMFld5 : ##Val
    15 : END IF
    16 : IF : ##Slot = 6
    17 :    SET VALUE : HxcVcDMFld6 : ##Val
    18 : END IF
    19 : IF : ##Slot = 7
    20 :    SET VALUE : HxcVcDMFld7 : ##Val
    21 : END IF
    22 : IF : ##Slot = 8
    23 :    SET VALUE : HxcVcDMFld8 : ##Val
    24 : END IF
    25 : IF : ##Slot = 9
    26 :    SET VALUE : HxcVcDMFld9 : ##Val
    27 : END IF
    28 : IF : ##Slot = 10
    29 :    SET VALUE : HxcVcDMFld10 : ##Val
    30 : END IF
    31 : IF : ##Slot = 11
    32 :    SET VALUE : HxcVcDMFld11 : ##Val
    33 : END IF
    34 : IF : ##Slot = 12
    35 :    SET VALUE : HxcVcDMFld12 : ##Val
    36 : END IF
    37 : IF : ##Slot = 13
    38 :    SET VALUE : HxcVcDMFld13 : ##Val
    39 : END IF
    40 : IF : ##Slot = 14
    41 :    SET VALUE : HxcVcDMFld14 : ##Val
    42 : END IF
    43 : IF : ##Slot = 15
    44 :    SET VALUE : HxcVcDMFld15 : ##Val
    45 : END IF
    46 : IF : ##Slot = 16
    47 :    SET VALUE : HxcVcDMFld16 : ##Val
    48 : END IF
    49 : RETURN : Yes

[Function: Hxc Apply Template Response]
    ;; Proven walk (build 347) + header; body/button → FK1..16 via Set Map Slot
    Variable : I : Number
    Variable : CompType : String
    Variable : Fmt : String
    Variable : VComp : String
    Variable : VKey : String
    01 : SET : I : 0
    02 : CALL : Hxc Clear Fetch Vars
    03 : SET : HxcVcFetchStatus : "Template not found or empty response."
    04 : WALK COLLECTION : Parameter Collection
    05 :    WALK COLLECTION : items
    06 :       WALK COLLECTION : components
    07 :          SET : CompType : $type
    08 :          IF : ##CompType = "header" OR ##CompType = "HEADER" OR ##CompType = "Header"
    09 :             SET : HxcVcHasHeader : Yes
    10 :             SET : Fmt : $format
    11 :             IF : $$IsEmpty:##Fmt
    12 :                SET : Fmt : "TEXT"
    13 :             END IF
    14 :             SET : HxcVcHeaderFormat : ##Fmt
    15 :             IF : ##Fmt = "IMAGE" OR ##Fmt = "VIDEO" OR ##Fmt = "DOCUMENT" OR ##Fmt = "GIF" OR ##Fmt = "image" OR ##Fmt = "video" OR ##Fmt = "document" OR ##Fmt = "gif"
    16 :                SET : HxcVcHeaderKind : "media"
    17 :             ELSE
    18 :                SET : HxcVcHeaderKind : "text"
    19 :             END IF
    20 :             IF : ##HxcVcHeaderKind = "text"
    21 :                IF : NOT $$IsEmpty:$text
    22 :                   SET : HxcVcPreviewText : "[Header] " + $text + " | "
    23 :                END IF
    24 :             END IF
    25 :          END IF
    26 :          IF : ##CompType = "body" OR ##CompType = "BODY" OR ##CompType = "Body"
    27 :             IF : NOT $$IsEmpty:$text
    28 :                SET : HxcVcPreviewText : ##HxcVcPreviewText + $text
    29 :             END IF
    30 :          END IF
    31 :       END WALK
    32 :       WALK COLLECTION : variables
    33 :          SET : VComp : $component
    34 :          SET : VKey : $key
    35 :          IF : $$IsEmpty:##VComp
    36 :             SET : VComp : "body"
    37 :          END IF
    38 :          IF : ##VComp = "HEADER"
    39 :             SET : VComp : "header"
    40 :          END IF
    41 :          IF : ##VComp = "BODY"
    42 :             SET : VComp : "body"
    43 :          END IF
    44 :          IF : ##VComp = "BUTTON"
    45 :             SET : VComp : "button"
    46 :          END IF
    47 :          IF : NOT $$IsEmpty:##VKey
    48 :             IF : ##VComp = "header"
    49 :                IF : NOT ##HxcVcHeaderKind = "media"
    50 :                   SET : HxcVcHasHeader : Yes
    51 :                   IF : $$IsEmpty:##HxcVcHeaderKind
    52 :                      SET : HxcVcHeaderKind : "text"
    53 :                   END IF
    54 :                   SET : HxcVcHeaderKey : ##VKey
    55 :                END IF
    56 :             ELSE
    57 :                SET : I : ##I + 1
    58 :                CALL : Hxc Set Map Slot : ##I : ##VKey : ##VComp
    59 :             END IF
    60 :          END IF
    61 :       END WALK
    62 :       SET : HxcVcFetched : Yes
    63 :       SET : HxcVcFetchStatus : "Template loaded."
    64 :    END WALK
    65 : END WALK
    66 : IF : ##HxcVcFetched
    67 :    IF : $$IsEmpty:##HxcVcPreviewText
    68 :       SET : HxcVcPreviewText : "(No body text in template)"
    69 :    END IF
    70 : END IF
    71 : RETURN : Yes

[Function: Hxc Fetch Template]
    01 : CALL : Hxc Sync From Company
    02 : CALL : Hxc Clear Fetch Vars
    03 : IF : $$IsEmpty:##HxcSysWorkspaceId OR $$IsEmpty:##HxcSysChannelId OR $$IsEmpty:##HxcSysApiKey
    04 :    SET : HxcVcFetchStatus : "Save API Settings (Ctrl+A) before fetching a template."
    05 :    Msg Box : "Helixcer Template" : ##HxcVcFetchStatus
    06 :    RETURN : No
    07 : END IF
    08 : SET : HxcVcFetchName : $HxcVcDraftTemplate
    09 : IF : $$IsEmpty:##HxcVcFetchName
    10 :    SET : HxcVcFetchName : $HxcVcDraftTemplate:Company:##SVCurrentCompany
    11 : END IF
    12 : IF : $$IsEmpty:##HxcVcFetchLang
    13 :    SET : HxcVcFetchLang : $HxcVcDraftLang
    14 : END IF
    15 : IF : $$IsEmpty:##HxcVcFetchLang
    16 :    SET : HxcVcFetchLang : "en"
    17 : END IF
    18 : IF : $$IsEmpty:##HxcVcFetchName
    19 :    SET : HxcVcFetchStatus : "Enter Template Name first."
    20 :    Msg Box : "Helixcer Template" : ##HxcVcFetchStatus
    21 :    RETURN : No
    22 : END IF
    23 : SET : HxcVcFetchStatus : "Fetching..."
    24 : Start Progress : 1 : "Helixcer Chat" : "Template" : "Fetching template details"
    25 : HTTP Request : @@HxcTemplateUrl : GET : JSON : UTF8 : Hxc Connection Request : Hxc Apply Template Response
    26 : End Progress
    27 : IF : NOT ##HxcVcFetched
    28 :    IF : $$IsEmpty:##HxcVcFetchStatus OR ##HxcVcFetchStatus = "Fetching..."
    29 :       SET : HxcVcFetchStatus : "Could not fetch [" + ##HxcVcFetchName + "]. Open Helixcer Chat → Status. If Connected, check the template name on this channel."
    30 :    END IF
    31 :    Msg Box : "Helixcer Template" : ##HxcVcFetchStatus
    32 :    RETURN : No
    33 : END IF
    34 : SET VALUE : HxcVcDMFld1 : ""
    35 : SET VALUE : HxcVcDMFld2 : ""
    36 : SET VALUE : HxcVcDMFld3 : ""
    37 : SET VALUE : HxcVcDMFld4 : ""
    38 : SET VALUE : HxcVcDMFld5 : ""
    39 : SET VALUE : HxcVcDMFld6 : ""
    40 : SET VALUE : HxcVcDMFld7 : ""
    41 : SET VALUE : HxcVcDMFld8 : ""
    42 : SET VALUE : HxcVcDMFld9 : ""
    43 : SET VALUE : HxcVcDMFld10 : ""
    44 : SET VALUE : HxcVcDMFld11 : ""
    45 : SET VALUE : HxcVcDMFld12 : ""
    46 : SET VALUE : HxcVcDMFld13 : ""
    47 : SET VALUE : HxcVcDMFld14 : ""
    48 : SET VALUE : HxcVcDMFld15 : ""
    49 : SET VALUE : HxcVcDMFld16 : ""
    50 : SET VALUE : HxcVcDraftHeaderFld : ""
    51 : IF : ##HxcVcHeaderKind = "media"
    52 :    IF : $$IsEmpty:$HxcVcDraftMedia OR $HxcVcDraftMedia = "None"
    53 :       SET VALUE : HxcVcDraftMedia : "Voucher PDF"
    54 :    END IF
    55 : ELSE
    56 :    SET VALUE : HxcVcDraftMedia : "None"
    57 : END IF
    58 : SET : HxcVcMoveToMapping : Yes
    59 : RETURN : Yes

;; ---------------------------------------------------------------------------
;; Pack helpers + commit draft → Aggregate config
;; ---------------------------------------------------------------------------

[Function: Hxc Pack Maps]
    Variable : S : String
    01 : SET : S : ""
    02 : IF : ##HxcVcHeaderKind = "text" AND NOT $$IsEmpty:##HxcVcHeaderKey
    03 :    SET : S : ##S + "header:" + ##HxcVcHeaderKey + "=" + $HxcVcDraftHeaderFld + ";"
    04 : END IF
    05 : IF : NOT $$IsEmpty:##HxcVcFK1
    06 :    SET : S : ##S + ##HxcVcFC1 + ":" + ##HxcVcFK1 + "=" + $HxcVcDMFld1 + ";"
    07 : END IF
    08 : IF : NOT $$IsEmpty:##HxcVcFK2
    09 :    SET : S : ##S + ##HxcVcFC2 + ":" + ##HxcVcFK2 + "=" + $HxcVcDMFld2 + ";"
    10 : END IF
    11 : IF : NOT $$IsEmpty:##HxcVcFK3
    12 :    SET : S : ##S + ##HxcVcFC3 + ":" + ##HxcVcFK3 + "=" + $HxcVcDMFld3 + ";"
    13 : END IF
    14 : IF : NOT $$IsEmpty:##HxcVcFK4
    15 :    SET : S : ##S + ##HxcVcFC4 + ":" + ##HxcVcFK4 + "=" + $HxcVcDMFld4 + ";"
    16 : END IF
    17 : IF : NOT $$IsEmpty:##HxcVcFK5
    18 :    SET : S : ##S + ##HxcVcFC5 + ":" + ##HxcVcFK5 + "=" + $HxcVcDMFld5 + ";"
    19 : END IF
    20 : IF : NOT $$IsEmpty:##HxcVcFK6
    21 :    SET : S : ##S + ##HxcVcFC6 + ":" + ##HxcVcFK6 + "=" + $HxcVcDMFld6 + ";"
    22 : END IF
    23 : IF : NOT $$IsEmpty:##HxcVcFK7
    24 :    SET : S : ##S + ##HxcVcFC7 + ":" + ##HxcVcFK7 + "=" + $HxcVcDMFld7 + ";"
    25 : END IF
    26 : IF : NOT $$IsEmpty:##HxcVcFK8
    27 :    SET : S : ##S + ##HxcVcFC8 + ":" + ##HxcVcFK8 + "=" + $HxcVcDMFld8 + ";"
    28 : END IF
    29 : IF : NOT $$IsEmpty:##HxcVcFK9
    30 :    SET : S : ##S + ##HxcVcFC9 + ":" + ##HxcVcFK9 + "=" + $HxcVcDMFld9 + ";"
    31 : END IF
    32 : IF : NOT $$IsEmpty:##HxcVcFK10
    33 :    SET : S : ##S + ##HxcVcFC10 + ":" + ##HxcVcFK10 + "=" + $HxcVcDMFld10 + ";"
    34 : END IF
    35 : IF : NOT $$IsEmpty:##HxcVcFK11
    36 :    SET : S : ##S + ##HxcVcFC11 + ":" + ##HxcVcFK11 + "=" + $HxcVcDMFld11 + ";"
    37 : END IF
    38 : IF : NOT $$IsEmpty:##HxcVcFK12
    39 :    SET : S : ##S + ##HxcVcFC12 + ":" + ##HxcVcFK12 + "=" + $HxcVcDMFld12 + ";"
    40 : END IF
    41 : IF : NOT $$IsEmpty:##HxcVcFK13
    42 :    SET : S : ##S + ##HxcVcFC13 + ":" + ##HxcVcFK13 + "=" + $HxcVcDMFld13 + ";"
    43 : END IF
    44 : IF : NOT $$IsEmpty:##HxcVcFK14
    45 :    SET : S : ##S + ##HxcVcFC14 + ":" + ##HxcVcFK14 + "=" + $HxcVcDMFld14 + ";"
    46 : END IF
    47 : IF : NOT $$IsEmpty:##HxcVcFK15
    48 :    SET : S : ##S + ##HxcVcFC15 + ":" + ##HxcVcFK15 + "=" + $HxcVcDMFld15 + ";"
    49 : END IF
    50 : IF : NOT $$IsEmpty:##HxcVcFK16
    51 :    SET : S : ##S + ##HxcVcFC16 + ":" + ##HxcVcFK16 + "=" + $HxcVcDMFld16 + ";"
    52 : END IF
    53 : RETURN : ##S
[Function: Hxc Pack Vouchers]
    Variable : S : String
    01 : SET : S : ""
    02 : WALK COLLECTION : HxcVcDraftVchs
    03 :    IF : NOT $$IsEmpty:$HxcVcDraftVchName
    04 :       IF : NOT $HxcVcDraftVchName = "End of List"
    05 :          IF : NOT $HxcVcDraftVchName = "Not Applicable"
    06 :             SET : S : ##S + $HxcVcDraftVchName + ","
    07 :          END IF
    08 :       END IF
    09 :    END IF
    10 : END WALK
    11 : RETURN : ##S

[Function: Hxc Clear Draft Vchs]
    ;; Remove all draft voucher-type rows
    01 : WALK COLLECTION : HxcVcDraftVchs
    02 :    DELETE OBJECT
    03 : END WALK
    04 : RETURN : Yes

[Function: Hxc Seed Draft Vch Row]
    ;; One blank row so Repeat Aggregate is editable
    01 : INSERT COLLECTION OBJECT : HxcVcDraftVchs
    02 : SET VALUE : HxcVcDraftVchName : ""
    03 : SET TARGET : ..
    04 : RETURN : Yes

[Function: Hxc Parse Types Into Draft]
    ;; Split saved CSV (type1,type2,) into Aggregate rows + trailing blank
    Parameter : TypesCsv : String
    Variable  : Piece : String
    Variable  : Counter : Number
    Variable  : ExpLen : Number
    Variable  : Ch : String
    01 : CALL : Hxc Clear Draft Vchs
    02 : SET : Piece : ""
    03 : SET : Counter : 0
    04 : SET : ExpLen : $$StringLength:##TypesCsv
    05 : WHILE : ##Counter < ##ExpLen
    06 :    SET : Ch : $$StringPart:##TypesCsv:##Counter:1
    07 :    IF : ##Ch = ","
    08 :       IF : NOT $$IsEmpty:##Piece
    09 :          INSERT COLLECTION OBJECT : HxcVcDraftVchs
    10 :          SET VALUE : HxcVcDraftVchName : ##Piece
    11 :          SET TARGET : ..
    12 :       END IF
    13 :       SET : Piece : ""
    14 :    ELSE
    15 :       SET : Piece : ##Piece + ##Ch
    16 :    END IF
    17 :    SET : Counter : ##Counter + 1
    18 : END WHILE
    19 : IF : NOT $$IsEmpty:##Piece
    20 :    INSERT COLLECTION OBJECT : HxcVcDraftVchs
    21 :    SET VALUE : HxcVcDraftVchName : ##Piece
    22 :    SET TARGET : ..
    23 : END IF
    24 : CALL : Hxc Seed Draft Vch Row
    25 : RETURN : Yes

[Function: Hxc Vc Clear Draft]
    01 : CALL : Hxc Clear Fetch Vars
    02 : CALL : Hxc Clear Draft Vchs
    03 : CALL : Hxc Seed Draft Vch Row
    04 : SET VALUE : HxcVcDraftName : ""
    05 : SET VALUE : HxcVcDraftTemplate : ""
    06 : SET VALUE : HxcVcDraftLang : "en"
    07 : SET VALUE : HxcVcDraftMedia : "None"
    08 : SET VALUE : HxcVcDraftAuto : No
    09 : SET VALUE : HxcVcDraftConfirm : No
    10 : SET VALUE : HxcVcDraftEditKey : ""
    11 : SET VALUE : HxcVcDraftHeaderFld : ""
    12 : SET VALUE : HxcVcDMFld1 : ""
    13 : SET VALUE : HxcVcDMFld2 : ""
    14 : SET VALUE : HxcVcDMFld3 : ""
    15 : SET VALUE : HxcVcDMFld4 : ""
    16 : SET VALUE : HxcVcDMFld5 : ""
    17 : SET VALUE : HxcVcDMFld6 : ""
    18 : SET VALUE : HxcVcDMFld7 : ""
    19 : SET VALUE : HxcVcDMFld8 : ""
    20 : SET VALUE : HxcVcDMFld9 : ""
    21 : SET VALUE : HxcVcDMFld10 : ""
    22 : SET VALUE : HxcVcDMFld11 : ""
    23 : SET VALUE : HxcVcDMFld12 : ""
    24 : SET VALUE : HxcVcDMFld13 : ""
    25 : SET VALUE : HxcVcDMFld14 : ""
    26 : SET VALUE : HxcVcDMFld15 : ""
    27 : SET VALUE : HxcVcDMFld16 : ""
    28 : RETURN : Yes


[Function: Hxc Vc Commit Draft]
    Variable : Maps : String
    Variable : Vchs : String
    Variable : EditKey : String
    01 : SET : HxcVcSaveOk : No
    02 : IF : $$IsEmpty:$HxcVcDraftName
    03 :    Msg Box : "Helixcer Voucher Config" : "Config Name is required."
    04 :    RETURN : No
    05 : END IF
    06 : IF : $$IsEmpty:$HxcVcDraftTemplate
    07 :    Msg Box : "Helixcer Voucher Config" : "Template Name is required."
    08 :    RETURN : No
    09 : END IF
    10 : IF : NOT ##HxcVcFetched
    11 :    Msg Box : "Helixcer Voucher Config" : "Fetch the template first (Enter on Language)."
    12 :    RETURN : No
    13 : END IF
    14 : SET : Maps : $$HxcPackMaps
    15 : SET : Vchs : $$HxcPackVouchers
    16 : SET : EditKey : $HxcVcDraftEditKey
    17 : IF : NOT $$IsEmpty:##EditKey
    18 :    WALK COLLECTION : HxcVoucherConfigs
    19 :       IF : $HxcVcName = ##EditKey
    20 :          SET TARGET
    21 :          SET VALUE : HxcVcName : $HxcVcDraftName
    22 :          SET VALUE : HxcVcTemplateName : $HxcVcDraftTemplate
    23 :          SET VALUE : HxcVcLanguage : $HxcVcDraftLang
    24 :          SET VALUE : HxcVcMediaExport : $HxcVcDraftMedia
    25 :          SET VALUE : HxcVcAutoSend : $HxcVcDraftAuto
    26 :          SET VALUE : HxcVcConfirmBeforeSend : $HxcVcDraftConfirm
    27 :          SET VALUE : HxcVcVarMapsText : ##Maps
    28 :          SET VALUE : HxcVcVoucherTypes : ##Vchs
    29 :          SET TARGET : ..
    30 :       END IF
    31 :    END WALK
    32 : ELSE
    33 :    INSERT COLLECTION OBJECT : HxcVoucherConfigs
    34 :    SET VALUE : HxcVcName : $HxcVcDraftName
    35 :    SET VALUE : HxcVcTemplateName : $HxcVcDraftTemplate
    36 :    SET VALUE : HxcVcLanguage : $HxcVcDraftLang
    37 :    SET VALUE : HxcVcMediaExport : $HxcVcDraftMedia
    38 :    SET VALUE : HxcVcAutoSend : $HxcVcDraftAuto
    39 :    SET VALUE : HxcVcConfirmBeforeSend : $HxcVcDraftConfirm
    40 :    SET VALUE : HxcVcVarMapsText : ##Maps
    41 :    SET VALUE : HxcVcVoucherTypes : ##Vchs
    42 :    SET TARGET : ..
    43 : END IF
    44 : CALL : Hxc Vc Clear Draft
    45 : SET : HxcVcSaveOk : Yes
    46 : Msg Box : "Helixcer Voucher Config" : "Config saved."
    47 : RETURN : Yes

;; ---------------------------------------------------------------------------
;; Menu
;; ---------------------------------------------------------------------------

[#Menu: Gateway of Tally]
    Add : Key Item : Before : @@LOCQuit : Helixcer Chat : H : Menu : Helixcer Chat Menu

[Menu: Helixcer Chat Menu]
    Title    : "Helixcer Chat"
    Key Item : API Settings   : S : Alter : Helixcer API Settings
    Key Item : Voucher Config : V : Menu  : Helixcer Voucher Config Menu
    Key Item : Status         : T : Call  : Hxc Show Status
    Key Item : About          : A : Display : Helixcer Chat About
    Key Item : Back           : B : Menu  : Gateway of Tally

[Menu: Helixcer Voucher Config Menu]
    Title    : "Voucher Config"
    Key Item : Create Config : C : Alter : Helixcer Voucher Config Create
    Key Item : Alter Config  : A : Alter : Helixcer Voucher Config Alter
    Key Item : List Configs  : L : Alter : Helixcer Voucher Config List
    Key Item : Back          : B : Menu  : Helixcer Chat Menu

;; ---------------------------------------------------------------------------
;; API Settings
;; ---------------------------------------------------------------------------

[Report: Helixcer API Settings]
    Form   : Helixcer API Settings
    Title  : "API Settings"
    Object : Company

[Form: Helixcer API Settings]
    Part   : Helixcer API Settings
    Button : Form Accept, Form Cancel

[Part: Helixcer API Settings]
    Lines  : Hxc Api Settings Title, +
             Hxc Workspace Id Line, Hxc Channel Id Line, Hxc Api Key Line, +
             Hxc Save Hint Line
    Scroll : Vertical

[Line: Hxc Api Settings Title]
    Field : Hxc Api Settings Title

[Field: Hxc Api Settings Title]
    Use       : Name Field
    Set as    : "Helixcer Chat — API Settings (build 384)"
    Style     : Bold
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

[Line: Hxc Workspace Id Line]
    Fields : Medium Prompt, HxcWorkspaceIdFld
    Local  : Field : Medium Prompt : Set as : "Workspace ID"
    Local  : Field : Medium Prompt : Width  : 22

[Field: HxcWorkspaceIdFld]
    Use      : Name Field
    Storage  : HxcWorkspaceIdUDF
    Set as   : $HxcWorkspaceIdUDF
    Width    : 50
    Max      : 64
    On       : Accept : Yes : SET : HxcSysWorkspaceId : $Value
    On       : Accept : Yes : Field Accept

[Line: Hxc Channel Id Line]
    Fields : Medium Prompt, HxcChannelIdFld
    Local  : Field : Medium Prompt : Set as : "Channel ID"
    Local  : Field : Medium Prompt : Width  : 22

[Field: HxcChannelIdFld]
    Use      : Name Field
    Storage  : HxcChannelIdUDF
    Set as   : $HxcChannelIdUDF
    Width    : 50
    Max      : 64
    On       : Accept : Yes : SET : HxcSysChannelId : $Value
    On       : Accept : Yes : Field Accept

[Line: Hxc Api Key Line]
    Fields : Medium Prompt, HxcApiKeyFld
    Local  : Field : Medium Prompt : Set as : "API Key"
    Local  : Field : Medium Prompt : Width  : 22

[Field: HxcApiKeyFld]
    Use      : Name Field
    Storage  : HxcApiKeyUDF
    Set as   : $HxcApiKeyUDF
    Width    : 50
    Max      : 200
    On       : Accept : Yes : SET : HxcSysApiKey : $Value
    On       : Accept : Yes : Field Accept

[Line: Hxc Save Hint Line]
    Field : Hxc Save Hint

[Field: Hxc Save Hint]
    Use       : Name Field
    Set as    : "Tab all fields, then Ctrl+A to Accept."
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

;; ---------------------------------------------------------------------------
;; Shared Create/Alter form body — layout only (functions unchanged)
;; Sections: Template | Mapping+Preview (side-by-side) | Voucher Rules | Settings
;; ---------------------------------------------------------------------------

;; Template card
[Part: Hxc Vc Form Template Part]
    Lines  : Hxc Vc F Template Sect, +
             Hxc Vc F Name Line, Hxc Vc F Template Line, Hxc Vc F Lang Line, +
             Hxc Vc F Fetch Status Line

;; Mapping (left) + Message Preview (right) — single-line preview
;; Mapping LEFT + Preview RIGHT (no Height on Mid Row — Height/% broke Horizontal)
[Part: Hxc Vc Form Mid Row]
    Parts      : Hxc Vc Form Left Col, Hxc Vc Form Preview Part
    Horizontal : Yes

[Part: Hxc Vc Form Left Col]
    On : Focus : ##HxcVcMoveToMapping : SET : HxcVcMoveToMapping : No
    Lines  : Hxc Vc F Map Sect, +
             Hxc Vc F Hdr Media Line, Hxc Vc F Hdr Col Head, Hxc Vc F Hdr Text Line, +
             Hxc Vc F Body Sect, Hxc Vc F Body Col Head, +
             Hxc Vc F Body1, +
             Hxc Vc F Body2, +
             Hxc Vc F Body3, +
             Hxc Vc F Body4, +
             Hxc Vc F Body5, +
             Hxc Vc F Body6, +
             Hxc Vc F Body7, +
             Hxc Vc F Body8, +
             Hxc Vc F Btn Sect, Hxc Vc F Btn Col Head, +
             Hxc Vc F Btn1, +
             Hxc Vc F Btn2, +
             Hxc Vc F Btn3, +
             Hxc Vc F Btn4
    Scroll : Vertical
    Width  : 55% Screen

[Part: Hxc Vc Form Preview Part]
    Lines  : Hxc Vc F Prev Head, Hxc Vc F Prev Body
    Width  : 45% Screen

;; Voucher Rules
[Part: Hxc Vc Form Vch Part]
    On : Focus : ##HxcVcMoveToMapping : SET : HxcVcMoveToMapping : No
    Lines    : Hxc Vc F Vch Sect, Hxc Vc F Vch Head, Hxc Vc F Vch Data
    Repeat   : Hxc Vc F Vch Data : HxcVcDraftVchs
    Break On : $$IsEmpty:$HxcVcDraftVchName OR $HxcVcDraftVchName = "End of List" OR $HxcVcDraftVchName = "Not Applicable"
    Scroll   : Vertical

[Part: Hxc Vc Form Settings Part]
    On : Focus : ##HxcVcMoveToMapping : SET : HxcVcMoveToMapping : No
    Lines    : Hxc Vc F Auto Line, Hxc Vc F Confirm Line

;; --- Template fields ---

[Line: Hxc Vc F Template Sect]
    Field : Hxc Vc F Template Sect Fld

[Field: Hxc Vc F Template Sect Fld]
    Use       : Name Field
    Set as    : "Template"
    Style     : Bold
    Color     : Dark Green
    FullWidth : Yes
    Skip      : Yes

[Line: Hxc Vc F Name Line]
    Fields : Medium Prompt, Hxc Vc F Name
    Local  : Field : Medium Prompt : Set as : "Config Name"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc F Name]
    Skip     : ##HxcVcMoveToMapping
    Use      : Name Field
    Storage  : HxcVcDraftName
    Set as   : $HxcVcDraftName
    Width    : 40
    Max      : 60

[Line: Hxc Vc F Template Line]
    Fields : Medium Prompt, Hxc Vc F Template
    Local  : Field : Medium Prompt : Set as : "Template Name"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc F Template]
    Skip     : ##HxcVcMoveToMapping
    Use      : Name Field
    Storage  : HxcVcDraftTemplate
    Set as   : $HxcVcDraftTemplate
    Width    : 40
    Max      : 80
    On       : Accept : Yes : SET : HxcVcFetchName : $Value
    On       : Accept : Yes : CALL : Hxc Clear Fetch Vars
    On       : Accept : Yes : Field Accept

[Line: Hxc Vc F Lang Line]
    Fields : Medium Prompt, Hxc Vc F Lang
    Local  : Field : Medium Prompt : Set as : "Language"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc F Lang]
    Skip     : ##HxcVcMoveToMapping
    Use      : Name Field
    Storage  : HxcVcDraftLang
    Set as   : If $$IsEmpty:$HxcVcDraftLang THEN "en" ELSE $HxcVcDraftLang
    Width    : 16
    Max      : 16
    On       : Accept : Yes : SET : HxcVcFetchLang : $Value
    On       : Accept : Yes : SET : HxcVcFetchName : $HxcVcDraftTemplate
    On       : Accept : Yes : CALL : Hxc Fetch Template
    On       : Accept : ##HxcVcFetched : Field Accept

[Line: Hxc Vc F Fetch Status Line]
    Field : Hxc Vc F Fetch Status

[Field: Hxc Vc F Fetch Status]
    Use        : Name Field
    Set as     : If NOT ##HxcVcFetched THEN "Enter Language, then Fetch Template (Enter / Alt+F)" ELSE If $$IsEmpty:##HxcVcFetchStatus THEN "Template loaded." ELSE ##HxcVcFetchStatus
    Set Always : Yes
    Color      : Dark Green
    FullWidth  : Yes
    Skip       : Yes

;; --- Mapping + header ---

[Line: Hxc Vc F Map Sect]
    Field : Hxc Vc F Map Sect Fld

[Field: Hxc Vc F Map Sect Fld]
    Use       : Name Field
    Set as    : "Variable Mapping"
    Style     : Bold
    Color     : Dark Green
    FullWidth : Yes
    Skip      : Yes
    Inactive  : NOT ##HxcVcFetched

[Line: Hxc Vc F Hdr Media Line]
    Fields : Medium Prompt, Hxc Vc F Media
    Local  : Field : Medium Prompt : Set as : "Media Header"
    Local  : Field : Medium Prompt : Width  : 22
    Local  : Field : Medium Prompt : Inactive : NOT ##HxcVcFetched OR NOT ##HxcVcHeaderKind = "media"

[Field: Hxc Vc F Media]
    Use        : Name Field
    Storage    : HxcVcDraftMedia
    Set as     : If $$IsEmpty:$HxcVcDraftMedia THEN "None" ELSE $HxcVcDraftMedia
    Table      : Hxc Media Export List
    Show Table : Always
    Width      : 40
    Max        : 40
    Inactive   : NOT ##HxcVcFetched OR NOT ##HxcVcHeaderKind = "media"

[Line: Hxc Vc F Hdr Col Head]
    Invisible : NOT ##HxcVcFetched OR NOT ##HxcVcHeaderKind = "text"
    Fields    : Hxc Vc F Hdr Col Key, Hxc Vc F Hdr Col Fld

[Field: Hxc Vc F Hdr Col Key]
    Use    : Name Field
    Set as : "Header variable"
    Style  : Bold
    Color  : Dark Green
    Skip   : Yes
    Width  : 28

[Field: Hxc Vc F Hdr Col Fld]
    Use    : Name Field
    Set as : "Voucher field"
    Style  : Bold
    Color  : Dark Green
    Skip   : Yes
    Width  : 28

[Line: Hxc Vc F Hdr Text Line]
    Invisible : NOT ##HxcVcFetched OR NOT ##HxcVcHeaderKind = "text"
    Fields    : Hxc Vc F Hdr MK, Hxc Vc F Hdr MF

[Field: Hxc Vc F Hdr MK]
    Use        : Name Field
    Set as     : If $$IsEmpty:##HxcVcHeaderKey THEN "" ELSE ("{{" + ##HxcVcHeaderKey + "}}")
    Set Always : Yes
    Skip       : Yes
    Width      : 28
    Inactive   : NOT ##HxcVcFetched OR NOT ##HxcVcHeaderKind = "text"

[Field: Hxc Vc F Hdr MF]
    Use        : Name Field
    Storage    : HxcVcDraftHeaderFld
    Set as     : $HxcVcDraftHeaderFld
    Table      : Hxc Voucher Field List, Not Applicable
    Show Table : Always
    Width      : 28
    Max        : 40
    Inactive   : NOT ##HxcVcFetched OR NOT ##HxcVcHeaderKind = "text"

[Line: Hxc Vc F Body Sect]
    Field : Hxc Vc F Body Sect Fld

[Field: Hxc Vc F Body Sect Fld]
    Use       : Name Field
    Set as    : ""
    Style     : Bold
    Color     : Dark Green
    FullWidth : Yes
    Skip      : Yes
    Inactive  : NOT ##HxcVcFetched OR NOT ##HxcVcHasBodyMaps

[Line: Hxc Vc F Body Col Head]
    Fields : Hxc Vc F Body Col Key, Hxc Vc F Body Col Fld

[Field: Hxc Vc F Body Col Key]
    Use       : Name Field
    Set as    : "Body variable"
    Style     : Bold
    Color     : Dark Green
    Skip      : Yes
    Width     : 28
    Inactive  : NOT ##HxcVcFetched OR NOT ##HxcVcHasBodyMaps

[Field: Hxc Vc F Body Col Fld]
    Use       : Name Field
    Set as    : "Voucher field"
    Style     : Bold
    Color     : Dark Green
    Skip      : Yes
    Width     : 28
    Inactive  : NOT ##HxcVcFetched OR NOT ##HxcVcHasBodyMaps

[Line: Hxc Vc F Body1]
    Invisible : NOT ##HxcVcFetched OR $$IsEmpty:##HxcVcFK1 OR NOT ##HxcVcFC1 = "body"
    Fields : Hxc Vc F Body1 MK, Hxc Vc F Body1 MF

[Field: Hxc Vc F Body1 MK]
    Use        : Name Field
    Set as     : "{{" + ##HxcVcFK1 + "}}"
    Set Always : Yes
    Skip       : Yes
    Width      : 28
    Inactive   : NOT ##HxcVcFetched OR $$IsEmpty:##HxcVcFK1 OR NOT ##HxcVcFC1 = "body"

[Field: Hxc Vc F Body1 MF]
    Use        : Name Field
    Storage    : HxcVcDMFld1
    Set as     : $HxcVcDMFld1
    Table      : Hxc Voucher Field List, Not Applicable
    Show Table : Always
    Width      : 28
    Max        : 40
    Color      : Black
