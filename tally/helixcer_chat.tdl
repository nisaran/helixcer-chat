[Variable: HxcVcFetchStatus]
    Type : String

[Variable: HxcVcFetchLang]
    Type : String

[Variable: HxcVcFetchName]
    Type : String

[Variable: HxcVcMapsCsv]
    Type : String

[Variable: HxcVcHasHeader]
    Type : Logical

[Variable: HxcVcHeaderKind]
    Type : String

[Variable: HxcVcHeaderFormat]
    Type : String

[Variable: HxcVcHeaderKey]
    Type : String

[Variable: HxcVcFK1]
    Type : String

