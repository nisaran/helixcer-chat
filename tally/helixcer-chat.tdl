           "Opening Balance Type", "Closing Balance", "Closing Balance Type", "Currency", "Credit Limit", +
           "Credit Period", "Contact Name", "Mobile Number", "Phone Number", "Fax", +
           "Email", "Website", "Address", "Address Line 1", "Address Line 2", +
           "Address Line 3", "Address Line 4", "Address Line 5", "Pincode", "State", +
           "Country", "GST Registration Type", "GSTIN or UIN", "PAN or IT Number", "Notes", +
           "Master ID", "GUID"

[Part: Hxc Reminder Storage]
    Line : Hxc Reminder Storage

[Line: Hxc Reminder Storage]
    Fields : Hxc Reminder Store Template, Hxc Reminder Store Language, Hxc Reminder Store Maps, Hxc Reminder Store Preview

[Field: Hxc Reminder Store Template]
    Use : Name Field
    Storage : HxcReminderTemplate
    Set as : ##HxcVcDraftTemplate
    Set Always : Yes
    Invisible : Yes
    Max : 4096

[Field: Hxc Reminder Store Language]
    Use : Name Field
    Storage : HxcReminderLanguage
    Set as : If NOT $$IsEmpty:##HxcVcDraftLang Then ##HxcVcDraftLang Else If NOT $$IsEmpty:##HxcVcFetchLang Then ##HxcVcFetchLang Else "en"
    Set Always : Yes
    Invisible : Yes
    Max : 4096

[Field: Hxc Reminder Store Maps]
    Use : Name Field
    Storage : HxcReminderMaps
    Set as : $$HxcPackMaps
    Set Always : Yes
    Invisible : Yes
    Max : 4096

[Field: Hxc Reminder Store Preview]
    Use : Name Field
    Storage : HxcReminderPreview
    Set as : ##HxcVcPreviewText
    Set Always : Yes
    Invisible : Yes
    Max : 4096

[System: Formula]
    Hxc Reminder Template Required : "Fetch the selected WhatsApp template before saving."
    Hxc Reminder Media Unsupported : "Select a WhatsApp template without a media header for outstanding reminders."

[Variable: HxcReminderEditing]
    Type : Logical

[System: Variable]
    HxcReminderEditing : No

[Function: Hxc Open Reminder Template]
    01 : CALL : Hxc Vt Close Settings
    02 : SET : HxcReminderEditing : Yes
    03 : SET : HxcVcDraftTemplate : $HxcReminderTemplate:Company:##SVCurrentCompany
    04 : SET : HxcVcDraftLang : If $$IsEmpty:($HxcReminderLanguage:Company:##SVCurrentCompany) Then "en" Else $HxcReminderLanguage:Company:##SVCurrentCompany
    05 : SET : HxcVcPreviewText : $HxcReminderPreview:Company:##SVCurrentCompany
    06 : IF : NOT $$IsEmpty:##HxcVcDraftTemplate AND NOT $$IsEmpty:##HxcVcPreviewText
    07 :    SET : HxcVcFetchName : ##HxcVcDraftTemplate
    08 :    SET : HxcVcFetchLang : ##HxcVcDraftLang
    09 :    SET : HxcVcSavedMaps : $HxcReminderMaps:Company:##SVCurrentCompany
    10 :    SET : HxcVtSavedSlot : 0
    11 :    SET : HxcVtReadingSavedRows : Yes
    12 :    CALL : Hxc Apply Saved Maps
    13 :    SET : HxcVtReadingSavedRows : No
    14 :    SET : HxcVtSavedRowsReady : Yes
    15 :    SET : HxcVcFetchStatus : "Saved template and mappings loaded."
    16 : END IF

[Function: Hxc Close Reminder Template]
    01 : SET : HxcReminderEditing : No
    02 : CALL : Hxc Vc Clear Draft

[Function: Hxc Restore Reminder Mappings]
    01 : IF : ##HxcVcFetchName = $HxcReminderTemplate:Company:##SVCurrentCompany AND ##HxcVcFetchLang = (If $$IsEmpty:($HxcReminderLanguage:Company:##SVCurrentCompany) Then "en" Else $HxcReminderLanguage:Company:##SVCurrentCompany)
    02 :    SET : HxcVcSavedMaps : $HxcReminderMaps:Company:##SVCurrentCompany
    03 :    CALL : Hxc Apply Saved Maps
    04 : END IF

