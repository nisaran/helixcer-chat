;; Helixcer Chat — TallyPrime TDL
;; API Settings: save Workspace ID / Channel ID / API Key only (no HTTP fetch)

;; ---------------------------------------------------------------------------
;; Persistent settings (written to TallySav.Cfg on Form Accept)
;; ---------------------------------------------------------------------------

[Variable: HxcWorkspaceId]
    Type       : String
    Persistent : Yes

[Variable: HxcChannelId]
    Type       : String
    Persistent : Yes

[Variable: HxcApiKey]
    Type       : String
    Persistent : Yes

[Variable: HxcApiKeyDraft]
    Type : String

[System: Variable]
    HxcWorkspaceId : ""
    HxcChannelId   : ""
    HxcApiKey      : ""
    HxcApiKeyDraft : ""

[System: Formula]
    Hxc Api Key Masked : If $$IsEmpty:##HxcApiKey THEN "" ELSE "******"

;; ---------------------------------------------------------------------------
;; Gateway of Tally → Helixcer Chat
;; ---------------------------------------------------------------------------

[#Menu: Gateway of Tally]
    Add : Key Item : Before : @@LOCQuit : Helixcer Chat : H : Menu : Helixcer Chat Menu

[Menu: Helixcer Chat Menu]
    Title    : "Helixcer Chat"
    Key Item : API Settings : S : Modify Variable : Helixcer API Settings
    Key Item : About        : A : Display : Helixcer Chat About
    Key Item : Back         : B : Menu : Gateway of Tally

;; ---------------------------------------------------------------------------
;; API Settings — save only
;; ---------------------------------------------------------------------------

[Report: Helixcer API Settings]
    Form  : Helixcer API Settings
    Title : "API Settings"

[Form: Helixcer API Settings]
    Part   : Helixcer API Settings
    Button : Form Accept, Form Cancel
    On     : Form Accept : Yes : Call : Hxc Confirm Save

[Part: Helixcer API Settings]
    Lines  : Hxc Api Settings Title, +
             Hxc Workspace Id Line, Hxc Channel Id Line, Hxc Api Key Line
    Scroll : Vertical

[Line: Hxc Api Settings Title]
    Field : Hxc Api Settings Title

[Field: Hxc Api Settings Title]
    Use       : Name Field
    Set as    : "Helixcer Chat — API Settings"
    Style     : Bold
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

[Line: Hxc Workspace Id Line]
    Fields : Medium Prompt, Hxc Workspace Id
    Local  : Field : Medium Prompt : Set as : "Workspace ID"
    Local  : Field : Medium Prompt : Width  : 20

;; Modifies (not Variable) so Modify Variable + Form Accept persists to TallySav.Cfg
[Field: Hxc Workspace Id]
    Use      : Name Field
    Set as   : ##HxcWorkspaceId
    Modifies : HxcWorkspaceId : Yes
    Width    : 60
    Max      : 64

[Line: Hxc Channel Id Line]
    Fields : Medium Prompt, Hxc Channel Id
    Local  : Field : Medium Prompt : Set as : "Channel ID"
    Local  : Field : Medium Prompt : Width  : 20

[Field: Hxc Channel Id]
    Use      : Name Field
    Set as   : ##HxcChannelId
    Modifies : HxcChannelId : Yes
    Width    : 60
    Max      : 64

[Line: Hxc Api Key Line]
    Fields : Medium Prompt, Hxc Api Key
    Local  : Field : Medium Prompt : Set as : "API Key"
    Local  : Field : Medium Prompt : Width  : 20

;; Do not Modifies HxcApiKey directly — that would save "******" over the secret
[Field: Hxc Api Key]
    Use      : Name Field
    Set as   : @@HxcApiKeyMasked
    Modifies : HxcApiKeyDraft : Yes
    Width    : 60
    Max      : 200

;; Enter / Ctrl+A → Yes/No → persist (no Helixcer API call)
[Function: Hxc Confirm Save]
    ;; Copy a newly typed key into the persistent secret (ignore mask)
    01 : IF : NOT $$IsEmpty:##HxcApiKeyDraft
    02 :    IF : ##HxcApiKeyDraft != "******"
    03 :       IF : ##HxcApiKeyDraft != "*"
    04 :          IF : ##HxcApiKeyDraft != "********"
    05 :             SET : HxcApiKey : ##HxcApiKeyDraft
    06 :          END IF
    07 :       END IF
    08 :    END IF
    09 : END IF
    10 : Query Box : "Do you want to save?" : Yes
    11 : IF : $$LastResult
    12 :    Form Accept
    13 : END IF
    14 : RETURN : Yes

;; ---------------------------------------------------------------------------
;; About
;; ---------------------------------------------------------------------------

[Report: Helixcer Chat About]
    Form : Helixcer Chat About

[Form: Helixcer Chat About]
    Part : Helixcer Chat About

[Part: Helixcer Chat About]
    Lines : Helixcer Chat About Title, Helixcer Chat About Body, Helixcer Chat About Status

[Line: Helixcer Chat About Title]
    Field : Helixcer Chat About Title

[Field: Helixcer Chat About Title]
    Use       : Name Field
    Set as    : "Helixcer Chat"
    Style     : Bold
    Align     : Centre
    FullWidth : Yes

[Line: Helixcer Chat About Body]
    Field : Helixcer Chat About Body

[Field: Helixcer Chat About Body]
    Use       : Name Field
    Set as    : "Open API Settings to save Workspace ID, Channel ID, and API Key."
    Align     : Centre
    FullWidth : Yes

[Line: Helixcer Chat About Status]
    Field : Helixcer Chat About Status

[Field: Helixcer Chat About Status]
    Use       : Name Field
    Set as    : If $$IsEmpty:##HxcApiKey THEN "API Key: not set" ELSE +
                If $$IsEmpty:##HxcWorkspaceId THEN "API Key: saved (Workspace ID missing)" ELSE +
                If $$IsEmpty:##HxcChannelId THEN "API Key: saved (Channel ID missing)" ELSE +
                "Settings saved"
    Align     : Centre
    FullWidth : Yes
