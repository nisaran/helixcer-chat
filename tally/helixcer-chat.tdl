;; Helixcer Chat — TallyPrime TDL
;;
;; Load in TallyPrime:
;;   F1 (Help) → TDL & Add-On → select this file → Enable → Yes
;; Or: Gateway of Tally → F4 (Manage Local TDLs) → add helixcer-chat.tdl

;; ---------------------------------------------------------------------------
;; Persistent settings (system scope → TallySav.Cfg)
;; Do NOT re-declare these on the Report with "Variable :"
;; ---------------------------------------------------------------------------

[Variable: HxcWorkspaceId]
    Type       : String
    Persistent : Yes

[Variable: HxcChannelId]
    Type       : String
    Persistent : Yes

[Variable: HxcApiKey]
    Type       : String
    Persistent : Yes

[Variable: HxcWorkspaceName]
    Type       : String
    Persistent : Yes

[Variable: HxcChannelName]
    Type       : String
    Persistent : Yes

[Variable: HxcConnectionStatus]
    Type       : String
    Persistent : Yes

[System: Variable]
    HxcWorkspaceId      : ""
    HxcChannelId        : ""
    HxcApiKey           : ""
    HxcWorkspaceName    : ""
    HxcChannelName      : ""
    HxcConnectionStatus : ""

[System: Formula]
    Hxc Connection Url : "https://api.chat.helixcer.com/api/v1/connection?channelId=" + ##HxcChannelId

;; ---------------------------------------------------------------------------
;; Request report — GET body ignored; Export Headers are what matter
;; ---------------------------------------------------------------------------

[Report: Hxc Connection Request]
    Form          : Hxc Connection Request
    Export Header : "Authorization: Bearer " + ##HxcApiKey
    Export Header : "X-Workspace-Id: " + ##HxcWorkspaceId
    Export Header : "Accept: application/json"

[Form: Hxc Connection Request]
    Part : Hxc Connection Request

[Part: Hxc Connection Request]
    Lines : Hxc Connection Request

[Line: Hxc Connection Request]
    Fields : Hxc Connection Request

[Field: Hxc Connection Request]
    Use    : Name Field
    Set as : ""
    Skip   : Yes

;; ---------------------------------------------------------------------------
;; Apply Parameter Collection from HTTP Request into persistent vars
;; ---------------------------------------------------------------------------

[Function: Hxc Apply Connection Response]
    01 : SET : HxcWorkspaceName : ""
    02 : SET : HxcChannelName : ""
    03 : SET : HxcConnectionStatus : "Could not fetch names. Check IDs and API Key."
    04 : WALK COLLECTION : Parameter Collection
    05 :    IF : NOT $$IsEmpty:$workspaceName
    06 :       SET : HxcWorkspaceName : $workspaceName
    07 :       SET : HxcChannelName : $channelName
    08 :       SET : HxcConnectionStatus : "Connected"
    09 :    END IF
    10 : END WALK
    11 : RETURN : Yes

;; ---------------------------------------------------------------------------
;; Fetch + permanently store names (Persistent variables)
;; ---------------------------------------------------------------------------

[Function: Hxc Fetch Connection]
    01 : IF : $$IsEmpty:##HxcWorkspaceId OR $$IsEmpty:##HxcChannelId OR $$IsEmpty:##HxcApiKey
    02 :    SET : HxcWorkspaceName : ""
    03 :    SET : HxcChannelName : ""
    04 :    SET : HxcConnectionStatus : "Enter Workspace ID, Channel ID, and API Key"
    05 :    RETURN : No
    06 : END IF
    07 : SET : HxcWorkspaceName : ""
    08 : SET : HxcChannelName : ""
    09 : SET : HxcConnectionStatus : "Fetching from Helixcer..."
    10 : HTTP Request : @@HxcConnectionUrl : GET : JSON : UTF8 : Hxc Connection Request : Hxc Apply Connection Response
    11 : IF : $$IsEmpty:##HxcWorkspaceName AND ##HxcConnectionStatus = "Fetching from Helixcer..."
    12 :    SET : HxcConnectionStatus : "Could not reach Helixcer. Check internet / firewall."
    13 : END IF
    14 : RETURN : Yes

;; ---------------------------------------------------------------------------
;; Gateway of Tally → Helixcer Chat
;; ---------------------------------------------------------------------------

[#Menu: Gateway of Tally]
    Add : Key Item : Before : @@LOCQuit : Helixcer Chat : H : Menu : Helixcer Chat Menu

[Menu: Helixcer Chat Menu]
    Title    : "Helixcer Chat"
    Key Item : API Settings : S : Modify Variable : Helixcer API Settings
    Key Item : About        : A : Display : Helixcer Chat About
    Key Item : Back         : B : Menu : Gateway of Tally

;; ---------------------------------------------------------------------------
;; API Settings
;; ---------------------------------------------------------------------------

[Report: Helixcer API Settings]
    Form  : Helixcer API Settings
    Title : "API Settings"
    Auto  : Yes

[Form: Helixcer API Settings]
    Part   : Helixcer API Settings
    Button : Form Accept, Form Cancel, Hxc Fetch Names Button
    ;; Rebuild the form when Status changes so names/status become visible
    Option : Hxc Settings Refresh : ##HxcConnectionStatus

[!Form: Hxc Settings Refresh]

[Button: Hxc Fetch Names Button]
    Key    : Alt+V
    Title  : "Verify"
    Action : Call : Hxc Fetch Connection

[Part: Helixcer API Settings]
    Lines  : Hxc Api Settings Title, Hxc Api Settings Hint, +
             Hxc Workspace Id Line, Hxc Channel Id Line, Hxc Api Key Line, +
             Hxc Workspace Name Line, Hxc Channel Name Line, Hxc Connection Status Line
    Scroll : Vertical

[Line: Hxc Api Settings Title]
    Field : Hxc Api Settings Title

[Field: Hxc Api Settings Title]
    Use       : Name Field
    Set as    : "Helixcer Chat — API Settings"
    Style     : Bold
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

[Line: Hxc Api Settings Hint]
    Field : Hxc Api Settings Hint

[Field: Hxc Api Settings Hint]
    Use       : Name Field
    Set as    : "Tab off API Key, or press Alt+V (Verify), to load names"
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

[Line: Hxc Workspace Id Line]
    Fields : Medium Prompt, Hxc Workspace Id
    Local  : Field : Medium Prompt : Set as : "Workspace ID"
    Local  : Field : Medium Prompt : Width  : 20

[Field: Hxc Workspace Id]
    Use      : Name Field
    Set as   : ##HxcWorkspaceId
    Modifies : HxcWorkspaceId : Yes
    Width    : 60
    Max      : 64

[Line: Hxc Channel Id Line]
    Fields : Medium Prompt, Hxc Channel Id
    Local  : Field : Medium Prompt : Set as : "Channel ID"
    Local  : Field : Medium Prompt : Width  : 20

[Field: Hxc Channel Id]
    Use      : Name Field
    Set as   : ##HxcChannelId
    Modifies : HxcChannelId : Yes
    Width    : 60
    Max      : 64

[Line: Hxc Api Key Line]
    Fields : Medium Prompt, Hxc Api Key
    Local  : Field : Medium Prompt : Set as : "API Key"
    Local  : Field : Medium Prompt : Width  : 20

[Field: Hxc Api Key]
    Use      : Name Field
    Set as   : ##HxcApiKey
    Modifies : HxcApiKey : Yes
    Width    : 60
    Max      : 200
    ;; On: Accept must include condition + Field Accept or the field never finishes
    On       : Accept : Yes : SET : HxcApiKey : $Value
    On       : Accept : Yes : Call : Hxc Fetch Connection
    On       : Accept : Yes : Field Accept

[Line: Hxc Workspace Name Line]
    Fields : Medium Prompt, Hxc Workspace Name
    Local  : Field : Medium Prompt : Set as : "Workspace Name"
    Local  : Field : Medium Prompt : Width  : 20

[Field: Hxc Workspace Name]
    Use       : Name Field
    Set as    : ##HxcWorkspaceName
    Set Always: Yes
    Width     : 60
    Skip      : Yes

[Line: Hxc Channel Name Line]
    Fields : Medium Prompt, Hxc Channel Name
    Local  : Field : Medium Prompt : Set as : "Channel Name"
    Local  : Field : Medium Prompt : Width  : 20

[Field: Hxc Channel Name]
    Use       : Name Field
    Set as    : ##HxcChannelName
    Set Always: Yes
    Width     : 60
    Skip      : Yes

[Line: Hxc Connection Status Line]
    Fields : Medium Prompt, Hxc Connection Status
    Local  : Field : Medium Prompt : Set as : "Status"
    Local  : Field : Medium Prompt : Width  : 20

[Field: Hxc Connection Status]
    Use       : Name Field
    Set as    : ##HxcConnectionStatus
    Set Always: Yes
    Width     : 60
    Skip      : Yes

;; ---------------------------------------------------------------------------
;; About
;; ---------------------------------------------------------------------------

[Report: Helixcer Chat About]
    Form : Helixcer Chat About

[Form: Helixcer Chat About]
    Part : Helixcer Chat About

[Part: Helixcer Chat About]
    Lines : Helixcer Chat About Title, Helixcer Chat About Body, Helixcer Chat About Status

[Line: Helixcer Chat About Title]
    Field : Helixcer Chat About Title

[Field: Helixcer Chat About Title]
    Use       : Name Field
    Set as    : "Helixcer Chat"
    Style     : Bold
    Align     : Centre
    FullWidth : Yes

[Line: Helixcer Chat About Body]
    Field : Helixcer Chat About Body

[Field: Helixcer Chat About Body]
    Use       : Name Field
    Set as    : If $$IsEmpty:##HxcWorkspaceName THEN +
                "Open API Settings, enter IDs and API Key, then Tab off API Key or press Alt+V." +
                ELSE ##HxcWorkspaceName + " / " + ##HxcChannelName
    Align     : Centre
    FullWidth : Yes

[Line: Helixcer Chat About Status]
    Field : Helixcer Chat About Status

[Field: Helixcer Chat About Status]
    Use       : Name Field
    Set as    : If $$IsEmpty:##HxcConnectionStatus THEN +
                If $$IsEmpty:##HxcApiKey THEN "API Key: not set" ELSE "API Key: saved" +
                ELSE ##HxcConnectionStatus
    Align     : Centre
    FullWidth : Yes
