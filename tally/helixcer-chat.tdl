[Field: Hxc History Details]
    Use : Name Field
    Style : Normal
    Set as : $Details
    Width : 30% Screen
    Skip : Yes
    Word Wrap : Yes : Low : Yes

[Function: Hxc History Display Time]
    Parameter : Timestamp : String
    Returns : String
    Variable : Hour24 : Number
    Variable : Hour12 : Number
    Variable : HourText : String
    Variable : Meridiem : String
    01 : IF : $$StringLength:##Timestamp < 19
    02 :    RETURN : ##Timestamp
    03 : END IF
    04 : SET : Hour24 : $$Number:($$StringPart:##Timestamp:11:2)
    05 : SET : Hour12 : If ##Hour24 = 0 Then 12 Else If ##Hour24 > 12 Then ##Hour24 - 12 Else ##Hour24
    06 : SET : HourText : If ##Hour12 < 10 Then ("0" + ($$String:##Hour12)) Else $$String:##Hour12
    07 : SET : Meridiem : If ##Hour24 < 12 Then "am" Else "pm"
    08 : RETURN : ($$StringPart:##Timestamp:8:2) + "-" + ($$StringPart:##Timestamp:5:2) + "-" + ($$StringPart:##Timestamp:2:2) + ", " + ##HourText + ":" + ($$StringPart:##Timestamp:14:2) + ":" + ($$StringPart:##Timestamp:17:2) + " " + ##Meridiem

[Variable: HxcSendMappingCount]
    Type : Number

[System: Variable]
    HxcSendMappingCount : 0

[Variable: HxcSendDocument]
    Type : Logical

[Part: Hxc Send Preview Message]
    Width : 36% Screen
    Line : Hxc Vc F Prev Body
    Repeat : Hxc Vc F Prev Body
    Height : @@HxcSendPreviewBodyHeight
    Scroll : Vertical
    Set : $$HxcPreviewLineCount
    Local : Field : Hxc Vc F Prev Body Fld : Inactive : No
    Local : Field : Hxc Vc F Prev Body Fld : Word Wrap : Always : None : Yes

[System: Formula]
    Hxc Send Preview Body Height : $$HxcSendPreviewBodyHeight
    Hxc Send Preview Form Height : @@HxcSendPreviewBodyHeight + @@HxcPreviewRecipientHeight + (If ##HxcSendDocument Then 7 Else 5)

[Function: Hxc Send Preview Body Height]
    Returns : Number
    Variable : Row : Number
    Variable : RowCount : Number
    Variable : HeightNeeded : Number
    Variable : TextWidth : Number
    01 : SET : RowCount : $$HxcPreviewLineCount
    02 : SET : HeightNeeded : 1
    03 : WHILE : ##Row < ##RowCount AND ##HeightNeeded < 24
    04 :    INCREMENT : Row
    05 :    SET : TextWidth : $$StringLength:($$HxcPreviewRowContent:##Row)
    06 :    INCREMENT : HeightNeeded
    07 :    WHILE : ##TextWidth > 60 AND ##HeightNeeded < 24
    08 :       INCREMENT : HeightNeeded
    09 :       SET : TextWidth : ##TextWidth - 60
    10 :    END WHILE
    11 : END WHILE
    12 : RETURN : ##HeightNeeded

[Variable: HxcSendPreviewFilename]
    Type : String

[Variable: HxcSendPreviewOpen]
    Type : Logical

[Variable: HxcSendPreviewText]
    Type : String

[System: Variable]
    HxcSendPreviewOpen : No
    HxcSendPreviewFilename : ""
    HxcSendPreviewText : ""
    HxcSendDocument : No
    List Variable : HxcSendPreviewValues : String
    List Variable : HxcSendQueuedMappings : String
    List Variable : HxcSendQueuedComponents : String
    List Variable : HxcSendQueuedKeys : String

