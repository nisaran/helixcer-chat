    Width : 24
    Max : 200

[Field: HxcVcHdrCustomInput]
    Option : Hxc Vt Mapping Value Style : ##HxcVtEditing
    Use : Hxc Vc Custom Mapping Input
    Modifies : HxcVcDraftCustom0
    Set as : If ##HxcVcDraftHeaderFld = @@HxcCustomValueLabel THEN ##HxcVcDraftCustom0 ELSE ""
    Skip   : @@HxcVtShowingSavedRows OR (##HxcVcMoveToConfirm OR (NOT (##HxcVcDraftHeaderFld = @@HxcCustomValueLabel)))
