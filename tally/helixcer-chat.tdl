    Local : Field : Hxc History Time : Set as : "Time (local)"
    Local : Field : Hxc History Voucher : Set as : "Voucher No."
    Local : Field : Hxc History Recipient : Set as : "To mobile"
    Local : Field : Hxc History Template : Set as : "Template"
    Local : Field : Hxc History Language : Set as : "Ln"
    Local : Field : Hxc History Status : Set as : "Status"
    Local : Field : Hxc History Message ID : Set as : "Message ID"
    Local : Field : Hxc History Details : Set as : "Details"

