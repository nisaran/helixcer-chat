[Field: HxcVcBtn16Mapping]
    Option : Hxc Vt Mapping Value Style : ##HxcVtEditing
    Use        : Name Field
    Modifies   : HxcVcDMFld16
    Set as     : ##HxcVcDMFld16
    Option : Hxc Voucher Mapping Table : NOT ##HxcReminderEditing
    Option : Hxc Ledger Mapping Table : ##HxcReminderEditing
    Show Table : Always
    Width      : 28
    Max        : 40
    Color      : Black
    Inactive   : NOT @@HxcVtShowMappings OR $$IsEmpty:##HxcVcFK16 OR NOT ##HxcVcFC16 = "button"
    On         : Accept : Yes : SET : HxcVcDMFld16 : $$Value
    On         : Accept : ##HxcVcMoveToMapping : SET : HxcVcMoveToMapping : No
    On         : Accept : Yes : Field Accept
    Skip : @@HxcVtShowingSavedRows OR (##HxcVcMoveToConfirm)

[Field: HxcVcBtn16CustomInput]
    Option : Hxc Vt Mapping Value Style : ##HxcVtEditing
    Use : Hxc Vc Custom Mapping Input
    Modifies : HxcVcDraftCustom16
    Set as : If ##HxcVcDMFld16 = @@HxcCustomValueLabel THEN ##HxcVcDraftCustom16 ELSE ""
    Skip   : @@HxcVtShowingSavedRows OR (##HxcVcMoveToConfirm OR (NOT (##HxcVcDMFld16 = @@HxcCustomValueLabel)))
    Control : HxcVcCustomValueRequired : (##HxcVcDMFld16 = @@HxcCustomValueLabel) AND $$IsEmpty:$$Value
    On : Accept : Yes : SET : HxcVcDraftCustom16 : $$Value
    On : Accept : Yes : Field Accept

;; --- Message Preview ---

[Line: Hxc Vc F Prev Head]
    Field : Hxc Vc F Prev Head Fld

[Field: Hxc Vc F Prev Head Fld]
    Option : Hxc Vt Section Heading Style : ##HxcVtEditing
    Use       : Name Field
    Set as    : "Message Preview"
    Style     : Bold
    Color     : Dark Green
    FullWidth : Yes
    Skip      : Yes
    Inactive  : NOT @@HxcVtShowMappings

[Line: Hxc Vc F Prev Body]
    Field : Hxc Vc F Prev Body Fld

[Field: Hxc Vc F Prev Body Fld]
    Use        : Name Field
    Set as     : $$HxcPreviewRowContent:$$Line
    Style      : Normal
    Option     : Hxc Preview Header Style : $$StringPart:($$HxcPreviewLineText:$$Line):0:9 = "[Header] "
    Option     : Hxc Preview Media Style : $$StringPart:($$HxcPreviewLineText:$$Line):0:8 = "[Media] "
    Option     : Hxc Preview Footer Style : $$StringPart:($$HxcPreviewLineText:$$Line):0:9 = "[Footer] "
    Option     : Hxc Preview Button Style : $$StringPart:($$HxcPreviewLineText:$$Line):0:9 = "[Button] "
    Option     : Hxc Preview Button URL Style : $$StringPart:($$HxcPreviewLineText:$$Line):0:6 = "[URL] "
    Option     : Hxc Send Preview Regular Text : ##HxcSendPreviewOpen
    Word Wrap  : Always : None : Yes
    Max Display Lines : 50
    Max Edit Lines : 50
    Set Always : Yes
    FullWidth  : Yes
    Skip       : Yes
    Color : Hxc Preview Body Ink
    Inactive   : NOT @@HxcVtShowMappings
    Background : Hxc Preview Body Fill

;; --- Voucher Rules ---

[Line: Hxc Vc F Vch Sect]
    Field : Hxc Vc F Vch Sect Fld

[Field: Hxc Vc F Vch Sect Fld]
    Use       : Name Field
    Set as    : "Voucher Rules"
    Style     : Bold
    Color     : Dark Green
    FullWidth : Yes
    Skip      : Yes
    Inactive  : NOT ##HxcVcFetched

[Line: Hxc Vc F Vch Head]
    Field : Hxc Vc F Vch Head Fld

[Field: Hxc Vc F Vch Head Fld]
    Use       : Name Field
    Set as    : "Applicable Voucher Types  (add rows; End of List / blank to end)"
    FullWidth : Yes
    Skip      : Yes
    Inactive  : NOT ##HxcVcFetched

[Line: Hxc Vc F Vch Data]
    Invisible : NOT ##HxcVcFetched
    Fields : Medium Prompt, HxcVcVoucherTypeInput
    Local  : Field : Medium Prompt : Set as : "Voucher Type"
    Local  : Field : Medium Prompt : Width  : 22
    Local  : Field : Medium Prompt : Inactive : NOT ##HxcVcFetched

[Field: HxcVcVoucherTypeInput]
    Use        : Name Field
    Set as     : $$ListValue:HxcVcVoucherDraft:($$String:$$Line)
    Table      : Hxc Voucher Type List, End of List
    Show Table : Always
    Width      : 40
    Max        : 80
    Inactive   : NOT ##HxcVcFetched
    Skip Sysname : Yes
    Skip       : ##HxcVcMoveToConfirm
    On         : Accept : Yes : CALL : Hxc Store Voucher Type : $$Line : $$Value
    On         : Accept : ##HxcVcMoveToMapping : SET : HxcVcMoveToMapping : No
    On         : Accept : Yes : Field Accept

[Line: Hxc Vc F Auto Line]
    Fields : Medium Prompt, HxcVcAutoSendInput
    Local  : Field : Medium Prompt : Set as : "Auto send after save"
    Local  : Field : Medium Prompt : Width  : 22
    Local  : Field : Medium Prompt : Inactive : NOT @@HxcVtShowMappings

[Field: HxcVcAutoSendInput]
    Use      : Logical Field
    Variable  : HxcVcDraftAuto
    Set as   : ##HxcVcDraftAuto
    Width    : 8
    Inactive   : NOT @@HxcVtShowMappings
    On       : Accept : ##HxcVcMoveToMapping : SET : HxcVcMoveToMapping : No
    On       : Accept : Yes : SET : HxcVcMoveToConfirm : $$Value
    On       : Accept : Yes : SET : HxcVcAutoSendEnabled : $$Value
    On       : Accept : Yes : SET : HxcVcDraftAuto : ##HxcVcAutoSendEnabled
    On       : Accept : Yes : Field Accept
    Skip : @@HxcVtShowingSavedRows OR (##HxcVcMoveToConfirm)

[Line: Hxc Vc F Confirm Line]
    Fields : Hxc Vc Confirm Prompt, Hxc Vc F Confirm

[Field: Hxc Vc Confirm Prompt]
    Use      : Medium Prompt
    Set as   : "Confirm before send"
    Width    : 22
    Inactive : NOT @@HxcVtShowMappings
    Option   : Hxc Vc Confirm Grey Text : NOT ##HxcVcAutoSendEnabled

[!Field: Hxc Vc Confirm Grey Text]
    Color : Hxc Confirm Grey

[Color: Hxc Confirm Grey]
    RGB : 128, 128, 128

[Field: Hxc Vc F Confirm]
    Use      : Logical Field
    Variable  : HxcVcDraftConfirm
    Set as   : ##HxcVcDraftConfirm
    Width    : 12
    Inactive : NOT @@HxcVtShowMappings
    Skip     : @@HxcVtShowingSavedRows OR (NOT ##HxcVcAutoSendEnabled)
    Option   : Hxc Vc Confirm Grey Text : NOT ##HxcVcAutoSendEnabled
    On : Accept : Yes : SET : HxcVcDraftConfirm : $$Value
    On : Accept : ##HxcVcMoveToConfirm : SET : HxcVcMoveToConfirm : No
    On : Accept : Yes : Field Accept


;; ---------------------------------------------------------------------------
;; CREATE — clear draft, show sequential form
;; ---------------------------------------------------------------------------


[Button: Hxc Fetch Template Btn]
    Key    : Alt + F
    Action : Call : Hxc Fetch Template
    Title  : "Fetch Template"

[Report: Helixcer Voucher Config Create]
    List Variable : HxcVcVoucherDraft : String
    Form   : Helixcer Voucher Config Create
    Title  : "Create Voucher Config"
    Object : Company
    Set    : HxcVcFetched : No
    Set    : HxcVcMoveToMapping : No
    Set    : HxcVcMoveToConfirm : No
    Set    : HxcVcPreviewText : ""
    Set    : HxcVcFetchStatus : ""
    Set    : HxcVcCreateNeedsReset : Yes
    Set    : HxcVcCreateBlank : No
    Set    : HxcVcDraftName : ""
    Set    : HxcVcDraftTemplate : ""
    Set    : HxcVcDraftLang : "en"
    Set    : HxcVcDraftMedia : "None"
    Set    : HxcVcDraftAuto : No
    Set    : HxcVcDraftConfirm : No
    Set    : HxcVcDraftEditKey : ""
    Set    : HxcVcDraftHeaderFld : ""

[Form: Helixcer Voucher Config Create]
    Part   : Hxc Vc Cr Title Part, Hxc Vc Form Template Part, Hxc Vc Form Mid Row, Hxc Vc Form Vch Part, Hxc Vc Form Settings Part, Hxc Vc Cr Hint Part
    Button : Hxc Fetch Template Btn, Form Accept, Form Cancel
    On     : Form Create  : Yes : CALL : Hxc Initialize New Config
    On     : Form Destroy : Yes : CALL : Hxc Vc Clear Draft
    On     : Form Destroy : Yes : CALL : Hxc Clear Fetch Vars
    On     : Form Accept  : Yes : CALL : Hxc Vc Commit Draft
    On     : Form Accept  : ##HxcVcSaveOk : Form Accept

[Part: Hxc Vc Cr Title Part]
    Lines : Hxc Vc Cr Title Line

[Line: Hxc Vc Cr Title Line]
    Field : Hxc Vc Cr Title

[Field: Hxc Vc Cr Title]
    Use       : Name Field
    Set as    : "Create Voucher Config (build 420)"
    Style     : Bold
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

[Part: Hxc Vc Cr Hint Part]
    Lines : Hxc Vc Cr Hint Line

[Line: Hxc Vc Cr Hint Line]
    Field : Hxc Vc Cr Hint

[Field: Hxc Vc Cr Hint]
    Use       : Name Field
    Set as    : "Fetch Template: Enter on Language or Alt+F.  Save Config: Ctrl+A."
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

;; ---------------------------------------------------------------------------
;; ALTER — pick config, load into draft, same form
;; ---------------------------------------------------------------------------

[Function: Hxc Vc Load Draft From Config]
    Variable : EditKey : String
    Variable : TypesRaw : String
    01 : SET : EditKey : ##HxcVcDraftEditKey
    02 : IF : $$IsEmpty:##EditKey
    03 :    RETURN : Yes
    04 : END IF
    05 : CALL : Hxc Vc Clear Draft
    06 : SET : HxcVcDraftEditKey : ##EditKey
    07 : SET : TypesRaw : ""
    08 : WALK COLLECTION : Hxc Voucher Config Names
    09 :    IF : $HxcVcName = ##EditKey
    10 :       SET : HxcVcDraftName : $HxcVcName
    11 :       SET : HxcVcDraftTemplate : $HxcVcTemplateName
    12 :       SET : HxcVcDraftLang : $HxcVcLanguage
    13 :       SET : HxcVcDraftMedia : $HxcVcMediaExport
    14 :       SET : HxcVcDraftAuto : $HxcVcAutoSend
    141 :       SET : HxcVcAutoSendEnabled : $HxcVcAutoSend
    15 :       SET : HxcVcDraftConfirm : $HxcVcConfirmBeforeSend
    16 :       SET : TypesRaw : $HxcVcVoucherTypes
    17 :    END IF
    18 : END WALK
    19 : CALL : Hxc Parse Types Into Draft : ##TypesRaw
    20 : RETURN : Yes

[Report: Helixcer Voucher Config Alter]
    List Variable : HxcVcVoucherDraft : String
    Form   : Helixcer Voucher Config Alter
    Title  : "Alter Voucher Config"
    Object : Company
    Set    : HxcVcFetched : No
    Set    : HxcVcPreviewText : ""
    Set    : HxcVcFetchStatus : ""
    Set    : HxcVcCreateNeedsReset : No
    Set    : HxcVcCreateBlank : No

[Form: Helixcer Voucher Config Alter]
    Part   : Hxc Vc Al Title Part, Hxc Vc Al Pick Part, Hxc Vc Form Template Part, Hxc Vc Form Mid Row, Hxc Vc Form Vch Part, Hxc Vc Form Settings Part, Hxc Vc Al Hint Part
    Button : Hxc Fetch Template Btn, Form Accept, Form Cancel
    On     : Form Create  : Yes : CALL : Hxc Vc Clear Draft
    On     : Form Create  : Yes : CALL : Hxc Clear Fetch Vars
    On     : Form Destroy : Yes : CALL : Hxc Vc Clear Draft
    On     : Form Destroy : Yes : CALL : Hxc Clear Fetch Vars
    On     : Form Accept  : Yes : CALL : Hxc Vc Commit Draft
    On     : Form Accept  : ##HxcVcSaveOk : Form Accept

[Part: Hxc Vc Al Title Part]
    Lines : Hxc Vc Al Title Line

[Line: Hxc Vc Al Title Line]
    Field : Hxc Vc Al Title

[Field: Hxc Vc Al Title]
    Use       : Name Field
    Set as    : "Alter Voucher Config (build 420)"
    Style     : Bold
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

[Part: Hxc Vc Al Pick Part]
    Lines : Hxc Vc Al Pick Line

[Line: Hxc Vc Al Pick Line]
    Fields : Medium Prompt, Hxc Vc Al Pick
    Local  : Field : Medium Prompt : Set as : "Select Config"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc Al Pick]
    Skip : ##HxcVcMoveToConfirm OR (##HxcVcFetched AND ##HxcVcMoveToMapping)
    Use        : Name Field
    Variable    : HxcVcDraftEditKey
    Set as     : ##HxcVcDraftEditKey
    Table      : Hxc Voucher Config Names
    Show Table : Always
    Width      : 40
    Max        : 60
    On         : Accept : Yes : CALL : Hxc Vc Load Draft From Config
    On         : Accept : Yes : Field Accept

[Part: Hxc Vc Al Hint Part]
    Lines : Hxc Vc Al Hint Line

[Line: Hxc Vc Al Hint Line]
    Field : Hxc Vc Al Hint

[Field: Hxc Vc Al Hint]
    Use       : Name Field
    Set as    : "Select config, edit fields below, Ctrl+A."
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

;; ---------------------------------------------------------------------------
;; LIST
;; ---------------------------------------------------------------------------

[Report: Helixcer Voucher Config List]
    Form   : Helixcer Voucher Config List
    Title  : "List Voucher Configs"
    Object : Company

[Form: Helixcer Voucher Config List]
    Part   : Hxc Vc Ls Title Part, Hxc Vc Ls Part, Hxc Vc Ls Hint Part
    Button : Form Cancel

[Part: Hxc Vc Ls Title Part]
    Lines : Hxc Vc Ls Title Line

[Line: Hxc Vc Ls Title Line]
    Field : Hxc Vc Ls Title

[Field: Hxc Vc Ls Title]
    Use       : Name Field
    Set as    : "Voucher Config List (build 420)"
    Style     : Bold
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

[Part: Hxc Vc Ls Part]
    Lines    : Hxc Vc Ls Header Line, Hxc Vc Ls Data Line
    Repeat   : Hxc Vc Ls Data Line : HxcVoucherConfigs
    Break On : $$IsEmpty:$HxcVcName
    Scroll   : Vertical

[Line: Hxc Vc Ls Header Line]
    Fields : Hxc Vc Ls H Name, Hxc Vc Ls H Template, Hxc Vc Ls H Lang, +
             Hxc Vc Ls H Types, Hxc Vc Ls H Media, Hxc Vc Ls H Auto
    Local  : Field : Default : Skip  : Yes
    Local  : Field : Default : Align : Centre
    Local  : Field : Default : Style : Bold

[Field: Hxc Vc Ls H Name]
    Use    : Name Field
    Set as : "Config Name"
    Width  : 16

[Field: Hxc Vc Ls H Template]
    Use    : Name Field
    Set as : "Template"
    Width  : 16

[Field: Hxc Vc Ls H Lang]
    Use    : Name Field
    Set as : "Lang"
    Width  : 6

[Field: Hxc Vc Ls H Types]
    Use    : Name Field
    Set as : "Voucher Types"
    Width  : 24

[Field: Hxc Vc Ls H Media]
    Use    : Name Field
    Set as : "Media"
    Width  : 12

[Field: Hxc Vc Ls H Auto]
    Use    : Name Field
    Set as : "Auto"
    Width  : 6

[Line: Hxc Vc Ls Data Line]
    Fields : Hxc Vc Ls D Name, Hxc Vc Ls D Template, Hxc Vc Ls D Lang, +
             Hxc Vc Ls D Types, Hxc Vc Ls D Media, Hxc Vc Ls D Auto
    Local  : Field : Default : Skip : Yes

[Field: Hxc Vc Ls D Name]
    Use    : Name Field
    Set as : $HxcVcName
    Width  : 16

[Field: Hxc Vc Ls D Template]
    Use    : Name Field
    Set as : $HxcVcTemplateName
    Width  : 16

[Field: Hxc Vc Ls D Lang]
    Use    : Name Field
    Set as : $HxcVcLanguage
    Width  : 6

[Field: Hxc Vc Ls D Types]
    Use    : Name Field
    Set as : $HxcVcVoucherTypes
    Width  : 24

[Field: Hxc Vc Ls D Media]
    Use    : Name Field
    Set as : $HxcVcMediaExport
    Width  : 12

[Field: Hxc Vc Ls D Auto]
    Use    : Name Field
    Set as : If $HxcVcAutoSend THEN "Yes" ELSE "No"
    Width  : 6

[Part: Hxc Vc Ls Hint Part]
    Lines : Hxc Vc Ls Hint Line

[Line: Hxc Vc Ls Hint Line]
    Field : Hxc Vc Ls Hint

[Field: Hxc Vc Ls Hint]
    Use       : Name Field
    Set as    : "Read-only. Esc to leave."
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

;; ---------------------------------------------------------------------------
;; About
;; ---------------------------------------------------------------------------

[Report: Helixcer Chat About]
    Form : Helixcer Chat About

[Form: Helixcer Chat About]
    Part : Helixcer Chat About

[Part: Helixcer Chat About]
    Lines : Helixcer Chat About Title, Helixcer Chat About Support Email, Helixcer Chat About Support WhatsApp

[Line: Helixcer Chat About Title]
    Field : Helixcer Chat About Title

[Field: Helixcer Chat About Title]
    Use       : Name Field
    Set as    : "Helixcer Chat (build 420)"
    Style     : Bold
    Align     : Centre
    FullWidth : Yes

[Line: Helixcer Chat About Support Email]
    Field : Helixcer Chat About Support Email

[Field: Helixcer Chat About Support Email]
    Use : Name Field
    Set as : "Support email: info@helixcer.com"
    Align : Centre
    FullWidth : Yes
    Skip : Yes

[Line: Helixcer Chat About Support WhatsApp]
    Field : Helixcer Chat About Support WhatsApp

[Field: Helixcer Chat About Support WhatsApp]
    Use : Helixcer Chat About Support Email
    Set as : "WhatsApp: +91 62820 10794"

[System: Formula]
    HxcCustomValueLabel : "♦ Custom Value"
    HxcVcCustomValueRequired : "Enter a custom value for this variable."
    HxcVcMissingCustomValue :     (##HxcVcHeaderKind = "text" AND NOT $$IsEmpty:##HxcVcHeaderKey AND ##HxcVcDraftHeaderFld = @@HxcCustomValueLabel AND $$IsEmpty:##HxcVcDraftCustom0) OR +
        (NOT $$IsEmpty:##HxcVcFK1 AND (##HxcVcFC1 = "body" OR ##HxcVcFC1 = "button") AND @@HxcVcMappingField1 = @@HxcCustomValueLabel AND $$IsEmpty:@@HxcVcMappingCustom1) OR +
        (NOT $$IsEmpty:##HxcVcFK2 AND (##HxcVcFC2 = "body" OR ##HxcVcFC2 = "button") AND @@HxcVcMappingField2 = @@HxcCustomValueLabel AND $$IsEmpty:@@HxcVcMappingCustom2) OR +
        (NOT $$IsEmpty:##HxcVcFK3 AND (##HxcVcFC3 = "body" OR ##HxcVcFC3 = "button") AND @@HxcVcMappingField3 = @@HxcCustomValueLabel AND $$IsEmpty:@@HxcVcMappingCustom3) OR +
        (NOT $$IsEmpty:##HxcVcFK4 AND (##HxcVcFC4 = "body" OR ##HxcVcFC4 = "button") AND @@HxcVcMappingField4 = @@HxcCustomValueLabel AND $$IsEmpty:@@HxcVcMappingCustom4) OR +
        (NOT $$IsEmpty:##HxcVcFK5 AND (##HxcVcFC5 = "body" OR ##HxcVcFC5 = "button") AND ##HxcVcDMFld5 = @@HxcCustomValueLabel AND $$IsEmpty:##HxcVcDraftCustom5) OR +
        (NOT $$IsEmpty:##HxcVcFK6 AND (##HxcVcFC6 = "body" OR ##HxcVcFC6 = "button") AND ##HxcVcDMFld6 = @@HxcCustomValueLabel AND $$IsEmpty:##HxcVcDraftCustom6) OR +
        (NOT $$IsEmpty:##HxcVcFK7 AND (##HxcVcFC7 = "body" OR ##HxcVcFC7 = "button") AND ##HxcVcDMFld7 = @@HxcCustomValueLabel AND $$IsEmpty:##HxcVcDraftCustom7) OR +
        (NOT $$IsEmpty:##HxcVcFK8 AND (##HxcVcFC8 = "body" OR ##HxcVcFC8 = "button") AND ##HxcVcDMFld8 = @@HxcCustomValueLabel AND $$IsEmpty:##HxcVcDraftCustom8) OR +
        (NOT $$IsEmpty:##HxcVcFK9 AND (##HxcVcFC9 = "button") AND ##HxcVcDMFld9 = @@HxcCustomValueLabel AND $$IsEmpty:##HxcVcDraftCustom9) OR +
        (NOT $$IsEmpty:##HxcVcFK10 AND (##HxcVcFC10 = "button") AND ##HxcVcDMFld10 = @@HxcCustomValueLabel AND $$IsEmpty:##HxcVcDraftCustom10) OR +
        (NOT $$IsEmpty:##HxcVcFK11 AND (##HxcVcFC11 = "button") AND ##HxcVcDMFld11 = @@HxcCustomValueLabel AND $$IsEmpty:##HxcVcDraftCustom11) OR +
        (NOT $$IsEmpty:##HxcVcFK12 AND (##HxcVcFC12 = "button") AND ##HxcVcDMFld12 = @@HxcCustomValueLabel AND $$IsEmpty:##HxcVcDraftCustom12) OR +
        (NOT $$IsEmpty:##HxcVcFK13 AND (##HxcVcFC13 = "button") AND ##HxcVcDMFld13 = @@HxcCustomValueLabel AND $$IsEmpty:##HxcVcDraftCustom13) OR +
        (NOT $$IsEmpty:##HxcVcFK14 AND (##HxcVcFC14 = "button") AND ##HxcVcDMFld14 = @@HxcCustomValueLabel AND $$IsEmpty:##HxcVcDraftCustom14) OR +
        (NOT $$IsEmpty:##HxcVcFK15 AND (##HxcVcFC15 = "button") AND ##HxcVcDMFld15 = @@HxcCustomValueLabel AND $$IsEmpty:##HxcVcDraftCustom15) OR +
        (NOT $$IsEmpty:##HxcVcFK16 AND (##HxcVcFC16 = "button") AND ##HxcVcDMFld16 = @@HxcCustomValueLabel AND $$IsEmpty:##HxcVcDraftCustom16)
    HxcVoucherMappingSort : If $Name = @@HxcCustomValueLabel THEN "0" ELSE $Name
    HxcVcMappingField1 : If ##HxcVcFC1 = "button" THEN ##HxcVcButtonField1 ELSE ##HxcVcDMFld1
    HxcVcMappingCustom1 : If ##HxcVcFC1 = "button" THEN ##HxcVcButtonCustom1 ELSE ##HxcVcDraftCustom1
    HxcVcMappingField2 : If ##HxcVcFC2 = "button" THEN ##HxcVcButtonField2 ELSE ##HxcVcDMFld2
    HxcVcMappingCustom2 : If ##HxcVcFC2 = "button" THEN ##HxcVcButtonCustom2 ELSE ##HxcVcDraftCustom2
    HxcVcMappingField3 : If ##HxcVcFC3 = "button" THEN ##HxcVcButtonField3 ELSE ##HxcVcDMFld3
    HxcVcMappingCustom3 : If ##HxcVcFC3 = "button" THEN ##HxcVcButtonCustom3 ELSE ##HxcVcDraftCustom3
    HxcVcMappingField4 : If ##HxcVcFC4 = "button" THEN ##HxcVcButtonField4 ELSE ##HxcVcDMFld4
    HxcVcMappingCustom4 : If ##HxcVcFC4 = "button" THEN ##HxcVcButtonCustom4 ELSE ##HxcVcDraftCustom4

[Function: Hxc Restore Custom Mappings]
    Variable : EditKey : String
    01 : SET : EditKey : ##HxcVcDraftEditKey
    02 : IF : $$IsEmpty:##EditKey
    03 :    RETURN : Yes
    04 : END IF
    05 : WALK COLLECTION : Hxc Voucher Config Names
    06 :    IF : $HxcVcName = ##EditKey AND $HxcVcTemplateName = ##HxcVcFetchName AND $HxcVcLanguage = ##HxcVcFetchLang
    10 :       IF : (##HxcVcHeaderKind = "text" AND NOT $$IsEmpty:##HxcVcHeaderKey) AND NOT $$IsEmpty:$HxcVcCustom0
    11 :          SET : HxcVcDraftHeaderFld : @@HxcCustomValueLabel
    12 :          SET : HxcVcDraftCustom0 : $HxcVcCustom0
    13 :       END IF
    14 :       IF : (NOT $$IsEmpty:##HxcVcFK1 AND (##HxcVcFC1 = "body" OR ##HxcVcFC1 = "button")) AND NOT $$IsEmpty:$HxcVcCustom1
    15 :          IF : ##HxcVcFC1 = "button"
    151 :             SET : HxcVcButtonField1 : @@HxcCustomValueLabel
    152 :             SET : HxcVcButtonCustom1 : $HxcVcCustom1
    153 :          ELSE
    154 :             SET : HxcVcDMFld1 : @@HxcCustomValueLabel
    155 :             SET : HxcVcDraftCustom1 : $HxcVcCustom1
    16 :          END IF
    17 :       END IF
    18 :       IF : (NOT $$IsEmpty:##HxcVcFK2 AND (##HxcVcFC2 = "body" OR ##HxcVcFC2 = "button")) AND NOT $$IsEmpty:$HxcVcCustom2
    19 :          IF : ##HxcVcFC2 = "button"
    191 :             SET : HxcVcButtonField2 : @@HxcCustomValueLabel
    192 :             SET : HxcVcButtonCustom2 : $HxcVcCustom2
    193 :          ELSE
    194 :             SET : HxcVcDMFld2 : @@HxcCustomValueLabel
    195 :             SET : HxcVcDraftCustom2 : $HxcVcCustom2
    20 :          END IF
    21 :       END IF
    22 :       IF : (NOT $$IsEmpty:##HxcVcFK3 AND (##HxcVcFC3 = "body" OR ##HxcVcFC3 = "button")) AND NOT $$IsEmpty:$HxcVcCustom3
    23 :          IF : ##HxcVcFC3 = "button"
    231 :             SET : HxcVcButtonField3 : @@HxcCustomValueLabel
    232 :             SET : HxcVcButtonCustom3 : $HxcVcCustom3
    233 :          ELSE
    234 :             SET : HxcVcDMFld3 : @@HxcCustomValueLabel
    235 :             SET : HxcVcDraftCustom3 : $HxcVcCustom3
    24 :          END IF
    25 :       END IF
    26 :       IF : (NOT $$IsEmpty:##HxcVcFK4 AND (##HxcVcFC4 = "body" OR ##HxcVcFC4 = "button")) AND NOT $$IsEmpty:$HxcVcCustom4
    27 :          IF : ##HxcVcFC4 = "button"
    271 :             SET : HxcVcButtonField4 : @@HxcCustomValueLabel
    272 :             SET : HxcVcButtonCustom4 : $HxcVcCustom4
    273 :          ELSE
    274 :             SET : HxcVcDMFld4 : @@HxcCustomValueLabel
    275 :             SET : HxcVcDraftCustom4 : $HxcVcCustom4
    28 :          END IF
    29 :       END IF
    30 :       IF : (NOT $$IsEmpty:##HxcVcFK5 AND (##HxcVcFC5 = "body" OR ##HxcVcFC5 = "button")) AND NOT $$IsEmpty:$HxcVcCustom5
    31 :          SET : HxcVcDMFld5 : @@HxcCustomValueLabel
    32 :          SET : HxcVcDraftCustom5 : $HxcVcCustom5
    33 :       END IF
    34 :       IF : (NOT $$IsEmpty:##HxcVcFK6 AND (##HxcVcFC6 = "body" OR ##HxcVcFC6 = "button")) AND NOT $$IsEmpty:$HxcVcCustom6
    35 :          SET : HxcVcDMFld6 : @@HxcCustomValueLabel
    36 :          SET : HxcVcDraftCustom6 : $HxcVcCustom6
    37 :       END IF
    38 :       IF : (NOT $$IsEmpty:##HxcVcFK7 AND (##HxcVcFC7 = "body" OR ##HxcVcFC7 = "button")) AND NOT $$IsEmpty:$HxcVcCustom7
    39 :          SET : HxcVcDMFld7 : @@HxcCustomValueLabel
    40 :          SET : HxcVcDraftCustom7 : $HxcVcCustom7
    41 :       END IF
    42 :       IF : (NOT $$IsEmpty:##HxcVcFK8 AND (##HxcVcFC8 = "body" OR ##HxcVcFC8 = "button")) AND NOT $$IsEmpty:$HxcVcCustom8
    43 :          SET : HxcVcDMFld8 : @@HxcCustomValueLabel
    44 :          SET : HxcVcDraftCustom8 : $HxcVcCustom8
    45 :       END IF
    827 :       IF : ##HxcVcFC9 = "button" AND NOT $$IsEmpty:$HxcVcCustom9
    828 :          SET : HxcVcDraftCustom9 : $HxcVcCustom9
    829 :       END IF
    830 :       IF : ##HxcVcFC10 = "button" AND NOT $$IsEmpty:$HxcVcCustom10
    831 :          SET : HxcVcDraftCustom10 : $HxcVcCustom10
    832 :       END IF
    833 :       IF : ##HxcVcFC11 = "button" AND NOT $$IsEmpty:$HxcVcCustom11
    834 :          SET : HxcVcDraftCustom11 : $HxcVcCustom11
    835 :       END IF
    836 :       IF : ##HxcVcFC12 = "button" AND NOT $$IsEmpty:$HxcVcCustom12
    837 :          SET : HxcVcDraftCustom12 : $HxcVcCustom12
    838 :       END IF
    839 :       IF : ##HxcVcFC13 = "button" AND NOT $$IsEmpty:$HxcVcCustom13
    840 :          SET : HxcVcDraftCustom13 : $HxcVcCustom13
    841 :       END IF
    842 :       IF : ##HxcVcFC14 = "button" AND NOT $$IsEmpty:$HxcVcCustom14
    843 :          SET : HxcVcDraftCustom14 : $HxcVcCustom14
    844 :       END IF
    845 :       IF : ##HxcVcFC15 = "button" AND NOT $$IsEmpty:$HxcVcCustom15
    846 :          SET : HxcVcDraftCustom15 : $HxcVcCustom15
    847 :       END IF
    848 :       IF : ##HxcVcFC16 = "button" AND NOT $$IsEmpty:$HxcVcCustom16
    849 :          SET : HxcVcDraftCustom16 : $HxcVcCustom16
    850 :       END IF
    46 :    END IF
    47 : END WALK
    48 : RETURN : Yes

[Field: Hxc Vc Custom Mapping Input]
