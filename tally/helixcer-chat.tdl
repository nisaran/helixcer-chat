[Function: Hxc Open Party Receivable]
    Variable : FinancialYearStart : Date
    001 : SET : FinancialYearStart : $StartingFrom:Company:##SVCurrentCompany
    002 : SET : HxcReceivableToDate : $EndingAt:Company:##SVCurrentCompany
    003 : IF : $$IsEmpty:##HxcReceivableToDate
    004 :    SET : HxcReceivableToDate : ##SVCurrentDate
    005 : END IF
    006 : SET : HxcReceivableFromDate : If $$IsEmpty:##FinancialYearStart Then ##SVFromDate Else $$FinYearBeg:##HxcReceivableToDate:##FinancialYearStart
    01 : SET : HxcReceivableGroup : ""
    02 : SET : HxcReceivableReopen : Yes
    03 : WHILE : ##HxcReceivableReopen
    04 :    SET : HxcReceivableReopen : No
    05 :    DISPLAY : Hxc Party Receivable
    06 : END WHILE

