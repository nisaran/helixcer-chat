[Field: Hxc Vc F MP3]
    Use        : Name Field
    Set as     : "Map Var"
    Skip       : Yes
    Width      : 22
    Inactive   : NOT ##HxcVcFetched OR $$IsEmpty:##HxcVcFK3

[Field: Hxc Vc F MK3]
    Use        : Name Field
    Set as     : ##HxcVcFK3
    Set Always : Yes
    Skip       : Yes
    Width      : 8
    Inactive   : NOT ##HxcVcFetched OR $$IsEmpty:##HxcVcFK3

[Field: Hxc Vc F MF3]
    Use        : Name Field
    Storage    : HxcVcDMFld3
    Set as     : $HxcVcDMFld3
    Set Always : Yes
    Table      : Hxc Voucher Field List, Not Applicable
    Width      : 28
    Max        : 40
    Inactive   : NOT ##HxcVcFetched OR $$IsEmpty:##HxcVcFK3

[Line: Hxc Vc F Map4]
    Fields : Hxc Vc F MP4, Hxc Vc F MK4, Hxc Vc F MF4

[Field: Hxc Vc F MP4]
    Use        : Name Field
    Set as     : "Map Var"
    Skip       : Yes
    Width      : 22
    Inactive   : NOT ##HxcVcFetched OR $$IsEmpty:##HxcVcFK4

[Field: Hxc Vc F MK4]
    Use        : Name Field
    Set as     : ##HxcVcFK4
    Set Always : Yes
    Skip       : Yes
    Width      : 8
    Inactive   : NOT ##HxcVcFetched OR $$IsEmpty:##HxcVcFK4

[Field: Hxc Vc F MF4]
    Use        : Name Field
