;; Helixcer Chat — TallyPrime TDL
;; BUILD: 331-no-hash-fields
;; If save still says Bad formula '#Hxc Workspace Id', this file is NOT loaded.
;;
;; API Settings — save only. Drafts + SET (never #FieldName with spaces).
;; Status — About-style Display; Alt+R Msg Box fetch.

;; ---------------------------------------------------------------------------
;; System Persistent variables
;; ---------------------------------------------------------------------------

[Variable: HxcWorkspaceId]
    Type       : String
    Persistent : Yes

[Variable: HxcChannelId]
    Type       : String
    Persistent : Yes

[Variable: HxcApiKey]
    Type       : String
    Persistent : Yes

[Variable: HxcApiKeyDraft]
    Type : String

[Variable: HxcWorkspaceIdDraft]
    Type : String

[Variable: HxcChannelIdDraft]
    Type : String

[Variable: HxcWorkspaceName]
    Type       : String
    Persistent : Yes

[Variable: HxcChannelName]
    Type       : String
    Persistent : Yes

[Variable: HxcConnectionStatus]
    Type       : String
    Persistent : Yes

[System: Variable]
    HxcWorkspaceId      : ""
    HxcChannelId        : ""
    HxcApiKey           : ""
    HxcApiKeyDraft      : ""
    HxcWorkspaceIdDraft : ""
    HxcChannelIdDraft   : ""
    HxcWorkspaceName    : ""
    HxcChannelName      : ""
    HxcConnectionStatus : ""

[System: Formula]
    Hxc Connection Url : "https://api.chat.helixcer.com/api/v1/connection?channelId=" + ##HxcChannelId
    Hxc Api Key Masked : If $$IsEmpty:##HxcApiKey THEN "" ELSE "******"

;; ---------------------------------------------------------------------------
;; HTTP GET /api/v1/connection
;; ---------------------------------------------------------------------------

[Report: Hxc Connection Request]
    Form          : Hxc Connection Request
    Export Header : "Authorization: Bearer " + ##HxcApiKey
    Export Header : "X-Workspace-Id: " + ##HxcWorkspaceId
    Export Header : "Accept: application/json"

[Form: Hxc Connection Request]
    Part : Hxc Connection Request

[Part: Hxc Connection Request]
    Lines : Hxc Connection Request

[Line: Hxc Connection Request]
    Fields : Hxc Connection Request

[Field: Hxc Connection Request]
    Use    : Name Field
    Set as : ""
    Skip   : Yes

[Function: Hxc Apply Connection Response]
    Variable : Platform : String
    01 : SET : HxcWorkspaceName : ""
    02 : SET : HxcChannelName : ""
    03 : SET : HxcConnectionStatus : "Could not fetch. Check IDs and API Key."
    04 : WALK COLLECTION : Parameter Collection
    05 :    IF : NOT $$IsEmpty:$workspaceName
    06 :       SET : Platform : $platformLabel
    07 :       IF : $$IsEmpty:##Platform
    08 :          SET : Platform : $connectorType
    09 :       END IF
    10 :       IF : $$IsEmpty:##Platform
    11 :          SET : Platform : "Channel"
    12 :       END IF
    13 :       SET : HxcWorkspaceName : $workspaceName
    14 :       SET : HxcChannelName : $channelName + " (" + ##Platform + ")"
    15 :       SET : HxcConnectionStatus : "Connected"
    16 :    END IF
    17 : END WALK
    18 : RETURN : Yes

[Function: Hxc Fetch Connection]
    01 : IF : $$IsEmpty:##HxcWorkspaceId OR $$IsEmpty:##HxcChannelId OR $$IsEmpty:##HxcApiKey
    02 :    SET : HxcWorkspaceName : ""
    03 :    SET : HxcChannelName : ""
    04 :    SET : HxcConnectionStatus : "Save Workspace ID, Channel ID, and API Key in API Settings first."
    05 :    RETURN : No
    06 : END IF
    07 : SET : HxcWorkspaceName : ""
    08 : SET : HxcChannelName : ""
    09 : SET : HxcConnectionStatus : "Checking..."
    10 : Start Progress : 1 : "Helixcer Chat" : "Connection status" : "Fetching workspace and channel"
    11 : HTTP Request : @@HxcConnectionUrl : GET : JSON : UTF8 : Hxc Connection Request : Hxc Apply Connection Response
    12 : End Progress
    13 : IF : $$IsEmpty:##HxcWorkspaceName
    14 :    IF : ##HxcConnectionStatus = "Checking..."
    15 :       SET : HxcConnectionStatus : "Could not fetch. Check IDs and API Key."
    16 :    END IF
    17 : END IF
    18 : RETURN : Yes

;; Fetch then one message (used from Status Alt+R). Do not Display from here.
[Function: Hxc Show Status]
    01 : CALL : Hxc Fetch Connection
    02 : Msg Box : "Helixcer Connection Status" : ##HxcConnectionStatus
    03 : Msg Box : "Workspace" : If $$IsEmpty:##HxcWorkspaceName THEN ##HxcWorkspaceId ELSE ##HxcWorkspaceName
    04 : Msg Box : "Channel" : If $$IsEmpty:##HxcChannelName THEN ##HxcChannelId ELSE ##HxcChannelName
    05 : RETURN : Yes

;; ---------------------------------------------------------------------------
;; Gateway of Tally → Helixcer Chat
;; ---------------------------------------------------------------------------

[#Menu: Gateway of Tally]
    Add : Key Item : Before : @@LOCQuit : Helixcer Chat : H : Menu : Helixcer Chat Menu

[Menu: Helixcer Chat Menu]
    Title    : "Helixcer Chat"
    Key Item : API Settings : S : Modify Variable : Helixcer API Settings
    Key Item : Status       : T : Display : Helixcer Chat Status
    Key Item : About        : A : Display : Helixcer Chat About
    Key Item : Back         : B : Menu : Gateway of Tally

;; ---------------------------------------------------------------------------
;; API Settings — save only
;; ---------------------------------------------------------------------------

[Report: Helixcer API Settings]
    Form  : Helixcer API Settings
    Title : "API Settings"

[Form: Helixcer API Settings]
    Part   : Helixcer API Settings
    Button : Form Accept, Form Cancel
    On     : Form Accept : Yes : Call : Hxc Confirm Save

[Part: Helixcer API Settings]
    Lines  : Hxc Api Settings Title, +
             Hxc Workspace Id Line, Hxc Channel Id Line, Hxc Api Key Line
    Scroll : Vertical

[Line: Hxc Api Settings Title]
    Field : Hxc Api Settings Title

[Field: Hxc Api Settings Title]
    Use       : Name Field
    Set as    : "Helixcer Chat — API Settings (build 331)"
    Style     : Bold
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

[Line: Hxc Workspace Id Line]
    Fields : Medium Prompt, HxcWorkspaceIdFld
    Local  : Field : Medium Prompt : Set as : "Workspace ID"
    Local  : Field : Medium Prompt : Width  : 20

[Field: HxcWorkspaceIdFld]
    Use      : Name Field
    Set as   : ##HxcWorkspaceId
    Modifies : HxcWorkspaceIdDraft : Yes
    Width    : 60
    Max      : 64
    On       : Accept : Yes : SET : HxcWorkspaceIdDraft : $Value
    On       : Accept : Yes : SET : HxcWorkspaceId : $Value
    On       : Accept : Yes : Field Accept

[Line: Hxc Channel Id Line]
    Fields : Medium Prompt, HxcChannelIdFld
    Local  : Field : Medium Prompt : Set as : "Channel ID"
    Local  : Field : Medium Prompt : Width  : 20

[Field: HxcChannelIdFld]
    Use      : Name Field
    Set as   : ##HxcChannelId
    Modifies : HxcChannelIdDraft : Yes
    Width    : 60
    Max      : 64
    On       : Accept : Yes : SET : HxcChannelIdDraft : $Value
    On       : Accept : Yes : SET : HxcChannelId : $Value
    On       : Accept : Yes : Field Accept

[Line: Hxc Api Key Line]
    Fields : Medium Prompt, HxcApiKeyFld
    Local  : Field : Medium Prompt : Set as : "API Key"
    Local  : Field : Medium Prompt : Width  : 20

[Field: HxcApiKeyFld]
    Use      : Name Field
    Set as   : @@HxcApiKeyMasked
    Modifies : HxcApiKeyDraft : Yes
    Width    : 60
    Max      : 200
    On       : Accept : Yes : Call : Hxc Capture Api Key
    On       : Accept : Yes : Field Accept

[Function: Hxc Capture Api Key]
    01 : SET : HxcApiKeyDraft : $Value
    02 : IF : $$IsEmpty:$Value
    03 :    RETURN : Yes
    04 : END IF
    05 : IF : $Value = "******"
    06 :    RETURN : Yes
    07 : END IF
    08 : IF : $Value = "*"
    09 :    RETURN : Yes
    10 : END IF
    11 : IF : $Value = "********"
    12 :    RETURN : Yes
    13 : END IF
    14 : SET : HxcApiKey : $Value
    15 : RETURN : Yes

;; Promote drafts → Persistent vars. Never use #FieldName (spaces = Bad formula).
;; RETURN Yes/No only — never nest Form Accept.
[Function: Hxc Confirm Save]
    01 : IF : NOT $$IsEmpty:##HxcWorkspaceIdDraft
    02 :    SET : HxcWorkspaceId : ##HxcWorkspaceIdDraft
    03 : END IF
    04 : IF : NOT $$IsEmpty:##HxcChannelIdDraft
    05 :    SET : HxcChannelId : ##HxcChannelIdDraft
    06 : END IF
    07 : CALL : Hxc Capture Api Key From Draft
    08 : Query Box : "Do you want to save?" : Yes
    09 : IF : $$LastResult
    10 :    RETURN : Yes
    11 : END IF
    12 : RETURN : No

[Function: Hxc Capture Api Key From Draft]
    01 : IF : $$IsEmpty:##HxcApiKeyDraft
    02 :    RETURN : Yes
    03 : END IF
    04 : IF : ##HxcApiKeyDraft = "******"
    05 :    RETURN : Yes
    06 : END IF
    07 : IF : ##HxcApiKeyDraft = "*"
    08 :    RETURN : Yes
    09 : END IF
    10 : IF : ##HxcApiKeyDraft = "********"
    11 :    RETURN : Yes
    12 : END IF
    13 : SET : HxcApiKey : ##HxcApiKeyDraft
    14 : RETURN : Yes

;; ---------------------------------------------------------------------------
;; Status — same shape as About (plain Display). Alt+R fetches + Msg Box.
;; ---------------------------------------------------------------------------

[Report: Helixcer Chat Status]
    Form  : Helixcer Chat Status
    Title : "Status"

[Form: Helixcer Chat Status]
    Part   : Helixcer Chat Status
    Button : Form Cancel, Hxc Status Refresh Button

[Button: Hxc Status Refresh Button]
    Key    : Alt+R
    Title  : "Refresh"
    Action : Call : Hxc Show Status

[Part: Helixcer Chat Status]
    Lines : Helixcer Chat Status Title, Helixcer Chat Status Body, Helixcer Chat Status Detail

[Line: Helixcer Chat Status Title]
    Field : Helixcer Chat Status Title

[Field: Helixcer Chat Status Title]
    Use       : Name Field
    Set as    : "Helixcer Chat — Status"
    Style     : Bold
    Align     : Centre
    FullWidth : Yes

[Line: Helixcer Chat Status Body]
    Field : Helixcer Chat Status Body

[Field: Helixcer Chat Status Body]
    Use       : Name Field
    Set as    : If $$IsEmpty:##HxcConnectionStatus THEN "Press Alt+R to check connection" ELSE ##HxcConnectionStatus
    Align     : Centre
    FullWidth : Yes

[Line: Helixcer Chat Status Detail]
    Field : Helixcer Chat Status Detail

[Field: Helixcer Chat Status Detail]
    Use       : Name Field
    Set as    : If $$IsEmpty:##HxcWorkspaceName THEN "Alt+R loads workspace and channel names" ELSE ##HxcWorkspaceName + " / " + ##HxcChannelName
    Align     : Centre
    FullWidth : Yes

;; ---------------------------------------------------------------------------
;; About
;; ---------------------------------------------------------------------------

[Report: Helixcer Chat About]
    Form : Helixcer Chat About

[Form: Helixcer Chat About]
    Part : Helixcer Chat About

[Part: Helixcer Chat About]
    Lines : Helixcer Chat About Title, Helixcer Chat About Body, Helixcer Chat About Status

[Line: Helixcer Chat About Title]
    Field : Helixcer Chat About Title

[Field: Helixcer Chat About Title]
    Use       : Name Field
    Set as    : "Helixcer Chat"
    Style     : Bold
    Align     : Centre
    FullWidth : Yes

[Line: Helixcer Chat About Body]
    Field : Helixcer Chat About Body

[Field: Helixcer Chat About Body]
    Use       : Name Field
    Set as    : "API Settings saves credentials. Status checks the live connection."
    Align     : Centre
    FullWidth : Yes

[Line: Helixcer Chat About Status]
    Field : Helixcer Chat About Status

[Field: Helixcer Chat About Status]
    Use       : Name Field
    Set as    : If $$IsEmpty:##HxcApiKey THEN "API Key: not set" ELSE +
                If $$IsEmpty:##HxcWorkspaceId THEN "API Key saved; Workspace ID missing" ELSE +
                If $$IsEmpty:##HxcChannelId THEN "API Key saved; Channel ID missing" ELSE +
                If $$IsEmpty:##HxcConnectionStatus THEN "Credentials saved — open Status to verify" ELSE +
                ##HxcConnectionStatus
    Align     : Centre
    FullWidth : Yes
