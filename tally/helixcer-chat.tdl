    Invisible : $$IsEmpty:$$ListValue:HxcSendValues:($Name + "|11")

[Field: Hxc Send Map Field 12]
    JSON Tag : $$ListValue:HxcSendKeys:"slot|12"
    Set as : $$ListValue:HxcSendValues:($Name + "|12")
    Invisible : $$IsEmpty:$$ListValue:HxcSendValues:($Name + "|12")

[Field: Hxc Send Map Field 13]
