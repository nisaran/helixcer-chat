;; Helixcer Chat — TallyPrime TDL
;; BUILD: 346-create-form
;; Title must show "(build 346)".
;;
;; Create Config = ONE sequential form (not a name list):
;;   Config Name → Template → Language → Variable Mapping → Media →
;;   Voucher Types (multi) → Auto / Confirm → Ctrl+A
;; Uses Company draft UDFs + Alter (no Display). On Accept commits into Aggregate.
;; Template API fetch still phase 2.

;; ---------------------------------------------------------------------------
;; Company UDFs
;; ---------------------------------------------------------------------------

[System: UDF]
    HxcWorkspaceIdUDF : String : 25101
    HxcChannelIdUDF   : String : 25102
    HxcApiKeyUDF      : String : 25103
    ;; Saved configs
    HxcVoucherConfigs      : Aggregate : 25110
    HxcVcName              : String    : 25111
    HxcVcTemplateName      : String    : 25112
    HxcVcLanguage          : String    : 25113
    HxcVcVoucherTypes      : String    : 25114
    HxcVcMediaExport       : String    : 25115
    HxcVcAutoSend          : Logical   : 25116
    HxcVcConfirmBeforeSend : Logical   : 25117
    HxcVcVarMapsText       : String    : 25118
    ;; Create/Alter draft buffer (one form, not a repeating name list)
    HxcVcDraftName     : String  : 25120
    HxcVcDraftTemplate : String  : 25121
    HxcVcDraftLang     : String  : 25122
    HxcVcDraftMedia    : String  : 25123
    HxcVcDraftAuto     : Logical : 25124
    HxcVcDraftConfirm  : Logical : 25125
    HxcVcDraftEditKey  : String  : 25126
    HxcVcDMKey1 : String : 25131
    HxcVcDMFld1 : String : 25132
    HxcVcDMKey2 : String : 25133
    HxcVcDMFld2 : String : 25134
    HxcVcDMKey3 : String : 25135
    HxcVcDMFld3 : String : 25136
    HxcVcDMKey4 : String : 25137
    HxcVcDMFld4 : String : 25138
    HxcVcDMKey5 : String : 25139
    HxcVcDMFld5 : String : 25140
    HxcVcDV1 : String : 25141
    HxcVcDV2 : String : 25142
    HxcVcDV3 : String : 25143
    HxcVcDV4 : String : 25144
    HxcVcDV5 : String : 25145
    HxcVcDV6 : String : 25146
    HxcVcDV7 : String : 25147
    HxcVcDV8 : String : 25148

;; ---------------------------------------------------------------------------
;; Status mirrors + save flag
;; ---------------------------------------------------------------------------

[Variable: HxcSysWorkspaceId]
    Type       : String
    Persistent : Yes

[Variable: HxcSysChannelId]
    Type       : String
    Persistent : Yes

[Variable: HxcSysApiKey]
    Type       : String
    Persistent : Yes

[Variable: HxcWorkspaceName]
    Type       : String
    Persistent : Yes

[Variable: HxcChannelName]
    Type       : String
    Persistent : Yes

[Variable: HxcConnectionStatus]
    Type       : String
    Persistent : Yes

[Variable: HxcVcSaveOk]
    Type : Logical

[System: Variable]
    HxcSysWorkspaceId   : ""
    HxcSysChannelId     : ""
    HxcSysApiKey        : ""
    HxcWorkspaceName    : ""
    HxcChannelName      : ""
    HxcConnectionStatus : ""
    HxcVcSaveOk         : No

[System: Formula]
    Hxc Connection Url : "https://api.chat.helixcer.com/api/v1/connection?channelId=" + ##HxcSysChannelId
    Hxc Sys Summary    : "WS=[" + ##HxcSysWorkspaceId + "] CH=[" + ##HxcSysChannelId + "] KeyChars=" + $$StringLength:##HxcSysApiKey

;; ---------------------------------------------------------------------------
;; Tables
;; ---------------------------------------------------------------------------

[Collection: Hxc Media Export List]
    List : "None", "Voucher PDF", "Voucher HTML", "Voucher XML", "Voucher Excel"

[Collection: Hxc Voucher Type List]
    Type   : Voucher Type
    Format : $Name, 40

[Collection: Hxc Voucher Field List]
    List : "Voucher Number", "Voucher Date", "Amount", "Reference", "Narration", +
           "Party Name", "Party Mobile", "Party Email", "Company Name", "Guid"

[Collection: Hxc Voucher Config Names]
    Type     : HxcVoucherConfigs : Company
    Child Of : ##SVCurrentCompany
    Format   : $HxcVcName, 40
    Fetch    : HxcVcName, HxcVcTemplateName, HxcVcLanguage, HxcVcVoucherTypes, +
               HxcVcMediaExport, HxcVcAutoSend, HxcVcConfirmBeforeSend, HxcVcVarMapsText
    Title    : "Voucher Configs"

;; ---------------------------------------------------------------------------
;; HTTP (Status)
;; ---------------------------------------------------------------------------

[Report: Hxc Connection Request]
    Form          : Hxc Connection Request
    Export Header : "Authorization: Bearer " + ##HxcSysApiKey
    Export Header : "X-Workspace-Id: " + ##HxcSysWorkspaceId
    Export Header : "Accept: application/json"

[Form: Hxc Connection Request]
    Part : Hxc Connection Request

[Part: Hxc Connection Request]
    Lines : Hxc Connection Request

[Line: Hxc Connection Request]
    Fields : Hxc Connection Request

[Field: Hxc Connection Request]
    Use    : Name Field
    Set as : ""
    Skip   : Yes

[Function: Hxc Apply Connection Response]
    Variable : Platform : String
    01 : SET : HxcWorkspaceName : ""
    02 : SET : HxcChannelName : ""
    03 : SET : HxcConnectionStatus : "Could not fetch. Check IDs and API Key."
    04 : WALK COLLECTION : Parameter Collection
    05 :    IF : NOT $$IsEmpty:$workspaceName
    06 :       SET : Platform : $platformLabel
    07 :       IF : $$IsEmpty:##Platform
    08 :          SET : Platform : $connectorType
    09 :       END IF
    10 :       IF : $$IsEmpty:##Platform
    11 :          SET : Platform : "Channel"
    12 :       END IF
    13 :       SET : HxcWorkspaceName : $workspaceName
    14 :       SET : HxcChannelName : $channelName + " (" + ##Platform + ")"
    15 :       SET : HxcConnectionStatus : "Connected"
    16 :    END IF
    17 : END WALK
    18 : RETURN : Yes

[Function: Hxc Sync From Company]
    01 : IF : NOT $$IsEmpty:$HxcWorkspaceIdUDF:Company:##SVCurrentCompany
    02 :    SET : HxcSysWorkspaceId : $HxcWorkspaceIdUDF:Company:##SVCurrentCompany
    03 : END IF
    04 : IF : NOT $$IsEmpty:$HxcChannelIdUDF:Company:##SVCurrentCompany
    05 :    SET : HxcSysChannelId : $HxcChannelIdUDF:Company:##SVCurrentCompany
    06 : END IF
    07 : IF : NOT $$IsEmpty:$HxcApiKeyUDF:Company:##SVCurrentCompany
    08 :    SET : HxcSysApiKey : $HxcApiKeyUDF:Company:##SVCurrentCompany
    09 : END IF
    10 : RETURN : Yes

[Function: Hxc Fetch Connection]
    01 : CALL : Hxc Sync From Company
    02 : IF : $$IsEmpty:##HxcSysWorkspaceId OR $$IsEmpty:##HxcSysChannelId OR $$IsEmpty:##HxcSysApiKey
    03 :    SET : HxcConnectionStatus : "Not ready. " + @@HxcSysSummary + "  Accept API Settings with Ctrl+A first."
    04 :    RETURN : No
    05 : END IF
    06 : SET : HxcWorkspaceName : ""
    07 : SET : HxcChannelName : ""
    08 : SET : HxcConnectionStatus : "Checking..."
    09 : Start Progress : 1 : "Helixcer Chat" : "Connection status" : "Fetching workspace and channel"
    10 : HTTP Request : @@HxcConnectionUrl : GET : JSON : UTF8 : Hxc Connection Request : Hxc Apply Connection Response
    11 : End Progress
    12 : IF : $$IsEmpty:##HxcWorkspaceName
    13 :    IF : ##HxcConnectionStatus = "Checking..."
    14 :       SET : HxcConnectionStatus : "Could not fetch. Check IDs and API Key."
    15 :    END IF
    16 : END IF
    17 : RETURN : Yes

[Function: Hxc Show Status]
    01 : CALL : Hxc Fetch Connection
    02 : Msg Box : "Helixcer Connection Status" : ##HxcConnectionStatus
    03 : IF : NOT $$IsEmpty:##HxcWorkspaceName
    04 :    Msg Box : "Workspace" : ##HxcWorkspaceName
    05 :    Msg Box : "Channel" : ##HxcChannelName
    06 : END IF
    07 : RETURN : Yes

;; ---------------------------------------------------------------------------
;; Pack helpers + commit draft → Aggregate config
;; ---------------------------------------------------------------------------

[Function: Hxc Pack Maps]
    Variable : S : String
    01 : SET : S : ""
    02 : IF : NOT $$IsEmpty:$HxcVcDMKey1
    03 :    SET : S : ##S + $HxcVcDMKey1 + "=" + $HxcVcDMFld1 + ";"
    04 : END IF
    05 : IF : NOT $$IsEmpty:$HxcVcDMKey2
    06 :    SET : S : ##S + $HxcVcDMKey2 + "=" + $HxcVcDMFld2 + ";"
    07 : END IF
    08 : IF : NOT $$IsEmpty:$HxcVcDMKey3
    09 :    SET : S : ##S + $HxcVcDMKey3 + "=" + $HxcVcDMFld3 + ";"
    10 : END IF
    11 : IF : NOT $$IsEmpty:$HxcVcDMKey4
    12 :    SET : S : ##S + $HxcVcDMKey4 + "=" + $HxcVcDMFld4 + ";"
    13 : END IF
    14 : IF : NOT $$IsEmpty:$HxcVcDMKey5
    15 :    SET : S : ##S + $HxcVcDMKey5 + "=" + $HxcVcDMFld5 + ";"
    16 : END IF
    17 : RETURN : ##S

[Function: Hxc Pack Vouchers]
    Variable : S : String
    01 : SET : S : ""
    02 : IF : NOT $$IsEmpty:$HxcVcDV1
    03 :    SET : S : ##S + $HxcVcDV1 + ","
    04 : END IF
    05 : IF : NOT $$IsEmpty:$HxcVcDV2
    06 :    SET : S : ##S + $HxcVcDV2 + ","
    07 : END IF
    08 : IF : NOT $$IsEmpty:$HxcVcDV3
    09 :    SET : S : ##S + $HxcVcDV3 + ","
    10 : END IF
    11 : IF : NOT $$IsEmpty:$HxcVcDV4
    12 :    SET : S : ##S + $HxcVcDV4 + ","
    13 : END IF
    14 : IF : NOT $$IsEmpty:$HxcVcDV5
    15 :    SET : S : ##S + $HxcVcDV5 + ","
    16 : END IF
    17 : IF : NOT $$IsEmpty:$HxcVcDV6
    18 :    SET : S : ##S + $HxcVcDV6 + ","
    19 : END IF
    20 : IF : NOT $$IsEmpty:$HxcVcDV7
    21 :    SET : S : ##S + $HxcVcDV7 + ","
    22 : END IF
    23 : IF : NOT $$IsEmpty:$HxcVcDV8
    24 :    SET : S : ##S + $HxcVcDV8 + ","
    25 : END IF
    26 : RETURN : ##S

[Function: Hxc Vc Clear Draft]
    01 : SET VALUE : HxcVcDraftName : ""
    02 : SET VALUE : HxcVcDraftTemplate : ""
    03 : SET VALUE : HxcVcDraftLang : "en"
    04 : SET VALUE : HxcVcDraftMedia : "None"
    05 : SET VALUE : HxcVcDraftAuto : No
    06 : SET VALUE : HxcVcDraftConfirm : No
    07 : SET VALUE : HxcVcDraftEditKey : ""
    08 : SET VALUE : HxcVcDMKey1 : ""
    09 : SET VALUE : HxcVcDMFld1 : ""
    10 : SET VALUE : HxcVcDMKey2 : ""
    11 : SET VALUE : HxcVcDMFld2 : ""
    12 : SET VALUE : HxcVcDMKey3 : ""
    13 : SET VALUE : HxcVcDMFld3 : ""
    14 : SET VALUE : HxcVcDMKey4 : ""
    15 : SET VALUE : HxcVcDMFld4 : ""
    16 : SET VALUE : HxcVcDMKey5 : ""
    17 : SET VALUE : HxcVcDMFld5 : ""
    18 : SET VALUE : HxcVcDV1 : ""
    19 : SET VALUE : HxcVcDV2 : ""
    20 : SET VALUE : HxcVcDV3 : ""
    21 : SET VALUE : HxcVcDV4 : ""
    22 : SET VALUE : HxcVcDV5 : ""
    23 : SET VALUE : HxcVcDV6 : ""
    24 : SET VALUE : HxcVcDV7 : ""
    25 : SET VALUE : HxcVcDV8 : ""
    26 : RETURN : Yes

[Function: Hxc Vc Commit Draft]
    Variable : Maps : String
    Variable : Vchs : String
    Variable : EditKey : String
    01 : SET : HxcVcSaveOk : No
    02 : IF : $$IsEmpty:$HxcVcDraftName
    03 :    Msg Box : "Helixcer Voucher Config" : "Config Name is required."
    04 :    RETURN : No
    05 : END IF
    06 : IF : $$IsEmpty:$HxcVcDraftTemplate
    07 :    Msg Box : "Helixcer Voucher Config" : "Template Name is required."
    08 :    RETURN : No
    09 : END IF
    10 : SET : Maps : $$HxcPackMaps
    11 : SET : Vchs : $$HxcPackVouchers
    12 : SET : EditKey : $HxcVcDraftEditKey
    13 : IF : NOT $$IsEmpty:##EditKey
    14 :    WALK COLLECTION : HxcVoucherConfigs
    15 :       IF : $HxcVcName = ##EditKey
    16 :          SET TARGET
    17 :          SET VALUE : HxcVcName : $HxcVcDraftName
    18 :          SET VALUE : HxcVcTemplateName : $HxcVcDraftTemplate
    19 :          SET VALUE : HxcVcLanguage : $HxcVcDraftLang
    20 :          SET VALUE : HxcVcMediaExport : $HxcVcDraftMedia
    21 :          SET VALUE : HxcVcAutoSend : $HxcVcDraftAuto
    22 :          SET VALUE : HxcVcConfirmBeforeSend : $HxcVcDraftConfirm
    23 :          SET VALUE : HxcVcVarMapsText : ##Maps
    24 :          SET VALUE : HxcVcVoucherTypes : ##Vchs
    25 :          SET TARGET : ..
    26 :       END IF
    27 :    END WALK
    28 : ELSE
    29 :    INSERT COLLECTION OBJECT : HxcVoucherConfigs
    30 :    SET VALUE : HxcVcName : $HxcVcDraftName
    31 :    SET VALUE : HxcVcTemplateName : $HxcVcDraftTemplate
    32 :    SET VALUE : HxcVcLanguage : $HxcVcDraftLang
    33 :    SET VALUE : HxcVcMediaExport : $HxcVcDraftMedia
    34 :    SET VALUE : HxcVcAutoSend : $HxcVcDraftAuto
    35 :    SET VALUE : HxcVcConfirmBeforeSend : $HxcVcDraftConfirm
    36 :    SET VALUE : HxcVcVarMapsText : ##Maps
    37 :    SET VALUE : HxcVcVoucherTypes : ##Vchs
    38 :    SET TARGET : ..
    39 : END IF
    40 : CALL : Hxc Vc Clear Draft
    41 : SET : HxcVcSaveOk : Yes
    42 : Msg Box : "Helixcer Voucher Config" : "Config saved."
    43 : RETURN : Yes

;; ---------------------------------------------------------------------------
;; Menu
;; ---------------------------------------------------------------------------

[#Menu: Gateway of Tally]
    Add : Key Item : Before : @@LOCQuit : Helixcer Chat : H : Menu : Helixcer Chat Menu

[Menu: Helixcer Chat Menu]
    Title    : "Helixcer Chat"
    Key Item : API Settings   : S : Alter : Helixcer API Settings
    Key Item : Voucher Config : V : Menu  : Helixcer Voucher Config Menu
    Key Item : Status         : T : Call  : Hxc Show Status
    Key Item : About          : A : Display : Helixcer Chat About
    Key Item : Back           : B : Menu  : Gateway of Tally

[Menu: Helixcer Voucher Config Menu]
    Title    : "Voucher Config"
    Key Item : Create Config : C : Alter : Helixcer Voucher Config Create
    Key Item : Alter Config  : A : Alter : Helixcer Voucher Config Alter
    Key Item : List Configs  : L : Alter : Helixcer Voucher Config List
    Key Item : Back          : B : Menu  : Helixcer Chat Menu

;; ---------------------------------------------------------------------------
;; API Settings
;; ---------------------------------------------------------------------------

[Report: Helixcer API Settings]
    Form   : Helixcer API Settings
    Title  : "API Settings"
    Object : Company

[Form: Helixcer API Settings]
    Part   : Helixcer API Settings
    Button : Form Accept, Form Cancel

[Part: Helixcer API Settings]
    Lines  : Hxc Api Settings Title, +
             Hxc Workspace Id Line, Hxc Channel Id Line, Hxc Api Key Line, +
             Hxc Save Hint Line
    Scroll : Vertical

[Line: Hxc Api Settings Title]
    Field : Hxc Api Settings Title

[Field: Hxc Api Settings Title]
    Use       : Name Field
    Set as    : "Helixcer Chat — API Settings (build 346)"
    Style     : Bold
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

[Line: Hxc Workspace Id Line]
    Fields : Medium Prompt, HxcWorkspaceIdFld
    Local  : Field : Medium Prompt : Set as : "Workspace ID"
    Local  : Field : Medium Prompt : Width  : 22

[Field: HxcWorkspaceIdFld]
    Use      : Name Field
    Storage  : HxcWorkspaceIdUDF
    Set as   : $HxcWorkspaceIdUDF
    Width    : 50
    Max      : 64
    On       : Accept : Yes : SET : HxcSysWorkspaceId : $Value
    On       : Accept : Yes : Field Accept

[Line: Hxc Channel Id Line]
    Fields : Medium Prompt, HxcChannelIdFld
    Local  : Field : Medium Prompt : Set as : "Channel ID"
    Local  : Field : Medium Prompt : Width  : 22

[Field: HxcChannelIdFld]
    Use      : Name Field
    Storage  : HxcChannelIdUDF
    Set as   : $HxcChannelIdUDF
    Width    : 50
    Max      : 64
    On       : Accept : Yes : SET : HxcSysChannelId : $Value
    On       : Accept : Yes : Field Accept

[Line: Hxc Api Key Line]
    Fields : Medium Prompt, HxcApiKeyFld
    Local  : Field : Medium Prompt : Set as : "API Key"
    Local  : Field : Medium Prompt : Width  : 22

[Field: HxcApiKeyFld]
    Use      : Name Field
    Storage  : HxcApiKeyUDF
    Set as   : $HxcApiKeyUDF
    Width    : 50
    Max      : 200
    On       : Accept : Yes : SET : HxcSysApiKey : $Value
    On       : Accept : Yes : Field Accept

[Line: Hxc Save Hint Line]
    Field : Hxc Save Hint

[Field: Hxc Save Hint]
    Use       : Name Field
    Set as    : "Tab all fields, then Ctrl+A to Accept."
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

;; ---------------------------------------------------------------------------
;; Shared Create/Alter form body (draft fields — single form, not name list)
;; ---------------------------------------------------------------------------

[Part: Hxc Vc Form Body]
    Lines  : Hxc Vc F Name Line, Hxc Vc F Template Line, Hxc Vc F Lang Line, +
             Hxc Vc F Map Head, +
             Hxc Vc F Map1, Hxc Vc F Map2, Hxc Vc F Map3, Hxc Vc F Map4, Hxc Vc F Map5, +
             Hxc Vc F Media Line, +
             Hxc Vc F Vch Head, +
             Hxc Vc F V1, Hxc Vc F V2, Hxc Vc F V3, Hxc Vc F V4, +
             Hxc Vc F V5, Hxc Vc F V6, Hxc Vc F V7, Hxc Vc F V8, +
             Hxc Vc F Auto Line, Hxc Vc F Confirm Line
    Scroll : Vertical

[Line: Hxc Vc F Name Line]
    Fields : Medium Prompt, Hxc Vc F Name
    Local  : Field : Medium Prompt : Set as : "Config Name"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc F Name]
    Use      : Name Field
    Storage  : HxcVcDraftName
    Set as   : $HxcVcDraftName
    Width    : 40
    Max      : 60

[Line: Hxc Vc F Template Line]
    Fields : Medium Prompt, Hxc Vc F Template
    Local  : Field : Medium Prompt : Set as : "Template Name"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc F Template]
    Use      : Name Field
    Storage  : HxcVcDraftTemplate
    Set as   : $HxcVcDraftTemplate
    Width    : 40
    Max      : 80

[Line: Hxc Vc F Lang Line]
    Fields : Medium Prompt, Hxc Vc F Lang
    Local  : Field : Medium Prompt : Set as : "Language"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc F Lang]
    Use      : Name Field
    Storage  : HxcVcDraftLang
    Set as   : If $$IsEmpty:$HxcVcDraftLang THEN "en" ELSE $HxcVcDraftLang
    Width    : 16
    Max      : 16

[Line: Hxc Vc F Map Head]
    Field : Hxc Vc F Map Head Fld

[Field: Hxc Vc F Map Head Fld]
    Use       : Name Field
    Set as    : "— Variable Mapping (Var → Voucher field) —"
    Style     : Bold
    FullWidth : Yes
    Skip      : Yes

[Line: Hxc Vc F Map1]
    Fields : Medium Prompt, Hxc Vc F MK1, Hxc Vc F MF1
    Local  : Field : Medium Prompt : Set as : "Var 1"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc F MK1]
    Use      : Name Field
    Storage  : HxcVcDMKey1
    Set as   : If $$IsEmpty:$HxcVcDMKey1 THEN "1" ELSE $HxcVcDMKey1
    Width    : 8
    Max      : 8

[Field: Hxc Vc F MF1]
    Use      : Name Field
    Storage  : HxcVcDMFld1
    Set as   : $HxcVcDMFld1
    Table    : Hxc Voucher Field List, Not Applicable
    Width    : 28
    Max      : 40

[Line: Hxc Vc F Map2]
    Fields : Medium Prompt, Hxc Vc F MK2, Hxc Vc F MF2
    Local  : Field : Medium Prompt : Set as : "Var 2"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc F MK2]
    Use      : Name Field
    Storage  : HxcVcDMKey2
    Set as   : If $$IsEmpty:$HxcVcDMKey2 THEN "2" ELSE $HxcVcDMKey2
    Width    : 8
    Max      : 8

[Field: Hxc Vc F MF2]
    Use      : Name Field
    Storage  : HxcVcDMFld2
    Set as   : $HxcVcDMFld2
    Table    : Hxc Voucher Field List, Not Applicable
    Width    : 28
    Max      : 40

[Line: Hxc Vc F Map3]
    Fields : Medium Prompt, Hxc Vc F MK3, Hxc Vc F MF3
    Local  : Field : Medium Prompt : Set as : "Var 3"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc F MK3]
    Use      : Name Field
    Storage  : HxcVcDMKey3
    Set as   : If $$IsEmpty:$HxcVcDMKey3 THEN "3" ELSE $HxcVcDMKey3
    Width    : 8
    Max      : 8

[Field: Hxc Vc F MF3]
    Use      : Name Field
    Storage  : HxcVcDMFld3
    Set as   : $HxcVcDMFld3
    Table    : Hxc Voucher Field List, Not Applicable
    Width    : 28
    Max      : 40

[Line: Hxc Vc F Map4]
    Fields : Medium Prompt, Hxc Vc F MK4, Hxc Vc F MF4
    Local  : Field : Medium Prompt : Set as : "Var 4"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc F MK4]
    Use      : Name Field
    Storage  : HxcVcDMKey4
    Set as   : If $$IsEmpty:$HxcVcDMKey4 THEN "4" ELSE $HxcVcDMKey4
    Width    : 8
    Max      : 8

[Field: Hxc Vc F MF4]
    Use      : Name Field
    Storage  : HxcVcDMFld4
    Set as   : $HxcVcDMFld4
    Table    : Hxc Voucher Field List, Not Applicable
    Width    : 28
    Max      : 40

[Line: Hxc Vc F Map5]
    Fields : Medium Prompt, Hxc Vc F MK5, Hxc Vc F MF5
    Local  : Field : Medium Prompt : Set as : "Var 5"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc F MK5]
    Use      : Name Field
    Storage  : HxcVcDMKey5
    Set as   : If $$IsEmpty:$HxcVcDMKey5 THEN "5" ELSE $HxcVcDMKey5
    Width    : 8
    Max      : 8

[Field: Hxc Vc F MF5]
    Use      : Name Field
    Storage  : HxcVcDMFld5
    Set as   : $HxcVcDMFld5
    Table    : Hxc Voucher Field List, Not Applicable
    Width    : 28
    Max      : 40

[Line: Hxc Vc F Media Line]
    Fields : Medium Prompt, Hxc Vc F Media
    Local  : Field : Medium Prompt : Set as : "Media Header"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc F Media]
    Use        : Name Field
    Storage    : HxcVcDraftMedia
    Set as     : If $$IsEmpty:$HxcVcDraftMedia THEN "None" ELSE $HxcVcDraftMedia
    Table      : Hxc Media Export List
    Show Table : Always
    Width      : 40
    Max        : 40

[Line: Hxc Vc F Vch Head]
    Field : Hxc Vc F Vch Head Fld

[Field: Hxc Vc F Vch Head Fld]
    Use       : Name Field
    Set as    : "— Applicable Voucher Types (pick multiple) —"
    Style     : Bold
    FullWidth : Yes
    Skip      : Yes

[Line: Hxc Vc F V1]
    Fields : Medium Prompt, Hxc Vc F DV1
    Local  : Field : Medium Prompt : Set as : "Voucher Type 1"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc F DV1]
    Use      : Name Field
    Storage  : HxcVcDV1
    Set as   : $HxcVcDV1
    Table    : Hxc Voucher Type List, Not Applicable
    Width    : 40
    Max      : 40

[Line: Hxc Vc F V2]
    Fields : Medium Prompt, Hxc Vc F DV2
    Local  : Field : Medium Prompt : Set as : "Voucher Type 2"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc F DV2]
    Use      : Name Field
    Storage  : HxcVcDV2
    Set as   : $HxcVcDV2
    Table    : Hxc Voucher Type List, Not Applicable
    Width    : 40
    Max      : 40

[Line: Hxc Vc F V3]
    Fields : Medium Prompt, Hxc Vc F DV3
    Local  : Field : Medium Prompt : Set as : "Voucher Type 3"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc F DV3]
    Use      : Name Field
    Storage  : HxcVcDV3
