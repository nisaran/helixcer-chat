;; Helixcer Chat — TallyPrime TDL
;; BUILD: 351-dynamic-maps-vtypes
;; Title must show "(build 351)".
;;
;; Create Config flow:
;;   Config Name → Template → Language Enter → fetch →
;;   Preview + up to 4 dynamic var maps → Media →
;;   Dynamic voucher-type rows (Aggregate Repeat) → Settings → Ctrl+A
;; Mapping/preview hidden until fetch. Max 4 template variables.

;; ---------------------------------------------------------------------------
;; Company UDFs
;; ---------------------------------------------------------------------------

[System: UDF]
    HxcWorkspaceIdUDF : String : 25101
    HxcChannelIdUDF   : String : 25102
    HxcApiKeyUDF      : String : 25103
    ;; Saved configs
    HxcVoucherConfigs      : Aggregate : 25110
    HxcVcName              : String    : 25111
    HxcVcTemplateName      : String    : 25112
    HxcVcLanguage          : String    : 25113
    HxcVcVoucherTypes      : String    : 25114
    HxcVcMediaExport       : String    : 25115
    HxcVcAutoSend          : Logical   : 25116
    HxcVcConfirmBeforeSend : Logical   : 25117
    HxcVcVarMapsText       : String    : 25118
    ;; Create/Alter draft buffer (one form, not a repeating name list)
    HxcVcDraftName     : String  : 25120
    HxcVcDraftTemplate : String  : 25121
    HxcVcDraftLang     : String  : 25122
    HxcVcDraftMedia    : String  : 25123
    HxcVcDraftAuto     : Logical : 25124
    HxcVcDraftConfirm  : Logical : 25125
    HxcVcDraftEditKey  : String  : 25126
    HxcVcDMKey1 : String : 25131
    HxcVcDMFld1 : String : 25132
    HxcVcDMKey2 : String : 25133
    HxcVcDMFld2 : String : 25134
    HxcVcDMKey3 : String : 25135
    HxcVcDMFld3 : String : 25136
    HxcVcDMKey4 : String : 25137
    HxcVcDMFld4 : String : 25138
    ;; Dynamic voucher-type picker (Repeat Aggregate; add rows as needed)
    HxcVcDraftVchs    : Aggregate : 25150
    HxcVcDraftVchName : String    : 25151

;; ---------------------------------------------------------------------------
;; Status mirrors + save flag
;; ---------------------------------------------------------------------------

[Variable: HxcSysWorkspaceId]
    Type       : String
    Persistent : Yes

[Variable: HxcSysChannelId]
    Type       : String
    Persistent : Yes

[Variable: HxcSysApiKey]
    Type       : String
    Persistent : Yes

[Variable: HxcWorkspaceName]
    Type       : String
    Persistent : Yes

[Variable: HxcChannelName]
    Type       : String
    Persistent : Yes

[Variable: HxcConnectionStatus]
    Type       : String
    Persistent : Yes

[Variable: HxcVcSaveOk]
    Type : Logical

[Variable: HxcVcFetched]
    Type : Logical

[Variable: HxcVcPreviewText]
    Type : String

[Variable: HxcVcFetchStatus]
    Type : String

[Variable: HxcVcFK1]
    Type : String

[Variable: HxcVcFK2]
    Type : String

[Variable: HxcVcFK3]
    Type : String

[Variable: HxcVcFK4]
    Type : String

[Variable: HxcVcFetchLang]
    Type : String

[System: Variable]
    HxcSysWorkspaceId   : ""
    HxcSysChannelId     : ""
    HxcSysApiKey        : ""
    HxcWorkspaceName    : ""
    HxcChannelName      : ""
    HxcConnectionStatus : ""
    HxcVcSaveOk         : No
    HxcVcFetched        : No
    HxcVcPreviewText    : ""
    HxcVcFetchStatus    : ""
    HxcVcFK1            : ""
    HxcVcFK2            : ""
    HxcVcFK3            : ""
    HxcVcFK4            : ""
    HxcVcFetchLang      : "en"

[System: Formula]
    Hxc Connection Url : "https://api.chat.helixcer.com/api/v1/connection?channelId=" + ##HxcSysChannelId
    Hxc Sys Summary    : "WS=[" + ##HxcSysWorkspaceId + "] CH=[" + ##HxcSysChannelId + "] KeyChars=" + $$StringLength:##HxcSysApiKey
    Hxc Template Url   : "https://api.chat.helixcer.com/api/v1/whatsapp/templates/" + $HxcVcDraftTemplate + "?channelId=" + ##HxcSysChannelId + "&language=" + ##HxcVcFetchLang

;; ---------------------------------------------------------------------------
;; Tables
;; ---------------------------------------------------------------------------

[Collection: Hxc Media Export List]
    List : "None", "Voucher PDF", "Voucher HTML", "Voucher XML", "Voucher Excel"

[Collection: Hxc Voucher Type List]
    Type   : Voucher Type
    Format : $Name, 40

[Collection: Hxc Voucher Field List]
    List : "Voucher Number", "Voucher Date", "Amount", "Reference", "Narration", +
           "Party Name", "Party Mobile", "Party Email", "Company Name", "Guid"

[Collection: Hxc Voucher Config Names]
    Type     : HxcVoucherConfigs : Company
    Child Of : ##SVCurrentCompany
    Format   : $HxcVcName, 40
    Fetch    : HxcVcName, HxcVcTemplateName, HxcVcLanguage, HxcVcVoucherTypes, +
               HxcVcMediaExport, HxcVcAutoSend, HxcVcConfirmBeforeSend, HxcVcVarMapsText
    Title    : "Voucher Configs"

;; ---------------------------------------------------------------------------
;; HTTP (Status)
;; ---------------------------------------------------------------------------

[Report: Hxc Connection Request]
    Form          : Hxc Connection Request
    Export Header : "Authorization: Bearer " + ##HxcSysApiKey
    Export Header : "X-Workspace-Id: " + ##HxcSysWorkspaceId
    Export Header : "Accept: application/json"

[Form: Hxc Connection Request]
    Part : Hxc Connection Request

[Part: Hxc Connection Request]
    Lines : Hxc Connection Request

[Line: Hxc Connection Request]
    Fields : Hxc Connection Request

[Field: Hxc Connection Request]
    Use    : Name Field
    Set as : ""
    Skip   : Yes

[Function: Hxc Apply Connection Response]
    Variable : Platform : String
    01 : SET : HxcWorkspaceName : ""
    02 : SET : HxcChannelName : ""
    03 : SET : HxcConnectionStatus : "Could not fetch. Check IDs and API Key."
    04 : WALK COLLECTION : Parameter Collection
    05 :    IF : NOT $$IsEmpty:$workspaceName
    06 :       SET : Platform : $platformLabel
    07 :       IF : $$IsEmpty:##Platform
    08 :          SET : Platform : $connectorType
    09 :       END IF
    10 :       IF : $$IsEmpty:##Platform
    11 :          SET : Platform : "Channel"
    12 :       END IF
    13 :       SET : HxcWorkspaceName : $workspaceName
    14 :       SET : HxcChannelName : $channelName + " (" + ##Platform + ")"
    15 :       SET : HxcConnectionStatus : "Connected"
    16 :    END IF
    17 : END WALK
    18 : RETURN : Yes

[Function: Hxc Sync From Company]
    01 : IF : NOT $$IsEmpty:$HxcWorkspaceIdUDF:Company:##SVCurrentCompany
    02 :    SET : HxcSysWorkspaceId : $HxcWorkspaceIdUDF:Company:##SVCurrentCompany
    03 : END IF
    04 : IF : NOT $$IsEmpty:$HxcChannelIdUDF:Company:##SVCurrentCompany
    05 :    SET : HxcSysChannelId : $HxcChannelIdUDF:Company:##SVCurrentCompany
    06 : END IF
    07 : IF : NOT $$IsEmpty:$HxcApiKeyUDF:Company:##SVCurrentCompany
    08 :    SET : HxcSysApiKey : $HxcApiKeyUDF:Company:##SVCurrentCompany
    09 : END IF
    10 : RETURN : Yes

[Function: Hxc Fetch Connection]
    01 : CALL : Hxc Sync From Company
    02 : IF : $$IsEmpty:##HxcSysWorkspaceId OR $$IsEmpty:##HxcSysChannelId OR $$IsEmpty:##HxcSysApiKey
    03 :    SET : HxcConnectionStatus : "Not ready. " + @@HxcSysSummary + "  Accept API Settings with Ctrl+A first."
    04 :    RETURN : No
    05 : END IF
    06 : SET : HxcWorkspaceName : ""
    07 : SET : HxcChannelName : ""
    08 : SET : HxcConnectionStatus : "Checking..."
    09 : Start Progress : 1 : "Helixcer Chat" : "Connection status" : "Fetching workspace and channel"
    10 : HTTP Request : @@HxcConnectionUrl : GET : JSON : UTF8 : Hxc Connection Request : Hxc Apply Connection Response
    11 : End Progress
    12 : IF : $$IsEmpty:##HxcWorkspaceName
    13 :    IF : ##HxcConnectionStatus = "Checking..."
    14 :       SET : HxcConnectionStatus : "Could not fetch. Check IDs and API Key."
    15 :    END IF
    16 : END IF
    17 : RETURN : Yes

[Function: Hxc Show Status]
    01 : CALL : Hxc Fetch Connection
    02 : Msg Box : "Helixcer Connection Status" : ##HxcConnectionStatus
    03 : IF : NOT $$IsEmpty:##HxcWorkspaceName
    04 :    Msg Box : "Workspace" : ##HxcWorkspaceName
    05 :    Msg Box : "Channel" : ##HxcChannelName
    06 : END IF
    07 : RETURN : Yes

[Function: Hxc Clear Fetch Vars]
    01 : SET : HxcVcFetched : No
    02 : SET : HxcVcPreviewText : ""
    03 : SET : HxcVcFetchStatus : ""
    04 : SET : HxcVcFK1 : ""
    05 : SET : HxcVcFK2 : ""
    06 : SET : HxcVcFK3 : ""
    07 : SET : HxcVcFK4 : ""
    08 : RETURN : Yes

[Function: Hxc Apply Template Response]
    Variable : I : Number
    Variable : CompType : String
    01 : SET : I : 0
    02 : SET : HxcVcFetched : No
    03 : SET : HxcVcPreviewText : ""
    04 : SET : HxcVcFK1 : ""
    05 : SET : HxcVcFK2 : ""
    06 : SET : HxcVcFK3 : ""
    07 : SET : HxcVcFK4 : ""
    08 : SET : HxcVcFetchStatus : "Template not found or empty response."
    09 : WALK COLLECTION : Parameter Collection
    10 :    WALK COLLECTION : items
    11 :       WALK COLLECTION : components
    12 :          SET : CompType : $type
    13 :          IF : ##CompType = "body" OR ##CompType = "BODY" OR ##CompType = "Body"
    14 :             IF : NOT $$IsEmpty:$text
    15 :                SET : HxcVcPreviewText : $text
    16 :             END IF
    17 :          END IF
    18 :       END WALK
    19 :       WALK COLLECTION : variables
    20 :          SET : I : ##I + 1
    21 :          IF : ##I = 1
    22 :             SET : HxcVcFK1 : $key
    23 :          END IF
    24 :          IF : ##I = 2
    25 :             SET : HxcVcFK2 : $key
    26 :          END IF
    27 :          IF : ##I = 3
    28 :             SET : HxcVcFK3 : $key
    29 :          END IF
    30 :          IF : ##I = 4
    31 :             SET : HxcVcFK4 : $key
    32 :          END IF
    33 :          ;; Max 4 mappable variables; ignore further keys
    34 :       END WALK
    35 :       SET : HxcVcFetched : Yes
    36 :       IF : ##I > 4
    37 :          SET : HxcVcFetchStatus : "Template loaded. Mapping first 4 variables only."
    38 :       ELSE
    39 :          SET : HxcVcFetchStatus : "Template loaded."
    40 :       END IF
    41 :    END WALK
    42 : END WALK
    43 : IF : ##HxcVcFetched
    44 :    IF : $$IsEmpty:##HxcVcPreviewText
    45 :       SET : HxcVcPreviewText : "(No body text in template)"
    46 :    END IF
    47 : END IF
    48 : RETURN : Yes

[Function: Hxc Fetch Template]
    01 : CALL : Hxc Sync From Company
    02 : CALL : Hxc Clear Fetch Vars
    03 : IF : $$IsEmpty:##HxcSysWorkspaceId OR $$IsEmpty:##HxcSysChannelId OR $$IsEmpty:##HxcSysApiKey
    04 :    SET : HxcVcFetchStatus : "Save API Settings (Ctrl+A) before fetching a template."
    05 :    Msg Box : "Helixcer Template" : ##HxcVcFetchStatus
    06 :    RETURN : No
    07 : END IF
    08 : IF : $$IsEmpty:$HxcVcDraftTemplate
    09 :    SET : HxcVcFetchStatus : "Enter Template Name first."
    10 :    Msg Box : "Helixcer Template" : ##HxcVcFetchStatus
    11 :    RETURN : No
    12 : END IF
    13 : IF : $$IsEmpty:##HxcVcFetchLang
    14 :    SET : HxcVcFetchLang : "en"
    15 : END IF
    16 : SET : HxcVcFetchStatus : "Fetching..."
    17 : Start Progress : 1 : "Helixcer Chat" : "Template" : "Fetching template details"
    18 : HTTP Request : @@HxcTemplateUrl : GET : JSON : UTF8 : Hxc Connection Request : Hxc Apply Template Response
    19 : End Progress
    20 : IF : NOT ##HxcVcFetched
    21 :    IF : $$IsEmpty:##HxcVcFetchStatus
    22 :       SET : HxcVcFetchStatus : "Could not fetch template. Check name, language, and API Settings."
    23 :    END IF
    24 :    Msg Box : "Helixcer Template" : ##HxcVcFetchStatus
    25 :    RETURN : No
    26 : END IF
    27 : SET VALUE : HxcVcDMFld1 : ""
    28 : SET VALUE : HxcVcDMFld2 : ""
    29 : SET VALUE : HxcVcDMFld3 : ""
    30 : SET VALUE : HxcVcDMFld4 : ""
    31 : Msg Box : "Helixcer Template" : ##HxcVcFetchStatus
    32 : RETURN : Yes

;; ---------------------------------------------------------------------------
;; Pack helpers + commit draft → Aggregate config
;; ---------------------------------------------------------------------------

[Function: Hxc Pack Maps]
    Variable : S : String
    01 : SET : S : ""
    02 : IF : NOT $$IsEmpty:##HxcVcFK1
    03 :    SET : S : ##S + ##HxcVcFK1 + "=" + $HxcVcDMFld1 + ";"
    04 : END IF
    05 : IF : NOT $$IsEmpty:##HxcVcFK2
    06 :    SET : S : ##S + ##HxcVcFK2 + "=" + $HxcVcDMFld2 + ";"
    07 : END IF
    08 : IF : NOT $$IsEmpty:##HxcVcFK3
    09 :    SET : S : ##S + ##HxcVcFK3 + "=" + $HxcVcDMFld3 + ";"
    10 : END IF
    11 : IF : NOT $$IsEmpty:##HxcVcFK4
    12 :    SET : S : ##S + ##HxcVcFK4 + "=" + $HxcVcDMFld4 + ";"
    13 : END IF
    14 : RETURN : ##S

[Function: Hxc Pack Vouchers]
    Variable : S : String
    01 : SET : S : ""
    02 : WALK COLLECTION : HxcVcDraftVchs
    03 :    IF : NOT $$IsEmpty:$HxcVcDraftVchName
    04 :       SET : S : ##S + $HxcVcDraftVchName + ","
    05 :    END IF
    06 : END WALK
    07 : RETURN : ##S

[Function: Hxc Clear Draft Vchs]
    01 : WALK COLLECTION : HxcVcDraftVchs
    02 :    SET VALUE : HxcVcDraftVchName : ""
    03 : END WALK
    04 : RETURN : Yes

[Function: Hxc Vc Clear Draft]
    01 : CALL : Hxc Clear Fetch Vars
    02 : CALL : Hxc Clear Draft Vchs
    03 : SET VALUE : HxcVcDraftName : ""
    04 : SET VALUE : HxcVcDraftTemplate : ""
    05 : SET VALUE : HxcVcDraftLang : "en"
    06 : SET VALUE : HxcVcDraftMedia : "None"
    07 : SET VALUE : HxcVcDraftAuto : No
    08 : SET VALUE : HxcVcDraftConfirm : No
    09 : SET VALUE : HxcVcDraftEditKey : ""
    10 : SET VALUE : HxcVcDMKey1 : ""
    11 : SET VALUE : HxcVcDMFld1 : ""
    12 : SET VALUE : HxcVcDMKey2 : ""
    13 : SET VALUE : HxcVcDMFld2 : ""
    14 : SET VALUE : HxcVcDMKey3 : ""
    15 : SET VALUE : HxcVcDMFld3 : ""
    16 : SET VALUE : HxcVcDMKey4 : ""
    17 : SET VALUE : HxcVcDMFld4 : ""
    18 : RETURN : Yes

[Function: Hxc Vc Commit Draft]
    Variable : Maps : String
    Variable : Vchs : String
    Variable : EditKey : String
    01 : SET : HxcVcSaveOk : No
    02 : IF : $$IsEmpty:$HxcVcDraftName
    03 :    Msg Box : "Helixcer Voucher Config" : "Config Name is required."
    04 :    RETURN : No
    05 : END IF
    06 : IF : $$IsEmpty:$HxcVcDraftTemplate
    07 :    Msg Box : "Helixcer Voucher Config" : "Template Name is required."
    08 :    RETURN : No
    09 : END IF
    10 : IF : NOT ##HxcVcFetched
    11 :    Msg Box : "Helixcer Voucher Config" : "Fetch the template first (Enter on Language)."
    12 :    RETURN : No
    13 : END IF
    14 : SET : Maps : $$HxcPackMaps
    15 : SET : Vchs : $$HxcPackVouchers
    16 : SET : EditKey : $HxcVcDraftEditKey
    17 : IF : NOT $$IsEmpty:##EditKey
    18 :    WALK COLLECTION : HxcVoucherConfigs
    19 :       IF : $HxcVcName = ##EditKey
    20 :          SET TARGET
    21 :          SET VALUE : HxcVcName : $HxcVcDraftName
    22 :          SET VALUE : HxcVcTemplateName : $HxcVcDraftTemplate
    23 :          SET VALUE : HxcVcLanguage : $HxcVcDraftLang
    24 :          SET VALUE : HxcVcMediaExport : $HxcVcDraftMedia
    25 :          SET VALUE : HxcVcAutoSend : $HxcVcDraftAuto
    26 :          SET VALUE : HxcVcConfirmBeforeSend : $HxcVcDraftConfirm
    27 :          SET VALUE : HxcVcVarMapsText : ##Maps
    28 :          SET VALUE : HxcVcVoucherTypes : ##Vchs
    29 :          SET TARGET : ..
    30 :       END IF
    31 :    END WALK
    32 : ELSE
    33 :    INSERT COLLECTION OBJECT : HxcVoucherConfigs
    34 :    SET VALUE : HxcVcName : $HxcVcDraftName
    35 :    SET VALUE : HxcVcTemplateName : $HxcVcDraftTemplate
    36 :    SET VALUE : HxcVcLanguage : $HxcVcDraftLang
    37 :    SET VALUE : HxcVcMediaExport : $HxcVcDraftMedia
    38 :    SET VALUE : HxcVcAutoSend : $HxcVcDraftAuto
    39 :    SET VALUE : HxcVcConfirmBeforeSend : $HxcVcDraftConfirm
    40 :    SET VALUE : HxcVcVarMapsText : ##Maps
    41 :    SET VALUE : HxcVcVoucherTypes : ##Vchs
    42 :    SET TARGET : ..
    43 : END IF
    44 : CALL : Hxc Vc Clear Draft
    45 : SET : HxcVcSaveOk : Yes
    46 : Msg Box : "Helixcer Voucher Config" : "Config saved."
    47 : RETURN : Yes

;; ---------------------------------------------------------------------------
;; Menu
;; ---------------------------------------------------------------------------

[#Menu: Gateway of Tally]
    Add : Key Item : Before : @@LOCQuit : Helixcer Chat : H : Menu : Helixcer Chat Menu

[Menu: Helixcer Chat Menu]
    Title    : "Helixcer Chat"
    Key Item : API Settings   : S : Alter : Helixcer API Settings
    Key Item : Voucher Config : V : Menu  : Helixcer Voucher Config Menu
    Key Item : Status         : T : Call  : Hxc Show Status
    Key Item : About          : A : Display : Helixcer Chat About
    Key Item : Back           : B : Menu  : Gateway of Tally

[Menu: Helixcer Voucher Config Menu]
    Title    : "Voucher Config"
    Key Item : Create Config : C : Alter : Helixcer Voucher Config Create
    Key Item : Alter Config  : A : Alter : Helixcer Voucher Config Alter
    Key Item : List Configs  : L : Alter : Helixcer Voucher Config List
    Key Item : Back          : B : Menu  : Helixcer Chat Menu

;; ---------------------------------------------------------------------------
;; API Settings
;; ---------------------------------------------------------------------------

[Report: Helixcer API Settings]
    Form   : Helixcer API Settings
    Title  : "API Settings"
    Object : Company

[Form: Helixcer API Settings]
    Part   : Helixcer API Settings
    Button : Form Accept, Form Cancel

[Part: Helixcer API Settings]
    Lines  : Hxc Api Settings Title, +
             Hxc Workspace Id Line, Hxc Channel Id Line, Hxc Api Key Line, +
             Hxc Save Hint Line
    Scroll : Vertical

[Line: Hxc Api Settings Title]
    Field : Hxc Api Settings Title

[Field: Hxc Api Settings Title]
    Use       : Name Field
    Set as    : "Helixcer Chat — API Settings (build 351)"
    Style     : Bold
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

[Line: Hxc Workspace Id Line]
    Fields : Medium Prompt, HxcWorkspaceIdFld
    Local  : Field : Medium Prompt : Set as : "Workspace ID"
    Local  : Field : Medium Prompt : Width  : 22

[Field: HxcWorkspaceIdFld]
    Use      : Name Field
    Storage  : HxcWorkspaceIdUDF
    Set as   : $HxcWorkspaceIdUDF
    Width    : 50
    Max      : 64
    On       : Accept : Yes : SET : HxcSysWorkspaceId : $Value
    On       : Accept : Yes : Field Accept

[Line: Hxc Channel Id Line]
    Fields : Medium Prompt, HxcChannelIdFld
    Local  : Field : Medium Prompt : Set as : "Channel ID"
    Local  : Field : Medium Prompt : Width  : 22

[Field: HxcChannelIdFld]
    Use      : Name Field
    Storage  : HxcChannelIdUDF
    Set as   : $HxcChannelIdUDF
    Width    : 50
    Max      : 64
    On       : Accept : Yes : SET : HxcSysChannelId : $Value
    On       : Accept : Yes : Field Accept

[Line: Hxc Api Key Line]
    Fields : Medium Prompt, HxcApiKeyFld
    Local  : Field : Medium Prompt : Set as : "API Key"
    Local  : Field : Medium Prompt : Width  : 22

[Field: HxcApiKeyFld]
    Use      : Name Field
    Storage  : HxcApiKeyUDF
    Set as   : $HxcApiKeyUDF
    Width    : 50
    Max      : 200
    On       : Accept : Yes : SET : HxcSysApiKey : $Value
    On       : Accept : Yes : Field Accept

[Line: Hxc Save Hint Line]
    Field : Hxc Save Hint

[Field: Hxc Save Hint]
    Use       : Name Field
    Set as    : "Tab all fields, then Ctrl+A to Accept."
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

;; ---------------------------------------------------------------------------
;; Shared Create/Alter form body (draft fields — single form, not name list)
;; ---------------------------------------------------------------------------

[Part: Hxc Vc Form Body]
    Lines  : Hxc Vc F Name Line, Hxc Vc F Template Line, Hxc Vc F Lang Line, Hxc Vc F Fetch Hint Line, +
             Hxc Vc F Prev Head, Hxc Vc F Prev Body, +
             Hxc Vc F Map Head, +
             Hxc Vc F Map1, Hxc Vc F Map2, Hxc Vc F Map3, Hxc Vc F Map4, +
             Hxc Vc F Media Line
    Scroll : Vertical

;; Dynamic voucher types — add as many rows as needed (blank row to stop)
[Part: Hxc Vc Form Vch Part]
    Lines    : Hxc Vc F Vch Head, Hxc Vc F Vch Data
    Repeat   : Hxc Vc F Vch Data : HxcVcDraftVchs
    Break On : $$IsEmpty:$HxcVcDraftVchName
    Scroll   : Vertical

[Part: Hxc Vc Form Settings Part]
    Lines : Hxc Vc F Auto Line, Hxc Vc F Confirm Line

[Line: Hxc Vc F Name Line]
    Fields : Medium Prompt, Hxc Vc F Name
    Local  : Field : Medium Prompt : Set as : "Config Name"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc F Name]
    Use      : Name Field
    Storage  : HxcVcDraftName
    Set as   : $HxcVcDraftName
    Width    : 40
    Max      : 60

[Line: Hxc Vc F Template Line]
    Fields : Medium Prompt, Hxc Vc F Template
    Local  : Field : Medium Prompt : Set as : "Template Name"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc F Template]
    Use      : Name Field
    Storage  : HxcVcDraftTemplate
    Set as   : $HxcVcDraftTemplate
    Width    : 40
    Max      : 80
    On       : Accept : Yes : CALL : Hxc Clear Fetch Vars
    On       : Accept : Yes : Field Accept

[Line: Hxc Vc F Lang Line]
    Fields : Medium Prompt, Hxc Vc F Lang
    Local  : Field : Medium Prompt : Set as : "Language"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc F Lang]
    Use      : Name Field
    Storage  : HxcVcDraftLang
    Set as   : If $$IsEmpty:$HxcVcDraftLang THEN "en" ELSE $HxcVcDraftLang
    Width    : 16
    Max      : 16
    ;; Enter on Language fetches template → preview + variable rows
    On       : Accept : Yes : SET : HxcVcFetchLang : $Value
    On       : Accept : Yes : CALL : Hxc Fetch Template
    On       : Accept : Yes : Field Accept

[Line: Hxc Vc F Fetch Hint Line]
    Field : Hxc Vc F Fetch Hint

[Field: Hxc Vc F Fetch Hint]
    Use       : Name Field
    Set as    : "Enter Template Name + Language, then Enter on Language to fetch."
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes
    Inactive  : ##HxcVcFetched

[Line: Hxc Vc F Prev Head]
    Field : Hxc Vc F Prev Head Fld

[Field: Hxc Vc F Prev Head Fld]
    Use       : Name Field
    Set as    : "— Template Preview —"
    Style     : Bold
    FullWidth : Yes
    Skip      : Yes
    Inactive  : NOT ##HxcVcFetched

[Line: Hxc Vc F Prev Body]
    Field : Hxc Vc F Prev Body Fld

[Field: Hxc Vc F Prev Body Fld]
    Use        : Name Field
    Set as     : ##HxcVcPreviewText
    Set Always : Yes
    FullWidth  : Yes
    Skip       : Yes
    Inactive   : NOT ##HxcVcFetched

[Line: Hxc Vc F Map Head]
    Field : Hxc Vc F Map Head Fld

[Field: Hxc Vc F Map Head Fld]
    Use       : Name Field
    Set as    : "— Variable Mapping (max 4; only fetched vars) —"
    Style     : Bold
    FullWidth : Yes
    Skip      : Yes
    Inactive  : NOT ##HxcVcFetched

[Line: Hxc Vc F Map1]
    Fields : Hxc Vc F MP1, Hxc Vc F MK1, Hxc Vc F MF1

[Field: Hxc Vc F MP1]
    Use        : Name Field
    Set as     : "Map Var"
    Skip       : Yes
    Width      : 22
    Inactive   : NOT ##HxcVcFetched OR $$IsEmpty:##HxcVcFK1

