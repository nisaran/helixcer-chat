[System: Formula]
    HxcVtSetupEnabled : If $$IsEmpty:#HxcVtEnableInput Then $HxcVtEnabled Else #HxcVtEnableInput
    HxcVtCurrentMasterName : If NOT $$IsEmpty:$Name Then $Name Else If NOT $$IsEmpty:($$ReportObject:$Name) Then $$ReportObject:$Name Else $$Owner:$Name
    HxcVtOnSelectedMaster : ##HxcVtEditing AND NOT ##HxcReminderEditing AND NOT $$IsEmpty:##HxcVtMasterName AND @@HxcVtCurrentMasterName = ##HxcVtMasterName
    HxcVtWrongMaster : "Reopen Helixcer Chat from the Voucher Type you want to edit."
    HxcVtFetchRequired : "Fetch the template before accepting Helixcer Chat settings."
    HxcVtCustomRequired : "Enter a value for each variable mapped to Custom Value."

;; Prepare the draft before the subform evaluates its Invisible attributes.
[Function: Hxc Prepare Voucher Type Settings]
    Parameter : SelectedMaster : String
    Returns : Logical
    01 : IF : $$IsEmpty:##SelectedMaster
    02 :    RETURN : No
    03 : END IF
    05 : CALL : Hxc Vt Load Settings : ##SelectedMaster
    07 : RETURN : Yes

[Function: Hxc Vt Load Settings]
    Parameter : SelectedMaster : String
    List Variable : HxcVcVoucherDraft : String
    000 : SET : HxcReminderEditing : No
    00 : SET : HxcVtMasterName : ##SelectedMaster
    01 : CALL : Hxc Vc Clear Draft
    02 : SET : HxcVtEditing : Yes
    03 : CALL : Hxc Vt Read Selected Settings
    04 : SET : HxcVcDraftTemplate : ##HxcVtStoredTemplate
    041 : SET : HxcVtWhatsAppOn : ##HxcVtStoredWhatsAppEnabled = "Yes" OR ($$IsEmpty:##HxcVtStoredWhatsAppEnabled AND NOT $$IsEmpty:##HxcVtStoredTemplate)
    05 : SET : HxcVcDraftLang : If $$IsEmpty:##HxcVtStoredLanguage THEN "en" ELSE ##HxcVtStoredLanguage
    06 : SET : HxcVcDraftMedia : If $$IsEmpty:##HxcVtStoredMedia THEN "None" ELSE ##HxcVtStoredMedia
    10 : SET : HxcVcDraftAuto : ##HxcVtStoredAuto
    11 : SET : HxcVcAutoSendEnabled : ##HxcVtStoredAuto
    12 : SET : HxcVcDraftConfirm : ##HxcVtStoredConfirm
    13 : IF : NOT $$IsEmpty:##HxcVtStoredTemplate
    14 :    SET : HxcVcFetchName : ##HxcVtStoredTemplate
    15 :    SET : HxcVcFetchLang : ##HxcVcDraftLang
    16 :    SET : HxcVtSavedSlot : 0
    17 :    SET : HxcVtReadingSavedRows : Yes
    180 :    SET : HxcVcHeaderKind : ##HxcVtStoredHeaderKind
    18 :    IF : $$IsEmpty:##HxcVcHeaderKind AND NOT $$IsEmpty:##HxcVtStoredMedia AND NOT (##HxcVtStoredMedia = "None")
    19 :       SET : HxcVcHeaderKind : "media"
    20 :    END IF
    21 :    CALL : Hxc Vt Restore Mappings
    22 :    SET : HxcVtReadingSavedRows : No
    23 :    SET : HxcVtSavedRowsReady : Yes
    24 : END IF
    25 : RETURN : Yes

[Collection: Hxc Vt Selected Settings]
    Type   : Voucher Type
    Fetch  : Name, HxcVtWhatsAppEnabled, HxcVtTemplate, HxcVtLanguage, HxcVtMedia, HxcVtAuto, HxcVtConfirm, HxcVtMaps, HxcVtPreview, HxcVtHeaderKind, +
             HxcVtCustom0, HxcVtCustom1, HxcVtCustom2, HxcVtCustom3, HxcVtCustom4, HxcVtCustom5, HxcVtCustom6, HxcVtCustom7, HxcVtCustom8, +
               HxcVtCustom9, HxcVtCustom10, HxcVtCustom11, HxcVtCustom12, HxcVtCustom13, HxcVtCustom14, HxcVtCustom15, HxcVtCustom16

[System: Formula]
    HxcVtShowMappings : ##HxcVcFetched OR ((##HxcVtEditing OR ##HxcReminderEditing) AND ##HxcVtSavedRowsReady)
    HxcVtShowingSavedRows : ##HxcVtEditing AND ##HxcVtSavedRowsReady AND NOT ##HxcVcFetched

[Function: Hxc Vt Read Selected Settings]
    01 : SET : HxcVcSavedMaps : $HxcVtMaps:VoucherType:##HxcVtMasterName
    02 : SET : HxcVcPreviewText : $HxcVtPreview:VoucherType:##HxcVtMasterName
    03 : SET : HxcVtStoredWhatsAppEnabled : $HxcVtWhatsAppEnabled:VoucherType:##HxcVtMasterName
    04 : SET : HxcVtStoredTemplate : $HxcVtTemplate:VoucherType:##HxcVtMasterName
    05 : SET : HxcVtStoredLanguage : $HxcVtLanguage:VoucherType:##HxcVtMasterName
    06 : SET : HxcVtStoredMedia : $HxcVtMedia:VoucherType:##HxcVtMasterName
    07 : SET : HxcVtStoredHeaderKind : $HxcVtHeaderKind:VoucherType:##HxcVtMasterName
    08 : SET : HxcVtStoredAuto : $HxcVtAuto:VoucherType:##HxcVtMasterName
    09 : SET : HxcVtStoredConfirm : $HxcVtConfirm:VoucherType:##HxcVtMasterName
    10 : SET : HxcVtStoredCustom0 : $HxcVtCustom0:VoucherType:##HxcVtMasterName
    11 : SET : HxcVtStoredCustom1 : $HxcVtCustom1:VoucherType:##HxcVtMasterName
    12 : SET : HxcVtStoredCustom2 : $HxcVtCustom2:VoucherType:##HxcVtMasterName
    13 : SET : HxcVtStoredCustom3 : $HxcVtCustom3:VoucherType:##HxcVtMasterName
    14 : SET : HxcVtStoredCustom4 : $HxcVtCustom4:VoucherType:##HxcVtMasterName
    15 : SET : HxcVtStoredCustom5 : $HxcVtCustom5:VoucherType:##HxcVtMasterName
    16 : SET : HxcVtStoredCustom6 : $HxcVtCustom6:VoucherType:##HxcVtMasterName
    17 : SET : HxcVtStoredCustom7 : $HxcVtCustom7:VoucherType:##HxcVtMasterName
    18 : SET : HxcVtStoredCustom8 : $HxcVtCustom8:VoucherType:##HxcVtMasterName
    19 : SET : HxcVtStoredCustom9 : $HxcVtCustom9:VoucherType:##HxcVtMasterName
    20 : SET : HxcVtStoredCustom10 : $HxcVtCustom10:VoucherType:##HxcVtMasterName
    21 : SET : HxcVtStoredCustom11 : $HxcVtCustom11:VoucherType:##HxcVtMasterName
    22 : SET : HxcVtStoredCustom12 : $HxcVtCustom12:VoucherType:##HxcVtMasterName
    23 : SET : HxcVtStoredCustom13 : $HxcVtCustom13:VoucherType:##HxcVtMasterName
    24 : SET : HxcVtStoredCustom14 : $HxcVtCustom14:VoucherType:##HxcVtMasterName
    25 : SET : HxcVtStoredCustom15 : $HxcVtCustom15:VoucherType:##HxcVtMasterName
    26 : SET : HxcVtStoredCustom16 : $HxcVtCustom16:VoucherType:##HxcVtMasterName

[Function: Hxc Vt Close Settings]
    00 : SET : HxcVtMasterName : ""
    01 : SET : HxcVtEditing : No
    011 : SET : HxcVtWhatsAppOn : No
    02 : SET : HxcVcSavedMaps : ""
    03 : CALL : Hxc Vc Clear Draft

[Function: Hxc Vt Restore Mappings]
    Variable : StoredLanguage : String
    00 : SET : StoredLanguage : If $$IsEmpty:##HxcVtStoredLanguage THEN "en" ELSE ##HxcVtStoredLanguage
    01 : IF : NOT (##HxcVtStoredTemplate = ##HxcVcFetchName AND ##StoredLanguage = ##HxcVcFetchLang)
    02 :    RETURN : Yes
    03 : END IF
    031 : IF : ##HxcVcHeaderKind = "media" AND NOT $$IsEmpty:##HxcVtStoredMedia
    032 :    SET : HxcVcDraftMedia : ##HxcVtStoredMedia
    033 : END IF
    05 : CALL : Hxc Apply Saved Maps
    06 : SET : HxcVcDraftCustom0 : ##HxcVtStoredCustom0
    10 : IF : ##HxcVcFC1 = "button"
    11 :    SET : HxcVcButtonCustom1 : ##HxcVtStoredCustom1
    12 : ELSE
    13 :    SET : HxcVcDraftCustom1 : ##HxcVtStoredCustom1
    14 : END IF
    20 : IF : ##HxcVcFC2 = "button"
    21 :    SET : HxcVcButtonCustom2 : ##HxcVtStoredCustom2
    22 : ELSE
    23 :    SET : HxcVcDraftCustom2 : ##HxcVtStoredCustom2
    24 : END IF
    30 : IF : ##HxcVcFC3 = "button"
    31 :    SET : HxcVcButtonCustom3 : ##HxcVtStoredCustom3
    32 : ELSE
    33 :    SET : HxcVcDraftCustom3 : ##HxcVtStoredCustom3
    34 : END IF
    40 : IF : ##HxcVcFC4 = "button"
    41 :    SET : HxcVcButtonCustom4 : ##HxcVtStoredCustom4
    42 : ELSE
    43 :    SET : HxcVcDraftCustom4 : ##HxcVtStoredCustom4
    44 : END IF
    50 : SET : HxcVcDraftCustom5 : ##HxcVtStoredCustom5
    60 : SET : HxcVcDraftCustom6 : ##HxcVtStoredCustom6
    70 : SET : HxcVcDraftCustom7 : ##HxcVtStoredCustom7
    80 : SET : HxcVcDraftCustom8 : ##HxcVtStoredCustom8
    709 : SET : HxcVcDraftCustom9 : ##HxcVtStoredCustom9
    710 : SET : HxcVcDraftCustom10 : ##HxcVtStoredCustom10
    711 : SET : HxcVcDraftCustom11 : ##HxcVtStoredCustom11
    712 : SET : HxcVcDraftCustom12 : ##HxcVtStoredCustom12
    713 : SET : HxcVcDraftCustom13 : ##HxcVtStoredCustom13
    714 : SET : HxcVcDraftCustom14 : ##HxcVtStoredCustom14
    715 : SET : HxcVcDraftCustom15 : ##HxcVtStoredCustom15
    716 : SET : HxcVcDraftCustom16 : ##HxcVtStoredCustom16
    90 : RETURN : Yes




[Part: Hxc Vt Mapping Layout]
    Invisible : NOT ##HxcVtWhatsAppOn
    Parts      : Hxc Vt Mapping Panel, Hxc Vt Preview Panel
    Horizontal : Yes
    Space Top  : 0.35
    Space Bottom : 0.35

[Part: Hxc Vt Mapping Panel]
    Use          : Hxc Vc Form Left Col
    Add : Lines : At End : Hxc Contact Mapping Heading, Hxc Contact Mapping Name, Hxc Contact Mapping Company, Hxc Contact Mapping Tag
    Background   : Hxc Vt Panel
    Border       : Hxc Vt Panel Border
    Space Bottom : 0.25

[Line: Hxc Contact Mapping Heading]
    Field : Hxc Contact Mapping Heading

[Field: Hxc Contact Mapping Heading]
    Use : Hxc Vt Sending Heading Text
    Set as : "Contact Mapping (optional)"

[Line: Hxc Contact Mapping Name]
    Fields : Medium Prompt, Hxc Contact Mapping Name
    Local : Field : Medium Prompt : Set as : "Name"

[Field: Hxc Contact Mapping Name]
    Use : Hxc Contact Mapping Input
    Storage : HxcVtContactNameMap
    Option : Hxc Reminder Contact Name Storage : ##HxcReminderEditing

[!Field: Hxc Reminder Contact Name Storage]
    Storage : HxcReminderContactNameMap

[Line: Hxc Contact Mapping Company]
    Fields : Medium Prompt, Hxc Contact Mapping Company
    Local : Field : Medium Prompt : Set as : "Company"

[Field: Hxc Contact Mapping Company]
    Use : Hxc Contact Mapping Input
    Storage : HxcVtContactCompanyMap
    Option : Hxc Reminder Contact Company Storage : ##HxcReminderEditing

[!Field: Hxc Reminder Contact Company Storage]
    Storage : HxcReminderContactCompanyMap

[Line: Hxc Contact Mapping Tag]
    Fields : Medium Prompt, Hxc Contact Mapping Tag
    Local : Field : Medium Prompt : Set as : "Tag"

[Field: Hxc Contact Mapping Tag]
    Use : Hxc Contact Mapping Input
    Storage : HxcVtContactTagMap
    Option : Hxc Reminder Contact Tag Storage : ##HxcReminderEditing

[!Field: Hxc Reminder Contact Tag Storage]
    Storage : HxcReminderContactTagMap

[Field: Hxc Contact Mapping Input]
    Use : Name Field
    Table : Hxc Contact Voucher Fields, Not Applicable
    Option : Hxc Ledger Mapping Table : ##HxcReminderEditing
    Width : 30
    Max : 240

[Collection: Hxc Contact Voucher Fields]
    Use : Hxc Voucher Field List
    Add : Filter : Hxc Contact Mapping Field Allowed

[System: Formula]
    Hxc Contact Mapping Field Allowed : $Name <> @@HxcCustomValueLabel

[Part: Hxc Vt Preview Panel]
    Use          : Hxc Vc Form Preview Part
    Background   : Hxc Vt Preview Surface
    Border       : Hxc Vt Panel Border
    Space Bottom : 0.25

[Part: Hxc Vt Sending Panel]
    Invisible : NOT ##HxcVtWhatsAppOn
    Lines      : Hxc Vt Sending Heading, Hxc Vc F Auto Line, Hxc Vc F Confirm Line
    Background : Hxc Vt Panel
    Border     : Hxc Vt Panel Border
    Space Top  : 0.2

[Line: Hxc Vt Sending Heading]
    Field : Hxc Vt Sending Heading Text
    Invisible : NOT @@HxcVtShowMappings

[Field: Hxc Vt Sending Heading Text]
    Use        : Name Field
    Set as     : "Sending"
    Skip       : Yes
    Full Width : Yes
    Style      : Bold
    Color      : Hxc Vt Accent
    Background : Hxc Vt Section Band

[!Field: Hxc Vt Section Heading Style]
    Color      : Hxc Vt Accent
    Background : Hxc Vt Section Band

[!Field: Hxc Vt Column Heading Style]
    Style      : Hxc Vt Mapping Text Small
    Color      : Hxc Vt Accent
    Background : Hxc Vt Preview Surface

[Border: Hxc Vt Panel Border]
    Top    : Thin
    Bottom : Thin
    Color  : Hxc Vt Divider

[Color: Hxc Vt Page]
    RGB : 244, 247, 250

[Color: Hxc Vt Panel]
    RGB : 252, 253, 254

[Color: Hxc Vt Preview Surface]
    RGB : 238, 246, 248

[Color: Hxc Vt Section Band]
    RGB : 218, 233, 239

[Color: Hxc Vt Accent]
    RGB : 22, 68, 86

[Color: Hxc Vt Divider]
    RGB : 198, 215, 224


[System: Formula]
    HxcPreviewDisplayText : If ##HxcSendPreviewOpen Then ##HxcSendPreviewText Else If @@HxcVtShowingSavedRows AND $$IsEmpty:##HxcVcPreviewText THEN "Fetch the template once and save to keep its preview." ELSE ##HxcVcPreviewText

[System: Formula]
    Hxc Settings Preview Has Document : NOT ##HxcSendPreviewOpen AND ($$StringPart:@@HxcPreviewDisplayText:0:27) = "[Media] DOCUMENT attachment"

[Function: Hxc Preview Layout Text]
    Returns : String
    Variable : Text : String
    Variable : Offset : Number
    Variable : TextLength : Number
    01 : SET : Text : @@HxcPreviewDisplayText
    010 : SET : Text : $$StringFindAndReplace:##Text:(($$StrByCharCode:13) + ($$StrByCharCode:10)):($$StrByCharCode:10)
    0101 : SET : Text : $$StringFindAndReplace:##Text:($$StrByCharCode:13):($$StrByCharCode:10)
    0102 : SET : Text : $$StringFindAndReplace:##Text:($$StrByCharCode:10):$$NewLine
    011 : IF : (@@HxcSettingsPreviewHasDocument OR (##HxcSendPreviewOpen AND ##HxcSendDocument)) AND $$StringPart:##Text:0:8 = "[Media] "
    012 :    SET : TextLength : $$StringLength:##Text
    013 :    SET : Offset : 8
    014 :    WHILE : ##Offset < ##TextLength AND NOT ($$StringPart:##Text:##Offset:1 = $$NewLine)
    015 :       INCREMENT : Offset
    016 :    END WHILE
    017 :    WHILE : ##Offset < ##TextLength AND $$StringPart:##Text:##Offset:1 = $$NewLine
    018 :       INCREMENT : Offset
    019 :    END WHILE
    020 :    IF : ##Offset >= ##TextLength
    021 :       RETURN : ""
    022 :    END IF
    023 :    RETURN : $$StringPart:##Text:##Offset:(##TextLength - ##Offset)
    024 : END IF
    02 : IF : NOT ($$StringPart:##Text:0:9 = "[Header] ")
    03 :    RETURN : ##Text
    04 : END IF
    05 : SET : TextLength : $$StringLength:##Text
    06 : SET : Offset : 9
    07 : WHILE : ##Offset + 3 <= ##TextLength
    08 :    IF : $$StringPart:##Text:##Offset:1 = $$NewLine
    09 :       RETURN : ##Text
    10 :    END IF
    11 :    IF : $$StringPart:##Text:##Offset:3 = " | "
    12 :       RETURN : ($$StringPart:##Text:0:##Offset) + $$NewLine + $$NewLine + ($$StringPart:##Text:(##Offset + 3):(##TextLength - ##Offset - 3))
    13 :    END IF
    14 :    INCREMENT : Offset
    15 : END WHILE
    16 : RETURN : ##Text

[Function: Hxc Preview Line Count]
    Returns : Number
    Variable : Text : String
    Variable : Offset : Number
    Variable : LineCount : Number
    01 : SET : Text : $$HxcPreviewLayoutText
    02 : SET : Offset : 0
    03 : SET : LineCount : 1
    04 : WHILE : ##Offset < $$StringLength:##Text
    05 :    IF : $$StringPart:##Text:##Offset:1 = $$NewLine
    06 :       INCREMENT : LineCount
    07 :    END IF
    08 :    INCREMENT : Offset
    09 : END WHILE
    10 : RETURN : ##LineCount

[Function: Hxc Preview Line Text]
    Returns : String
    Parameter : Wanted : Number
    Variable : Text : String
    Variable : TextLength : Number
    Variable : Offset : Number
    Variable : StartAt : Number
    Variable : CurrentLine : Number
    01 : SET : Text : $$HxcPreviewLayoutText
    02 : SET : TextLength : $$StringLength:##Text
    03 : SET : Offset : 0
    04 : SET : StartAt : 0
    05 : SET : CurrentLine : 1
    06 : WHILE : ##Offset < ##TextLength
    07 :    IF : $$StringPart:##Text:##Offset:1 = $$NewLine
    08 :       IF : ##CurrentLine = ##Wanted
    09 :          RETURN : If ##Offset = ##StartAt THEN " " ELSE $$StringPart:##Text:##StartAt:(##Offset - ##StartAt)
    10 :       END IF
    11 :       INCREMENT : CurrentLine
    12 :       SET : StartAt : ##Offset + 1
    13 :    END IF
    14 :    INCREMENT : Offset
    15 : END WHILE
    16 : RETURN : If ##CurrentLine = ##Wanted AND ##StartAt < ##TextLength THEN $$StringPart:##Text:##StartAt:(##TextLength - ##StartAt) ELSE " "


[Function: Hxc Preview Row Content]
    Returns : String
    Parameter : RowNumber : Number
    Variable : RawLine : String
    Variable : Prefix : String
    01 : SET : RawLine : $$HxcPreviewLineText:##RowNumber
    02 : SET : Prefix : $$StringPart:##RawLine:0:9
    03 : IF : ##Prefix = "[Header] " OR ##Prefix = "[Footer] " OR ##Prefix = "[Button] "
    04 :    RETURN : $$StringPart:##RawLine:9:(($$StringLength:##RawLine) - 9)
    05 : END IF
    06 : IF : $$StringPart:##RawLine:0:8 = "[Media] "
    071 :    IF : ##RawLine = "[Media] DOCUMENT attachment"
    072 :       RETURN : If ##HxcSendPreviewOpen AND NOT $$IsEmpty:##HxcSendPreviewFilename Then ##HxcSendPreviewFilename Else "Document Header"
    073 :    END IF
    074 :    IF : ##RawLine = "[Media] IMAGE attachment"
    075 :       RETURN : "Image Header"
    076 :    END IF
    077 :    IF : ##RawLine = "[Media] VIDEO attachment"
    078 :       RETURN : "Video Header"
    079 :    END IF
    07 :    RETURN : $$StringPart:##RawLine:8:(($$StringLength:##RawLine) - 8)
    08 : END IF
    081 : IF : $$StringPart:##RawLine:0:6 = "[URL] "
    082 :    RETURN : $$StringPart:##RawLine:6:(($$StringLength:##RawLine) - 6)
    083 : END IF
    09 : RETURN : ##RawLine

[!Field: Hxc Send Preview Regular Text]
    Style : Hxc Send Preview Small

[Style: Hxc Send Preview Small]
    Use : Small
    Height : 9
    Bold : No

[!Field: Hxc Preview Header Style]
    Style      : Bold
    Color : Hxc Preview Header Ink
    Background : Hxc Preview Header Fill

[!Field: Hxc Preview Media Style]
    Style      : Bold
    Color : Hxc Preview Header Ink
    Background : Hxc Preview Header Fill

[!Field: Hxc Preview Footer Style]
    Color      : Hxc Preview Muted

[!Field: Hxc Preview Button Style]
    Style      : Bold
    Align      : Centre
    Color : Hxc Preview Button Ink
    Background : Hxc Preview Button Fill
    Border     : Hxc Preview Button Divider

[!Field: Hxc Preview Button URL Style]
    Style      : Hxc Preview URL Small
    Align      : Centre
    Color      : Hxc Preview Muted
    Background : Hxc Preview Button Fill

[Border: Hxc Preview Button Divider]
    Top   : Thin
    Color : Hxc Vt Divider

[Color: Hxc Preview Muted]
    RGB : 78, 99, 111

[Color: Hxc Preview Header Ink]
    RGB : 45, 62, 112

[Color: Hxc Preview Header Fill]
    RGB : 228, 235, 251

[Color: Hxc Preview Body Ink]
    RGB : 30, 45, 52

[Color: Hxc Preview Body Fill]
    RGB : 247, 250, 252

[Color: Hxc Preview Button Ink]
    RGB : 12, 93, 72

[Color: Hxc Preview Button Fill]
    RGB : 220, 243, 234


[Style: Hxc Preview URL Small]
    Use    : Small
    Height : 8


[!Line: Hxc Vt Mapping Row Spacing]
    Space Top    : 0.12
    Space Bottom : 0.12
    Border       : Hxc Vt Mapping Row Divider

[Border: Hxc Vt Mapping Row Divider]
    Bottom : Thin
    Color  : Hxc Vt Mapping Row Grey

[Color: Hxc Vt Mapping Row Grey]
    RGB : 216, 221, 225


[!Field: Hxc Vt Mapping Value Style]
    Style : Hxc Vt Mapping Value Small

[Style: Hxc Vt Mapping Text Small]
    Use    : Small
    Height : 9

[Style: Hxc Vt Mapping Value Small]
    Use    : Hxc Vt Mapping Text Small
    Bold   : Yes


;; Voucher recipient details

[#Part: VCH Narration]
    Add : Line : At Beginning : Hxc Provide Party Details Line, Hxc Voucher Invoice Contact Line, Hxc Voucher Last WhatsApp Footer
    Local : Line : Hxc Voucher Invoice Contact Line : Invisible : NOT @@HxcInvoiceContactVisible
    Local : Line : Hxc Voucher Last WhatsApp Footer : Invisible : $$InPrintMode OR NOT ($HxcShowLastVoucherMessageStatus:Company:##SVCurrentCompany)

[Line: Hxc Provide Party Details Line]
    Fields : Medium Prompt, Hxc Provide Party Details
    Local : Field : Medium Prompt : Set as : "Provide Party Details:"
    Local : Field : Medium Prompt : Width : 22
    Invisible : NOT (@@HxcSettlementVoucher AND @@HxcContactVoucherEnabled)

[Field: Hxc Provide Party Details]
    Use : Logical Field
    Storage : HxcProvidePartyDetails
    Set as : $HxcProvidePartyDetails
    Width : 8
    Sub Form : Hxc Settlement Party Details : $$Value AND @@HxcSettlementVoucher AND @@HxcContactVoucherEnabled

[Report: Hxc Settlement Party Details]
    Form : Hxc Settlement Party Details
    Title : "Party Details"
    Auto : Yes

[Form: Hxc Settlement Party Details]
    Parts : Hxc Settlement Party Selection, Hxc Voucher Recipient
    Width : 55% Screen
    Space Top : 1
    Space Bottom : 1
    Space Left : 1
    Space Right : 1
    Horizontal Align : Centre
    Vertical Align : Centre
    Button : Form Accept, Form Cancel
    On : Form Destroy : Yes : CALL : Hxc Clear Recipient Draft

[Part: Hxc Settlement Party Selection]
    Lines : Hxc Settlement Party Ledger Line, Hxc Settlement Address Line

[Line: Hxc Settlement Party Ledger Line]
    Fields : Medium Prompt, Hxc Settlement Party Ledger
    Local : Field : Medium Prompt : Set as : "Party Ledger"
    Local : Field : Medium Prompt : Width : 22

[Field: Hxc Settlement Party Ledger]
    Use : Name Field
    Storage : HxcSettlementPartyLedger
    Set as : If NOT $$IsEmpty:@@HxcSettlementSavedParty Then @@HxcSettlementSavedParty Else If $$IsSysNameEqual:NotApplicable:$HxcSettlementPartyLedger Then $$SysName:NotApplicable Else @@HxcSettlementFirstParty
    Width : 44
    Table : Hxc Settlement Party Ledgers, Not Applicable
    Show Table : Always
    On : Accept : NOT ($$Value = $HxcSettlementPartyLedger) : Set Object Values : HxcSettlementAddress : "Primary"
    On : Accept : Yes : CALL : Hxc Clear Recipient Draft
    On : Accept : Yes : Field Accept

[Collection: Hxc Settlement Party Ledgers]
    Type : Ledger
    Fetch : Name, Parent
    Filter : Hxc Settlement Eligible Ledger Row
    Format : $Name, 44
    Title : "Sundry Debtors and Creditors"

[Line: Hxc Settlement Address Line]
    Fields : Medium Prompt, Hxc Settlement Address
    Local : Field : Medium Prompt : Set as : "Address Type"
    Local : Field : Medium Prompt : Width : 22

[Field: Hxc Settlement Address]
    Use : Name Field
    Storage : HxcSettlementAddress
    Set as : @@HxcVoucherBuyerAddress
    Width : 32
    Table : Hxc Settlement Primary Address, Hxc Settlement Ledger Addresses
    Show Table : Always
    On : Accept : Yes : CALL : Hxc Clear Recipient Draft
    On : Accept : Yes : Field Accept

[Collection: Hxc Settlement Primary Address]
    List : "Primary"

[Collection: Hxc Settlement Ledger Addresses]
    Source Collection : Hxc Settlement Address Ledger
    Walk : LedMultiAddressList
    By : HxcSettlementAddressName : $AddressName
    Fetch : AddressName
    Format : $HxcSettlementAddressName, 32

[Collection: Hxc Settlement Address Ledger]
    Type : Ledger
    Parm Var : HxcAddressPartyName : String : If $$IsEmpty:#HxcSettlementPartyLedger Then $HxcSettlementPartyLedger Else #HxcSettlementPartyLedger
    Fetch : Name, LedMultiAddressList, LedMultiAddressList.*, AddressName
    Filter : Hxc Settlement Address Ledger Match

[System: Formula]
    Hxc Contact Voucher Type : If NOT $$IsEmpty:$VoucherTypeName Then $VoucherTypeName Else If NOT $$IsEmpty:($$ReportObject:$VoucherTypeName) Then $$ReportObject:$VoucherTypeName Else If NOT $$IsEmpty:$$Owner:$VoucherTypeName Then $$Owner:$VoucherTypeName Else ##SVVoucherType
    Hxc Contact Voucher Enabled : $HxcVtEnabled:VoucherType:@@HxcContactVoucherType
    Hxc Settlement Voucher : $$IsReceipt:@@HxcContactVoucherType OR $$IsPayment:@@HxcContactVoucherType
    Hxc Invoice Contact Visible : @@HxcContactVoucherEnabled AND ($$IsSales:@@HxcContactVoucherType OR $$IsPurchase:@@HxcContactVoucherType OR $$IsCreditNote:@@HxcContactVoucherType OR $$IsDebitNote:@@HxcContactVoucherType OR $$IsSalesOrder:@@HxcContactVoucherType OR $$IsPurcOrder:@@HxcContactVoucherType)
    Hxc Settlement Address Ledger Match : NOT $$IsEmpty:##HxcAddressPartyName AND $Name = ##HxcAddressPartyName
    Hxc Settlement Eligible Entry : $$HxcEligibleSettlementLedger:$LedgerName
    Hxc Settlement Eligible Ledger Row : $$HxcEligibleSettlementLedger:$Name
    Hxc Settlement First Party : $$FilterValue:$LedgerName:AllLedgerEntries:First:HxcSettlementEligibleEntry
    Hxc Settlement Saved Party : If $$HxcEligibleSettlementLedger:$HxcSettlementPartyLedger Then $HxcSettlementPartyLedger Else ""

[Function: Hxc Eligible Settlement Ledger]
    Parameter : LedgerName : String
    Returns : Logical
    01 : RETURN : NOT $$IsEmpty:##LedgerName AND ($$IsLedOfGrp:##LedgerName:$$GroupSundryDebtors OR $$IsLedOfGrp:##LedgerName:$$GroupSundryCreditors)


[Variable: HxcInvoiceAddressPending]
    Type : Logical

[Variable: HxcInvoiceBuyerInput]
    Type : String

[Variable: HxcInvoiceAddressInput]
    Type : String

[System: Variable]
    HxcInvoiceAddressPending : No
    HxcInvoiceBuyerInput : ""
    HxcInvoiceAddressInput : ""

[#Field: EI PartyLedger]
    Add : On : At Beginning : Accept : @@HxcInvoiceBuyerChanged : Set Object Values : HxcVoucherContactName : ""
    Add : On : At Beginning : Accept : @@HxcInvoiceBuyerChanged : Set Object Values : HxcVoucherContactCountry : ""
    Add : On : At Beginning : Accept : @@HxcInvoiceBuyerChanged : Set Object Values : HxcVoucherContactMobile : ""
    Add : On : At Beginning : Accept : @@HxcInvoiceBuyerChanged : Set Object Values : HxcVoucherContactEmail : ""
    Add : On : At Beginning : Accept : @@HxcInvoiceBuyerChanged : Set Object Values : HxcVoucherContactKey : ""
    Add : On : At Beginning : Accept : @@HxcInvoiceBuyerChanged : Set Object Values : HxcVoucherContactScope : ""
    Add : On : At Beginning : Accept : @@HxcInvoiceBuyerChanged : CALL : Hxc Clear Invoice Buyer Contact : $$Value
    Add : On : At End : Accept : @@HxcInvoiceContactVisible : SET : HxcInvoiceBuyerInput : $$Value
    Add : On : At End : Accept : Yes : Field Accept

[#Field: EI PartyAddressType]
    Add : On : At Beginning : Accept : @@HxcInvoiceContactVisible : CALL : Hxc Load Invoice Address Contact : $$Value
    Add : On : At End : Accept : Yes : Field Accept

[Function: Hxc Clear Invoice Buyer Contact]
    Parameter : SelectedBuyer : String
    01 : CALL : Hxc Clear Recipient Draft
    02 : SET : HxcInvoiceBuyerInput : ##SelectedBuyer
    03 : SET : HxcInvoiceAddressInput : ""
    031 : SET : HxcInvoiceAddressPending : Yes
    04 : SET : HxcRecipientDraftName : $$SysName:NotApplicable
    05 : SET : HxcRecipientDraftLedger : @@HxcVoucherRecipientScope

[Function: Hxc Load Invoice Address Contact]
    Parameter : SelectedAddress : String
    01 : SET : HxcInvoiceAddressInput : ##SelectedAddress
    011 : SET : HxcInvoiceAddressPending : No
    02 : CALL : Hxc Clear Recipient Draft
    03 : SET : HxcRecipientDraftName : @@HxcVoucherDefaultName
    04 : SET : HxcRecipientDraftMobile : @@HxcVoucherDefaultMobile
    05 : SET : HxcRecipientDraftEmail : @@HxcVoucherDefaultEmail
    06 : IF : NOT $$IsEmpty:##HxcRecipientDraftMobile
    07 :    SET : HxcRecipientDraftCountry : @@HxcVoucherDefaultCountry
    08 : END IF
    09 : IF : $$IsSysNameEqual:NotApplicable:##HxcRecipientDraftName
    10 :    SET : HxcRecipientDraftName : ""
    11 : END IF
    12 : SET : HxcRecipientDraftLedger : @@HxcVoucherRecipientScope
    13 : SET OBJECT VALUES : HxcVoucherContactName : ##HxcRecipientDraftName
    14 : SET OBJECT VALUES : HxcVoucherContactMobile : ##HxcRecipientDraftMobile
    15 : SET OBJECT VALUES : HxcVoucherContactCountry : ##HxcRecipientDraftCountry
    16 : SET OBJECT VALUES : HxcVoucherContactEmail : ##HxcRecipientDraftEmail
    17 : SET OBJECT VALUES : HxcVoucherContactKey : ""
    18 : SET OBJECT VALUES : HxcVoucherContactScope : If $$IsEmpty:##HxcRecipientDraftMobile Then "" Else ##HxcRecipientDraftLedger

[Function: Hxc Clear Unconfirmed Invoice Contact]
    01 : CALL : Hxc Clear Recipient Draft
    02 : SET OBJECT VALUES : HxcVoucherContactName : ""
    03 : SET OBJECT VALUES : HxcVoucherContactMobile : ""
    04 : SET OBJECT VALUES : HxcVoucherContactCountry : ""
    05 : SET OBJECT VALUES : HxcVoucherContactEmail : ""
    06 : SET OBJECT VALUES : HxcVoucherContactKey : ""
    07 : SET OBJECT VALUES : HxcVoucherContactScope : ""

[#Form: VchSuppl PartyDetails]
    Add : On : At Beginning : Form Accept : @@HxcInvoiceContactVisible AND $$IsEmpty:##HxcInvoiceAddressInput : CALL : Hxc Clear Unconfirmed Invoice Contact
    Add : On : At End : Form Accept : Yes : Form Accept
    Add : On : At End : Form Destroy : Yes : SET : HxcRecipientDraftLedger : ""
    Add : On : At End : Form Destroy : Yes : SET : HxcInvoiceBuyerInput : ""
    Add : On : At End : Form Destroy : Yes : SET : HxcInvoiceAddressInput : ""
    Add : On : At End : Form Destroy : Yes : SET : HxcInvoiceAddressPending : No

[Variable: HxcRecipientDraftLedger]
    Type : String

[Variable: HxcRecipientDraftName]
    Type : String

[Variable: HxcRecipientDraftCountry]
    Type : String

[Variable: HxcRecipientDraftMobile]
    Type : String

[Variable: HxcRecipientDraftEmail]
    Type : String

[Line: Hxc Voucher Invoice Contact Line]
    Field : Hxc Voucher Invoice Contact
    Invisible : NOT @@HxcInvoiceContactVisible

[Field: Hxc Voucher Invoice Contact]
    Use : Name Field
    Style : Bold
    Set as : @@HxcVoucherInvoiceContactChoice
    Set Always : Yes
    Table : Hxc Voucher Contact Table, Not Applicable
    Show Table : Always
    Width : 65
    On : Focus : NOT @@HxcVoucherRecipientDraftMatches : CALL : Hxc Populate Recipient Draft
    On : Focus : Yes : Refresh Data
    On : Focus : Yes : Refresh
    On : Accept : @@HxcVoucherRecipientChanged : SET : HxcRecipientDraftEmail : $$CurrentTableObj:$HxcRecipientEmail
    On : Accept : @@HxcVoucherRecipientChanged AND NOT @@HxcVoucherRecipientNotApplicable : SET : HxcRecipientDraftMobile : $$CurrentTableObj:$HxcRecipientMobile
    On : Accept : @@HxcVoucherRecipientCountryUpdate AND NOT @@HxcVoucherRecipientNotApplicable : SET : HxcRecipientDraftCountry : $$CurrentTableObj:$HxcRecipientCountry
    On : Accept : @@HxcVoucherRecipientCountryUpdate AND NOT @@HxcVoucherRecipientNotApplicable : Set Object Values : HxcVoucherContactCountry : ##HxcRecipientDraftCountry
    On : Accept : @@HxcVoucherRecipientChanged AND NOT @@HxcVoucherRecipientNotApplicable : Set Object Values : HxcVoucherContactMobile : ##HxcRecipientDraftMobile
    On : Accept : @@HxcVoucherRecipientChanged : Set Object Values : HxcVoucherContactEmail : ##HxcRecipientDraftEmail
    On : Accept : @@HxcVoucherRecipientChanged : Set Object Values : HxcVoucherContactKey : @@HxcVoucherRecipientInputKey
    On : Accept : Yes : SET : HxcRecipientDraftName : If @@HxcVoucherRecipientNotApplicable Then $$SysName:NotApplicable Else If NOT $$IsEmpty:$$CurrentTableObj:$HxcRecipientName Then $$CurrentTableObj:$HxcRecipientName Else $$Value
    On : Accept : Yes : Set Object Values : HxcVoucherContactName : If @@HxcVoucherRecipientNotApplicable Then $$SysName:NotApplicable Else ##HxcRecipientDraftName
    On : Accept : @@HxcVoucherRecipientNotApplicable : Set Object Values : HxcVoucherContactMobile : ""
    On : Accept : @@HxcVoucherRecipientNotApplicable : Set Object Values : HxcVoucherContactCountry : ""
    On : Accept : @@HxcVoucherRecipientNotApplicable : Set Object Values : HxcVoucherContactEmail : ""
    On : Accept : @@HxcVoucherRecipientNotApplicable : Set Object Values : HxcVoucherContactKey : ""
    On : Accept : Yes : Set Object Values : HxcVoucherContactScope : @@HxcVoucherRecipientScope
    On : Accept : Yes : SET : HxcRecipientDraftLedger : @@HxcVoucherRecipientScope
    On : Accept : Yes : Refresh Data
    On : Accept : Yes : Refresh
    On : Accept : Yes : Field Accept

[Part: Hxc Voucher Recipient]
    On : Focus : NOT @@HxcVoucherRecipientDraftMatches : CALL : Hxc Populate Recipient Draft
    Lines : Hxc Voucher Recipient Name Line, Hxc Voucher Recipient Mobile Line, Hxc Voucher Recipient Email Line

[Line: Hxc Voucher Recipient Name Line]
    Fields : Medium Prompt, Hxc Voucher Recipient Name
    Local : Field : Medium Prompt : Set as : "Contact Name"
    Local : Field : Medium Prompt : Color : Hxc Recipient Dark Orange
    Local : Field : Medium Prompt : Width : 22

[Field: Hxc Voucher Recipient Name]
    Color : Hxc Recipient Dark Orange
    Use : Name Field
    Storage : HxcVoucherContactName
    Set as : If $$IsEmpty:@@HxcVoucherRecipientDisplayName Then $$SysName:NotApplicable Else @@HxcVoucherRecipientDisplayName
    Set Always : Yes
    Table : Hxc Settlement Contact Table, Not Applicable
    Show Table : Always
    Width : 32
    On : Focus : NOT @@HxcVoucherRecipientDraftMatches : CALL : Hxc Populate Recipient Draft
    On : Focus : Yes : Refresh Data
    On : Focus : Yes : Refresh
    On : Accept : @@HxcVoucherRecipientChanged : SET : HxcRecipientDraftEmail : $$CurrentTableObj:$HxcRecipientEmail
    On : Accept : @@HxcVoucherRecipientChanged AND NOT @@HxcVoucherRecipientNotApplicable : SET : HxcRecipientDraftMobile : $$CurrentTableObj:$HxcRecipientMobile
    On : Accept : @@HxcVoucherRecipientCountryUpdate AND NOT @@HxcVoucherRecipientNotApplicable : SET : HxcRecipientDraftCountry : $$CurrentTableObj:$HxcRecipientCountry
    On : Accept : @@HxcVoucherRecipientCountryUpdate AND NOT @@HxcVoucherRecipientNotApplicable : Set Object Values : HxcVoucherContactCountry : ##HxcRecipientDraftCountry
    On : Accept : @@HxcVoucherRecipientChanged AND NOT @@HxcVoucherRecipientNotApplicable : Set Object Values : HxcVoucherContactMobile : ##HxcRecipientDraftMobile
    On : Accept : @@HxcVoucherRecipientChanged : Set Object Values : HxcVoucherContactEmail : ##HxcRecipientDraftEmail
    On : Accept : @@HxcVoucherRecipientChanged : Set Object Values : HxcVoucherContactKey : @@HxcVoucherRecipientInputKey
    On : Accept : Yes : SET : HxcRecipientDraftName : If @@HxcVoucherRecipientNotApplicable Then $$SysName:NotApplicable Else If NOT $$IsEmpty:$$CurrentTableObj:$HxcRecipientName Then $$CurrentTableObj:$HxcRecipientName Else $$Value
    On : Accept : Yes : Set Object Values : HxcVoucherContactName : ##HxcRecipientDraftName
    On : Accept : Yes : Set Object Values : HxcVoucherContactScope : @@HxcVoucherRecipientScope
    On : Accept : Yes : Refresh Data
    On : Accept : Yes : Refresh
    On : Accept : Yes : Field Accept

[Line: Hxc Voucher Recipient Mobile Line]
    Fields : Medium Prompt, Hxc Voucher Recipient Country, Hxc Voucher Recipient Mobile
    Local : Field : Medium Prompt : Set as : "Contact No."
    Local : Field : Medium Prompt : Color : Hxc Recipient Dark Orange
    Local : Field : Medium Prompt : Width : 22

[Field: Hxc Voucher Recipient Country]
    Color : Hxc Recipient Dark Orange
    Use : Name Field
    Validate : $$IsEmpty:$$Value OR $$HxcValidDialingCode:$$Value
    Skip Forward : No
    Storage : HxcVoucherContactCountry
    Set as : If $$IsEmpty:@@HxcVoucherRecipientCountryValue AND @@HxcVoucherAddressHasNoContact Then @@HxcCompanyDefaultCountryCode Else @@HxcVoucherRecipientCountryValue
    On : Accept : Yes : SET : HxcRecipientDraftCountry : $$Value
    On : Accept : Yes : Set Object Values : HxcVoucherContactScope : @@HxcVoucherRecipientScope
    On : Accept : Yes : Field Accept
    Set Always : Yes
    Width : 7

[Field: Hxc Voucher Recipient Mobile]
    Color : Hxc Recipient Dark Orange
    Use : Name Field
    Storage : HxcVoucherContactMobile
    Set as : If @@HxcVoucherRecipientDraftMatches Then ##HxcRecipientDraftMobile Else If @@HxcVoucherSavedContactMatches Then $HxcVoucherContactMobile Else @@HxcVoucherDefaultMobile
    Modifies : HxcRecipientDraftMobile : Yes
    On : Accept : Yes : Set Object Values : HxcVoucherContactScope : @@HxcVoucherRecipientScope
    On : Accept : Yes : Field Accept
    Set Always : Yes
    Width : 25

[Line: Hxc Voucher Recipient Email Line]
    Fields : Medium Prompt, Hxc Voucher Recipient Email
    Local : Field : Medium Prompt : Set as : "Contact Email"
    Local : Field : Medium Prompt : Color : Hxc Recipient Dark Orange
    Local : Field : Medium Prompt : Width : 22

[Field: Hxc Voucher Recipient Email]
    Color : Hxc Recipient Dark Orange
    Use : Name Field
    Storage : HxcVoucherContactEmail
    Set as : If @@HxcVoucherRecipientDraftMatches Then ##HxcRecipientDraftEmail Else If @@HxcVoucherSavedContactMatches Then $HxcVoucherContactEmail Else @@HxcVoucherDefaultEmail
    Modifies : HxcRecipientDraftEmail : Yes
    On : Accept : Yes : Set Object Values : HxcVoucherContactScope : @@HxcVoucherRecipientScope
    On : Accept : Yes : Field Accept
    Set Always : Yes
    Width : 35

[Table: Hxc Voucher Contact Table]
    Collection : Hxc Voucher Primary Contact, Hxc Voucher Address Contacts, Hxc Voucher Mobile Contacts
    Title : "Address Type / Contact Name / Contact No."
    Format : $HxcRecipientChoice, 65

[Table: Hxc Settlement Contact Table]
    Collection : Hxc Voucher Primary Contact, Hxc Voucher Address Contacts, Hxc Voucher Mobile Contacts
    Title : "Address Type / Contact Name / Contact No."
    Format : $HxcRecipientName, 28
    Format : $HxcRecipientMobile, 22
    Format : $HxcRecipientAddress, 28

[Collection: Hxc Voucher Buyer Ledger]
    Type : Ledger
    Parm Var : HxcContactPartyName : String : If @@HxcSettlementVoucher AND NOT $$IsEmpty:#HxcSettlementPartyLedger Then #HxcSettlementPartyLedger Else If NOT $$IsEmpty:@@HxcVoucherBuyerLedgerName Then @@HxcVoucherBuyerLedgerName Else If NOT $$IsEmpty:$BasicBuyerName Then $BasicBuyerName Else If NOT $$IsEmpty:$PartyLedgerName Then $PartyLedgerName Else If NOT $$IsEmpty:($$ReportObject:$BasicBuyerName) Then $$ReportObject:$BasicBuyerName Else If NOT $$IsEmpty:($$ReportObject:$PartyLedgerName) Then $$ReportObject:$PartyLedgerName Else $$Owner:$PartyLedgerName
    Fetch : Name, LedgerContact, LedgerMobile, MobileNumber, AddrTypeMobileNumber, Email, CountryName, LedMultiAddressList, LedMultiAddressList.*, AddressName, AddrTypeMobileCountryCode, CountryISDCode, LedgercountryISDcode, MobileCountryCode, LedgerMobileCountryCode, MobileISDCode, ISDCode, CountryCode, ContactDetails, ContactDetails.*
    Filter : Hxc Voucher Buyer Ledger Match

[Collection: Hxc Voucher Primary Contact]
    Source Collection : Hxc Voucher Buyer Ledger
    By : HxcRecipientPrimaryLedger : $Name
    Compute : HxcRecipientName : $LedgerContact
    Compute : HxcRecipientCountry : If NOT $$IsEmpty:$LedgercountryISDcode Then $LedgercountryISDcode Else If NOT $$IsEmpty:$AddrTypeMobileCountryCode Then $AddrTypeMobileCountryCode Else If NOT $$IsEmpty:$CountryISDCode Then $CountryISDCode Else If NOT $$IsEmpty:$MobileCountryCode Then $MobileCountryCode Else If NOT $$IsEmpty:$LedgerMobileCountryCode Then $LedgerMobileCountryCode Else If NOT $$IsEmpty:$MobileISDCode Then $MobileISDCode Else If NOT $$IsEmpty:$ISDCode Then $ISDCode Else If NOT $$IsEmpty:$CountryCode Then $CountryCode Else If $CountryName = "India" Then "+91" Else ""
    Compute : HxcRecipientMobile : If NOT $$IsEmpty:$LedgerMobile Then $LedgerMobile Else If NOT $$IsEmpty:$MobileNumber Then $MobileNumber Else $AddrTypeMobileNumber
    Compute : HxcRecipientEmail : $Email
    Compute : HxcRecipientAddress : "Primary"
    Compute : HxcRecipientKey : $Name + "|Primary|" + $LedgerContact
    Compute : HxcRecipientChoice : $$HxcFormatVoucherContactChoice:$HxcRecipientAddress:$HxcRecipientName:$HxcRecipientMobile:$HxcRecipientCountry
    Search Key : "PRIMARY"
    Filter : Hxc Voucher Contact Available

[Collection: Hxc Voucher Address Contacts]
    Source Collection : Hxc Voucher Buyer Ledger
    Walk : LedMultiAddressList
    By : HxcRecipientAddressKey : $AddressName
    Fetch : AddressName, AddrTypeContactPerson, ContactPerson, CountryISDCode, AddrTypeMobileCountryCode, MobileNumber, AddrTypeMobileNumber, Email, AddrTypeEMail
    Compute : HxcRecipientName : If $$IsEmpty:$AddrTypeContactPerson Then $ContactPerson Else $AddrTypeContactPerson
    Compute : HxcRecipientCountry : If $$IsEmpty:$CountryISDCode Then $AddrTypeMobileCountryCode Else $CountryISDCode
    Compute : HxcRecipientMobile : If $$IsEmpty:$MobileNumber Then $AddrTypeMobileNumber Else $MobileNumber
    Compute : HxcRecipientEmail : If $$IsEmpty:$Email Then $AddrTypeEMail Else $Email
    Compute : HxcRecipientAddress : $AddressName
    Compute : HxcRecipientKey : $$Owner:$Name + "|Address|" + $AddressName + "|" + $HxcRecipientName
    Compute : HxcRecipientChoice : $$HxcFormatVoucherContactChoice:$HxcRecipientAddress:$HxcRecipientName:$HxcRecipientMobile:$HxcRecipientCountry
    Search Key : $$Upper:$AddressName
    Filter : Hxc Voucher Contact Available

[Collection: Hxc Voucher Mobile Contact Rows]
    Source Collection : Hxc Voucher Buyer Ledger
    Walk : ContactDetails
    Fetch : Name, PhoneNumber, CountryISDCode
    Compute : HxcRecipientName : $Name
    Compute : HxcRecipientCountry : $CountryISDCode
    Compute : HxcRecipientMobile : $PhoneNumber
    Compute : HxcRecipientEmail : ""
    Compute : HxcRecipientAddress : "Additional Mobile"
    Compute : HxcRecipientKey : $$Owner:$Name + "|Mobile|" + $Name + "|" + $PhoneNumber
    Compute : HxcRecipientChoice : $$HxcFormatVoucherContactChoice:$HxcRecipientAddress:$HxcRecipientName:$HxcRecipientMobile:$HxcRecipientCountry
    Filter : Hxc Voucher Mobile Contact Available

[Collection: Hxc Voucher Mobile Contacts]
    Source Collection : Hxc Voucher Mobile Contact Rows
    By : HxcRecipientMobileKey : $HxcRecipientKey
    Compute : HxcRecipientName : $HxcRecipientName
    Compute : HxcRecipientCountry : $HxcRecipientCountry
    Compute : HxcRecipientMobile : $HxcRecipientMobile
    Compute : HxcRecipientEmail : $HxcRecipientEmail
    Compute : HxcRecipientAddress : $HxcRecipientAddress
    Compute : HxcRecipientKey : $HxcRecipientKey
    Compute : HxcRecipientChoice : $HxcRecipientChoice
    Search Key : $$Upper:$HxcRecipientKey
    Filter : Hxc Voucher Mobile Contact Available

[System: Formula]
    Hxc Voucher Buyer Ledger Name : If @@HxcSettlementVoucher Then @@HxcSettlementSavedParty Else @@HxcVoucherStoredBuyerLedger
    Hxc Invoice Buyer Changed : @@HxcInvoiceContactVisible AND NOT $$IsEmpty:$$Value AND NOT ($$Value = @@HxcVoucherStoredBuyerLedger)
    Hxc Voucher Stored Buyer Ledger : If NOT $$IsEmpty:##HxcInvoiceBuyerInput Then ##HxcInvoiceBuyerInput Else If NOT $$IsEmpty:$BasicBuyerName Then $BasicBuyerName Else If NOT $$IsEmpty:$$Owner:$BasicBuyerName Then $$Owner:$BasicBuyerName Else If NOT $$IsEmpty:$PartyLedgerName Then $PartyLedgerName Else If NOT $$IsEmpty:($$ReportObject:$BasicBuyerName) Then $$ReportObject:$BasicBuyerName Else If NOT $$IsEmpty:($$ReportObject:$PartyLedgerName) Then $$ReportObject:$PartyLedgerName Else $$Owner:$PartyLedgerName
    Hxc Voucher Recipient Draft Matches : NOT $$IsEmpty:##HxcRecipientDraftLedger AND ##HxcRecipientDraftLedger = @@HxcVoucherRecipientScope
    Hxc Voucher Buyer Address Raw : If @@HxcSettlementVoucher Then $HxcSettlementAddress Else If NOT $$IsEmpty:##HxcInvoiceAddressInput Then ##HxcInvoiceAddressInput Else If $$IsEmpty:$PartyAddressType Then $$Owner:$PartyAddressType Else $PartyAddressType
    Hxc Voucher Buyer Address : If $$IsEmpty:@@HxcVoucherBuyerAddressRaw OR @@HxcVoucherBuyerAddressRaw = "Primary" OR $$StringPart:@@HxcVoucherBuyerAddressRaw:2:7 = "Primary" Then "Primary" Else @@HxcVoucherBuyerAddressRaw
    Hxc Voucher Recipient Scope : (If @@HxcSettlementVoucher Then "Settlement|" Else "") + @@HxcVoucherBuyerLedgerName + "|" + @@HxcVoucherBuyerAddress
    Hxc Voucher Legacy Primary Prefix : @@HxcVoucherBuyerLedgerName + "|Primary|"
    Hxc Voucher Legacy Address Prefix : @@HxcVoucherBuyerLedgerName + "|Address|" + @@HxcVoucherBuyerAddress + "|"
    Hxc Voucher Saved Recipient Has Details : NOT $$IsEmpty:$HxcVoucherContactName OR NOT $$IsEmpty:$HxcVoucherContactMobile OR NOT $$IsEmpty:$HxcVoucherContactEmail
    Hxc Voucher Saved Contact Matches : @@HxcVoucherSavedRecipientHasDetails AND (If NOT $$IsEmpty:$HxcVoucherContactScope Then $HxcVoucherContactScope = @@HxcVoucherRecipientScope Else NOT $$IsEmpty:$HxcVoucherContactKey AND (If @@HxcVoucherBuyerAddress = "Primary" Then ($$StringPart:$HxcVoucherContactKey:0:($$StringLength:@@HxcVoucherLegacyPrimaryPrefix)) = @@HxcVoucherLegacyPrimaryPrefix Else ($$StringPart:$HxcVoucherContactKey:0:($$StringLength:@@HxcVoucherLegacyAddressPrefix)) = @@HxcVoucherLegacyAddressPrefix))
    Hxc Voucher Default Name : If @@HxcVoucherBuyerAddress <> "Primary" AND $$IsEmpty:@@HxcVoucherDefaultMobile AND $$IsEmpty:@@HxcVoucherDefaultEmail Then $$SysName:NotApplicable Else (If @@HxcVoucherBuyerAddress = "Primary" Then $LedgerContact:Ledger:@@HxcVoucherBuyerLedgerName Else $$HxcVoucherAddressRecipient:@@HxcVoucherBuyerLedgerName:@@HxcVoucherBuyerAddress:"Name")
    Hxc Voucher Address Has No Contact : $$IsEmpty:@@HxcVoucherDefaultMobile AND $$IsEmpty:@@HxcVoucherDefaultEmail
    Hxc Voucher Recipient Country Value : If @@HxcVoucherRecipientDraftMatches Then ##HxcRecipientDraftCountry Else If @@HxcVoucherSavedContactMatches Then $HxcVoucherContactCountry Else If @@HxcInvoiceContactVisible Then "" Else @@HxcVoucherDefaultCountry
    Hxc Invoice Recipient Has No Number : If @@HxcVoucherRecipientDraftMatches Then $$IsEmpty:##HxcRecipientDraftMobile Else NOT @@HxcVoucherSavedContactMatches OR $$IsEmpty:$HxcVoucherContactMobile
    Hxc Company Default Country Code : If $$HxcValidDialingCode:($HxcDefaultCountryCode:Company:##SVCurrentCompany) Then $HxcDefaultCountryCode:Company:##SVCurrentCompany Else ""
    Hxc Voucher Default Country : If @@HxcVoucherAddressHasNoContact Then @@HxcCompanyDefaultCountryCode Else (If @@HxcVoucherBuyerAddress = "Primary" Then (If NOT $$IsEmpty:($LedgercountryISDcode:Ledger:@@HxcVoucherBuyerLedgerName) Then $LedgercountryISDcode:Ledger:@@HxcVoucherBuyerLedgerName Else If NOT $$IsEmpty:($AddrTypeMobileCountryCode:Ledger:@@HxcVoucherBuyerLedgerName) Then $AddrTypeMobileCountryCode:Ledger:@@HxcVoucherBuyerLedgerName Else If NOT $$IsEmpty:($CountryISDCode:Ledger:@@HxcVoucherBuyerLedgerName) Then $CountryISDCode:Ledger:@@HxcVoucherBuyerLedgerName Else If NOT $$IsEmpty:($MobileCountryCode:Ledger:@@HxcVoucherBuyerLedgerName) Then $MobileCountryCode:Ledger:@@HxcVoucherBuyerLedgerName Else If NOT $$IsEmpty:($LedgerMobileCountryCode:Ledger:@@HxcVoucherBuyerLedgerName) Then $LedgerMobileCountryCode:Ledger:@@HxcVoucherBuyerLedgerName Else If NOT $$IsEmpty:($MobileISDCode:Ledger:@@HxcVoucherBuyerLedgerName) Then $MobileISDCode:Ledger:@@HxcVoucherBuyerLedgerName Else If NOT $$IsEmpty:($ISDCode:Ledger:@@HxcVoucherBuyerLedgerName) Then $ISDCode:Ledger:@@HxcVoucherBuyerLedgerName Else If NOT $$IsEmpty:($CountryCode:Ledger:@@HxcVoucherBuyerLedgerName) Then $CountryCode:Ledger:@@HxcVoucherBuyerLedgerName Else If $CountryName:Ledger:@@HxcVoucherBuyerLedgerName = "India" Then "+91" Else "") Else $$HxcVoucherAddressRecipient:@@HxcVoucherBuyerLedgerName:@@HxcVoucherBuyerAddress:"Country")
    Hxc Voucher Default Mobile : If @@HxcVoucherBuyerAddress = "Primary" Then (If NOT $$IsEmpty:($LedgerMobile:Ledger:@@HxcVoucherBuyerLedgerName) Then $LedgerMobile:Ledger:@@HxcVoucherBuyerLedgerName Else If NOT $$IsEmpty:($MobileNumber:Ledger:@@HxcVoucherBuyerLedgerName) Then $MobileNumber:Ledger:@@HxcVoucherBuyerLedgerName Else $AddrTypeMobileNumber:Ledger:@@HxcVoucherBuyerLedgerName) Else $$HxcVoucherAddressRecipient:@@HxcVoucherBuyerLedgerName:@@HxcVoucherBuyerAddress:"Mobile"
    Hxc Voucher Default Email : If @@HxcVoucherBuyerAddress = "Primary" Then (If NOT $$IsEmpty:($Email:Ledger:@@HxcVoucherBuyerLedgerName) Then $Email:Ledger:@@HxcVoucherBuyerLedgerName Else $AddrTypeEMail:Ledger:@@HxcVoucherBuyerLedgerName) Else $$HxcVoucherAddressRecipient:@@HxcVoucherBuyerLedgerName:@@HxcVoucherBuyerAddress:"Email"
    Hxc Voucher Buyer Ledger Match : NOT $$IsEmpty:##HxcContactPartyName AND $Name = ##HxcContactPartyName
    Hxc Voucher Contact Available : NOT $$IsEmpty:$HxcRecipientName
    Hxc Voucher Mobile Contact Available : NOT $$IsEmpty:$HxcRecipientName AND NOT $$IsEmpty:$HxcRecipientChoice AND NOT $$IsEmpty:($$HxcDialingDigits:$HxcRecipientMobile)
    Hxc Voucher Recipient Input Key : If $$IsEmpty:$$CurrentTableObj:$HxcRecipientKey Then @@HxcVoucherBuyerLedgerName + "|Manual|" + $$Value Else $$CurrentTableObj:$HxcRecipientKey
    Hxc Voucher Recipient Country Update : @@HxcVoucherRecipientChanged OR ($$IsEmpty:$HxcVoucherContactCountry AND NOT $$IsEmpty:$$CurrentTableObj:$HxcRecipientCountry)
    Hxc Voucher Recipient Display Name : If @@HxcInvoiceContactVisible AND ##HxcInvoiceAddressPending Then $$SysName:NotApplicable Else If @@HxcVoucherRecipientDraftMatches Then ##HxcRecipientDraftName Else If @@HxcVoucherSavedContactMatches Then $HxcVoucherContactName Else If @@HxcInvoiceContactVisible Then "" Else @@HxcVoucherDefaultName
    Hxc Voucher Recipient Not Applicable : $$IsSysNameEqual:NotApplicable:$$Value OR $$Value = "Not Applicable" OR $$Value = "♦ Not Applicable" OR (NOT $$IsEmpty:$$Value AND ($$StringFindAndReplace:$$Value:"Not Applicable":"") <> $$Value)
    Hxc Voucher Recipient Changed : @@HxcVoucherRecipientNotApplicable OR NOT (@@HxcVoucherRecipientInputKey = $HxcVoucherContactKey) OR ($$IsEmpty:$HxcVoucherContactMobile AND NOT $$IsEmpty:$$CurrentTableObj:$HxcRecipientMobile)
    Hxc Voucher Contact Address Label : $$HxcVoucherContactAddressFromKey:$HxcVoucherContactKey:@@HxcVoucherBuyerAddress
    Hxc Voucher Invoice Contact Choice : If ##HxcInvoiceAddressPending Then "" Else If @@HxcVoucherRecipientDraftMatches AND ($$IsSysNameEqual:NotApplicable:##HxcRecipientDraftName OR ##HxcRecipientDraftName = "Not Applicable") Then $$SysName:NotApplicable Else If @@HxcVoucherRecipientDraftMatches AND NOT $$IsEmpty:##HxcRecipientDraftName Then $$HxcFormatVoucherContactChoice:@@HxcVoucherContactAddressLabel:##HxcRecipientDraftName:##HxcRecipientDraftMobile:##HxcRecipientDraftCountry Else If @@HxcVoucherSavedContactMatches AND ($$IsSysNameEqual:NotApplicable:$HxcVoucherContactName OR $HxcVoucherContactName = "Not Applicable") Then $$SysName:NotApplicable Else If @@HxcVoucherSavedContactMatches Then $$HxcFormatVoucherContactChoice:@@HxcVoucherContactAddressLabel:$HxcVoucherContactName:$HxcVoucherContactMobile:$HxcVoucherContactCountry Else If NOT $$IsEmpty:@@HxcVoucherDefaultName AND NOT $$IsSysNameEqual:NotApplicable:@@HxcVoucherDefaultName Then $$HxcFormatVoucherContactChoice:@@HxcVoucherBuyerAddress:@@HxcVoucherDefaultName:@@HxcVoucherDefaultMobile:@@HxcVoucherDefaultCountry Else ""

[Function: Hxc Voucher Address Recipient]
    Parameter : Buyer : String
    Parameter : Address : String
    Parameter : Kind : String
    Returns : String
    Variable : Detail : String
    01 : SET : Address : $$Upper:##Address
    10 : IF : ##Kind = "Name"
    11 :    SET : Detail : $(Ledger, ##Buyer).LedMultiAddressList[1, ($$Upper:$AddressName = ##Address)].AddrTypeContactPerson
    12 :    RETURN : If $$IsEmpty:##Detail Then $(Ledger, ##Buyer).LedMultiAddressList[1, ($$Upper:$AddressName = ##Address)].ContactPerson Else ##Detail
    13 : END IF
    20 : IF : ##Kind = "Country"
    21 :    SET : Detail : $(Ledger, ##Buyer).LedMultiAddressList[1, ($$Upper:$AddressName = ##Address)].CountryISDCode
    22 :    RETURN : If $$IsEmpty:##Detail Then $(Ledger, ##Buyer).LedMultiAddressList[1, ($$Upper:$AddressName = ##Address)].AddrTypeMobileCountryCode Else ##Detail
    23 : END IF
    30 : IF : ##Kind = "Mobile"
    31 :    SET : Detail : $(Ledger, ##Buyer).LedMultiAddressList[1, ($$Upper:$AddressName = ##Address)].MobileNumber
    32 :    RETURN : If $$IsEmpty:##Detail Then $(Ledger, ##Buyer).LedMultiAddressList[1, ($$Upper:$AddressName = ##Address)].AddrTypeMobileNumber Else ##Detail
    33 : END IF
    40 : IF : ##Kind = "Email"
    41 :    SET : Detail : $(Ledger, ##Buyer).LedMultiAddressList[1, ($$Upper:$AddressName = ##Address)].Email
    42 :    RETURN : If $$IsEmpty:##Detail Then $(Ledger, ##Buyer).LedMultiAddressList[1, ($$Upper:$AddressName = ##Address)].AddrTypeEMail Else ##Detail
    43 : END IF
    50 : RETURN : ""

[Function: Hxc Populate Recipient Draft]
    01 : SET : HxcRecipientDraftName : If @@HxcVoucherSavedContactMatches Then $HxcVoucherContactName Else If @@HxcInvoiceContactVisible Then "" Else @@HxcVoucherDefaultName
    02 : SET : HxcRecipientDraftCountry : If @@HxcVoucherSavedContactMatches Then $HxcVoucherContactCountry Else If @@HxcInvoiceContactVisible Then "" Else @@HxcVoucherDefaultCountry
    03 : SET : HxcRecipientDraftMobile : If @@HxcVoucherSavedContactMatches Then $HxcVoucherContactMobile Else If @@HxcInvoiceContactVisible Then "" Else @@HxcVoucherDefaultMobile
    04 : SET : HxcRecipientDraftEmail : If @@HxcVoucherSavedContactMatches Then $HxcVoucherContactEmail Else If @@HxcInvoiceContactVisible Then "" Else @@HxcVoucherDefaultEmail
    05 : SET : HxcRecipientDraftLedger : @@HxcVoucherRecipientScope

[Function: Hxc Clear Recipient Draft]
    01 : SET : HxcRecipientDraftLedger : ""
    02 : SET : HxcRecipientDraftName : ""
    03 : SET : HxcRecipientDraftCountry : ""
    04 : SET : HxcRecipientDraftMobile : ""
    05 : SET : HxcRecipientDraftEmail : ""

[Function: Hxc Format Voucher Contact Choice]
    Parameter : Address : String
    Parameter : Name : String
    Parameter : Mobile : String
    Parameter : Country : String
    Returns : String
    Variable : Phone : String
    01 : SET : Phone : $$HxcPreviewLedgerNumber:##Mobile:##Country
    02 : IF : $$IsEmpty:##Phone AND NOT $$IsEmpty:##Mobile
    03 :    SET : Phone : If $$StringPart:##Mobile:0:1 = "+" Then ##Mobile Else ("+" + $$HxcDialingDigits:##Mobile)
    04 : END IF
    05 : IF : $$IsEmpty:##Name
    06 :    RETURN : ""
    07 : END IF
    08 : RETURN : ##Address + " . " + ##Name + If $$IsEmpty:##Phone Then "" Else (" . " + ##Phone)

[Function: Hxc Voucher Contact Address From Key]
    Parameter : Key : String
    Parameter : Fallback : String
    Returns : String
    Variable : Kind : String
    Variable : Address : String
    Variable : Index : Number
    01 : IF : $$IsEmpty:##Key
    02 :    RETURN : ##Fallback
    03 : END IF
    04 : SET : Index : 0
    05 : FOR TOKEN : Part : ##Key : "|"
    06 :    INCREMENT : Index
    07 :    IF : ##Index = 2
    08 :       SET : Kind : ##Part
    09 :    END IF
    10 :    IF : ##Index = 3
    11 :       SET : Address : ##Part
    12 :    END IF
    13 : END FOR
    14 : IF : ##Kind = "Primary"
    15 :    RETURN : "Primary"
    16 : END IF
    17 : IF : ##Kind = "Mobile"
    18 :    RETURN : "Additional Mobile"
    19 : END IF
    20 : IF : ##Kind = "Address" AND NOT $$IsEmpty:##Address
    21 :    RETURN : ##Address
    22 : END IF
    23 : RETURN : ##Fallback

[Color: Hxc Recipient Dark Orange]
    RGB : 184, 83, 0

[Function: Hxc Valid Dialing Code]
    Parameter : Code : String
    Returns : Logical
    Variable : Position : Number
    Variable : Length : Number
    01 : SET : Position : If $$StringPart:##Code:0:1 = "+" Then 1 Else 0
    02 : SET : Length : $$StringLength:##Code
    03 : IF : ##Length <= ##Position OR (##Length - ##Position) > 3
    04 :    RETURN : No
    05 : END IF
    06 : WHILE : ##Position < ##Length
    07 :    IF : NOT $$IsNumber:($$StringPart:##Code:##Position:1)
    08 :       RETURN : No
    09 :    END IF
    10 :    INCREMENT : Position
    11 : END WHILE
    12 : RETURN : Yes


;; Helixcer voucher WhatsApp dispatch
[#Report: Voucher]
    Variable : HxcVoucherFooterContext
    Set : HxcVoucherFooterContext : ""

[Variable: HxcVoucherFooterContext]
    Type : String

[#Form: Voucher]
    Add : Button : Hxc Send Voucher Button, Hxc Refresh Voucher WhatsApp Status
    Add : Key : Hxc Voucher PDF Export Test
    Add : Part : At End : Hxc Voucher Save Identity
    Add : On : At Beginning : Form Accept : Yes : CALL : Hxc Capture Voucher Send
    Add : On : At Beginning : Form Accept : ##HxcSendNewVoucher : Set Object Values : HxcVoucherSendSaveToken : ##HxcSendSaveToken
    Add : On : At End : Form Accept : Yes : Form Accept
    Add : On : At End : Form Accept : Yes : CALL : Hxc Send Newly Saved Voucher

[Part: Hxc Voucher Save Identity]
    Line : Hxc Voucher Save Identity

[Line: Hxc Voucher Save Identity]
    Field : Hxc Voucher Save Identity

[Field: Hxc Voucher Save Identity]
    Use : Name Field
    Storage : HxcVoucherSendSaveToken
    Set as : If $$InCreateMode Then $$MakeUniqueID Else $HxcVoucherSendSaveToken
    Set Always : No
    Invisible : Yes
    Skip : Yes

[Key: Hxc Voucher PDF Export Test]
    Key : Ctrl + Shift + F9
    Mode : Both
    Action : CALL : Hxc Test Export Saved Voucher PDF

[Function: Hxc Test Export Saved Voucher PDF]
    Variable : PdfPath : String
    01 : IF : NOT $$InAlterMode OR $$IsEmpty:$MasterID OR $$IsEmpty:$GUID
    02 :    MSG BOX : "Voucher PDF Test" : "Open a saved voucher in alteration mode first."
    03 :    RETURN
    04 : END IF
    041 : IF : $$IsEmpty:@@HxcVoucherPDFFolder
    042 :    MSG BOX : "Voucher PDF Test" : "Set PDF Export Folder in Helixcer Chat > General Settings first."
    043 :    RETURN
    044 : END IF
    05 : SET : PdfPath : $$HxcExportSavedVoucherReport:@@HxcVoucherPDFFolder:("Voucher-pdf-test-" + $$MakeUniqueID + ".pdf"):($$SysName:PDF)
    06 : OPEN FILE : ##PdfPath : Text : Read
    07 : IF : NOT $$LastResult
    08 :    MSG BOX : "Voucher PDF Test" : ("PDF was not created at:" + $$NewLine + ##PdfPath)
    09 :    RETURN
    10 : END IF
    11 : CLOSE FILE
    12 : MSG BOX : "Voucher PDF Test" : ("PDF created at:" + $$NewLine + ##PdfPath)

[Function: Hxc Export Saved Voucher Report]
    Parameter : PdfFolder : String
    Parameter : PdfName : String
    Parameter : ExportFormat : String
    Returns : String
    Variable : OriginalOpenAfterExport : Logical
    Variable : SVPrintLog : Logical
    Variable : SVExportLocation : String
    Variable : OriginalExportFormat : String
    Variable : OriginalPrintFileName : String
    Variable : PdfPath : String
    01 : SET : OriginalExportFormat : ##SVExportFormat
    02 : SET : OriginalPrintFileName : ##SVPrintFileName
    03 : SET : PdfPath : ##PdfFolder + "\" + ##PdfName
    04 : SET : SVExportFormat : ##ExportFormat
    05 : SET : SVPrintFileName : ##PdfPath
    051 : SET : OriginalOpenAfterExport : ##SVOpenFileAfterExport
    06 : SET : SVOpenFileAfterExport : No
    07 : SET : SVPrintLog : No
    08 : SET : SVExportLocation : ##PdfFolder
    081 : SET : HxcQuietVoucherPDFExport : Yes
    09 : EXPORT REPORT : Printed Invoice : Yes
    0901 : SET : HxcQuietVoucherPDFExport : No
    091 : SET : SVOpenFileAfterExport : ##OriginalOpenAfterExport
    10 : SET : SVPrintFileName : ##OriginalPrintFileName
    11 : SET : SVExportFormat : ##OriginalExportFormat
    12 : RETURN : ##PdfPath

[#Report: Printed Invoice]
    Option : Hxc Quiet Voucher PDF Export : ##HxcQuietVoucherPDFExport

[!Report: Hxc Quiet Voucher PDF Export]
    Local : Form : Printed Invoice : Open After Export : No
    Local : Form : Printed Invoice : Set Always : SVOpenFileAfterExport : No
    Variable : SVOpenFileAfterExport
    Set : SVOpenFileAfterExport : No

[Variable: HxcQuietVoucherPDFExport]
    Type : Logical

[System: Variable]
    HxcQuietVoucherPDFExport : No

[Button: Hxc Refresh Voucher WhatsApp Status]
    Title : "Refresh WhatsApp Status"
    Key : Alt + R
    Mode : Both
    Action Ex : FetchLatest : CALL : Hxc Refresh Last WhatsApp Status
    Action Ex : RedrawFooter : Refresh

[Function: Hxc Refresh Last WhatsApp Status]
    Variable : MessageId : String
    Variable : MessageDate : Date
    001 : IF : NOT $$IsEmpty:##HxcVoucherPendingFooter AND ##HxcVoucherPendingWorkspace = ($$HxcReadConnectorProfile:No) AND ##HxcVoucherPendingBaseline = ($$HxcReadLatestWhatsAppEntryKey)
    002 :    RETURN
    003 : END IF
    01 : WALK COLLECTION : Hxc Latest WhatsApp History
    02 :    IF : @@HxcLastWhatsAppFooterStatus != "Read" AND @@HxcLastWhatsAppFooterStatus != "Failed"
    03 :       SET : MessageId : @@HxcVoucherRefreshLookupKey
    04 :       SET : MessageDate : $$Date:(($$StringPart:$SentAt:8:2) + "-" + ($$StringPart:$SentAt:5:2) + "-" + ($$StringPart:$SentAt:0:4))
    05 :    END IF
    06 :    BREAK
    07 : END WALK
    08 : IF : NOT $$IsEmpty:##MessageId AND NOT $$IsEmpty:##MessageDate
    09 :    CALL : Hxc Request History Status : ##MessageDate : ##MessageDate : ##MessageId
    10 : END IF

[Button: Hxc Send Voucher Button]
    Title : "Send WhatsApp"
    Key : Alt + W
    Mode : Both
    Action Ex : SendVoucher : CALL : Hxc Send Saved Voucher : No
    Action Ex : RedrawFooter : Refresh

[System: Formula]
    Hxc Send Voucher Party Entry : $LedgerName = $$Owner:$PartyLedgerName
    Hxc Send Voucher Debit Entry : $$IsDr:$Amount
    Hxc Voucher Send Enabled : $HxcVtEnabled:VoucherType:$VoucherTypeName AND ($HxcVtWhatsAppEnabled:VoucherType:$VoucherTypeName = "Yes")

[Function: Hxc Capture Voucher Send]
    Variable : HxcVtMasterName : String
    Variable : AutoSendAfterSave : Logical
    001 : SET : HxcSendNewVoucher : No
    002 : SET : HxcSendConfirmOnSave : No
    003 : SET : HxcVtMasterName : @@HxcContactVoucherType
    004 : IF : $$IsEmpty:##HxcVtMasterName OR NOT ($HxcVtEnabled:VoucherType:##HxcVtMasterName) OR NOT ($HxcVtWhatsAppEnabled:VoucherType:##HxcVtMasterName = "Yes")
    005 :    RETURN
    006 : END IF
    007 : SET : AutoSendAfterSave : $HxcVtAuto:VoucherType:##HxcVtMasterName
    008 : SET : HxcSendConfirmOnSave : $HxcVtConfirm:VoucherType:##HxcVtMasterName
    00 : SET : HxcSendAlterVoucher : $$InAlterMode
    01 : SET : HxcSendNewVoucher : ($$InCreateMode OR ##HxcSendAlterVoucher) AND ##AutoSendAfterSave
    02 : IF : ##HxcSendNewVoucher
    03 :    SET : HxcSendSaveToken : If $$InCreateMode AND NOT $$IsEmpty:#HxcVoucherSaveIdentity Then #HxcVoucherSaveIdentity Else $$MakeUniqueID
    04 :    SET : HxcSendSaveDate : If $$IsEmpty:$Date Then $$ReportObject:$Date Else $Date
    041 :    SET : HxcSendSaveGuid : If $$IsEmpty:$GUID Then $$ReportObject:$GUID Else $GUID
    042 :    SET : HxcSendSaveMasterId : If $$IsEmpty:$MasterID Then $$ReportObject:$MasterID Else $MasterID
    05 : END IF

[Function: Hxc Send Newly Saved Voucher]
    Variable : SVFromDate : Date
    Variable : SVToDate : Date
    Variable : VerifiedVoucherFound : Logical
    001 : IF : NOT ##HxcSendNewVoucher
    002 :    RETURN
    003 : END IF
    01 : SET : HxcSendNewVoucher : No
    02 : SET : SVFromDate : ##HxcSendSaveDate
    03 : SET : SVToDate : ##HxcSendSaveDate
    031 : IF : $$IsEmpty:##HxcSendSaveGuid AND NOT $$IsEmpty:$GUID
    032 :    SET : HxcSendSaveGuid : $GUID
    033 : END IF
    04 : WALK COLLECTION : Hxc Newly Saved Voucher
    041 :    SET : VerifiedVoucherFound : Yes
    042 :    IF : ##HxcSendAlterVoucher AND ##HxcSendLastAttempt = $GUID
    043 :       SET : HxcSendLastAttempt : ""
    044 :    END IF
    05 :    CALL : Hxc Dispatch Voucher Whatsapp : Yes : $GUID
    06 : END WALK
    07 : SET : HxcSendSaveToken : ""
    08 : IF : NOT ##VerifiedVoucherFound AND NOT $$IsEmpty:$GUID AND NOT $$IsEmpty:$MasterID AND $Date = ##HxcSendSaveDate
    081 :    IF : ##HxcSendAlterVoucher AND ##HxcSendLastAttempt = $GUID
    082 :       SET : HxcSendLastAttempt : ""
    083 :    END IF
    09 :    CALL : Hxc Send Saved Voucher : Yes
    10 : ELSE
    11 :    IF : NOT ##VerifiedVoucherFound AND ##HxcSendConfirmOnSave
    12 :       MSG BOX : "Helixcer WhatsApp" : "The saved voucher could not be verified for the WhatsApp preview. Open it from Day Book and use Send WhatsApp."
    13 :    END IF
    14 : END IF

[Collection: Hxc Newly Saved Voucher]
    Type : Voucher
    Fetch : MasterID, GUID, Date, VoucherNumber, VoucherTypeName, IsCancelled, IsOptional, HxcVoucherSendSaveToken, HxcProvidePartyDetails, HxcSettlementPartyLedger, HxcSettlementAddress, HxcVoucherContactName, HxcVoucherContactScope, HxcVoucherContactMobile, HxcVoucherContactCountry, HxcVoucherContactEmail, PartyLedgerName, BasicBuyerName, PartyAddressType, PartyMailingName, Narration, Amount, AllLedgerEntries.LedgerName, AllLedgerEntries.Amount
    Filter : Hxc Send Save Token Matches

[System: Formula]
    Hxc Send Save Token Matches : NOT $$IsEmpty:##HxcSendSaveToken AND NOT $$IsEmpty:$MasterID AND NOT $$IsEmpty:$GUID AND ($HxcVoucherSendSaveToken = ##HxcSendSaveToken OR (NOT $$IsEmpty:##HxcSendSaveGuid AND $GUID = ##HxcSendSaveGuid) OR (##HxcSendAlterVoucher AND ##HxcSendSaveMasterId > 0 AND $MasterID = ##HxcSendSaveMasterId))

[Variable: HxcSendConfirmOnSave]
    Type : Logical

[Variable: HxcSendAlterVoucher]
    Type : Logical

[Variable: HxcSendSaveToken]
    Type : String

[Variable: HxcSendSaveGuid]
    Type : String

[Variable: HxcSendSaveMasterId]
    Type : Number

[Variable: HxcSendSaveDate]
    Type : Date

[System: Variable]
    HxcSendSaveToken : ""
    HxcSendAlterVoucher : No
    HxcSendConfirmOnSave : No
    HxcSendSaveDate : 0
    HxcSendSaveGuid : ""
    HxcSendSaveMasterId : 0

[Function: Hxc Send Saved Voucher]
    Parameter : Automatic : Logical
    Variable : SVFromDate : Date
    Variable : SVToDate : Date
    Variable : VoucherFound : Logical
    01 : IF : $$IsEmpty:$MasterID OR $$IsEmpty:$GUID
    02 :    MSG BOX : "Helixcer WhatsApp" : "Save the voucher before sending WhatsApp."
    03 :    RETURN
    04 : END IF
    05 : SET : HxcSendLookupGuid : $GUID
    06 : SET : SVFromDate : $Date
    07 : SET : SVToDate : $Date
    08 : SET : VoucherFound : No
    09 : WALK COLLECTION : Hxc Saved Voucher For Manual Send
    10 :    SET : VoucherFound : Yes
    11 :    CALL : Hxc Dispatch Voucher Whatsapp : ##Automatic : $GUID
    12 : END WALK
    13 : SET : HxcSendLookupGuid : ""
    14 : IF : NOT ##VoucherFound
    15 :    MSG BOX : "Helixcer WhatsApp" : "The saved voucher could not be found in the current company."
    16 : END IF

[Collection: Hxc Saved Voucher For Manual Send]
    Type : Voucher
    Fetch : GUID, MasterID, Date, VoucherNumber, VoucherTypeName, IsCancelled, IsOptional, HxcProvidePartyDetails, HxcSettlementPartyLedger, HxcSettlementAddress, HxcVoucherContactName, HxcVoucherContactScope, HxcVoucherContactMobile, HxcVoucherContactCountry, HxcVoucherContactEmail, PartyLedgerName, BasicBuyerName, PartyAddressType, PartyMailingName, Narration, Amount, AllLedgerEntries.LedgerName, AllLedgerEntries.Amount
    Filter : Hxc Send Lookup Guid Matches

[System: Formula]
    Hxc Send Lookup Guid Matches : NOT $$IsEmpty:##HxcSendLookupGuid AND $GUID = ##HxcSendLookupGuid

[Variable: HxcSendLookupGuid]
    Type : String

[System: Variable]
    HxcSendLookupGuid : ""

[Function: Hxc Read Voucher Send Template]
    Parameter : VoucherTypeName : String
    01 : SET : HxcSendPreviewText : $HxcVtPreview:VoucherType:##VoucherTypeName
    02 : SET : HxcSendTemplate : $HxcVtTemplate:VoucherType:##VoucherTypeName
    03 : SET : HxcSendLanguage : $HxcVtLanguage:VoucherType:##VoucherTypeName
    04 : IF : $$IsEmpty:##HxcSendTemplate OR $$IsEmpty:##HxcSendLanguage
    05 :    WALK COLLECTION : Hxc Vt Selected Settings
    051 :    IF : $Name = ##VoucherTypeName
    06 :       SET : HxcSendTemplate : $HxcVtTemplate
    07 :       SET : HxcSendLanguage : $HxcVtLanguage
    071 :      BREAK
    072 :   END IF
    08 :    END WALK
    09 : END IF
    10 : IF : NOT $$IsEmpty:##HxcSendTemplate AND $$IsEmpty:##HxcSendLanguage
    11 :    SET : HxcSendLanguage : "en"
    12 : END IF

[Function: Hxc Dispatch Voucher Whatsapp]
    Parameter : Automatic : Logical
    Parameter : VoucherGuid : String
    Variable : VchType : String
    Variable : RawMobile : String
    Variable : Code : String
    Variable : HeaderKind : String
    Variable : ErrorText : String
    Variable : PreviewAccepted : Logical
    Variable : NeedsConfirmation : Logical
    Variable : SavedMaps : String
    Variable : Unresolved : String
    Variable : QueuedCount : Number
    Variable : FailedCount : Number
    Variable : PdfName : String
    Variable : PdfPath : String
    Variable : RequestPath : String
    Variable : PendingRequests : String
    Variable : LastQueuedRecipient : String
    02 : IF : NOT @@HxcVoucherSendEnabled OR $IsCancelled OR $IsOptional
    021 :    IF : NOT ##Automatic
    022 :       MSG BOX : "Helixcer WhatsApp" : "WhatsApp is available for enabled vouchers that are neither cancelled nor optional."
    023 :    END IF
    03 :    RETURN
    04 : END IF
    05 : IF : ##Automatic AND ##HxcSendLastAttempt = ##VoucherGuid
    06 :    RETURN
    07 : END IF
    08 : SET : VchType : $VoucherTypeName
    081 : SET : NeedsConfirmation : NOT ##Automatic OR $HxcVtConfirm:VoucherType:##VchType
    09 : IF : ##Automatic AND NOT $HxcVtAuto:VoucherType:##VchType
    10 :    RETURN
    11 : END IF
    111 : SET : RawMobile : $HxcVoucherContactMobile
    112 : IF : $$IsEmpty:##RawMobile AND NOT ##NeedsConfirmation
    113 :    RETURN
    114 : END IF
    12 : CALL : Hxc Sync From Connector
    13 : CALL : Hxc Read Voucher Send Template : ##VchType
    15 : SET : HeaderKind : $HxcVtHeaderKind:VoucherType:##VchType
    18 : SET : Code : If $$IsEmpty:$HxcVoucherContactCountry Then @@HxcCompanyDefaultCountryCode Else $HxcVoucherContactCountry
    19 : SET : HxcSendTo : $$HxcNormalizePreviewMobile:##RawMobile:##Code
    20 : SET : HxcSendReference : ##VoucherGuid
    21 : SET : ErrorText : ""
    220 : IF : $$IsEmpty:##ErrorText AND ($$IsEmpty:##HxcSysWorkspaceId OR $$IsEmpty:##HxcSysChannelId)
    221 :    SET : ErrorText : "Configure the connection in Helixcer for TallyPrime Setup before sending."
    222 : END IF
    223 : IF : $$IsEmpty:##ErrorText AND ($$IsEmpty:##HxcSendTemplate OR $$IsEmpty:##HxcSendLanguage)
    224 :    SET : ErrorText : ("No saved WhatsApp template was found for " + ##VchType + ". Open Alter Helixcer Chat WhatsApp for that voucher type and verify the saved template.")
    225 : END IF
    2251 : IF : $$IsEmpty:##ErrorText AND @@HxcSettlementVoucher AND NOT $HxcProvidePartyDetails
    2252 :    SET : ErrorText : "Provide Party Details is set to No on the saved voucher."
    2253 : END IF
    2254 : IF : $$IsEmpty:##ErrorText AND @@HxcSettlementVoucher AND NOT $$IsEmpty:$HxcSettlementPartyLedger AND $$IsEmpty:@@HxcSettlementSavedParty AND NOT $$IsSysNameEqual:NotApplicable:$HxcSettlementPartyLedger
    2255 :    SET : ErrorText : "The saved Party Ledger is unavailable. Select the recipient ledger in Party Details."
    2256 : END IF
    2257 : IF : $$IsEmpty:##ErrorText AND @@HxcSettlementVoucher AND ##Automatic AND NOT ##NeedsConfirmation AND $$IsEmpty:$HxcVoucherContactScope
    2258 :    RETURN
    2259 : END IF
    22591 : IF : $$IsEmpty:##ErrorText AND @@HxcSettlementVoucher AND NOT $$IsEmpty:$HxcVoucherContactScope AND NOT ($HxcVoucherContactScope = @@HxcVoucherRecipientScope) AND NOT (@@HxcSettlementVoucher AND (NOT $$IsEmpty:@@HxcSettlementSavedParty) AND $HxcVoucherContactScope = (@@HxcSettlementSavedParty + "|" + @@HxcVoucherBuyerAddress))
    22592 :    SET : ErrorText : "The saved contact belongs to a different party or address. Confirm the recipient in Party Details."
    22593 : END IF
    226 : IF : $$IsEmpty:##ErrorText AND NOT ##NeedsConfirmation AND $$IsEmpty:##HxcSendTo
    227 :    SET : ErrorText : "Enter a valid international number in Party Details and save the voucher."
    228 : END IF
    229 : IF : $$IsEmpty:##ErrorText AND ##HeaderKind = "media" AND ($HxcVtMedia:VoucherType:##VchType <> "Voucher PDF" OR $$StringPart:($HxcVtPreview:VoucherType:##VchType):0:16 <> "[Media] DOCUMENT")
    230 :    SET : ErrorText : "This media send option requires a Document template configured with Voucher PDF."
    231 : END IF
    31 : IF : NOT $$IsEmpty:##ErrorText
    32 :    MSG BOX : "Helixcer WhatsApp" : ##ErrorText
    33 :    RETURN
    34 : END IF
    335 : IF : $$FileSize:@@HxcVoucherSenderExe <= 0
    336 :    MSG BOX : "Helixcer WhatsApp" : "The Windows sender is missing. Run Helixcer for TallyPrime Setup under this Windows account."
    337 :    RETURN
    338 : END IF
    340 : SET : HxcSendDocument : ##HeaderKind = "media"
    341 : SET : HxcSendMappingError : "A saved template mapping is invalid or ambiguous."
    342 : SET : SavedMaps : $HxcVtMaps:VoucherType:##VchType
    343 : IF : $$IsEmpty:##SavedMaps
    344 :    WALK COLLECTION : Hxc Vt Selected Settings
    3441 :      IF : $Name = ##VchType
    3442 :         SET : SavedMaps : $HxcVtMaps
    3443 :         BREAK
    3444 :      END IF
    3445 :   END WALK
    345 : END IF
    349 : SET : HxcPreviewRecipientLedger : If @@HxcSettlementVoucher OR $$IsEmpty:$PartyLedgerName Then @@HxcVoucherBuyerLedgerName Else $PartyLedgerName
    350 : SET : HxcPreviewRecipientNumbers : ""
    3501 : SET : HxcPreviewRecipientCount : 0
    3502 : LIST DELETE : HxcPreviewRecipientNames
    3503 : IF : ##NeedsConfirmation
    35031 :    CALL : Hxc Load Preview Ledger Contact Names
    3504 :    CALL : Hxc Cache Preview Ledger Contact Name : ##HxcSendTo : ($$HxcPreviewContactLabel:$HxcVoucherContactName:@@HxcVoucherBuyerAddress)
    35041 :    CALL : Hxc Append Preview Recipient : ##HxcSendTo : ($$HxcPreviewPickContactName:##HxcSendTo)
    3505 : END IF
    351 : SET : HxcSendPreviewOpen : ##NeedsConfirmation
    35 : CALL : Hxc Prepare Send Mappings : ##VchType : ##SavedMaps : No
    36 : IF : NOT $$LastResult
    361 :    SET : HxcSendPreviewOpen : No
    37 :    MSG BOX : "Helixcer WhatsApp" : ##HxcSendMappingError
    38 :    RETURN
    39 : END IF
    401 : IF : $$IsEmpty:##HxcSendPreviewText
    4011 :    SET : HxcSendPreviewText : $HxcVtPreview:VoucherType:##VchType
    4012 : END IF
    402 : IF : $$IsEmpty:##HxcSendPreviewText
    403 :       CALL : Hxc Run Connector Read : "preview" : ##HxcSendTemplate : ##HxcSendLanguage
    404 : END IF
    405 : IF : $$IsEmpty:##HxcSendPreviewText
    4051 :       SET : HxcSendPreviewOpen : No
    406 :       MSG BOX : "Helixcer WhatsApp" : "No message preview is available. Fetch and save the template before sending."
    407 :       RETURN
    408 : END IF
    4081 : SET : HxcSendPreviewFilename : ""
    4082 : IF : ##HxcSendDocument
    4083 :       SET : HxcSendPreviewFilename : $$HxcPreviewPDFName:($HxcVtPdfFileName:VoucherType:##VchType):$VoucherNumber
    4084 : END IF
    409 : SET : HxcSendPreviewOpen : Yes
    410 : CALL : Hxc Populate Send Preview
    41001 : SET : Unresolved : $$LastResult
    41002 : IF : NOT $$IsEmpty:##Unresolved
    41003 :    SET : HxcSendPreviewOpen : No
    41004 :    SET : HxcSendPreviewText : ""
    41005 :    MSG BOX : "Helixcer WhatsApp" : ("Missing mapping for " + ##Unresolved + " in " + ##VchType + ". Open Alter Helixcer Chat WhatsApp and save the mapping.")
    41006 :    RETURN
    41007 : END IF
    41008 : SET : PreviewAccepted : Yes
    41009 : IF : ##NeedsConfirmation
    41010 :    SET : HxcVoucherPreviewReopen : Yes
    41011 :    WHILE : ##HxcVoucherPreviewReopen
    41012 :       SET : HxcVoucherPreviewReopen : No
    41013 :       SET : HxcVoucherPreviewSendPressed : No
    41014 :       CALL : Hxc Trace Recipient Picker : "voucher-preview-open"
    411 :         EXECUTE : Hxc WhatsApp Send Preview
    412 :         SET : PreviewAccepted : $$LastResult AND ##HxcVoucherPreviewSendPressed
    41201 :    END WHILE
    4121 : END IF
    413 : SET : HxcSendPreviewOpen : No
    414 : SET : HxcSendPreviewText : ""
    4142 : SET : HxcSendPreviewFilename : ""
    42 : IF : NOT ##PreviewAccepted
    43 :       RETURN
    44 : END IF
    45 : IF : NOT ##NeedsConfirmation
    451 :    SET : HxcPreviewRecipientNumbers : ##HxcSendTo
    452 : END IF
    453 : IF : ##HxcSendDocument
    454 :    SET : PdfName : "Voucher-" + $$MakeUniqueID + ".pdf"
    455 : END IF
    46 : FOR TOKEN : RecipientToken : ##HxcPreviewRecipientNumbers : ","
    462 :    SET : HxcSendTo : ##RecipientToken
    463 :    CALL : Hxc Prepare Send Mappings : ##VchType : ##SavedMaps : No
    464 :    IF : NOT $$LastResult
    465 :       MSG BOX : "Helixcer WhatsApp" : ##HxcSendMappingError
    466 :       BREAK
    467 :    END IF
    468 :    SET : RequestPath : $$HxcWriteVoucherWhatsAppRequest:$VoucherNumber:##PdfName:No
    469 :    IF : NOT $$IsEmpty:##RequestPath
    471 :       INCREMENT : QueuedCount
    4711 :      SET : PendingRequests : If $$IsEmpty:##PendingRequests Then ##RequestPath Else ##PendingRequests + "|" + ##RequestPath
    4712 :      SET : LastQueuedRecipient : ##RecipientToken
    472 :    ELSE
    473 :       INCREMENT : FailedCount
    474 :    END IF
    475 : END FOR
    4751 : IF : ##HxcSendDocument AND ##QueuedCount > 0
    4752 :    SET : PdfPath : $$HxcExportSavedVoucherReport:@@HxcVoucherPDFFolder:##PdfName:($$SysName:PDF)
    4753 : END IF
    47531 : IF : ##QueuedCount > 0
    47532 :    SET : HxcVoucherPendingBaseline : $$HxcReadLatestWhatsAppEntryKey
    47533 : END IF
    4754 : FOR TOKEN : QueuedRequest : ##PendingRequests : "|"
    4756 :    CALL : Hxc Launch Voucher WhatsApp Request : ##QueuedRequest : $VoucherNumber : ##LastQueuedRecipient
    4757 :    SET : HxcSendLastAttempt : ##VoucherGuid
    4758 : END FOR
    476 : IF : ##QueuedCount > 0
    477 :    MSG BOX : "Helixcer WhatsApp" : (($$String:##QueuedCount) + " WhatsApp message(s) queued." + (If ##FailedCount > 0 Then " " + ($$String:##FailedCount) + " could not be queued." Else ""))
    478 : END IF

[Function: Hxc Dialing Digits]
    Parameter : PhoneText : String
    Returns : String
    Variable : Digits : String
    Variable : Character : String
    Variable : Offset : Number
    01 : SET : Offset : 0
    02 : WHILE : ##Offset < $$StringLength:##PhoneText
    03 :    SET : Character : $$StringPart:##PhoneText:##Offset:1
    04 :    IF : $$IsNumber:##Character
    05 :       SET : Digits : ##Digits + ##Character
    06 :    ELSE
    061 :       IF : NOT (##Character = " " OR ##Character = "-" OR ##Character = "(" OR ##Character = ")" OR (##Character = "+" AND ##Offset = 0))
    07 :          RETURN : ""
    071 :       END IF
    08 :    END IF
    09 :    INCREMENT : Offset
    10 : END WHILE
    11 : RETURN : ##Digits

[Function: Hxc Read Send Response]
    01 : WALK COLLECTION : Parameter Collection
    02 :    IF : NOT $$IsEmpty:$messageId
    03 :       SET : HxcSendMessageId : $messageId
    04 :    END IF
    05 :    IF : NOT $$IsEmpty:$requestId
    06 :       SET : HxcSendRequestId : $requestId
    07 :    END IF
    071 :    SET : HxcSendResponseStatus : $$String:$status
    072 :    IF : NOT $$IsEmpty:$message
    073 :       SET : HxcSendErrorMessage : $message
    074 :    END IF
    08 :    WALK COLLECTION : error
    09 :       IF : NOT $$IsEmpty:$code
    10 :          SET : HxcSendErrorCode : $code
    11 :       END IF
    111 :       IF : NOT $$IsEmpty:$message
    112 :          SET : HxcSendErrorMessage : $message
    113 :       END IF
    12 :       IF : NOT $$IsEmpty:$requestId
    13 :          SET : HxcSendRequestId : $requestId
    14 :       END IF
    15 :    END WALK
    16 : END WALK
    17 : RETURN : Yes

[Function: Hxc Resolve Voucher Total]
    Returns : String
    Variable : Total : Amount
    01 : SET : Total : $Amount
    02 : IF : ##Total = 0 AND NOT $$IsEmpty:$PartyLedgerName
    03 :    SET : Total : $$FilterAmtTotal:AllLedgerEntries:HxcSendVoucherPartyEntry:$Amount
    04 : END IF
    05 : IF : ##Total = 0
    06 :    SET : Total : $$FilterAmtTotal:AllLedgerEntries:HxcSendVoucherDebitEntry:$Amount
    07 : END IF
    08 : IF : ##Total = 0
    09 :    RETURN : ""
    10 : END IF
    11 : IF : ##Total < 0
    12 :    SET : Total : 0 - ##Total
    13 : END IF
    14 : RETURN : $$String:##Total

[Function: Hxc Resolve Voucher Send Value]
    Parameter : Label : String
    Returns : String
    1 : IF : ##Label = "Party Ledger Name"
    2 :    RETURN : $PartyLedgerName
    3 : END IF
    4 : IF : ##Label = "Party Name"
    5 :    RETURN : $PartyLedgerName
    6 : END IF
    7 : IF : ##Label = "Party Mailing Name"
    8 :    RETURN : If NOT $$IsEmpty:$PartyMailingName Then $PartyMailingName Else If NOT $$IsEmpty:($MailingName:Ledger:$PartyLedgerName) Then $MailingName:Ledger:$PartyLedgerName Else $PartyLedgerName
    9 : END IF
    10 : IF : ##Label = "Party Address"
    11 :    RETURN : ($Address:Address:First)
    12 : END IF
    13 : IF : ##Label = "Party Address 1"
    14 :    RETURN : $Address:Address:First
    15 : END IF
    16 : IF : ##Label = "Party Address 2"
    17 :    RETURN : $().Address[2].Address
    18 : END IF
    19 : IF : ##Label = "Party Address 3"
    20 :    RETURN : $().Address[3].Address
    21 : END IF
    22 : IF : ##Label = "Party State Name"
    23 :    RETURN : $StateName
    24 : END IF
    25 : IF : ##Label = "Party Country"
    26 :    RETURN : $CountryOfResidence
    27 : END IF
    28 : IF : ##Label = "Party Pincode"
    29 :    RETURN : $BasicBuyerPINCode
    30 : END IF
    31 : IF : ##Label = "Party GSTIN/UIN"
    32 :    RETURN : $PartyGSTIN
    33 : END IF
    34 : IF : ##Label = "Party Mobile"
    35 :    RETURN : If ##HxcSendPreviewOpen Then "(recipient mobile)" Else ##HxcSendTo
    36 : END IF
    37 : IF : ##Label = "Party Email"
    38 :    RETURN : $HxcVoucherContactEmail
    39 : END IF
    391 : IF : ##Label = "Contact Name"
    392 :    RETURN : If $$IsSysNameEqual:NotApplicable:$HxcVoucherContactName OR $HxcVoucherContactName = "Not Applicable" Then "" Else $HxcVoucherContactName
    393 : END IF
    394 : IF : ##Label = "Contact Mobile"
    395 :    RETURN : $HxcVoucherContactMobile
    396 : END IF
    397 : IF : ##Label = "Contact Email"
    398 :    RETURN : $HxcVoucherContactEmail
    399 : END IF
    40 : IF : ##Label = "Buyer Name"
    41 :    RETURN : $BasicBuyerName
    42 : END IF
    43 : IF : ##Label = "Consignee Name"
    44 :    RETURN : $ConsigneeName
    45 : END IF
    46 : IF : ##Label = "Company Name"
    47 :    RETURN : ##SVCurrentCompany
    48 : END IF
    49 : IF : ##Label = "Company Mailing Name"
    50 :    RETURN : $MailingName:Company:##SVCurrentCompany
    51 : END IF
    52 : IF : ##Label = "Company GSTIN"
    53 :    RETURN : $GSTRegistrationNumber:Company:##SVCurrentCompany
    54 : END IF
    55 : IF : ##Label = "Company State Name"
    56 :    RETURN : $StateName:Company:##SVCurrentCompany
    57 : END IF
    58 : IF : ##Label = "Voucher Number"
    59 :    RETURN : $VoucherNumber
    60 : END IF
    61 : IF : ##Label = "Voucher Date"
    62 :    RETURN : ($$String:$Date)
    63 : END IF
    64 : IF : ##Label = "Reference"
    65 :    RETURN : $Reference
    66 : END IF
    67 : IF : ##Label = "Narration"
    68 :    RETURN : $Narration
    69 : END IF
    70 : IF : ##Label = "Amount"
    71 :    RETURN : $$HxcResolveVoucherTotal
    72 : END IF
    73 : IF : ##Label = "Basic Buyer Name"
    74 :    RETURN : $BasicBuyerName
    75 : END IF
    76 : IF : ##Label = "Basic Buyer Address"
    77 :    RETURN : ($Address:Address:First)
    78 : END IF
    79 : IF : ##Label = "Basic Order Ref"
    80 :    RETURN : $BasicOrderRef
    81 : END IF
    82 : IF : ##Label = "Basic Order Terms"
    83 :    RETURN : $BasicOrderTerms
    84 : END IF
    85 : IF : ##Label = "Basic Ship Delivery Date"
    86 :    RETURN : ($$String:$BasicShipDeliveryDate)
    87 : END IF
    88 : IF : ##Label = "Basic Due Date"
    89 :    RETURN : ($$String:$BasicDueDate)
    90 : END IF
    91 : IF : ##Label = "Basic Base Value"
    92 :    RETURN : ($$String:$BasicBaseValue)
    93 : END IF
    94 : IF : ##Label = "Sales Person"
    95 :    RETURN : $SalesPerson
    96 : END IF
    97 : IF : ##Label = "Terms of Payment"
    98 :    RETURN : $BasicDueDateOfPymt
    99 : END IF
    100 : IF : ##Label = "Terms of Delivery"
    101 :    RETURN : $BasicOrderTerms
    102 : END IF
    103 : IF : ##Label = "Dispatch Through"
    104 :    RETURN : $BasicShipVia
    105 : END IF
    106 : IF : ##Label = "Destination"
    107 :    RETURN : $BasicFinalDestination
    108 : END IF
    109 : IF : ##Label = "Carrier Name"
    110 :    RETURN : $BasicShippedBy
    111 : END IF
    112 : IF : ##Label = "Bill of Lading"
    113 :    RETURN : $BasicShipDocumentNo
    114 : END IF
    115 : IF : ##Label = "Eway Bill Number"
    116 :    RETURN : $EWayBillNo
    117 : END IF
    118 : IF : ##Label = "IRN"
    119 :    RETURN : $IRN
    120 : END IF
    121 : IF : ##Label = "Guid"
    122 :    RETURN : $GUID
    123 : END IF
    124 : IF : ##Label = "Master ID"
    125 :    RETURN : ($$String:$MasterID)
    126 : END IF
    127 : RETURN : ""
 
