;; Helixcer Chat — TallyPrime TDL
;; BUILD: 420-contact-choice-above-narration
;; Title must show "(build 420)".
;;
;; Create draft is session Variables only (Name/Template/Lang + voucher slots).
;; Company Storage is used for saved HxcVoucherConfigs on Commit — never for Create UI.
;; Fetch reads ##HxcVcDraftTemplate after Modifies syncs the input field into the Variable.
;; Never read Company draft Storage for Create. Clear Fetch Vars does not wipe FetchName.
;;
;; Create Config flow:
;;   Config Name → Template → Language Enter (fetch) →
;;   Preview → Header (only if template has header) → Body maps (dynamic count) →
;;   Voucher types → Settings → Ctrl+A

;; ---------------------------------------------------------------------------
;; Company UDFs
;; ---------------------------------------------------------------------------

[System: UDF]
    HxcVoucherSendSaveToken : String : 25341
