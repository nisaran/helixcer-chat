;; Helixcer Chat — TallyPrime TDL
;;
;; Load in TallyPrime:
;;   F1 (Help) → TDL & Add-On → select this file → Enable → Yes
;; Or: Gateway of Tally → F4 (Manage Local TDLs) → add helixcer-chat.tdl

;; ---------------------------------------------------------------------------
;; Persistent settings (system scope → TallySav.Cfg)
;; Do NOT re-declare these on the Report with "Variable :"
;; ---------------------------------------------------------------------------

[Variable: HxcWorkspaceId]
    Type       : String
    Persistent : Yes

[Variable: HxcChannelId]
    Type       : String
    Persistent : Yes

[Variable: HxcApiKey]
    Type       : String
    Persistent : Yes

[Variable: HxcWorkspaceName]
    Type       : String
    Persistent : Yes

[Variable: HxcChannelName]
    Type       : String
    Persistent : Yes

[Variable: HxcConnectionStatus]
    Type       : String
    Persistent : Yes

[System: Variable]
    HxcWorkspaceId      : ""
    HxcChannelId        : ""
    HxcApiKey           : ""
    HxcWorkspaceName    : ""
    HxcChannelName      : ""
    HxcConnectionStatus : ""

[System: Formula]
    Hxc Connection Url  : "https://api.chat.helixcer.com/api/v1/connection?channelId=" + ##HxcChannelId
    Hxc Details Visible : If $$IsEmpty:##HxcWorkspaceName THEN No ELSE Yes
    Hxc Api Key Masked  : If $$IsEmpty:##HxcApiKey THEN "" ELSE "******"

;; ---------------------------------------------------------------------------
;; Request report — GET body ignored; Export Headers are what matter
;; ---------------------------------------------------------------------------

[Report: Hxc Connection Request]
    Form          : Hxc Connection Request
    Export Header : "Authorization: Bearer " + ##HxcApiKey
    Export Header : "X-Workspace-Id: " + ##HxcWorkspaceId
    Export Header : "Accept: application/json"

[Form: Hxc Connection Request]
    Part : Hxc Connection Request

[Part: Hxc Connection Request]
    Lines : Hxc Connection Request

[Line: Hxc Connection Request]
    Fields : Hxc Connection Request

[Field: Hxc Connection Request]
    Use    : Name Field
    Set as : ""
    Skip   : Yes

;; ---------------------------------------------------------------------------
;; Fetch connection (Tally Progress Bar = default loader)
;; ---------------------------------------------------------------------------

[Function: Hxc Apply Connection Response]
    Variable : Platform : String
    01 : SET : HxcWorkspaceName : ""
    02 : SET : HxcChannelName : ""
    03 : SET : HxcConnectionStatus : "Could not fetch names. Check IDs and API Key."
    04 : WALK COLLECTION : Parameter Collection
    05 :    IF : NOT $$IsEmpty:$workspaceName
    06 :       SET : Platform : $platformLabel
    07 :       IF : $$IsEmpty:##Platform
    08 :          SET : Platform : $connectorType
    09 :       END IF
    10 :       IF : $$IsEmpty:##Platform
    11 :          SET : Platform : "Channel"
    12 :       END IF
    13 :       SET : HxcWorkspaceName : $workspaceName
    14 :       SET : HxcChannelName : $channelName + " (" + ##Platform + ")"
    15 :       SET : HxcConnectionStatus : "Connected"
    16 :    END IF
    17 : END WALK
    18 : RETURN : Yes

[Function: Hxc Accept Api Key]
    Variable : Input Key : String
    01 : SET : Input Key : $Value
    02 : IF : $$IsEmpty:##Input Key OR ##Input Key = "******" OR ##Input Key = "********"
    03 :    ;; Mask accepted (no edit) — re-fetch with the saved key
    04 :    CALL : Hxc Fetch Connection
    05 :    RETURN : Yes
    06 : END IF
    07 : SET : HxcApiKey : ##Input Key
    08 : CALL : Hxc Fetch Connection
    09 : RETURN : Yes

[Function: Hxc Fetch Connection]
    01 : IF : $$IsEmpty:##HxcWorkspaceId OR $$IsEmpty:##HxcChannelId OR $$IsEmpty:##HxcApiKey
    02 :    SET : HxcWorkspaceName : ""
    03 :    SET : HxcChannelName : ""
    04 :    SET : HxcConnectionStatus : ""
    05 :    RETURN : No
    06 : END IF
    07 : SET : HxcWorkspaceName : ""
    08 : SET : HxcChannelName : ""
    09 : SET : HxcConnectionStatus : ""
    10 : Start Progress : 1 : "Helixcer Chat" : "Verifying connection" : "Fetching workspace and channel"
    11 : HTTP Request : @@HxcConnectionUrl : GET : JSON : UTF8 : Hxc Connection Request : Hxc Apply Connection Response
    12 : End Progress
    13 : IF : $$IsEmpty:##HxcWorkspaceName
    14 :    SET : HxcConnectionStatus : "Could not fetch names. Check IDs and API Key."
    15 : END IF
    16 : RETURN : Yes

;; ---------------------------------------------------------------------------
;; Gateway of Tally → Helixcer Chat
;; ---------------------------------------------------------------------------

[#Menu: Gateway of Tally]
    Add : Key Item : Before : @@LOCQuit : Helixcer Chat : H : Menu : Helixcer Chat Menu

[Menu: Helixcer Chat Menu]
    Title    : "Helixcer Chat"
    Key Item : API Settings : S : Modify Variable : Helixcer API Settings
    Key Item : About        : A : Display : Helixcer Chat About
    Key Item : Back         : B : Menu : Gateway of Tally

;; ---------------------------------------------------------------------------
;; API Settings
;; ---------------------------------------------------------------------------

[Report: Helixcer API Settings]
    Form  : Helixcer API Settings
    Title : "API Settings"
    Auto  : Yes

[Form: Helixcer API Settings]
    Part   : Helixcer API Settings
    Button : Form Accept, Form Cancel, Hxc Fetch Names Button
    ;; Rebuild when names arrive so blue detail lines appear
    Option : Hxc Settings Refresh : ##HxcWorkspaceName
    Option : Hxc Settings Refresh Status : ##HxcConnectionStatus

[!Form: Hxc Settings Refresh]
[!Form: Hxc Settings Refresh Status]

[Button: Hxc Fetch Names Button]
    Key    : Alt+V
    Title  : "Verify"
    Action : Call : Hxc Fetch Connection

[Part: Helixcer API Settings]
    Lines  : Hxc Api Settings Title, +
             Hxc Workspace Id Line, Hxc Channel Id Line, Hxc Api Key Line, +
             Hxc Details Spacer Line, +
             Hxc Connection Status Line, Hxc Workspace Name Line, Hxc Channel Name Line, +
             Hxc Save Hint Line, +
             Hxc Save Line
    Scroll : Vertical

[Line: Hxc Api Settings Title]
    Field : Hxc Api Settings Title

[Field: Hxc Api Settings Title]
    Use       : Name Field
    Set as    : "Helixcer Chat — API Settings"
    Style     : Bold
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

[Line: Hxc Workspace Id Line]
    Fields : Medium Prompt, Hxc Workspace Id
    Local  : Field : Medium Prompt : Set as : "Workspace ID"
    Local  : Field : Medium Prompt : Width  : 20

[Field: Hxc Workspace Id]
    Use      : Name Field
    Set as   : ##HxcWorkspaceId
    ;; No = save on Form Accept (avoids refresh wiping). SET also on leave for fetch.
    Modifies : HxcWorkspaceId : No
    Width    : 60
    Max      : 64
    On       : Accept : Yes : SET : HxcWorkspaceId : $Value
    On       : Accept : Yes : Field Accept

[Line: Hxc Channel Id Line]
    Fields : Medium Prompt, Hxc Channel Id
    Local  : Field : Medium Prompt : Set as : "Channel ID"
    Local  : Field : Medium Prompt : Width  : 20

[Field: Hxc Channel Id]
    Use      : Name Field
    Set as   : ##HxcChannelId
    Modifies : HxcChannelId : No
    Width    : 60
    Max      : 64
    On       : Accept : Yes : SET : HxcChannelId : $Value
    On       : Accept : Yes : Field Accept

[Line: Hxc Api Key Line]
    Fields : Medium Prompt, Hxc Api Key Password
    Local  : Field : Medium Prompt : Set as : "API Key"
    Local  : Field : Medium Prompt : Width  : 20

;; "Password" in the field name masks typed characters as *
;; Enter here must NOT close the form — Hxc Save Field is the last input field
[Field: Hxc Api Key Password]
    Use      : Name Field
    Set as   : @@HxcApiKeyMasked
    Width    : 60
    Max      : 200
    On       : Accept : Yes : Call : Hxc Accept Api Key
    On       : Accept : Yes : Field Accept

[Line: Hxc Details Spacer Line]
    Field     : Hxc Details Spacer
    Invisible : NOT @@HxcDetailsVisible

[Field: Hxc Details Spacer]
    Use       : Name Field
    Set as    : ""
    Skip      : Yes
    FullWidth : Yes

[Line: Hxc Connection Status Line]
    Fields    : Medium Prompt, Hxc Connection Status
    Local     : Field : Medium Prompt : Set as : "Status"
    Local     : Field : Medium Prompt : Width  : 20
    Local     : Field : Medium Prompt : Color  : Blue
    Invisible : NOT @@HxcDetailsVisible

[Field: Hxc Connection Status]
    Use       : Name Field
    Set as    : ##HxcConnectionStatus
    Set Always: Yes
    Color     : Blue
    Width     : 60
    Skip      : Yes

[Line: Hxc Workspace Name Line]
    Fields    : Medium Prompt, Hxc Workspace Name
    Local     : Field : Medium Prompt : Set as : "Workspace"
    Local     : Field : Medium Prompt : Width  : 20
    Local     : Field : Medium Prompt : Color  : Blue
    Invisible : NOT @@HxcDetailsVisible

[Field: Hxc Workspace Name]
    Use       : Name Field
    Set as    : ##HxcWorkspaceName
    Set Always: Yes
    Color     : Blue
    Width     : 60
    Skip      : Yes

[Line: Hxc Channel Name Line]
    Fields    : Medium Prompt, Hxc Channel Name
    Local     : Field : Medium Prompt : Set as : "Channel Name"
    Local     : Field : Medium Prompt : Width  : 20
    Local     : Field : Medium Prompt : Color  : Blue
    Invisible : NOT @@HxcDetailsVisible

[Field: Hxc Channel Name]
    Use       : Name Field
    Set as    : ##HxcChannelName
    Set Always: Yes
    Color     : Blue
    Width     : 60
    Skip      : Yes

[Line: Hxc Save Hint Line]
    Field     : Hxc Save Hint
    Invisible : NOT @@HxcDetailsVisible

[Field: Hxc Save Hint]
    Use       : Name Field
    Set as    : "Press Enter or Ctrl+A to save"
    Set Always: Yes
    Color     : Blue
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

;; Always last editable field so Enter on API Key only verifies (does not Form Accept)
[Line: Hxc Save Line]
    Fields : Medium Prompt, Hxc Save Field
    Local  : Field : Medium Prompt : Set as : If @@HxcDetailsVisible THEN "Save" ELSE " "
    Local  : Field : Medium Prompt : Width  : 20
    Local  : Field : Medium Prompt : Color  : Blue

[Field: Hxc Save Field]
    Use      : Name Field
    Set as   : If @@HxcDetailsVisible THEN "Yes" ELSE " "
    Set Always: Yes
    Width    : 10
    Max      : 10
    Color    : Blue
    Skip     : No
    On       : Accept : Yes : Field Accept
