    Action Ex : ClearGroup : Set : HxcReceivableGroup : ""
    Action Ex : MarkReopen : Set : HxcReceivableReopen : Yes
    Action Ex : ReopenReport : Form Reject

[Key: Hxc Select All Receivable Ledgers]
    Key : Ctrl + Space
    Action : Select All
    Mode : Display

[Key: Hxc Toggle Receivable Selection]
    Key : Space
    Action : Toggle Select
    Scope : Current Line
    Mode : Display

[Part: Hxc Party Receivable]
    Lines : Hxc Receivable Period, Hxc Receivable Active Group, Hxc Party Receivable Heading, Hxc Party Receivable Row
    Repeat : Hxc Party Receivable Row : Hxc Receivable Ledgers
    Scroll : Vertical

[Line: Hxc Receivable Period]
    Field : Hxc Receivable Period
    Selectable : No

[Field: Hxc Receivable Period]
    Use : Name Field
    Set as : "Period: " + ($$String:##SVFromDate) + " to " + ($$String:##SVToDate)
    Style : Normal
    Full Width : Yes
    Skip : Yes

[Line: Hxc Receivable Active Group]
    Field : Hxc Receivable Active Group
    Selectable : No

[Field: Hxc Receivable Active Group]
    Use : Name Field
    Set as : "Group: " + (If $$IsEmpty:##HxcReceivableGroup OR $$IsSysNameEqual:NotApplicable:##HxcReceivableGroup Then "All" Else ##HxcReceivableGroup)
    Style : Normal
    Full Width : Yes
    Skip : Yes

[Style: Hxc Receivable Heading Style]
    Use : Normal
    Bold : Yes

[Line: Hxc Party Receivable Heading]
    Fields : Hxc Receivable Ledger Heading, Hxc Receivable Ledger Group Heading, Hxc Receivable Contact Name Heading, Hxc Receivable Contact Number Heading, Hxc Receivable Balance Heading
    Selectable : No
    Border : Hxc Vt Mapping Row Divider

[Field: Hxc Receivable Ledger Heading]
    Use : Name Field
    Style : Hxc Receivable Heading Style
    Set as : "Party Ledger"
    Width : 31% Screen

[Field: Hxc Receivable Ledger Group Heading]
    Use : Name Field
    Style : Hxc Receivable Heading Style
    Set as : "Group"
    Width : 19% Screen

[Field: Hxc Receivable Contact Name Heading]
    Use : Name Field
    Style : Hxc Receivable Heading Style
    Set as : "Contact Name"
    Width : 18% Screen

[Field: Hxc Receivable Contact Number Heading]
    Use : Name Field
    Style : Hxc Receivable Heading Style
    Set as : "Contact No."
    Width : 15% Screen

[Field: Hxc Receivable Balance Heading]
    Use : Name Field
    Style : Hxc Receivable Heading Style
    Set as : "Closing Balance"
    Width : 18% Screen
    Align : Right

[Line: Hxc Party Receivable Row]
    Fields : Hxc Receivable Ledger, Hxc Receivable Ledger Group, Hxc Receivable Contact Name, Hxc Receivable Contact Number, Hxc Receivable Balance
    Selectable : Yes
    Border : Hxc Vt Mapping Row Divider
    Keys : Hxc Open Receivable Ledger On Enter, Hxc Open Receivable Ledger On Click

[Key: Hxc Open Receivable Ledger On Enter]
    Key : Enter
    Mode : Display
    Action : CALL : Hxc Open Receivable Ledger Outstandings : $Name

[Key: Hxc Open Receivable Ledger On Click]
    Use : Hxc Open Receivable Ledger On Enter
    Key : Left Click

[Function: Hxc Open Receivable Ledger Outstandings]
    Parameter : PartyLedger : String
    Variable : LedgerName : String
    01 : IF : NOT $$IsEmpty:##PartyLedger
    02 :    SET : LedgerName : ##PartyLedger
    03 :    DISPLAY : Hxc Receivable Ledger Outstandings
    04 : END IF

[Report: Hxc Receivable Ledger Outstandings]
    Use : Ledger Outstandings
    Set : SVFromDate : ##HxcReceivableFromDate
    Set : SVToDate : ##HxcReceivableToDate

[Field: Hxc Receivable Ledger]
    Use : Name Field
    Style : Normal
    Set as : $Name
    Quick Search : Yes
    Width : 31% Screen

[Field: Hxc Receivable Ledger Group]
    Use : Name Field
    Style : Normal
    Set as : $Parent
    Width : 19% Screen

[Field: Hxc Receivable Contact Name]
    Use : Name Field
    Style : Normal
    Set as : $LedgerContact:Ledger:$Name
    Width : 18% Screen

[Field: Hxc Receivable Contact Number]
    Use : Name Field
    Style : Normal
    Set as : $$HxcReminderMobile:$Name
    Width : 15% Screen


[Field: Hxc Receivable Balance]
    Use : Name Field
    Style : Normal
    Set as : $$HxcFormatReminderBalance:$ClosingBalance
    Align : Right
    Width : 18% Screen

[Collection: Hxc Receivable Ledgers]
    Collections : Hxc Receivable Debtors, Hxc Receivable Creditors
    Client Only : Yes
    Sort : Default : $Name

[Collection: Hxc Receivable Debtors]
    Type : Ledger
    Child Of : $$GroupSundryDebtors
    Belongs To : Yes
    Fetch : Name, Parent, ClosingBalance
    Client Only : Yes
    Filter : Hxc Has Debit Closing Balance, Hxc Receivable Row Matches Group

[Collection: Hxc Receivable Creditors]
    Use : Hxc Receivable Debtors
    Child Of : $$GroupSundryCreditors

[System: Formula]
    Hxc Has Debit Closing Balance : $$IsDr:$ClosingBalance AND $$Abs:$ClosingBalance > 0
    Hxc Receivable Group Is Selected : NOT $$IsEmpty:##HxcReceivableGroup AND NOT $$IsSysNameEqual:NotApplicable:##HxcReceivableGroup
    Hxc Receivable Row Matches Group : NOT @@HxcReceivableGroupIsSelected OR $Parent = ##HxcReceivableGroup
    Hxc Show Gateway Receivable : $HxcGatewayReceivable:Company:##SVCurrentCompany


[#Report: Group Outstandings]
    Local : Form : Default : Add : Button : Hxc Send Outstanding Reminder

[Button: Hxc Send Outstanding Reminder]
    Title : "Send WhatsApp Reminder"
    Key : Alt + W
    Action : CALL : Hxc Review Selected Reminder Ledgers : No

[Button: Hxc Send Receivable Reminder]
    Use : Hxc Send Outstanding Reminder
    Action : CALL : Hxc Review Selected Reminder Ledgers : Yes

[Collection: Hxc Selected Outstanding Ledgers]
    Data Source : Report : Selected Lines
    Fetch : Name, LedgerName, PartyLedgerName
    Client Only : Yes

[Variable: HxcReminderSelectedRows]
    Type : String

[Variable: HxcReminderSelectedCount]
    Type : Number

[System: Variable]
    HxcReminderSelectedRows : ""
    HxcReminderSelectedCount : 0
    HxcReminderEditRecipients : No
    HxcReminderFocusedLedger : ""
    HxcReminderReopenConfirmation : No
    List Variable : HxcReminderRecipientLists : String
    List Variable : HxcReminderCustomRecipients : String

[Variable: HxcReminderEditRecipients]
    Type : Logical

[Variable: HxcReminderFocusedLedger]
    Type : String

[Variable: HxcReminderReopenConfirmation]
    Type : Logical

[System: Formula]
    Hxc Reminder Selected Ledger Name : If NOT $$IsEmpty:($Name:Ledger:$LedgerName) Then $LedgerName Else If NOT $$IsEmpty:($Name:Ledger:$PartyLedgerName) Then $PartyLedgerName Else $Name
    Hxc Reminder Ledger On Row : $$HxcReminderLedgerAt:$$Line
    Hxc Reminder No Display Rows : "No selected ledger rows are available."

[Function: Hxc Reminder Ledger At]
    Parameter : WantedRow : Number
    Returns : String
    Variable : SelectedRow : Number
    01 : SET : SelectedRow : 0
    02 : FOR TOKEN : LedgerToken : ##HxcReminderSelectedRows : $$NewLine
    03 :    INCREMENT : SelectedRow
    04 :    IF : ##SelectedRow = ##WantedRow
    05 :       RETURN : ##LedgerToken
    06 :    END IF
    07 : END FOR
    08 : RETURN : ""

[Report: Hxc Confirm Outstanding Reminders]
    Form : Hxc Confirm Outstanding Reminders
    Title : "Send WhatsApp Reminder"

[Form: Hxc Confirm Outstanding Reminders]
    Width : 65% Screen
    Height : 48% Screen
    Background : Hxc Vt Page
    Parts : Hxc Reminder Confirmation Heading, Hxc Reminder Confirmation Rows
    Bottom Part : Hxc Reminder Confirmation Actions
    Control : Hxc Reminder No Display Rows : ##HxcReminderSelectedCount = 0

[Part: Hxc Reminder Confirmation Actions]
    Use : Hxc Send Preview Actions
    Option : Hxc Reminder Recipient Actions : ##HxcReminderEditRecipients

[!Part: Hxc Reminder Recipient Actions]
    Delete : Button : Hxc Send Preview Send
    Add : Button : At End : Hxc Edit Reminder Recipients, Hxc Send Receivable Reminders With Count

[Button: Hxc Send Receivable Reminders With Count]
    Use : Hxc Send Preview Send
    Title : "Send to " + ($$String:($$HxcReminderTotalRecipients)) + " Recipient(s)"
    Width : 24

[Part: Hxc Reminder Confirmation Heading]
    Lines : Hxc Reminder Confirmation Template, Hxc Reminder Confirmation Columns
    Background : Hxc Vt Section Band

[Line: Hxc Reminder Confirmation Template]
    Field : Hxc Reminder Confirmation Template

[Field: Hxc Reminder Confirmation Template]
    Use : Name Field
    Set as : "Template : " + ($HxcReminderTemplate:Company:##SVCurrentCompany) + (If ##HxcReminderEditRecipients Then "    |    Select a party's Contact No. and press F8 to edit recipients" Else "")
    Full Width : Yes
    Style : Normal
    Skip : Yes

[Part: Hxc Reminder Confirmation Rows]
    Line : Hxc Reminder Confirmation Row
    Repeat : Hxc Reminder Confirmation Row
    Set : ##HxcReminderSelectedCount
    Scroll : Vertical

[Line: Hxc Reminder Confirmation Row]
    Fields : Hxc Reminder Row Ledger, Hxc Reminder Row Name, Hxc Reminder Row Mobile, Hxc Reminder Row Balance
    Selectable : ##HxcReminderEditRecipients
    On : Focus : ##HxcReminderEditRecipients : SET : HxcReminderFocusedLedger : #HxcReminderRowLedger

[Button: Hxc Edit Reminder Recipients]
    Horizontal Align : Centre
    Title : "Edit Recipient(s)"
    Key : F8
    Width : 17
    Height : 2
    Skip Forward : Yes
    Inactive : $$IsEmpty:##HxcReminderFocusedLedger
    Action Ex : EditRecipients : CALL : Hxc Edit Reminder Recipients : ##HxcReminderFocusedLedger
    Action Ex : ReopenConfirmation : SET : HxcReminderReopenConfirmation : Yes
    Action Ex : CloseForReload : Form Accept

[Line: Hxc Reminder Confirmation Columns]
    Fields : Hxc Reminder Row Ledger, Hxc Reminder Row Name, Hxc Reminder Row Mobile, Hxc Reminder Row Balance
    Local : Field : Hxc Reminder Row Ledger : Set as : "Party Ledger"
    Local : Field : Hxc Reminder Row Name : Set as : "Primary Contact Name"
    Local : Field : Hxc Reminder Row Mobile : Set as : "Contact No."
    Local : Field : Hxc Reminder Row Mobile : Skip : Yes
    Local : Field : Hxc Reminder Row Balance : Set as : "Closing Balance"

[Field: Hxc Reminder Row Ledger]
    Use : Name Field
    Set as : @@HxcReminderLedgerOnRow
    Width : 23% Screen
    Option : Hxc Reminder Recipient Ledger Width : ##HxcReminderEditRecipients
    Style : Normal
    Skip : Yes

[Field: Hxc Reminder Row Name]
    Use : Name Field
    Set as : $LedgerContact:Ledger:@@HxcReminderLedgerOnRow
    Width : 17% Screen
    Option : Hxc Reminder Recipient Name Width : ##HxcReminderEditRecipients
    Style : Normal
    Skip : Yes

[Field: Hxc Reminder Row Mobile]
    Use : Name Field
    Set as : $$HxcReminderRecipientSummary:@@HxcReminderLedgerOnRow
    Set Always : Yes
    Width : 11% Screen
    Option : Hxc Reminder Recipient Mobile Width : ##HxcReminderEditRecipients
    Style : Normal
    Skip : NOT ##HxcReminderEditRecipients
    Read Only : Yes
    Word Wrap : Always : None : Yes

[!Field: Hxc Reminder Recipient Ledger Width]
    Width : 17% Screen

[!Field: Hxc Reminder Recipient Name Width]
    Width : 11% Screen

[!Field: Hxc Reminder Recipient Mobile Width]
    Width : 25% Screen

[Field: Hxc Reminder Row Balance]
    Use : Name Field
    Set as : $$HxcReminderClosingBalance:@@HxcReminderLedgerOnRow
    Width : 10% Screen
    Align : Right
    Style : Normal
    Skip : Yes

[Function: Hxc Reminder Mobile]
    Parameter : SelectedLedger : String
    Object : Ledger : ##SelectedLedger
    Returns : String
    Variable : Mobile : String
    Variable : Country : String
    01 : SET : Mobile : If NOT $$IsEmpty:$LedgerMobile Then $LedgerMobile Else If NOT $$IsEmpty:$MobileNumber Then $MobileNumber Else $AddrTypeMobileNumber
    02 : IF : $$IsEmpty:($$HxcDialingDigits:##Mobile)
    03 :    RETURN : ""
    04 : END IF
    05 : IF : $$StringPart:##Mobile:0:1 = "+"
    06 :    RETURN : "+" + $$HxcDialingDigits:##Mobile
    07 : END IF
    08 : SET : Country : If NOT $$IsEmpty:$LedgercountryISDcode Then $LedgercountryISDcode Else If NOT $$IsEmpty:$AddrTypeMobileCountryCode Then $AddrTypeMobileCountryCode Else If NOT $$IsEmpty:$CountryISDCode Then $CountryISDCode Else If $CountryName = "India" Then "+91" Else @@HxcCompanyDefaultCountryCode
    09 : RETURN : If $$IsEmpty:($$HxcDialingDigits:##Country) Then ##Mobile Else ("+" + $$HxcDialingDigits:##Country + $$HxcDialingDigits:##Mobile)

[Function: Hxc Reminder Closing Balance]
    Parameter : SelectedLedger : String
    Object : Ledger : ##SelectedLedger
    Returns : String
    01 : RETURN : $$HxcFormatReminderBalance:$ClosingBalance

[Function: Hxc Format Reminder Balance]
    Parameter : Balance : Amount
    Returns : String
    01 : RETURN : If $$Abs:##Balance = 0 Then "0" Else (($$StringFindAndReplace:($$String:##Balance):"(-)":"") + (If $$IsDr:##Balance Then " Dr" Else " Cr"))

[Function: Hxc Reminder Recipient List]
    Parameter : LedgerName : String
    Returns : String
    Variable : Numbers : String
    01 : SET : Numbers : $$ListValue:HxcReminderRecipientLists:##LedgerName
    02 : IF : $$IsEmpty:##Numbers
    03 :    RETURN : $$HxcReminderMobile:##LedgerName
    04 : END IF
    05 : RETURN : ##Numbers

[Function: Hxc Reminder Total Recipients]
    Returns : Number
    Variable : Numbers : String
    Variable : Total : Number
    01 : FOR TOKEN : SelectedLedger : ##HxcReminderSelectedRows : $$NewLine
    02 :    SET : Numbers : $$HxcReminderRecipientList:##SelectedLedger
    03 :    FOR TOKEN : RecipientNumber : ##Numbers : ","
    04 :       IF : NOT $$IsEmpty:##RecipientNumber
    05 :          INCREMENT : Total
    06 :       END IF
    07 :    END FOR
    08 : END FOR
    09 : RETURN : ##Total

[Function: Hxc Reminder Recipient Summary]
    Parameter : LedgerName : String
    Returns : String
    01 : RETURN : $$StringFindAndReplace:($$HxcReminderRecipientList:##LedgerName):",":", "

[Function: Hxc Edit Reminder Recipients]
    Parameter : LedgerName : String
    Variable : Numbers : String
    Variable : Digits : String
    Variable : Result : String
    Variable : RecipientKey : String
    01 : SET : HxcPreviewRecipientLedger : ##LedgerName
    02 : SET : HxcPreviewRecipientNumbers : ""
    03 : SET : HxcPreviewRecipientCount : 0
    04 : LIST DELETE : HxcPreviewRecipientNames
    05 : CALL : Hxc Load Preview Ledger Contact Names
    06 : SET : Numbers : $$HxcReminderRecipientList:##LedgerName
    07 : FOR TOKEN : Mobile : ##Numbers : ","
    08 :    SET : Digits : $$HxcDialingDigits:##Mobile
    081 :   SET : RecipientKey : ##LedgerName + "|" + ##Digits
    09 :    CALL : Hxc Append Preview Recipient : ##Digits : (If ($$ListValue:HxcReminderCustomRecipients:##RecipientKey) = "Yes" Then "Custom Number" Else $$HxcPreviewPickContactName:##Digits)
    10 : END FOR
    11 : CALL : Hxc Show Preview Checklist
    111 : IF : NOT $$LastResult
    112 :    RETURN
    113 : END IF
    12 : FOR TOKEN : Mobile : ##HxcPreviewRecipientNumbers : ","
    13 :    SET : Result : If $$IsEmpty:##Result Then "+" + ##Mobile Else ##Result + ",+" + ##Mobile
    131 :   SET : RecipientKey : ##LedgerName + "|" + ##Mobile
    132 :   LIST DELETE : HxcReminderCustomRecipients : ##RecipientKey
    133 :   IF : ($$ListValue:HxcPreviewRecipientNames:##Mobile) = "Custom Number"
    134 :      LIST ADD : HxcReminderCustomRecipients : ##RecipientKey : "Yes"
    135 :   END IF
    14 : END FOR
    15 : IF : NOT $$IsEmpty:##Result
    16 :    LIST DELETE : HxcReminderRecipientLists : ##LedgerName
    17 :    LIST ADD : HxcReminderRecipientLists : ##LedgerName : ##Result
    18 :    IF : ($$HxcReminderRecipientList:##LedgerName) <> ##Result
    21 :       MSG BOX : "Reminder Recipients" : "The recipient list could not be saved for this reminder."
    22 :    END IF
    23 : END IF

[Function: Hxc Review Selected Reminder Ledgers]
    Parameter : EditRecipients : Logical
    Variable : LedgerName : String
    Variable : Queued : Number
    Variable : Skipped : Number
    Variable : Failure : String
    Variable : FirstFailure : String
    Variable : Numbers : String
    Variable : ConfirmationAccepted : Logical
    List Variable : HxcReviewedReminderLedgers : String
    01 : SET : HxcReminderSelectedRows : ""
    011 : SET : HxcReminderSelectedCount : 0
    02 : WALK COLLECTION : Hxc Selected Outstanding Ledgers
    03 :    SET : LedgerName : @@HxcReminderSelectedLedgerName
    04 :    IF : NOT $$IsEmpty:##LedgerName AND NOT $$IsEmpty:($Name:Ledger:##LedgerName) AND $$IsEmpty:($$ListValue:HxcReviewedReminderLedgers:##LedgerName)
    05 :       LIST ADD : HxcReviewedReminderLedgers : ##LedgerName : ##LedgerName
    051 :      INCREMENT : HxcReminderSelectedCount
    052 :      SET : HxcReminderSelectedRows : If ##HxcReminderSelectedCount = 1 Then ##LedgerName Else (##HxcReminderSelectedRows + $$NewLine + ##LedgerName)
    06 :    END IF
    07 : END WALK
    08 : IF : ##HxcReminderSelectedCount = 0
    09 :    MSG BOX : "Outstanding Reminder" : "Press Space to select at least one ledger before sending a WhatsApp reminder."
    10 :    RETURN
    11 : END IF
    12 : IF : $$IsEmpty:($HxcReminderTemplate:Company:##SVCurrentCompany) OR $$IsEmpty:($HxcReminderPreview:Company:##SVCurrentCompany)
    13 :    MSG BOX : "Outstanding Reminder" : "Save an Outstanding Reminder template in Helixcer Chat first."
    14 :    RETURN
    15 : END IF
    151 : SET : HxcReminderEditRecipients : ##EditRecipients
    152 : LIST DELETE : HxcReminderRecipientLists
    1521 : LIST DELETE : HxcReminderCustomRecipients
    154 : SET : HxcReminderReopenConfirmation : Yes
    155 : WHILE : ##HxcReminderReopenConfirmation
    156 :    SET : HxcReminderReopenConfirmation : No
    157 :    SET : HxcReminderFocusedLedger : ""
    16 :     EXECUTE : Hxc Confirm Outstanding Reminders
    161 :    SET : ConfirmationAccepted : $$LastResult
    162 : END WHILE
    17 : IF : NOT ##ConfirmationAccepted
    18 :    SET : HxcReminderSelectedRows : ""
    181 :   SET : HxcReminderSelectedCount : 0
    19 :    RETURN
    20 : END IF
    21 : CALL : Hxc Sync From Connector
    22 : IF : $$IsEmpty:##HxcSysWorkspaceId OR $$IsEmpty:##HxcSysChannelId
    23 :    MSG BOX : "Outstanding Reminder" : "Configure the connection in Helixcer for TallyPrime Setup before sending."
    24 :    RETURN
    25 : END IF
    26 : IF : $$FileSize:@@HxcVoucherSenderExe <= 0
    27 :    MSG BOX : "Outstanding Reminder" : "Run Helixcer for TallyPrime Setup to install the Windows sender."
    28 :    RETURN
    29 : END IF
    30 : FOR TOKEN : SelectedLedger : ##HxcReminderSelectedRows : $$NewLine
    301 :   SET : Numbers : $$HxcReminderRecipientList:##SelectedLedger
    302 :   IF : $$IsEmpty:##Numbers
    303 :      INCREMENT : Skipped
    304 :      IF : $$IsEmpty:##FirstFailure
    305 :         SET : FirstFailure : ##SelectedLedger + " has no valid international mobile number."
    306 :      END IF
    307 :   ELSE
    308 :      FOR TOKEN : ReminderMobile : ##Numbers : ","
    31 :          CALL : Hxc Queue Ledger Reminder : ##SelectedLedger : ##ReminderMobile
    32 :          SET : Failure : $$LastResult
    33 :          IF : $$IsEmpty:##Failure
    34 :             INCREMENT : Queued
    35 :          ELSE
    36 :             INCREMENT : Skipped
    37 :             IF : $$IsEmpty:##FirstFailure
    38 :                SET : FirstFailure : ##Failure
    39 :             END IF
    40 :          END IF
    401 :      END FOR
    402 :   END IF
    41 : END FOR
    411 : LIST DELETE : HxcReminderRecipientLists
    412 : LIST DELETE : HxcReminderCustomRecipients
    42 : SET : HxcReminderSelectedRows : ""
    421 : SET : HxcReminderSelectedCount : 0
    43 : IF : ##Skipped > 0
    44 :    MSG BOX : "Outstanding Reminder" : (($$String:##Queued) + " queued. " + ($$String:##Skipped) + " skipped." + $$NewLine + ##FirstFailure)
    45 : ELSE
    46 :    MSG BOX : "Outstanding Reminder" : (($$String:##Queued) + " reminders queued.")
    47 : END IF

[Function: Hxc Queue Ledger Reminder]
    Parameter : ReminderLedger : String
    Parameter : Mobile : String
    Object : Ledger : ##ReminderLedger
    Returns : String
    Variable : MissingMapping : String
    Variable : ReminderMaps : String
    Variable : MappingsPrepared : Logical
    02 : SET : HxcSendTo : $$HxcDialingDigits:##Mobile
    03 : IF : $$StringPart:##Mobile:0:1 <> "+" OR $$StringLength:##HxcSendTo < 7 OR $$StringLength:##HxcSendTo > 15 OR $$StringPart:##HxcSendTo:0:1 = "0"
    04 :    RETURN : ##ReminderLedger + " has no valid international mobile number."
    05 : END IF
    06 : SET : HxcSendTemplate : $HxcReminderTemplate:Company:##SVCurrentCompany
    07 : SET : HxcSendLanguage : If $$IsEmpty:($HxcReminderLanguage:Company:##SVCurrentCompany) Then "en" Else $HxcReminderLanguage:Company:##SVCurrentCompany
    08 : SET : HxcSendDocument : No
    09 : SET : HxcSendReference : $$MakeUniqueID
    10 : SET : HxcSendMappingError : "A ledger template mapping is missing or invalid."
    11 : SET : ReminderMaps : $HxcReminderMaps:Company:##SVCurrentCompany
    111 : SET : MappingsPrepared : $$HxcPrepareSendMappings:"":##ReminderMaps:Yes
    12 : IF : NOT ##MappingsPrepared
    13 :    RETURN : ##ReminderLedger + ": " + ##HxcSendMappingError
    14 : END IF
    15 : SET : HxcSendPreviewText : $HxcReminderPreview:Company:##SVCurrentCompany
    16 : SET : HxcSendPreviewOpen : Yes
    17 : CALL : Hxc Populate Send Preview
    18 : SET : MissingMapping : $$LastResult
    19 : SET : HxcSendPreviewOpen : No
    20 : SET : HxcSendPreviewText : ""
    21 : IF : NOT $$IsEmpty:##MissingMapping
    22 :    RETURN : ##ReminderLedger + ": missing mapping for " + ##MissingMapping
    23 : END IF
    24 : CALL : Hxc Queue Voucher WhatsApp Send : ##ReminderLedger
    25 : IF : NOT $$LastResult
    26 :    RETURN : ##ReminderLedger + ": could not queue the reminder."
    27 : END IF
    28 : RETURN : ""

[Function: Hxc Resolve Reminder Ledger Value]
    Parameter : Label : String
    Returns : String
    1 : IF : ##Label = "Ledger Name" OR ##Label = "Party Ledger Name" OR ##Label = "Party Name"
    2 :    RETURN : $Name
    3 : END IF
    4 : IF : ##Label = "Mailing Name" OR ##Label = "Party Mailing Name"
    5 :    RETURN : If $$IsEmpty:$MailingName Then $Name Else $MailingName
    6 : END IF
    7 : IF : ##Label = "Alias"
    8 :    RETURN : $Alias
    9 : END IF
    10 : IF : ##Label = "Ledger Group"
    11 :    RETURN : $Parent
    12 : END IF
    13 : IF : ##Label = "Opening Balance"
    14 :    RETURN : If $$Abs:$OpeningBalance = 0 Then "0" Else $$String:($$Abs:$OpeningBalance)
    15 : END IF
    16 : IF : ##Label = "Opening Balance Type"
    17 :    RETURN : If $$Abs:$OpeningBalance = 0 Then "Nil" Else If $$IsDr:$OpeningBalance Then "Debit" Else "Credit"
    18 : END IF
    19 : IF : ##Label = "Closing Balance" OR ##Label = "Amount"
    20 :    RETURN : If $$Abs:$ClosingBalance = 0 Then "0" Else ($$StringFindAndReplace:($$String:$ClosingBalance):"(-)":"")
    21 : END IF
    22 : IF : ##Label = "Closing Balance Type" OR ##Label = "Balance Type"
    23 :    RETURN : If $$Abs:$ClosingBalance = 0 Then "Nil" Else If $$IsDr:$ClosingBalance Then "Debit" Else "Credit"
    24 : END IF
    25 : IF : ##Label = "Currency"
    26 :    RETURN : $CurrencyName
    27 : END IF
    28 : IF : ##Label = "Credit Limit"
    29 :    RETURN : If $$Abs:$CreditLimit = 0 Then "0" Else $$String:($$Abs:$CreditLimit)
    30 : END IF
    31 : IF : ##Label = "Credit Period"
    32 :    RETURN : $$String:$BillCreditPeriod
    33 : END IF
    34 : IF : ##Label = "Contact Name"
    35 :    RETURN : $LedgerContact
    36 : END IF
    37 : IF : ##Label = "Mobile Number" OR ##Label = "Party Mobile"
    38 :    RETURN : ##HxcSendTo
    39 : END IF
    40 : IF : ##Label = "Phone Number"
    41 :    RETURN : $LedgerPhone
    42 : END IF
    43 : IF : ##Label = "Fax"
    44 :    RETURN : $LedgerFax
    45 : END IF
    46 : IF : ##Label = "Email" OR ##Label = "Party Email"
    47 :    RETURN : $Email
    48 : END IF
    49 : IF : ##Label = "Website"
    50 :    RETURN : $Website
    51 : END IF
    52 : IF : ##Label = "Address" OR ##Label = "Party Address"
    53 :    RETURN : $Address:Address:First
    54 : END IF
    55 : IF : ##Label = "Address Line 1" OR ##Label = "Party Address 1"
    56 :    RETURN : $().Address[1].Address
    57 : END IF
    58 : IF : ##Label = "Address Line 2" OR ##Label = "Party Address 2"
    59 :    RETURN : $().Address[2].Address
    60 : END IF
    61 : IF : ##Label = "Address Line 3" OR ##Label = "Party Address 3"
    62 :    RETURN : $().Address[3].Address
    63 : END IF
    64 : IF : ##Label = "Address Line 4" OR ##Label = "Party Address 4"
    65 :    RETURN : $().Address[4].Address
    66 : END IF
    67 : IF : ##Label = "Address Line 5" OR ##Label = "Party Address 5"
    68 :    RETURN : $().Address[5].Address
    69 : END IF
    70 : IF : ##Label = "Pincode" OR ##Label = "Party Pincode"
    71 :    RETURN : $PINCode
    72 : END IF
    73 : IF : ##Label = "State" OR ##Label = "Party State Name"
    74 :    RETURN : $LedStateName
    75 : END IF
    76 : IF : ##Label = "Country" OR ##Label = "Party Country"
    77 :    RETURN : $CountryName
    78 : END IF
    79 : IF : ##Label = "GST Registration Type"
    80 :    RETURN : $GSTRegistrationType
    81 : END IF
    82 : IF : ##Label = "GSTIN or UIN" OR ##Label = "Party GSTIN/UIN"
    83 :    RETURN : $PartyGSTIN
    84 : END IF
    85 : IF : ##Label = "PAN or IT Number"
    86 :    RETURN : $IncomeTaxNumber
    87 : END IF
    88 : IF : ##Label = "Notes"
    89 :    RETURN : $Description
    90 : END IF
    91 : IF : ##Label = "Master ID"
    92 :    RETURN : $$String:$MasterID
    93 : END IF
    94 : IF : ##Label = "GUID" OR ##Label = "Guid"
    95 :    RETURN : $GUID
    96 : END IF
    97 : RETURN : ""