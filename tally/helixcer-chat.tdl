;; ---------------------------------------------------------------------------
;; Tables
;; ---------------------------------------------------------------------------

[Collection: Hxc Media Export List]
    List : "Voucher PDF"

[Collection: Hxc Voucher Type List]
    Type   : Voucher Type
    Format : $Name, 40

;; Dynamic voucher / party / company data labels for mapping (list only)
[Collection: Hxc Voucher Field List]
    Title  : "Voucher Dynamic Data"
    Table Sort : @@HxcVoucherMappingSort
    List : "♦ Custom Value", "Not Applicable", +
           "Party Ledger Name", "Party Name", "Party Mailing Name", "Party Address", +
           "Party Address 1", "Party Address 2", "Party Address 3", +
           "Party State Name", "Party Country", "Party Pincode", "Party GSTIN/UIN", +
           "Party Mobile", "Party Email", +
           "Contact Name", "Contact Mobile", "Contact Email", +
           "Buyer Name", "Consignee Name", +
           "Company Name", "Company Mailing Name", "Company GSTIN", "Company State Name", +
           "Voucher Number", "Voucher Date", "Reference", "Narration", "Amount", +
           "Basic Buyer Name", "Basic Buyer Address", "Basic Order Ref", "Basic Order Terms", +
           "Basic Ship Delivery Date", "Basic Due Date", "Basic Base Value", +
           "Sales Person", "Terms of Payment", "Terms of Delivery", "Dispatch Through", +
           "Destination", "Carrier Name", "Bill of Lading", "Eway Bill Number", "IRN", +
           "Guid", "Master ID"

[Collection: Hxc Voucher Config Names]
    Type     : HxcVoucherConfigs : Company
    Child Of : ##SVCurrentCompany
    Format   : $HxcVcName, 40
    Fetch    : HxcVcName, HxcVcTemplateName, HxcVcLanguage, HxcVcVoucherTypes, +
               HxcVcMediaExport, HxcVcAutoSend, HxcVcConfirmBeforeSend, HxcVcVarMapsText, +
               HxcVcCustom0, HxcVcCustom1, HxcVcCustom2, HxcVcCustom3, HxcVcCustom4, HxcVcCustom5, HxcVcCustom6, HxcVcCustom7, HxcVcCustom8, +
               HxcVcCustom9, HxcVcCustom10, HxcVcCustom11, HxcVcCustom12, HxcVcCustom13, HxcVcCustom14, HxcVcCustom15, HxcVcCustom16
    Title    : "Voucher Configs"

;; ---------------------------------------------------------------------------
;; HTTP (Status)
;; ---------------------------------------------------------------------------

[Variable: HxcConnectorApiResultPath]
    Type : String

[Collection: Hxc Connector API Response]
    Data Source : File XML : ##HxcConnectorApiResultPath : Unicode
    XML Object Path : Object : 1 : Collection
    Client Only : Yes

[Function: Hxc Run Connector Read]
    Parameter : ReadKind : String
    Parameter : TemplateName : String
    Parameter : LanguageCode : String
    Variable : RequestKind : String
    Variable : RequestPath : String
    01 : IF : $$IsEmpty:@@HxcWindowsConnectorRoot OR $$FileSize:@@HxcVoucherSenderExe <= 0
    02 :    RETURN
    03 : END IF
    031 : SET : RequestKind : If ##ReadKind = "connection" Then "connection" Else "template"
    04 : SET : RequestPath : @@HxcWindowsConnectorRoot + $$MakeUniqueID + ".api-request"
    05 : OPEN FILE : ##RequestPath : Text : Write
    06 : IF : NOT $$LastResult
    07 :    RETURN
    08 : END IF
    09 : WRITE FILE LINE : ##RequestKind
    10 : IF : ##ReadKind != "connection"
    11 :    WRITE FILE LINE : ##TemplateName
    12 :    WRITE FILE LINE : ##LanguageCode
    13 : END IF
    14 : CLOSE TARGET FILE
    15 : BrowseURL Ex : @@HxcVoucherSenderExe : (##HxcSysWorkspaceId + " " + @@HxcVoucherArgumentQuote + ##RequestPath + @@HxcVoucherArgumentQuote)
    20 : IF : $$FileSize:(##RequestPath + ".xml") > 0
    21 :    SET : HxcConnectorApiResultPath : ##RequestPath + ".xml"
    22 :    IF : ##ReadKind = "connection"
    23 :       CALL : Hxc Apply Connection Response
    24 :    ELSE
    25 :       IF : ##ReadKind = "template"
    26 :          CALL : Hxc Apply Template Response
    27 :       ELSE
    271 :          CALL : Hxc Read Send Preview Template
    272 :       END IF
    28 :    END IF
    29 :    DELETE FILE : ##HxcConnectorApiResultPath
    30 :    SET : HxcConnectorApiResultPath : ""
    31 : END IF


[Function: Hxc Apply Connection Response]
    Variable : Platform : String
    01 : SET : HxcWorkspaceName : ""
    02 : SET : HxcChannelName : ""
    021 : SET : HxcChannelPlatform : ""
    03 : SET : HxcConnectionStatus : "Could not fetch. Check IDs and API Key."
    04 : WALK COLLECTION : Hxc Connector API Response
    05 :    IF : NOT $$IsEmpty:$workspaceName
    06 :       SET : Platform : $platformLabel
    07 :       IF : $$IsEmpty:##Platform
    08 :          SET : Platform : $connectorType
    09 :       END IF
    10 :       IF : $$IsEmpty:##Platform
    11 :          SET : Platform : "Channel"
    12 :       END IF
    13 :       SET : HxcWorkspaceName : $workspaceName
    14 :       SET : HxcChannelName : $channelName
    141 :      SET : HxcChannelPlatform : ##Platform
    15 :       SET : HxcConnectionStatus : "Connected"
    16 :    END IF
    17 : END WALK
    18 : RETURN : Yes

[Function: Hxc Read Connector Profile]
    Parameter : ChannelOnly : Logical
    Returns : String
    Variable : ProfilePath : String
    Variable : ProfileValue : String
    01 : IF : $$IsEmpty:@@HxcWindowsConnectorRoot
    02 :    RETURN : ""
    03 : END IF
    04 : SET : ProfilePath : @@HxcWindowsConnectorRoot + "connection.txt"
    05 : OPEN FILE : ##ProfilePath : Text : Read
    06 : IF : NOT $$LastResult
    07 :    RETURN : ""
    08 : END IF
    09 : SET : ProfileValue : $$FileRead:0
    10 : IF : ##ChannelOnly AND NOT $$FileIsEOF
    11 :    SET : ProfileValue : $$FileRead:0
    12 : END IF
    13 : CLOSE FILE
    14 : RETURN : ##ProfileValue

[Function: Hxc Sync From Connector]
    01 : SET : HxcSysWorkspaceId : $$HxcReadConnectorProfile:No
    02 : SET : HxcSysChannelId : $$HxcReadConnectorProfile:Yes
    03 : RETURN : Yes


[Function: Hxc Fetch Connection]
    001 : SET : HxcWorkspaceName : ""
    002 : SET : HxcChannelName : ""
    003 : SET : HxcChannelPlatform : ""
    01 : CALL : Hxc Sync From Connector
    02 : IF : $$IsEmpty:##HxcSysWorkspaceId OR $$IsEmpty:##HxcSysChannelId
    03 :    SET : HxcConnectionStatus : "Configure the connection in Helixcer for TallyPrime Setup."
    04 :    RETURN : No
    05 : END IF
    08 : SET : HxcConnectionStatus : "Checking..."
    09 : Start Progress : 1 : "Helixcer Chat" : "Checking connection" : "Fetching workspace and channel"
    10 : CALL : Hxc Run Connector Read : "connection" : "" : ""
    11 : End Progress
    12 : IF : $$IsEmpty:##HxcWorkspaceName
    13 :    IF : ##HxcConnectionStatus = "Checking..."
    14 :       SET : HxcConnectionStatus : "Could not fetch. Check IDs and API Key."
    15 :    END IF
    16 : END IF
    17 : RETURN : Yes

[Function: Hxc Show Status]
    Variable : StatusDetails : String
    01 : CALL : Hxc Fetch Connection
    02 : SET : StatusDetails : "Status: " + ##HxcConnectionStatus
    03 : SET : StatusDetails : ##StatusDetails + $$NewLine + "Workspace: " + (If $$IsEmpty:##HxcWorkspaceName Then "-" Else ##HxcWorkspaceName)
    04 : SET : StatusDetails : ##StatusDetails + $$NewLine + "Channel: " + (If $$IsEmpty:##HxcChannelName Then "-" Else ##HxcChannelName)
    05 : SET : StatusDetails : ##StatusDetails + $$NewLine + "Platform: " + (If $$IsEmpty:##HxcChannelPlatform Then "-" Else ##HxcChannelPlatform)
    06 : MSG BOX : "Helixcer Connection Status" : ##StatusDetails
    07 : RETURN : Yes

[Function: Hxc Clear Fetch Vars]
    000 : SET : HxcVtSavedRowsReady : No
    00 : SET : HxcVcMoveToMapping : No
