[Function: Hxc Apply One Saved Map]
    Parameter : Comp : String
    Parameter : Key : String
    Parameter : Val : String
    01 : IF : $$IsEmpty:##Comp OR $$IsEmpty:##Key
    02 :    RETURN : Yes
    03 : END IF
    901 : IF : ##HxcVtReadingSavedRows
    902 :    IF : ##Comp = "header"
    903 :       SET : HxcVcHeaderKind : "text"
    904 :       SET : HxcVcHeaderKey : ##Key
    905 :    END IF
    906 :    IF : (##Comp = "body" OR ##Comp = "button") AND ##HxcVtSavedSlot < 16
    907 :       INCREMENT : HxcVtSavedSlot
    908 :       CALL : Hxc Set Map Slot : ##HxcVtSavedSlot : ##Key : ##Comp
    909 :    END IF
    910 : END IF
    04 : IF : ##Comp = "header"
    05 :    IF : ##Key = ##HxcVcHeaderKey OR $$IsEmpty:##HxcVcHeaderKey
    06 :       SET : HxcVcDraftHeaderFld : ##Val
    07 :    END IF
    08 :    RETURN : Yes
    09 : END IF
    10 : IF : ##Comp = "button"
    11 :    IF : ##HxcVcFC1 = "button" AND ##HxcVcFK1 = ##Key
    12 :       SET : HxcVcButtonField1 : ##Val
    13 :    END IF
    14 :    IF : ##HxcVcFC2 = "button" AND ##HxcVcFK2 = ##Key
    15 :       SET : HxcVcButtonField2 : ##Val
    16 :    END IF
    17 :    IF : ##HxcVcFC3 = "button" AND ##HxcVcFK3 = ##Key
    18 :       SET : HxcVcButtonField3 : ##Val
    19 :    END IF
    20 :    IF : ##HxcVcFC4 = "button" AND ##HxcVcFK4 = ##Key
    21 :       SET : HxcVcButtonField4 : ##Val
    22 :    END IF
    24 : END IF
    25 : IF : ##HxcVcFC1 = ##Comp AND ##HxcVcFK1 = ##Key
    26 :    CALL : Hxc Write Slot Fld : 1 : ##Val
    27 : END IF
    28 : IF : ##HxcVcFC2 = ##Comp AND ##HxcVcFK2 = ##Key
    29 :    CALL : Hxc Write Slot Fld : 2 : ##Val
    30 : END IF
    31 : IF : ##HxcVcFC3 = ##Comp AND ##HxcVcFK3 = ##Key
    32 :    CALL : Hxc Write Slot Fld : 3 : ##Val
    33 : END IF
    34 : IF : ##HxcVcFC4 = ##Comp AND ##HxcVcFK4 = ##Key
    35 :    CALL : Hxc Write Slot Fld : 4 : ##Val
    36 : END IF
    37 : IF : ##HxcVcFC5 = ##Comp AND ##HxcVcFK5 = ##Key
    38 :    CALL : Hxc Write Slot Fld : 5 : ##Val
    39 : END IF
    40 : IF : ##HxcVcFC6 = ##Comp AND ##HxcVcFK6 = ##Key
    41 :    CALL : Hxc Write Slot Fld : 6 : ##Val
    42 : END IF
    43 : IF : ##HxcVcFC7 = ##Comp AND ##HxcVcFK7 = ##Key
    44 :    CALL : Hxc Write Slot Fld : 7 : ##Val
    45 : END IF
    46 : IF : ##HxcVcFC8 = ##Comp AND ##HxcVcFK8 = ##Key
    47 :    CALL : Hxc Write Slot Fld : 8 : ##Val
    48 : END IF
    49 : IF : ##HxcVcFC9 = ##Comp AND ##HxcVcFK9 = ##Key
    50 :    CALL : Hxc Write Slot Fld : 9 : ##Val
    51 : END IF
    52 : IF : ##HxcVcFC10 = ##Comp AND ##HxcVcFK10 = ##Key
    53 :    CALL : Hxc Write Slot Fld : 10 : ##Val
    54 : END IF
    55 : IF : ##HxcVcFC11 = ##Comp AND ##HxcVcFK11 = ##Key
    56 :    CALL : Hxc Write Slot Fld : 11 : ##Val
    57 : END IF
    58 : IF : ##HxcVcFC12 = ##Comp AND ##HxcVcFK12 = ##Key
    59 :    CALL : Hxc Write Slot Fld : 12 : ##Val
    60 : END IF
    61 : IF : ##HxcVcFC13 = ##Comp AND ##HxcVcFK13 = ##Key
    62 :    CALL : Hxc Write Slot Fld : 13 : ##Val
    63 : END IF
    64 : IF : ##HxcVcFC14 = ##Comp AND ##HxcVcFK14 = ##Key
    65 :    CALL : Hxc Write Slot Fld : 14 : ##Val
    66 : END IF
    67 : IF : ##HxcVcFC15 = ##Comp AND ##HxcVcFK15 = ##Key
    68 :    CALL : Hxc Write Slot Fld : 15 : ##Val
    69 : END IF
    70 : IF : ##HxcVcFC16 = ##Comp AND ##HxcVcFK16 = ##Key
    71 :    CALL : Hxc Write Slot Fld : 16 : ##Val
    72 : END IF
    73 : RETURN : Yes

[Function: Hxc Parse Map Piece]
    Parameter : Piece : String
    Variable : MapComponent : String
    Variable : MapKey : String
    Variable : MapValue : String
    Variable : AfterComponent : String
    Variable : ValueOffset : Number
    01 : FOR TOKEN : ComponentToken : ##Piece : ":"
    02 :    SET : MapComponent : ##ComponentToken
    03 :    BREAK
    04 : END FOR
    05 : SET : ValueOffset : ($$StringLength:##MapComponent) + 1
    06 : SET : AfterComponent : $$StringPart:##Piece:##ValueOffset:(($$StringLength:##Piece) - ##ValueOffset)
    07 : FOR TOKEN : KeyToken : ##AfterComponent : "="
    08 :    SET : MapKey : ##KeyToken
    09 :    BREAK
    10 : END FOR
    11 : SET : ValueOffset : ($$StringLength:##MapKey) + 1
    12 : SET : MapValue : $$StringPart:##AfterComponent:##ValueOffset:(($$StringLength:##AfterComponent) - ##ValueOffset)
    13 : CALL : Hxc Apply One Saved Map : ##MapComponent : ##MapKey : ##MapValue
    14 : RETURN : Yes

[Function: Hxc Apply Saved Maps]
    01 : FOR TOKEN : MapToken : ##HxcVcSavedMaps : ";"
    02 :    IF : NOT $$IsEmpty:##MapToken
    03 :       CALL : Hxc Parse Map Piece : ##MapToken
    04 :    END IF
    05 : END FOR
    06 : RETURN : Yes

;; ---------------------------------------------------------------------------
;; Pack helpers + commit draft → Aggregate config
;; ---------------------------------------------------------------------------



[#Form: Voucher Type]
    Add : Part : At End : Hxc Voucher Type Setup

[Part: Hxc Voucher Type Setup]
    Lines : Hxc Vt Enable Line, Hxc Vt Settings Line

[Line: Hxc Vt Enable Line]
    Fields : Medium Prompt, HxcVtEnableInput
    Local : Field : Medium Prompt : Set as : "Enable Helixcer Chat"
    Local : Field : Medium Prompt : Width : 34

[Field: HxcVtEnableInput]
    Use     : Logical Field
    Storage : HxcVtEnabled
    Set as  : $HxcVtEnabled
    Width   : 8

[Line: Hxc Vt Settings Line]
    Indent : 2
    Fields : Hxc Vt Open Prompt, Hxc Vt Open Prompt Disabled, Hxc Vt Open Settings

[Field: Hxc Vt Open Prompt]
    Use       : Medium Prompt
    Set as    : "Alter Helixcer Chat WhatApp"
    Set Always : Yes
    Width     : 32
    Color     : Black
    Skip      : Yes
    Invisible : NOT @@HxcVtSetupEnabled

[Field: Hxc Vt Open Prompt Disabled]
    Use       : Medium Prompt
    Set as    : "Alter Helixcer Chat WhatApp"
    Set Always : Yes
    Width     : 32
    Color     : Hxc Confirm Grey
    Skip      : Yes
    Invisible : @@HxcVtSetupEnabled

[Field: Hxc Vt Open Settings]
    Use      : Logical Field
    Set as   : No
    Skip Forward : No
    Width    : 8
    Color    : Black
    Skip     : NOT @@HxcVtSetupEnabled
    Option   : Hxc Vt Disabled Menu Style : NOT @@HxcVtSetupEnabled
    Sub Form : Hxc Voucher Type Settings : @@HxcVtSetupEnabled AND $$Value AND $$HxcPrepareVoucherTypeSettings:@@HxcVtCurrentMasterName

[!Field: Hxc Vt Disabled Menu Style]
    Read Only : Yes
    Color : Hxc Confirm Grey

[Report: Hxc Voucher Type Settings]
    List Variable : HxcVcVoucherDraft : String
    Form : Hxc Voucher Type Settings
    Title : "Helixcer Chat WhatsApp Settings"
    Auto : Yes
    On : Load : NOT ##HxcVtEditing : CALL : Hxc Vt Load Settings : @@HxcVtCurrentMasterName

[Form: Hxc Voucher Type Settings]
    Height : 100% Screen
    Width  : 100% Screen
    Parts  : Hxc Vt WhatsApp Part, Hxc Vt Mapping Layout, Hxc Vt Sending Panel, Hxc Vt Storage Part
    Background : Hxc Vt Page
    Button : Hxc Fetch Template Btn, Form Accept, Form Cancel
    Control : HxcVtWrongMaster : NOT @@HxcVtOnSelectedMaster
    Control : HxcVtFetchRequired : ##HxcVtWhatsAppOn AND NOT ##HxcVcFetched AND (NOT ##HxcVtSavedRowsReady OR NOT (##HxcVcDraftTemplate = ##HxcVcFetchName AND ##HxcVcDraftLang = ##HxcVcFetchLang))
    Control : HxcVtCustomRequired : ##HxcVtWhatsAppOn AND @@HxcVcMissingCustomValue
    On : Form Destroy : Yes : CALL : Hxc Vt Close Settings

[Part: Hxc Vt WhatsApp Part]
    Lines : Hxc Vt WhatsApp Line, Hxc Vc F Template Sect, Hxc Vc F Template Line, Hxc Vc F Lang Line, Hxc Vc F Fetch Status Line
    Local : Line : Hxc Vc F Template Sect : Invisible : NOT ##HxcVtWhatsAppOn
    Local : Line : Hxc Vc F Template Line : Invisible : NOT ##HxcVtWhatsAppOn
    Local : Line : Hxc Vc F Lang Line : Invisible : NOT ##HxcVtWhatsAppOn
    Local : Line : Hxc Vc F Fetch Status Line : Invisible : NOT ##HxcVtWhatsAppOn
    On : Focus : NOT ##HxcVtEditing : CALL : Hxc Vt Load Settings : @@HxcVtCurrentMasterName
    Background : Hxc Vt Panel

[Line: Hxc Vt WhatsApp Line]
    Fields : Medium Prompt, HxcVtWhatsAppInput
    Local : Field : Medium Prompt : Set as : "Enable Helixcer Chat WhatsApp"
    Local : Field : Medium Prompt : Width : 34

[Field: HxcVtWhatsAppInput]
    Use      : Logical Field
    Set as   : ##HxcVtWhatsAppOn
    Set Always : Yes
    Width    : 8
    On : Accept : Yes : SET : HxcVtWhatsAppOn : $$Value
    On : Accept : ##HxcVtWhatsAppOn : Line Down
    On : Accept : NOT ##HxcVtWhatsAppOn : Field Accept

[Part: Hxc Vt Storage Part]
    Line : Hxc Vt Storage Line

[Line: Hxc Vt Storage Line]
    Fields : Hxc Vt Store WhatsApp Enabled, Hxc Vt Store Template, Hxc Vt Store Language, Hxc Vt Store Media, Hxc Vt Store Auto, +
             Hxc Vt Store Confirm, Hxc Vt Store Maps, Hxc Vt Store Custom0, Hxc Vt Store Custom1, +
             Hxc Vt Store Custom2, Hxc Vt Store Custom3, Hxc Vt Store Custom4, Hxc Vt Store Custom5, +
             Hxc Vt Store Custom6, Hxc Vt Store Custom7, Hxc Vt Store Custom8, Hxc Vt Store Preview, Hxc Vt Store Header Kind, +
             Hxc Vt Store Custom9, Hxc Vt Store Custom10, Hxc Vt Store Custom11, Hxc Vt Store Custom12, +
             Hxc Vt Store Custom13, Hxc Vt Store Custom14, Hxc Vt Store Custom15, Hxc Vt Store Custom16

[Field: Hxc Vt Store WhatsApp Enabled]
    Use        : Name Field
    Storage    : HxcVtWhatsAppEnabled
    Set as     : If @@HxcVtOnSelectedMaster THEN (If ##HxcVtWhatsAppOn THEN "Yes" ELSE "No") ELSE $HxcVtWhatsAppEnabled
    Set Always : Yes
    Invisible  : Yes

[Field: Hxc Vt Store Header Kind]
    Use        : Name Field
    Storage    : HxcVtHeaderKind
    Set as     : If @@HxcVtOnSelectedMaster AND ##HxcVtWhatsAppOn AND ##HxcVcFetched THEN ##HxcVcHeaderKind ELSE $HxcVtHeaderKind
    Set Always : Yes
    Invisible  : Yes

[Field: Hxc Vt Store Preview]
    Use        : Name Field
    Storage    : HxcVtPreview
    Set as     : If @@HxcVtOnSelectedMaster AND ##HxcVtWhatsAppOn AND ##HxcVcFetched THEN ##HxcVcPreviewText ELSE $HxcVtPreview
    Set Always : Yes
    Invisible  : Yes
    Max        : 4096

[Field: Hxc Vt Store Template]
    Use        : Name Field
    Storage    : HxcVtTemplate
    Set as     : If @@HxcVtOnSelectedMaster AND ##HxcVtWhatsAppOn THEN (##HxcVcDraftTemplate) ELSE $HxcVtTemplate
    Set Always : Yes
    Invisible  : Yes

[Field: Hxc Vt Store Language]
    Use        : Name Field
    Storage    : HxcVtLanguage
    Set as     : If @@HxcVtOnSelectedMaster AND ##HxcVtWhatsAppOn THEN (##HxcVcDraftLang) ELSE $HxcVtLanguage
    Set Always : Yes
    Invisible  : Yes

[Field: Hxc Vt Store Media]
    Use        : Name Field
    Storage    : HxcVtMedia
    Set as     : If @@HxcVtOnSelectedMaster AND ##HxcVtWhatsAppOn THEN (##HxcVcDraftMedia) ELSE $HxcVtMedia
    Set Always : Yes
    Invisible  : Yes

[Field: Hxc Vt Store Auto]
    Use        : Logical Field
    Storage    : HxcVtAuto
    Set as     : If @@HxcVtOnSelectedMaster AND ##HxcVtWhatsAppOn THEN (##HxcVcDraftAuto) ELSE $HxcVtAuto
    Set Always : Yes
    Invisible  : Yes

[Field: Hxc Vt Store Confirm]
    Use        : Logical Field
    Storage    : HxcVtConfirm
    Set as     : If @@HxcVtOnSelectedMaster AND ##HxcVtWhatsAppOn THEN ((##HxcVcDraftAuto AND ##HxcVcDraftConfirm)) ELSE $HxcVtConfirm
    Set Always : Yes
    Invisible  : Yes

[Field: Hxc Vt Store Maps]
    Use        : Name Field
    Storage    : HxcVtMaps
    Set as     : If @@HxcVtOnSelectedMaster AND ##HxcVtWhatsAppOn AND ##HxcVcFetched THEN ($$HxcPackMaps) ELSE $HxcVtMaps
    Set Always : Yes
    Invisible  : Yes

