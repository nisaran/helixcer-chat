;; Helixcer Chat — TallyPrime TDL
;; BUILD: 345-voucher-subform
;; Title must show "(build 345)".
;;
;; Crash fix: build 344 used Display + custom Form Accept / INSERT — c0000005.
;; Voucher Config now uses ONLY Alter + Object Company + Storage (same as API Settings).
;; Create/Alter: Config Name line → SubForm popup for the rest (Tally SubForm pattern).
;; List: Alter read-only. No Display of Company reports. No On Form Accept.

;; ---------------------------------------------------------------------------
;; Company UDFs
;; ---------------------------------------------------------------------------

[System: UDF]
    HxcWorkspaceIdUDF : String : 25101
    HxcChannelIdUDF   : String : 25102
    HxcApiKeyUDF      : String : 25103
    HxcVoucherConfigs      : Aggregate : 25110
    HxcVcName              : String    : 25111
    HxcVcTemplateName      : String    : 25112
    HxcVcLanguage          : String    : 25113
    HxcVcVoucherTypes      : String    : 25114
    HxcVcMediaExport       : String    : 25115
    HxcVcAutoSend          : Logical   : 25116
    HxcVcConfirmBeforeSend : Logical   : 25117

;; ---------------------------------------------------------------------------
;; Status mirrors
;; ---------------------------------------------------------------------------

[Variable: HxcSysWorkspaceId]
    Type       : String
    Persistent : Yes

[Variable: HxcSysChannelId]
    Type       : String
    Persistent : Yes

[Variable: HxcSysApiKey]
    Type       : String
    Persistent : Yes

[Variable: HxcWorkspaceName]
    Type       : String
    Persistent : Yes

[Variable: HxcChannelName]
    Type       : String
    Persistent : Yes

[Variable: HxcConnectionStatus]
    Type       : String
    Persistent : Yes

[System: Variable]
    HxcSysWorkspaceId   : ""
    HxcSysChannelId     : ""
    HxcSysApiKey        : ""
    HxcWorkspaceName    : ""
    HxcChannelName      : ""
    HxcConnectionStatus : ""

[System: Formula]
    Hxc Connection Url : "https://api.chat.helixcer.com/api/v1/connection?channelId=" + ##HxcSysChannelId
    Hxc Sys Summary    : "WS=[" + ##HxcSysWorkspaceId + "] CH=[" + ##HxcSysChannelId + "] KeyChars=" + $$StringLength:##HxcSysApiKey

;; ---------------------------------------------------------------------------
;; Tables
;; ---------------------------------------------------------------------------

[Collection: Hxc Media Export List]
    List : "None", "Voucher PDF", "Voucher HTML", "Voucher XML", "Voucher Excel"

[Collection: Hxc Voucher Type List]
    Type   : Voucher Type
    Format : $Name, 40

;; ---------------------------------------------------------------------------
;; HTTP (Status)
;; ---------------------------------------------------------------------------

[Report: Hxc Connection Request]
    Form          : Hxc Connection Request
    Export Header : "Authorization: Bearer " + ##HxcSysApiKey
    Export Header : "X-Workspace-Id: " + ##HxcSysWorkspaceId
    Export Header : "Accept: application/json"

[Form: Hxc Connection Request]
    Part : Hxc Connection Request

[Part: Hxc Connection Request]
    Lines : Hxc Connection Request

[Line: Hxc Connection Request]
    Fields : Hxc Connection Request

[Field: Hxc Connection Request]
    Use    : Name Field
    Set as : ""
    Skip   : Yes

[Function: Hxc Apply Connection Response]
    Variable : Platform : String
    01 : SET : HxcWorkspaceName : ""
    02 : SET : HxcChannelName : ""
    03 : SET : HxcConnectionStatus : "Could not fetch. Check IDs and API Key."
    04 : WALK COLLECTION : Parameter Collection
    05 :    IF : NOT $$IsEmpty:$workspaceName
    06 :       SET : Platform : $platformLabel
    07 :       IF : $$IsEmpty:##Platform
    08 :          SET : Platform : $connectorType
    09 :       END IF
    10 :       IF : $$IsEmpty:##Platform
    11 :          SET : Platform : "Channel"
    12 :       END IF
    13 :       SET : HxcWorkspaceName : $workspaceName
    14 :       SET : HxcChannelName : $channelName + " (" + ##Platform + ")"
    15 :       SET : HxcConnectionStatus : "Connected"
    16 :    END IF
    17 : END WALK
    18 : RETURN : Yes

[Function: Hxc Sync From Company]
    01 : IF : NOT $$IsEmpty:$HxcWorkspaceIdUDF:Company:##SVCurrentCompany
    02 :    SET : HxcSysWorkspaceId : $HxcWorkspaceIdUDF:Company:##SVCurrentCompany
    03 : END IF
    04 : IF : NOT $$IsEmpty:$HxcChannelIdUDF:Company:##SVCurrentCompany
    05 :    SET : HxcSysChannelId : $HxcChannelIdUDF:Company:##SVCurrentCompany
    06 : END IF
    07 : IF : NOT $$IsEmpty:$HxcApiKeyUDF:Company:##SVCurrentCompany
    08 :    SET : HxcSysApiKey : $HxcApiKeyUDF:Company:##SVCurrentCompany
    09 : END IF
    10 : RETURN : Yes

[Function: Hxc Fetch Connection]
    01 : CALL : Hxc Sync From Company
    02 : IF : $$IsEmpty:##HxcSysWorkspaceId OR $$IsEmpty:##HxcSysChannelId OR $$IsEmpty:##HxcSysApiKey
    03 :    SET : HxcConnectionStatus : "Not ready. " + @@HxcSysSummary + "  Accept API Settings with Ctrl+A first."
    04 :    RETURN : No
    05 : END IF
    06 : SET : HxcWorkspaceName : ""
    07 : SET : HxcChannelName : ""
    08 : SET : HxcConnectionStatus : "Checking..."
    09 : Start Progress : 1 : "Helixcer Chat" : "Connection status" : "Fetching workspace and channel"
    10 : HTTP Request : @@HxcConnectionUrl : GET : JSON : UTF8 : Hxc Connection Request : Hxc Apply Connection Response
    11 : End Progress
    12 : IF : $$IsEmpty:##HxcWorkspaceName
    13 :    IF : ##HxcConnectionStatus = "Checking..."
    14 :       SET : HxcConnectionStatus : "Could not fetch. Check IDs and API Key."
    15 :    END IF
    16 : END IF
    17 : RETURN : Yes

[Function: Hxc Show Status]
    01 : CALL : Hxc Fetch Connection
    02 : Msg Box : "Helixcer Connection Status" : ##HxcConnectionStatus
    03 : IF : NOT $$IsEmpty:##HxcWorkspaceName
    04 :    Msg Box : "Workspace" : ##HxcWorkspaceName
    05 :    Msg Box : "Channel" : ##HxcChannelName
    06 : END IF
    07 : RETURN : Yes

;; ---------------------------------------------------------------------------
;; Menu
;; ---------------------------------------------------------------------------

[#Menu: Gateway of Tally]
    Add : Key Item : Before : @@LOCQuit : Helixcer Chat : H : Menu : Helixcer Chat Menu

[Menu: Helixcer Chat Menu]
    Title    : "Helixcer Chat"
    Key Item : API Settings   : S : Alter : Helixcer API Settings
    Key Item : Voucher Config : V : Menu  : Helixcer Voucher Config Menu
    Key Item : Status         : T : Call  : Hxc Show Status
    Key Item : About          : A : Display : Helixcer Chat About
    Key Item : Back           : B : Menu  : Gateway of Tally

[Menu: Helixcer Voucher Config Menu]
    Title    : "Voucher Config"
    Key Item : Create Config : C : Alter : Helixcer Voucher Config Create
    Key Item : Alter Config  : A : Alter : Helixcer Voucher Config Alter
    Key Item : List Configs  : L : Alter : Helixcer Voucher Config List
    Key Item : Back          : B : Menu  : Helixcer Chat Menu

;; ---------------------------------------------------------------------------
;; API Settings
;; ---------------------------------------------------------------------------

[Report: Helixcer API Settings]
    Form   : Helixcer API Settings
    Title  : "API Settings"
    Object : Company

[Form: Helixcer API Settings]
    Part   : Helixcer API Settings
    Button : Form Accept, Form Cancel

[Part: Helixcer API Settings]
    Lines  : Hxc Api Settings Title, +
             Hxc Workspace Id Line, Hxc Channel Id Line, Hxc Api Key Line, +
             Hxc Save Hint Line
    Scroll : Vertical

[Line: Hxc Api Settings Title]
    Field : Hxc Api Settings Title

[Field: Hxc Api Settings Title]
    Use       : Name Field
    Set as    : "Helixcer Chat — API Settings (build 345)"
    Style     : Bold
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

[Line: Hxc Workspace Id Line]
    Fields : Medium Prompt, HxcWorkspaceIdFld
    Local  : Field : Medium Prompt : Set as : "Workspace ID"
    Local  : Field : Medium Prompt : Width  : 20

[Field: HxcWorkspaceIdFld]
    Use      : Name Field
    Storage  : HxcWorkspaceIdUDF
    Set as   : $HxcWorkspaceIdUDF
    Width    : 60
    Max      : 64
    On       : Accept : Yes : SET : HxcSysWorkspaceId : $Value
    On       : Accept : Yes : Field Accept

[Line: Hxc Channel Id Line]
    Fields : Medium Prompt, HxcChannelIdFld
    Local  : Field : Medium Prompt : Set as : "Channel ID"
    Local  : Field : Medium Prompt : Width  : 20

[Field: HxcChannelIdFld]
    Use      : Name Field
    Storage  : HxcChannelIdUDF
    Set as   : $HxcChannelIdUDF
    Width    : 60
    Max      : 64
    On       : Accept : Yes : SET : HxcSysChannelId : $Value
    On       : Accept : Yes : Field Accept

[Line: Hxc Api Key Line]
    Fields : Medium Prompt, HxcApiKeyFld
    Local  : Field : Medium Prompt : Set as : "API Key"
    Local  : Field : Medium Prompt : Width  : 20

[Field: HxcApiKeyFld]
    Use      : Name Field
    Storage  : HxcApiKeyUDF
    Set as   : $HxcApiKeyUDF
    Width    : 60
    Max      : 200
    On       : Accept : Yes : SET : HxcSysApiKey : $Value
    On       : Accept : Yes : Field Accept

[Line: Hxc Save Hint Line]
    Field : Hxc Save Hint

[Field: Hxc Save Hint]
    Use       : Name Field
    Set as    : "Tab all fields, then Ctrl+A to Accept (Tally default)."
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

;; ---------------------------------------------------------------------------
;; Voucher Config — CREATE
;; Blank Config Name line → SubForm popup (labeled fields) → Ctrl+A
;; ---------------------------------------------------------------------------

[Report: Helixcer Voucher Config Create]
    Form   : Helixcer Voucher Config Create
    Title  : "Create Voucher Config"
    Object : Company

[Form: Helixcer Voucher Config Create]
    Part   : Hxc Vc Cr Title Part, Hxc Vc Cr Name Part, Hxc Vc Cr Hint Part
    Button : Form Accept, Form Cancel

[Part: Hxc Vc Cr Title Part]
    Lines : Hxc Vc Cr Title Line

[Line: Hxc Vc Cr Title Line]
    Field : Hxc Vc Cr Title

[Field: Hxc Vc Cr Title]
    Use       : Name Field
    Set as    : "Create Voucher Config (build 345)"
    Style     : Bold
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

[Part: Hxc Vc Cr Name Part]
    Lines    : Hxc Vc Cr Name Line
    Repeat   : Hxc Vc Cr Name Line : HxcVoucherConfigs
    Break On : $$IsEmpty:$HxcVcName
    Scroll   : Vertical

[Line: Hxc Vc Cr Name Line]
    Fields : Medium Prompt, Hxc Vc Cr Name Fld
    Local  : Field : Medium Prompt : Set as : "Config Name"
    Local  : Field : Medium Prompt : Width  : 18

[Field: Hxc Vc Cr Name Fld]
    Use      : Name Field
    Storage  : HxcVcName
    Set as   : $HxcVcName
    Width    : 40
    Max      : 60
    ;; Popup detail form when name is entered (create or edit this row)
    Sub Form : Helixcer Voucher Config Detail : NOT $$IsEmpty:$Value

[Part: Hxc Vc Cr Hint Part]
    Lines : Hxc Vc Cr Hint Line

[Line: Hxc Vc Cr Hint Line]
    Field : Hxc Vc Cr Hint

[Field: Hxc Vc Cr Hint]
    Use       : Name Field
    Set as    : "Type a Config Name on the blank line → detail form opens. Then Ctrl+A."
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

;; ---------------------------------------------------------------------------
;; Voucher Config — ALTER (same Storage/SubForm; title differs)
;; ---------------------------------------------------------------------------

[Report: Helixcer Voucher Config Alter]
    Form   : Helixcer Voucher Config Alter
    Title  : "Alter Voucher Config"
    Object : Company

[Form: Helixcer Voucher Config Alter]
    Part   : Hxc Vc Al Title Part, Hxc Vc Al Name Part, Hxc Vc Al Hint Part
    Button : Form Accept, Form Cancel

[Part: Hxc Vc Al Title Part]
    Lines : Hxc Vc Al Title Line

[Line: Hxc Vc Al Title Line]
    Field : Hxc Vc Al Title

[Field: Hxc Vc Al Title]
    Use       : Name Field
    Set as    : "Alter Voucher Config (build 345)"
    Style     : Bold
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

[Part: Hxc Vc Al Name Part]
    Lines    : Hxc Vc Al Name Line
    Repeat   : Hxc Vc Al Name Line : HxcVoucherConfigs
    Break On : $$IsEmpty:$HxcVcName
    Scroll   : Vertical

[Line: Hxc Vc Al Name Line]
    Fields : Medium Prompt, Hxc Vc Al Name Fld
    Local  : Field : Medium Prompt : Set as : "Config Name"
    Local  : Field : Medium Prompt : Width  : 18

[Field: Hxc Vc Al Name Fld]
    Use      : Name Field
    Storage  : HxcVcName
    Set as   : $HxcVcName
    Width    : 40
    Max      : 60
    Sub Form : Helixcer Voucher Config Detail : NOT $$IsEmpty:$Value

[Part: Hxc Vc Al Hint Part]
    Lines : Hxc Vc Al Hint Line

[Line: Hxc Vc Al Hint Line]
    Field : Hxc Vc Al Hint

[Field: Hxc Vc Al Hint]
    Use       : Name Field
    Set as    : "Select a Config Name → detail form opens. Edit, then Ctrl+A."
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

;; ---------------------------------------------------------------------------
;; Voucher Config — DETAIL SubForm (popup labeled fields)
;; Inherits Aggregate object from Config Name field. No Object / no Repeat.
;; ---------------------------------------------------------------------------

[Report: Helixcer Voucher Config Detail]
    Form : Helixcer Voucher Config Detail
    Auto : Yes

[Form: Helixcer Voucher Config Detail]
    Part       : FormSubTitle, Hxc Vc Det Body
    Button     : Form Accept, Form Cancel
    Full Width : No
    Height     : 80% Screen
    Option     : Small Size Form
    Local      : Field : Form SubTitle : Info : "Voucher Config Details"

[Part: Hxc Vc Det Body]
    Lines  : Hxc Vc Det Template Line, Hxc Vc Det Lang Line, Hxc Vc Det Types Line, +
             Hxc Vc Det Media Line, Hxc Vc Det Auto Line, Hxc Vc Det Confirm Line
    Scroll : Vertical

[Line: Hxc Vc Det Template Line]
    Fields : Medium Prompt, Hxc Vc Det Template
    Local  : Field : Medium Prompt : Set as : "Template"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc Det Template]
    Use      : Name Field
    Storage  : HxcVcTemplateName
    Set as   : $HxcVcTemplateName
    Width    : 40
    Max      : 80

[Line: Hxc Vc Det Lang Line]
    Fields : Medium Prompt, Hxc Vc Det Lang
    Local  : Field : Medium Prompt : Set as : "Language"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc Det Lang]
    Use      : Name Field
    Storage  : HxcVcLanguage
    Set as   : If $$IsEmpty:$HxcVcLanguage THEN "en" ELSE $HxcVcLanguage
    Width    : 16
    Max      : 16

[Line: Hxc Vc Det Types Line]
    Fields : Medium Prompt, Hxc Vc Det Types
    Local  : Field : Medium Prompt : Set as : "Voucher Type"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc Det Types]
    Use      : Name Field
    Storage  : HxcVcVoucherTypes
    Set as   : $HxcVcVoucherTypes
    Table    : Hxc Voucher Type List, Not Applicable
    Width    : 40
    Max      : 120

[Line: Hxc Vc Det Media Line]
    Fields : Medium Prompt, Hxc Vc Det Media
    Local  : Field : Medium Prompt : Set as : "Media Header"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc Det Media]
    Use        : Name Field
    Storage    : HxcVcMediaExport
    Set as     : If $$IsEmpty:$HxcVcMediaExport THEN "None" ELSE $HxcVcMediaExport
    Table      : Hxc Media Export List
    Show Table : Always
    Width      : 40
    Max        : 40

[Line: Hxc Vc Det Auto Line]
    Fields : Medium Prompt, Hxc Vc Det Auto
    Local  : Field : Medium Prompt : Set as : "Auto Select after save?"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc Det Auto]
    Use      : Logical Field
    Storage  : HxcVcAutoSend
    Set as   : $HxcVcAutoSend
    Width    : 8

[Line: Hxc Vc Det Confirm Line]
    Fields : Medium Prompt, Hxc Vc Det Confirm
    Local  : Field : Medium Prompt : Set as : "Confirm before send?"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc Det Confirm]
    Use      : Logical Field
    Storage  : HxcVcConfirmBeforeSend
    Set as   : $HxcVcConfirmBeforeSend
    Width    : 8

;; ---------------------------------------------------------------------------
;; Voucher Config — LIST (Alter + Skip only — Display+Company crashed before)
;; ---------------------------------------------------------------------------

[Report: Helixcer Voucher Config List]
    Form   : Helixcer Voucher Config List
    Title  : "List Voucher Configs"
    Object : Company

[Form: Helixcer Voucher Config List]
    Part   : Hxc Vc Ls Title Part, Hxc Vc Ls Part, Hxc Vc Ls Hint Part
    Button : Form Cancel

[Part: Hxc Vc Ls Title Part]
    Lines : Hxc Vc Ls Title Line

[Line: Hxc Vc Ls Title Line]
    Field : Hxc Vc Ls Title

[Field: Hxc Vc Ls Title]
    Use       : Name Field
    Set as    : "Voucher Config List (build 345)"
    Style     : Bold
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

[Part: Hxc Vc Ls Part]
    Lines    : Hxc Vc Ls Header Line, Hxc Vc Ls Data Line
    Repeat   : Hxc Vc Ls Data Line : HxcVoucherConfigs
    Break On : $$IsEmpty:$HxcVcName
    Scroll   : Vertical

[Line: Hxc Vc Ls Header Line]
    Fields : Hxc Vc Ls H Name, Hxc Vc Ls H Template, Hxc Vc Ls H Lang, +
             Hxc Vc Ls H Types, Hxc Vc Ls H Media, Hxc Vc Ls H Auto, Hxc Vc Ls H Confirm
    Local  : Field : Default : Skip  : Yes
    Local  : Field : Default : Align : Centre
    Local  : Field : Default : Style : Bold

[Field: Hxc Vc Ls H Name]
    Use    : Name Field
    Set as : "Config Name"
    Width  : 18

[Field: Hxc Vc Ls H Template]
    Use    : Name Field
    Set as : "Template"
    Width  : 18

[Field: Hxc Vc Ls H Lang]
    Use    : Name Field
    Set as : "Lang"
    Width  : 8

[Field: Hxc Vc Ls H Types]
    Use    : Name Field
    Set as : "Voucher Types"
    Width  : 20

[Field: Hxc Vc Ls H Media]
    Use    : Name Field
    Set as : "Media"
    Width  : 14

[Field: Hxc Vc Ls H Auto]
    Use    : Name Field
    Set as : "Auto"
    Width  : 6

[Field: Hxc Vc Ls H Confirm]
    Use    : Name Field
    Set as : "Confirm"
    Width  : 8

[Line: Hxc Vc Ls Data Line]
    Fields : Hxc Vc Ls D Name, Hxc Vc Ls D Template, Hxc Vc Ls D Lang, +
             Hxc Vc Ls D Types, Hxc Vc Ls D Media, Hxc Vc Ls D Auto, Hxc Vc Ls D Confirm
    Local  : Field : Default : Skip : Yes

[Field: Hxc Vc Ls D Name]
    Use    : Name Field
    Set as : $HxcVcName
    Width  : 18

[Field: Hxc Vc Ls D Template]
    Use    : Name Field
    Set as : $HxcVcTemplateName
    Width  : 18

[Field: Hxc Vc Ls D Lang]
    Use    : Name Field
    Set as : $HxcVcLanguage
    Width  : 8

[Field: Hxc Vc Ls D Types]
    Use    : Name Field
    Set as : $HxcVcVoucherTypes
    Width  : 20

[Field: Hxc Vc Ls D Media]
    Use    : Name Field
    Set as : $HxcVcMediaExport
    Width  : 14

[Field: Hxc Vc Ls D Auto]
    Use    : Name Field
    Set as : If $HxcVcAutoSend THEN "Yes" ELSE "No"
    Width  : 6

[Field: Hxc Vc Ls D Confirm]
    Use    : Name Field
    Set as : If $HxcVcConfirmBeforeSend THEN "Yes" ELSE "No"
    Width  : 8

[Part: Hxc Vc Ls Hint Part]
    Lines : Hxc Vc Ls Hint Line

[Line: Hxc Vc Ls Hint Line]
    Field : Hxc Vc Ls Hint

[Field: Hxc Vc Ls Hint]
    Use       : Name Field
    Set as    : "Read-only. Esc to leave. Use Create / Alter to change."
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

;; ---------------------------------------------------------------------------
;; About
;; ---------------------------------------------------------------------------

[Report: Helixcer Chat About]
    Form : Helixcer Chat About

[Form: Helixcer Chat About]
    Part : Helixcer Chat About

[Part: Helixcer Chat About]
    Lines : Helixcer Chat About Title, Helixcer Chat About Body, Helixcer Chat About Status

[Line: Helixcer Chat About Title]
    Field : Helixcer Chat About Title

[Field: Helixcer Chat About Title]
    Use       : Name Field
    Set as    : "Helixcer Chat (build 345)"
    Style     : Bold
    Align     : Centre
    FullWidth : Yes

[Line: Helixcer Chat About Body]
    Field : Helixcer Chat About Body

[Field: Helixcer Chat About Body]
    Use       : Name Field
    Set as    : "Voucher Config: Create/Alter open detail SubForm. List is read-only."
    Align     : Centre
    FullWidth : Yes

[Line: Helixcer Chat About Status]
    Field : Helixcer Chat About Status

[Field: Helixcer Chat About Status]
    Use       : Name Field
    Set as    : @@HxcSysSummary
    Align     : Centre
    FullWidth : Yes
