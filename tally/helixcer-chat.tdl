[Function: Hxc Read Send Preview Template]
    Variable : HeaderText : String
    Variable : BodyText : String
    Variable : FooterText : String
    Variable : ButtonText : String
    Variable : Component : String
    01 : WALK COLLECTION : Hxc Connector API Response
    02 :    WALK COLLECTION : items
    03 :       WALK COLLECTION : components
    04 :          SET : Component : $$Upper:$type
    05 :          IF : ##Component = "HEADER" AND NOT $$IsEmpty:$text
    06 :             SET : HeaderText : "[Header] " + ($$StringFindAndReplace:$text:"__HXC_TEMPLATE_NEWLINE__":$$NewLine) + $$NewLine + $$NewLine
    07 :          END IF
    08 :          IF : ##Component = "BODY"
    09 :             SET : BodyText : ($$StringFindAndReplace:$text:"__HXC_TEMPLATE_NEWLINE__":$$NewLine)
    10 :          END IF
    11 :          IF : ##Component = "FOOTER" AND NOT $$IsEmpty:$text
    12 :             SET : FooterText : $$NewLine + $$NewLine + "[Footer] " + ($$StringFindAndReplace:$text:"__HXC_TEMPLATE_NEWLINE__":$$NewLine)
    13 :          END IF
    14 :          IF : ##Component = "BUTTONS"
    15 :             WALK COLLECTION : buttons
    16 :                SET : ButtonText : ##ButtonText + $$NewLine + "[Button] " + $text
    17 :                IF : NOT $$IsEmpty:$url
    18 :                   SET : ButtonText : ##ButtonText + $$NewLine + "[URL] " + $url
    19 :                END IF
    20 :             END WALK
    21 :          END IF
    22 :          IF : ##Component = "BUTTON"
    23 :             SET : ButtonText : ##ButtonText + $$NewLine + "[Button] " + $text
    24 :             IF : NOT $$IsEmpty:$url
    25 :                SET : ButtonText : ##ButtonText + $$NewLine + "[URL] " + $url
    26 :             END IF
    27 :          END IF
    28 :       END WALK
    29 :       IF : NOT $$IsEmpty:##BodyText
    30 :          SET : HxcSendPreviewText : ##HeaderText + ##BodyText + ##FooterText + ##ButtonText
    31 :       END IF
    32 :    END WALK
    33 : END WALK
    34 : RETURN : Yes

[Function: Hxc Populate Send Preview]
    Returns : String
    Variable : MissingMapping : String
    Variable : SourceText : String
    Variable : OutputText : String
    Variable : Component : String
    Variable : Offset : Number
    Variable : CopyFrom : Number
    Variable : LiteralEnd : Number
    Variable : Ending : Number
    Variable : KeyStart : Number
    Variable : KeyLength : Number
    Variable : Size : Number
    Variable : StartOfLine : Logical
    Variable : KeyText : String
    Variable : Resolved : String
    01 : SET : SourceText : $$HxcPreviewLayoutText
    02 : SET : Component : "body"
    03 : SET : StartOfLine : Yes
    04 : SET : Size : $$StringLength:##SourceText
    05 : SET : CopyFrom : 0
    06 : WHILE : ##Offset < ##Size
    07 :    IF : ##StartOfLine
    08 :       IF : $$StringPart:##SourceText:##Offset:9 = "[Header] "
    09 :          SET : Component : "header"
    10 :       ELSE
    11 :          IF : $$StringPart:##SourceText:##Offset:9 = "[Button] " OR $$StringPart:##SourceText:##Offset:6 = "[URL] "
    12 :             SET : Component : "button"
    13 :          ELSE
    14 :             SET : Component : "body"
    15 :          END IF
    16 :       END IF
    17 :    END IF
    18 :    SET : Resolved : ""
    19 :    IF : ##Offset + 1 < ##Size AND $$StringLength:($$StringFindAndReplace:($$StringPart:##SourceText:##Offset:2):"{{":"") = 0
    20 :       SET : KeyStart : ##Offset + 2
    21 :      SET : Ending : ##KeyStart
    22 :       WHILE : ##Ending + 1 < ##Size
    23 :          IF : $$StringLength:($$StringFindAndReplace:($$StringPart:##SourceText:##Ending:2):"}}":"") = 0
    24 :             SET : KeyLength : ##Ending - ##KeyStart
    25 :            SET : KeyText : If ##KeyLength > 0 Then ($$StringPart:##SourceText:##KeyStart:##KeyLength) Else ""
    26 :             SET : Resolved : $$ListValue:HxcSendPreviewValues:(##Component + "|" + ##KeyText)
    27 :            IF : $$IsEmpty:##Resolved AND $$IsEmpty:##MissingMapping
    28 :               SET : MissingMapping : If $$IsEmpty:##KeyText Then ("an empty " + ##Component + " placeholder") Else (##Component + " {{" + ##KeyText + "}}")
    29 :            END IF
    30 :             BREAK
    31 :          END IF
    32 :          IF : $$StringPart:##SourceText:##Ending:1 = $$NewLine
    33 :             BREAK
    34 :          END IF
    35 :          INCREMENT : Ending
    36 :       END WHILE
    37 :    END IF
    38 :    IF : $$IsEmpty:##Resolved
    39 :       SET : StartOfLine : $$StringPart:##SourceText:##Offset:1 = $$NewLine
    40 :       INCREMENT : Offset
    41 :    ELSE
    42 :       IF : ##Offset > ##CopyFrom AND $$StringLength:($$StringFindAndReplace:($$StringPart:##SourceText:(##Offset - 1):3):" {{":"") = 0
    43 :          SET : Resolved : "_ " + ##Resolved
    44 :          SET : LiteralEnd : ##Offset - 1
    45 :       ELSE
    46 :          SET : LiteralEnd : ##Offset
    47 :       END IF
    48 :       IF : ##LiteralEnd < ##Offset
    49 :          SET : OutputText : ##OutputText + ($$StringPart:##SourceText:##CopyFrom:(##LiteralEnd - ##CopyFrom)) + ($$StringPart:##Resolved:1:($$StringLength:##Resolved - 1))
    50 :       ELSE
    51 :          SET : OutputText : ##OutputText + ($$StringPart:##SourceText:##CopyFrom:(##LiteralEnd - ##CopyFrom)) + ##Resolved
    52 :       END IF
    53 :       SET : Offset : ##Ending + 2
    54 :       SET : CopyFrom : ##Offset
    55 :       SET : StartOfLine : No
    56 :    END IF
    57 : END WHILE
    58 : SET : HxcSendPreviewText : ##OutputText + ($$StringPart:##SourceText:##CopyFrom:(##Size - ##CopyFrom))
    59 : RETURN : ##MissingMapping

[Report: Hxc WhatsApp Send Preview]
    Form : Hxc WhatsApp Send Preview
    Title : "Confirm WhatsApp Message"

[Form: Hxc WhatsApp Send Preview]
    Width : 36% Screen
    Height : @@HxcSendPreviewFormHeight
    Background : Hxc Vt Page
    Parts : Hxc Send Preview Details, Hxc Preview Selected Recipients, Hxc Send Preview Heading, Hxc Send Preview PDF Header, Hxc Send Preview Message
    Bottom Part : Hxc Voucher Checklist Preview Actions
    Control : Hxc Preview No Recipients : ##HxcPreviewRecipientCount = 0

[Part: Hxc Send Preview Heading]
    Space Top : 0.25
    Lines : Hxc Vc F Prev Head
    Local : Field : Hxc Vc F Prev Head Fld : Inactive : No
    Local : Field : Hxc Vc F Prev Head Fld : Style : Hxc Send Preview Small

[Part: Hxc Send Preview PDF Header]
    Invisible : NOT ##HxcSendDocument
    Background : Hxc Preview Header Fill
    Space Top : 0.55
    Space Bottom : 0.55
    Line : Hxc Send Preview PDF Header

[Line: Hxc Send Preview PDF Header]
    Field : Hxc Send Preview PDF Header

[Field: Hxc Send Preview PDF Header]
    Use : Name Field
    Style : Hxc Send Preview Small
    Align : Centre
    Full Width : Yes
    Word Wrap : Always : None : Yes
    Set as : ##HxcSendPreviewFilename
    Skip : Yes

[Part: Hxc Send Preview Actions]
    Button : Hxc Send Preview Cancel, Hxc Send Preview Send
    Space Top : 0.5
    Space Bottom : 0.5
    Horizontal Align : Centre

[Button: Hxc Send Preview Send]
    Style : Hxc Send Preview Small
    Key Style : Hxc Send Preview Small
    Width : 12
    Height : 2
    Space Left : 1
    Horizontal Align : Centre
    Title : "Send"
    Key : S
    Skip Forward : No
    Action : Form Accept

[Button: Hxc Send Preview Cancel]
    Style : Hxc Send Preview Small
    Key Style : Hxc Send Preview Small
    Skip Forward : Yes
    Width : 12
    Height : 2
    Space Right : 1
    Horizontal Align : Centre
    Title : "Cancel"
    Key : C
    Action : Form Reject

[Part: Hxc Send Preview Details]
    Line : Hxc Send Preview Template
    Background : Hxc Vt Section Band
    Space Top : 0.5
    Space Bottom : 0.5
    Space Left : 1

[Style: Hxc Send Preview Details Font]
    Use : Hxc Send Preview Small
    Height : 10

[Part: Hxc Preview Recipients Heading]
    Line : Hxc Preview Recipients Heading
    Space Left : 1

[Line: Hxc Preview Recipients Heading]
    Field : Hxc Preview Recipients Heading

[Field: Hxc Preview Recipients Heading]
    Use : Name Field
    Set as : "Recipients"
    Style : Hxc Send Preview Small
    Skip : Yes

[Part: Hxc Preview Selected Recipients]
    Space Left : 1
    Space Top : 0
    Space Bottom : 0
    Lines : Hxc Preview Recipients Heading, Hxc Preview Missing Voucher Mobile, Hxc Preview Summary Row 1, Hxc Preview Summary Row 2, Hxc Preview Summary Row 3

[Line: Hxc Preview Missing Voucher Mobile]
    Field : Hxc Preview Missing Voucher Mobile
    Invisible : ##HxcPreviewRecipientCount > 0

[Field: Hxc Preview Missing Voucher Mobile]
    Use : Name Field
    Style : Hxc Send Preview Small
    Full Width : Yes
    Set as : "Please check the mobile number or save the voucher and try again"
    Skip : Yes

[Line: Hxc Preview Summary Row 1]
    Field : Hxc Preview Summary Recipient
    Invisible : ##HxcPreviewRecipientCount < 1
    Selectable : No
    Local : Field : Hxc Preview Summary Recipient : Set as : $$HxcPreviewRecipientText:1

[Line: Hxc Preview Summary Row 2]
    Field : Hxc Preview Summary Recipient
    Invisible : ##HxcPreviewRecipientCount < 2
    Selectable : No
    Local : Field : Hxc Preview Summary Recipient : Set as : $$HxcPreviewRecipientText:2

[Line: Hxc Preview Summary Row 3]
    Field : Hxc Preview Summary Recipient
    Invisible : ##HxcPreviewRecipientCount < 3
    Selectable : No
    Local : Field : Hxc Preview Summary Recipient : Set as : $$HxcPreviewRecipientText:3

[Field: Hxc Preview Summary Recipient]
    Use : Name Field
    Style : Hxc Preview Recipient Columns
    Full Width : Yes
    Set Always : Yes
    Skip : Yes

[Part: Hxc Voucher Checklist Preview Actions]
    Buttons : Hxc Send Preview Cancel, Hxc Send Voucher Checklist, Hxc Open Preview Checklist
    Space Top : 0.5
    Space Bottom : 0.5
    Horizontal Align : Centre

[Button: Hxc Send Voucher Checklist]
    Use : Hxc Send Preview Send
    Space Left : 0
    Title : If ##HxcPreviewRecipientCount > 1 Then "Send to " + ($$String:##HxcPreviewRecipientCount) + " recipients" Else "Send"
    Width : 18
    Inactive : ##HxcPreviewRecipientCount = 0
    Delete : Action
    Action Ex : ConfirmSend : SET : HxcVoucherPreviewSendPressed : Yes
    Action Ex : AcceptPreview : Form Accept

[Variable: HxcVoucherPreviewSendPressed]
    Type : Logical

[System: Variable]
    HxcVoucherPreviewSendPressed : No
    HxcVoucherPreviewReopen : No

[Variable: HxcVoucherPreviewReopen]
    Type : Logical

[Button: Hxc Open Preview Checklist]
    Horizontal Align : Centre
    Title : "Edit Recipient(s)"
    Space Left : 1
    Key : E
    Style : Hxc Send Preview Small
    Key Style : Hxc Send Preview Small
    Width : 17
    Height : 2
    Skip Forward : No
    Action Ex : Choose : CALL : Hxc Show Preview Checklist
    Action Ex : ReopenPreview : SET : HxcVoucherPreviewReopen : Yes
    Action Ex : CloseForReload : Form Reject

[Function: Hxc Show Preview Checklist]
    Returns : Logical
    Variable : Accepted : Logical
    Variable : OriginalRecipients : String
    001 : SET : OriginalRecipients : ##HxcPreviewRecipientNumbers
    01 : SET : HxcPreviewExistingNumbers : ##HxcPreviewRecipientNumbers
    02 : SET : HxcPreviewExistingCount : ##HxcPreviewRecipientCount
    03 : SET : HxcPreviewRecipientNumbers : ""
    04 : SET : HxcPreviewRecipientCount : 0
    041 : SET : HxcPreviewReplacementMobile : ""
    043 : SET : HxcPreviewDraftEnded : No
    044 : SET : HxcPreviewChecklistResult : ""
    045 : CALL : Hxc Trace Recipient Picker : "picker-open"
    05 : EXECUTE : Hxc Preview Checklist
    051 : CALL : Hxc Trace Recipient Picker : "picker-return"
    06 : SET : Accepted : NOT $$IsEmpty:##HxcPreviewChecklistResult
    061 : IF : NOT ##Accepted
    062 :    SET : HxcPreviewExistingNumbers : ##OriginalRecipients
    063 : END IF
    07 : IF : ##Accepted
    08 :    SET : HxcPreviewRecipientNumbers : ##HxcPreviewChecklistResult
    09 :    SET : HxcPreviewRecipientCount : 0
    10 :    FOR TOKEN : AppliedNumber : ##HxcPreviewRecipientNumbers : ","
    11 :       INCREMENT : HxcPreviewRecipientCount
    111 :   END FOR
    12 : ELSE
    13 :    FOR TOKEN : Mobile : ##HxcPreviewRecipientNumbers : ","
    141 :      IF : NOT $$HxcPreviewNumberIsOnMainList:##Mobile
    14 :          LIST DELETE : HxcPreviewRecipientNames : ##Mobile
    142 :      END IF
    15 :    END FOR
    16 :    SET : HxcPreviewRecipientNumbers : ##HxcPreviewExistingNumbers
    17 :    SET : HxcPreviewRecipientCount : ##HxcPreviewExistingCount
    18 : END IF
    19 : SET : HxcPreviewExistingNumbers : ""
    20 : SET : HxcPreviewExistingCount : 0
    21 : SET : HxcPreviewReplacementMobile : ""
    22 : CALL : Hxc Trace Recipient Picker : "picker-merged"
    23 : RETURN : ##Accepted

[Function: Hxc Apply Preview Recipient Checklist]
    Parameter : DraftRow1 : String
    Parameter : DraftRow2 : String
    Parameter : DraftRow3 : String
    Parameter : SavedRow1 : String
    Parameter : SavedRow2 : String
    Parameter : SavedRow3 : String
    Variable : SavedPosition : Number
    Variable : SavedChoice : String
    00011 : IF : ##HxcPreviewExistingCount >= 1
    00012 :    CALL : Hxc Stage Preview Existing Recipient : 1 : ##SavedRow1 : "" : ""
    00013 : END IF
    00021 : IF : ##HxcPreviewExistingCount >= 2
    00022 :    CALL : Hxc Stage Preview Existing Recipient : 2 : ##SavedRow2 : "" : ""
    00023 : END IF
    00031 : IF : ##HxcPreviewExistingCount >= 3
    00032 :    CALL : Hxc Stage Preview Existing Recipient : 3 : ##SavedRow3 : "" : ""
    00033 : END IF
    001 : CALL : Hxc Capture Preview Draft Field : ##DraftRow1
    002 : CALL : Hxc Capture Preview Draft Field : ##DraftRow2
    003 : CALL : Hxc Capture Preview Draft Field : ##DraftRow3
    01 : SET : HxcPreviewChecklistResult : ""
    011 : FOR TOKEN : SavedNumber : ##HxcPreviewExistingNumbers : ","
    012 :    INCREMENT : SavedPosition
    013 :    SET : SavedChoice : If ##SavedPosition = 1 Then ##SavedRow1 Else If ##SavedPosition = 2 Then ##SavedRow2 Else ##SavedRow3
    014 :    IF : NOT ($$HxcIsSavedRecipientEndChoice:##SavedChoice)
    015 :       SET : HxcPreviewChecklistResult : If $$IsEmpty:##HxcPreviewChecklistResult Then ##SavedNumber Else ##HxcPreviewChecklistResult + "," + ##SavedNumber
    016 :    END IF
    017 : END FOR
    02 : FOR TOKEN : DraftNumber : ##HxcPreviewRecipientNumbers : ","
    03 :    IF : NOT $$IsEmpty:##DraftNumber
    04 :       SET : HxcPreviewChecklistResult : If $$IsEmpty:##HxcPreviewChecklistResult Then ##DraftNumber Else ##HxcPreviewChecklistResult + "," + ##DraftNumber
    05 :    END IF
    06 : END FOR
    07 : CALL : Hxc Trace Recipient Picker : "picker-form-accept"

[Function: Hxc Is Saved Recipient End Choice]
    Parameter : Choice : String
    Returns : Logical
    01 : RETURN : $$Trim:##Choice = "♦ End of List" OR $$Trim:##Choice = "End of List"

[Function: Hxc Capture Preview Draft Field]
    Parameter : Choice : String
    Variable : Mobile : String
    Variable : Label : String
    01 : IF : ##HxcPreviewExistingCount + ##HxcPreviewRecipientCount >= 3
    02 :    RETURN
    03 : END IF
    04 : SET : Mobile : $$HxcPreviewPhoneFromChoice:##Choice
    05 : IF : $$IsEmpty:##Mobile OR $$HxcPreviewNumberIsOnMainList:##Mobile OR $$HxcPreviewNumberIsSelected:##Mobile
    06 :    RETURN
    07 : END IF
    08 : SET : Label : $$HxcResolvePreviewChoiceLabel:##Choice:##Mobile:""
    09 : CALL : Hxc Append Preview Recipient : ##Mobile : ##Label
    10 : CALL : Hxc Trace Recipient Picker : "draft-captured-at-confirmation"

[Function: Hxc Trace Recipient Picker]
    Parameter : EventName : String
    Variable : RootPath : String
    Variable : ResultCount : Number
    01 : SET : RootPath : @@HxcWindowsConnectorRoot
    02 : IF : $$IsEmpty:##RootPath
    03 :    RETURN
    04 : END IF
    05 : FOR TOKEN : TraceNumber : ##HxcPreviewChecklistResult : ","
    06 :    IF : NOT $$IsEmpty:##TraceNumber
    07 :       INCREMENT : ResultCount
    08 :    END IF
    09 : END FOR
    10 : OPEN FILE : (##RootPath + "recipient-picker-trace.log") : Text : Write
    11 : IF : $$LastResult
    12 :    WRITE FILE LINE : (##EventName + " existing=" + ($$String:##HxcPreviewExistingCount) + " current=" + ($$String:##HxcPreviewRecipientCount) + " captured=" + ($$String:##ResultCount))
    13 :    CLOSE TARGET FILE
    14 : END IF

[Report: Hxc Preview Checklist]
    Form : Hxc Preview Checklist
    Title : "Choose WhatsApp Recipients"

[Form: Hxc Preview Checklist]
    Width : 48% Screen
    Height : 48% Screen
    Background : Hxc Vt Page
    Part : Hxc Preview Checklist Contacts
    Bottom Part : Hxc Preview Checklist Footer
    Key : Hxc Preview Checklist Back to Recipients
    No Confirm : Yes
    On : Form Accept : Yes : CALL : Hxc Apply Preview Recipient Checklist : #HxcPreviewDraftRecipient1 : #HxcPreviewDraftRecipient2 : #HxcPreviewDraftRecipient3 : #HxcPreviewFirstRecipientInput : #HxcPreviewExistingRecipientInput2 : #HxcPreviewExistingRecipientInput3
    On : Form Accept : Yes : Form Accept

[Part: Hxc Preview Checklist Contacts]
    Space Top : 0
    Space Bottom : 0
    Space Left : 1
    Lines : Hxc Preview Recipient Entry Heading, Hxc Preview Existing Recipient 1, Hxc Preview Existing Recipient 2, Hxc Preview Existing Recipient 3, Hxc Preview Draft Recipient 1, Hxc Preview Draft Recipient 2, Hxc Preview Draft Recipient 3

[Line: Hxc Preview Existing Recipient 1]
    Space Top : 0
    Space Bottom : 0
    Field : HxcPreviewFirstRecipientInput
    Invisible : ##HxcPreviewExistingCount < 1

[Field: Hxc Preview Existing Recipient Input]
    Use : Name Field
    Style : Hxc Preview Recipient Columns
    Set Always : Yes
    Table : Hxc Preview First Recipient Numbers, Hxc Preview End Choice
    Dynamic : ""
    Show Table : Always
    Skip Forward : ##HxcPreviewDraftEnded
    Option : Hxc Preview Finished Recipient Field : ##HxcPreviewDraftEnded
    Option : Hxc Preview Reopened Existing Choices : ##HxcPreviewExistingCount > 1
    Width : 44% Screen
    Max Edit Lines : 1
    Max Display Lines : 1
[!Field: Hxc Preview Reopened Existing Choices]
    Table : Hxc Preview First Recipient Numbers, Hxc Preview End Choice

[Field: HxcPreviewFirstRecipientInput]
    Use : Hxc Preview Existing Recipient Input
    Set as : $$HxcPreviewExistingRecipientText:1
    On : Accept : @@HxcPreviewEndChoice : SET : HxcPreviewDraftEnded : Yes
    On : Accept : NOT @@HxcPreviewEndChoice : CALL : Hxc Stage Preview Existing Recipient : 1 : $$Value : ($$CurrentTableObj:$HxcPreviewMobile) : ($$CurrentTableObj:$HxcPreviewContactLabel)
    On : Accept : Yes : Field Accept

[!Field: Hxc Preview Finished Recipient Field]
    Show Table : On First Key
    Key : Hxc Reopen Finished Recipient Table

[Key: Hxc Reopen Finished Recipient Table]
    Key : Enter
    Action Ex : OpenRecipientTable : Field Table Mode
    Action Ex : ResumeEditing : Set : HxcPreviewDraftEnded : No

[Table: Hxc Preview First Recipient Numbers]
    Collection : Hxc Preview Ledger Primary, Hxc Preview Ledger Addresses, Hxc Preview Ledger Mobile Contacts
    Format : $$HxcFormatPreviewRecipient:$HxcPreviewMobile:$HxcPreviewContactLabel, 65
    Table Sort : Default
    Title : "Ledger WhatsApp Numbers"

[Function: Hxc Preview Phone From Choice]
    Parameter : Choice : String
    Returns : String
    01 : SET : Choice : $$Trim:##Choice
    02 : IF : ##Choice <> ($$StringFindAndReplace:##Choice:" ♦ ":"")
    03 :    FOR TOKEN : Phone : ##Choice : " "
    04 :       RETURN : $$HxcNormalizePreviewMobile:##Phone:""
    05 :    END FOR
    06 : END IF
    07 : RETURN : $$HxcNormalizePreviewMobile:##Choice:""

[Function: Hxc Resolve Preview Choice Label]
    Parameter : Choice : String
    Parameter : Mobile : String
    Parameter : Label : String
    Returns : String
    Variable : Offset : Number
    01 : IF : NOT $$IsEmpty:##Label AND ##Label <> "Ledger contact"
    02 :    RETURN : ##Label
    03 : END IF
    04 : WHILE : ##Offset < $$StringLength:##Choice
    05 :    IF : $$StringPart:##Choice:##Offset:3 = " ♦ "
    06 :       SET : Offset : ##Offset + 3
    07 :       RETURN : $$Trim:($$StringPart:##Choice:##Offset:(($$StringLength:##Choice) - ##Offset))
    08 :    END IF
    09 :    INCREMENT : Offset
    10 : END WHILE
    11 : SET : Label : $$HxcPreviewPickContactName:##Mobile
    12 : RETURN : If ##Label = "Ledger contact" Then "" Else ##Label

[Function: Hxc Stage Preview Existing Recipient]
    Parameter : Row : Number
    Parameter : Choice : String
    Parameter : Phone : String
    Parameter : Label : String
    Variable : Mobile : String
    Variable : Position : Number
    Variable : Numbers : String
    Variable : RowMobile : String
    01 : SET : Mobile : $$HxcPreviewPhoneFromChoice:(If $$IsEmpty:##Phone Then ##Choice Else ##Phone)
    02 : IF : $$IsEmpty:##Mobile
    03 :    RETURN
    04 : END IF
    05 : FOR TOKEN : Existing : ##HxcPreviewExistingNumbers : ","
    06 :    INCREMENT : Position
    07 :    SET : RowMobile : ##Existing
    08 :    IF : ##Position = ##Row
    09 :       IF : ##Mobile = ##Existing
    10 :          RETURN
    11 :       END IF
    12 :       IF : $$HxcPreviewNumberIsOnMainList:##Mobile OR $$HxcPreviewNumberIsSelected:##Mobile
    13 :          MSG BOX : "Helixcer WhatsApp" : "This number is already in the recipient list."
    14 :          RETURN
    15 :       END IF
    16 :       SET : RowMobile : ##Mobile
    17 :    END IF
    18 :    SET : Numbers : If $$IsEmpty:##Numbers Then ##RowMobile Else ##Numbers + "," + ##RowMobile
    19 : END FOR
    20 : SET : Label : $$HxcResolvePreviewChoiceLabel:##Choice:##Mobile:##Label
    21 : IF : $$IsEmpty:($$ListValue:HxcPreviewRecipientNames:##Mobile)
    22 :    LIST ADD : HxcPreviewRecipientNames : ##Mobile : ##Label
    23 : END IF
    24 : SET : HxcPreviewExistingNumbers : ##Numbers
    25 : SET : HxcPreviewReplacementMobile : ##Mobile

[Line: Hxc Preview Existing Recipient 2]
    Space Top : 0
    Space Bottom : 0
    Field : HxcPreviewExistingRecipientInput2
    Invisible : ##HxcPreviewExistingCount < 2

[Line: Hxc Preview Existing Recipient 3]
    Space Top : 0
    Space Bottom : 0
    Field : HxcPreviewExistingRecipientInput3
    Invisible : ##HxcPreviewExistingCount < 3

[Field: HxcPreviewExistingRecipientInput2]
    Use : Hxc Preview Existing Recipient Input
    Set as : $$HxcPreviewExistingRecipientText:2
    Delete : Dynamic
    Common Table : No
    Default Table Item : $HxcPreviewMobile = ($$HxcPreviewExistingRecipientPhone:2)
    On : Accept : @@HxcPreviewEndChoice : SET : HxcPreviewDraftEnded : Yes
    On : Accept : NOT @@HxcPreviewEndChoice : CALL : Hxc Stage Preview Existing Recipient : 2 : $$Value : ($$CurrentTableObj:$HxcPreviewMobile) : ($$CurrentTableObj:$HxcPreviewContactLabel)
    On : Accept : Yes : Field Accept

[Field: HxcPreviewExistingRecipientInput3]
    Use : Hxc Preview Existing Recipient Input
    Set as : $$HxcPreviewExistingRecipientText:3
    Delete : Dynamic
    Common Table : No
    Default Table Item : $HxcPreviewMobile = ($$HxcPreviewExistingRecipientPhone:3)
    On : Accept : @@HxcPreviewEndChoice : SET : HxcPreviewDraftEnded : Yes
    On : Accept : NOT @@HxcPreviewEndChoice : CALL : Hxc Stage Preview Existing Recipient : 3 : $$Value : ($$CurrentTableObj:$HxcPreviewMobile) : ($$CurrentTableObj:$HxcPreviewContactLabel)
    On : Accept : Yes : Field Accept

[Function: Hxc Preview Existing Recipient Phone]
    Parameter : WantedRow : Number
    Returns : String
    Variable : Row : Number
    01 : FOR TOKEN : Mobile : ##HxcPreviewExistingNumbers : ","
    02 :    INCREMENT : Row
    03 :    IF : ##Row = ##WantedRow
    04 :       RETURN : "+" + ##Mobile
    05 :    END IF
    06 : END FOR
    07 : RETURN : ""

[Function: Hxc Preview Existing Recipient Text]
    Parameter : WantedRow : Number
    Returns : String
    Variable : Row : Number
    Variable : Label : String
    01 : FOR TOKEN : Mobile : ##HxcPreviewExistingNumbers : ","
    02 :    INCREMENT : Row
    03 :    IF : ##Row = ##WantedRow
    04 :       SET : Label : ""
    040 :      IF : ##WantedRow > 1
    0401 :        SET : Label : $$HxcPreviewPickContactName:##Mobile
    0408 :      END IF
    041 :      IF : $$IsEmpty:##Label
    042 :         SET : Label : $$ListValue:HxcPreviewRecipientNames:##Mobile
    043 :         IF : $$IsEmpty:##Label OR ##Label = "Ledger contact"
    044 :            SET : Label : $$HxcPreviewPickContactName:##Mobile
    045 :         END IF
    046 :      END IF
    05 :       RETURN : $$HxcFormatPreviewRecipient:("+" + ##Mobile):##Label
    06 :    END IF
    07 : END FOR
    08 : RETURN : ""

[Line: Hxc Preview Recipient Entry Heading]
    Field : Hxc Preview Recipient Entry Heading
    Selectable : No

[Field: Hxc Preview Recipient Entry Heading]
    Use : Name Field
    Style : Hxc Send Preview Small
    Set as : "Recipients"
    Skip : Yes

[Line: Hxc Preview Recipient Entry]
    Space Top : 0
    Space Bottom : 0

[Line: Hxc Preview Draft Recipient 1]
    Use : Hxc Preview Recipient Entry
    Field : HxcPreviewDraftRecipient1
    Invisible : ##HxcPreviewExistingCount + 1 > 3
    Key : Hxc Remove Draft Recipient 1

[Field: HxcPreviewDraftRecipient1]
    Use : HxcPreviewDraftRecipient
    Set as : $$HxcPreviewRecipientText:1
    On : Accept : @@HxcPreviewEndChoice : SET : HxcPreviewDraftEnded : Yes
    On : Accept : NOT $$IsEmpty:$$Value AND NOT @@HxcPreviewEndChoice : CALL : Hxc Accept Draft Recipient : 1 : $$Value : ($$CurrentTableObj:$HxcPreviewMobile) : ($$CurrentTableObj:$HxcPreviewContactLabel)
    On : Accept : Yes : Field Accept
    On : Accept : NOT ##HxcPreviewDraftEnded AND ##HxcPreviewExistingCount + ##HxcPreviewRecipientCount >= 3 : Refresh Data
    On : Accept : NOT ##HxcPreviewDraftEnded AND ##HxcPreviewExistingCount + ##HxcPreviewRecipientCount >= 3 : Refresh

[Key: Hxc Remove Draft Recipient 1]
    Key : Delete
    Action Ex : Remove : CALL : Hxc Delete Preview Recipient : 1
    Action Ex : ReopenEntry : SET : HxcPreviewDraftEnded : No
    Action Ex : Reload : Refresh Data
    Action Ex : Redraw : Refresh

[Line: Hxc Preview Draft Recipient 2]
    Use : Hxc Preview Recipient Entry
    Field : HxcPreviewDraftRecipient2
    Invisible : ##HxcPreviewExistingCount + 2 > 3
    Key : Hxc Remove Draft Recipient 2

[Field: HxcPreviewDraftRecipient2]
    Use : HxcPreviewDraftRecipient
    Set as : $$HxcPreviewRecipientText:2
    On : Accept : @@HxcPreviewEndChoice : SET : HxcPreviewDraftEnded : Yes
    On : Accept : NOT $$IsEmpty:$$Value AND NOT @@HxcPreviewEndChoice : CALL : Hxc Accept Draft Recipient : 2 : $$Value : ($$CurrentTableObj:$HxcPreviewMobile) : ($$CurrentTableObj:$HxcPreviewContactLabel)
    On : Accept : Yes : Field Accept
    On : Accept : NOT ##HxcPreviewDraftEnded AND ##HxcPreviewExistingCount + ##HxcPreviewRecipientCount >= 3 : Refresh Data
    On : Accept : NOT ##HxcPreviewDraftEnded AND ##HxcPreviewExistingCount + ##HxcPreviewRecipientCount >= 3 : Refresh

[Key: Hxc Remove Draft Recipient 2]
    Key : Delete
    Action Ex : Remove : CALL : Hxc Delete Preview Recipient : 2
    Action Ex : ReopenEntry : SET : HxcPreviewDraftEnded : No
    Action Ex : Reload : Refresh Data
    Action Ex : Redraw : Refresh

[Line: Hxc Preview Draft Recipient 3]
    Use : Hxc Preview Recipient Entry
    Field : HxcPreviewDraftRecipient3
    Invisible : ##HxcPreviewExistingCount + 3 > 3
    Key : Hxc Remove Draft Recipient 3

[Field: HxcPreviewDraftRecipient3]
    Use : HxcPreviewDraftRecipient
    Set as : $$HxcPreviewRecipientText:3
    On : Accept : @@HxcPreviewEndChoice : SET : HxcPreviewDraftEnded : Yes
    On : Accept : NOT $$IsEmpty:$$Value AND NOT @@HxcPreviewEndChoice : CALL : Hxc Accept Draft Recipient : 3 : $$Value : ($$CurrentTableObj:$HxcPreviewMobile) : ($$CurrentTableObj:$HxcPreviewContactLabel)
    On : Accept : Yes : Field Accept
    On : Accept : NOT ##HxcPreviewDraftEnded AND ##HxcPreviewExistingCount + ##HxcPreviewRecipientCount >= 3 : Refresh Data
    On : Accept : NOT ##HxcPreviewDraftEnded AND ##HxcPreviewExistingCount + ##HxcPreviewRecipientCount >= 3 : Refresh

[Key: Hxc Remove Draft Recipient 3]
    Key : Delete
    Action Ex : Remove : CALL : Hxc Delete Preview Recipient : 3
    Action Ex : ReopenEntry : SET : HxcPreviewDraftEnded : No
    Action Ex : Reload : Refresh Data
    Action Ex : Redraw : Refresh

[Field: HxcPreviewDraftRecipient]
    Use : Name Field
    Style : Hxc Preview Recipient Columns
    Set Always : Yes
    Table : Hxc Preview Draft Numbers, Hxc Preview Custom Number Choice, Hxc Preview End Choice
    Common Table : No
    Dynamic : ""
    Show Table : Always
    Skip Forward : ##HxcPreviewDraftEnded
    Width : 44% Screen
    Max Display Lines : 1
    Max Edit Lines : 1
    Default Table Item : NOT $$IsEmpty:$HxcPreviewMobile
[Table: Hxc Preview Draft Numbers]
    Collection : Hxc Preview Draft Primary, Hxc Preview Draft Addresses, Hxc Preview Draft Mobile Contacts
    Format : $$HxcFormatPreviewRecipient:$HxcPreviewMobile:$HxcPreviewContactLabel, 65
    Table Sort : Default
    Title : "Ledger WhatsApp Numbers"

[Collection: Hxc Preview Draft Primary]
    Use : Hxc Preview Ledger Primary
    Add : Filter : Hxc Preview Draft Number Available

[Collection: Hxc Preview Draft Addresses]
    Use : Hxc Preview Ledger Addresses
    Add : Filter : Hxc Preview Draft Number Available

[Collection: Hxc Preview Draft Mobile Contacts]
    Use : Hxc Preview Ledger Mobile Contacts
    Add : Filter : Hxc Preview Draft Number Available

[Collection: Hxc Preview Custom Number Choice]
    List : "♦ Custom Number"

[Collection: Hxc Preview End Choice]
    List : "♦ End of List"

[System: Formula]
    Hxc Preview End Choice : $$Trim:$$Value = "♦ End of List" OR $$Trim:$$Value = "End of List"
    Hxc Preview Draft Number Available : $$HxcPreviewIsDraftNumberAvailable:$HxcPreviewMobile

[Function: Hxc Preview Is Draft Number Available]
    Parameter : Phone : String
    Returns : Logical
    Variable : Mobile : String
    01 : SET : Mobile : $$HxcDialingDigits:##Phone
    02 : RETURN : NOT $$IsEmpty:##Mobile AND NOT $$HxcPreviewNumberIsOnMainList:##Mobile AND NOT $$HxcPreviewNumberIsSelected:##Mobile

[Function: Hxc Accept Draft Recipient]
    Parameter : Row : Number
    Parameter : Choice : String
    Parameter : Phone : String
    Parameter : Label : String
    Variable : Mobile : String
    01 : IF : ##Choice = "Custom Number" OR ##Choice = "♦ Custom Number"
    02 :    CALL : Hxc Open Checklist Custom Number
    03 :    RETURN
    04 : END IF
    05 : IF : $$IsEmpty:##Choice OR $$IsEndOfList:##Choice OR ##Choice = "End of List"
    051 :    IF : ##Row > ##HxcPreviewRecipientCount AND NOT $$IsEmpty:##Choice
    052 :       SET : HxcPreviewDraftEnded : Yes
    053 :    END IF
    06 :    RETURN
    07 : END IF
    08 : IF : $$IsEmpty:##Phone
    09 :    SET : Phone : ##Choice
    10 : END IF
    11 : SET : Mobile : $$HxcPreviewPhoneFromChoice:##Phone
    12 : IF : $$IsEmpty:##Mobile OR $$HxcPreviewNumberIsOnMainList:##Mobile OR $$HxcPreviewNumberIsSelected:##Mobile
    13 :    RETURN
    14 : END IF
    15 : SET : Label : $$HxcResolvePreviewChoiceLabel:##Choice:##Mobile:##Label
    18 : IF : ##Row <= ##HxcPreviewRecipientCount
    19 :    CALL : Hxc Replace Draft Recipient : ##Row : ##Mobile : ##Label
    20 : ELSE
    21 :    IF : ##HxcPreviewExistingCount + ##HxcPreviewRecipientCount < 3
    22 :       CALL : Hxc Append Preview Recipient : ##Mobile : ##Label
    23 :    END IF
    24 : END IF
    25 : CALL : Hxc Trace Recipient Picker : ("draft-accepted-row-" + ($$String:##Row))

[Function: Hxc Replace Draft Recipient]
    Parameter : Row : Number
    Parameter : Mobile : String
    Parameter : Label : String
    Variable : Previous : String
    Variable : Numbers : String
    Variable : Entry : String
    01 : SET : Previous : $$HxcPreviewRecipientAt:##Row
    02 : FOR TOKEN : Existing : ##HxcPreviewRecipientNumbers : ","
    03 :    SET : Entry : If ##Existing = ##Previous Then ##Mobile Else ##Existing
    04 :    SET : Numbers : If $$IsEmpty:##Numbers Then ##Entry Else ##Numbers + "," + ##Entry
    05 : END FOR
    06 : LIST DELETE : HxcPreviewRecipientNames : ##Previous
    07 : LIST ADD : HxcPreviewRecipientNames : ##Mobile : ##Label
    08 : SET : HxcPreviewRecipientNumbers : ##Numbers


[Part: Hxc Preview Checklist Footer]
    Parts : Hxc Preview Recipient Note Part, Hxc Preview Checklist Actions
    Vertical : Yes

[Part: Hxc Preview Recipient Note Part]
    Line : Hxc Preview Recipient Limit Note

[Part: Hxc Preview Checklist Actions]
    Buttons : Hxc Send Preview Cancel, Hxc Finish Preview Checklist
    Horizontal Align : Centre

[Line: Hxc Preview Recipient Limit Note]
    Field : Hxc Preview Recipient Limit Note
    Space Bottom : 0.5

[Field: Hxc Preview Recipient Limit Note]
    Use : Name Field
    Space Left : 1
    Style : Hxc Send Preview Small
    Set as : "Note: Maximum 3 recipients can be added"
    Full Width : Yes
    Align : Left
    Skip : Yes

[Key: Hxc Preview Checklist Back to Recipients]
    Key : Shift + Tab
    Option : Hxc Preview Checklist Resume Recipients : ##HxcPreviewDraftEnded

[!Key: Hxc Preview Checklist Resume Recipients]
    Action Ex : ResumeEditing : Set : HxcPreviewDraftEnded : No
    Action Ex : GoToRecipients : Form Home

[Button: Hxc Finish Preview Checklist]
    Horizontal Align : Centre
    Title : "Add to List"
    Key : Alt + D
    Skip Forward : No
    Width : 16
    Height : 2
    Inactive : ##HxcPreviewExistingCount + ##HxcPreviewRecipientCount = 0
    Action : Form Accept

[Function: Hxc Open Checklist Custom Number]
    01 : IF : ##HxcPreviewExistingCount + ##HxcPreviewRecipientCount >= 3
    02 :    MSG BOX : "Helixcer WhatsApp" : "You can select up to three recipients."
    03 :    RETURN
    04 : END IF
    05 : EXECUTE : Hxc Checklist Custom Number

[Report: Hxc Checklist Custom Number]
    Form : Hxc Checklist Custom Number
    Title : "Add Custom WhatsApp Number"

[Form: Hxc Checklist Custom Number]
    Width : 36% Screen
    Height : 8
    Part : Hxc Checklist Custom Number
    Buttons : Form Accept, Form Cancel
    No Confirm : Yes
    On : Form Accept : Yes : CALL : Hxc Save Checklist Custom Number : #HxcPreviewCustomCountryInput : #HxcPreviewCustomMobileInput
    On : Form Accept : ##HxcPreviewCustomAccepted : Form Accept

[Part: Hxc Checklist Custom Number]
    Line : Hxc Checklist Custom Number

[Line: Hxc Checklist Custom Number]
    Fields : Medium Prompt, HxcPreviewCustomCountryInput, HxcPreviewCustomMobileInput
    Local : Field : Medium Prompt : Set as : "Mobile number"

[Field: HxcPreviewCustomCountryInput]
    Use : MobileCountryCode
    Delete : Storage
    Delete : Set By Condition
    Show Table : Always
    Set as : @@HxcCompanyDefaultCountryCode
    Validate : $$HxcValidDialingCode:$$Value
    Width : 8

[Field: HxcPreviewCustomMobileInput]
    Use : Name Field
    Width : 22

[Variable: HxcPreviewCustomAccepted]
    Type : Logical

[Function: Hxc Save Checklist Custom Number]
    Parameter : Country : String
    Parameter : Input : String
    Variable : Mobile : String
    01 : SET : HxcPreviewCustomAccepted : No
    02 : SET : Mobile : $$HxcNormalizePreviewMobile:##Input:##Country
    03 : IF : $$IsEmpty:##Mobile
    04 :    MSG BOX : "Helixcer WhatsApp" : "Enter a valid country code and mobile number."
    05 :    RETURN
    06 : END IF
    07 : IF : $$HxcPreviewNumberIsOnMainList:##Mobile OR $$HxcPreviewNumberIsSelected:##Mobile
    08 :    MSG BOX : "Helixcer WhatsApp" : "This number is already selected."
    09 :    RETURN
    10 : END IF
    11 : CALL : Hxc Append Preview Recipient : ##Mobile : "Custom Number"
    12 : SET : HxcPreviewCustomAccepted : Yes

[Variable: HxcPreviewRecipientCount]
    Type : Number

[Variable: HxcPreviewExistingNumbers]
    Type : String

[Variable: HxcPreviewExistingCount]
    Type : Number

[Variable: HxcPreviewReplacementMobile]
    Type : String

[Variable: HxcPreviewDraftEnded]
    Type : Logical

[Variable: HxcPreviewChecklistResult]
    Type : String

[System: Variable]
    HxcPreviewRecipientCount : 0
    HxcPreviewExistingNumbers : ""
    HxcPreviewExistingCount : 0
    HxcPreviewReplacementMobile : ""
    HxcPreviewDraftEnded : No
    HxcPreviewChecklistResult : ""
    HxcPreviewCustomAccepted : No
    List Variable : HxcPreviewRecipientNames : String
    List Variable : HxcPreviewLedgerContactNames : String
    HxcPreviewAddressNumbers : ""

[Variable: HxcPreviewAddressNumbers]
    Type : String

[System: Formula]
    Hxc Preview Recipient Height : 1 + (If ##HxcPreviewRecipientCount = 0 Then 1 Else ##HxcPreviewRecipientCount)
    Hxc Preview No Recipients : "Add at least one WhatsApp recipient before sending."

[Function: Hxc Load Preview Ledger Contact Names]
    01 : LIST DELETE : HxcPreviewLedgerContactNames
    011 : SET : HxcPreviewAddressNumbers : "|"
    02 : WALK COLLECTION : Hxc Preview Ledger Primary
    03 :    CALL : Hxc Cache Preview Ledger Contact Name : $HxcPreviewMobile : $HxcPreviewContactLabel
    031 :   SET : HxcPreviewAddressNumbers : ##HxcPreviewAddressNumbers + $HxcPreviewMobile + "|"
    04 : END WALK
    05 : WALK COLLECTION : Hxc Preview Ledger Addresses
    06 :    CALL : Hxc Cache Preview Ledger Contact Name : $HxcPreviewMobile : $HxcPreviewContactLabel
    061 :   SET : HxcPreviewAddressNumbers : ##HxcPreviewAddressNumbers + $HxcPreviewMobile + "|"
    07 : END WALK
    08 : WALK COLLECTION : Hxc Preview Ledger Mobile Contacts
    09 :    CALL : Hxc Cache Preview Ledger Contact Name : $HxcPreviewMobile : $HxcPreviewContactLabel
    10 : END WALK

[Function: Hxc Cache Preview Ledger Contact Name]
    Parameter : Phone : String
    Parameter : ContactName : String
    Variable : Mobile : String
    01 : SET : Mobile : $$HxcDialingDigits:##Phone
    02 : IF : NOT $$IsEmpty:##Mobile AND $$IsEmpty:($$ListValue:HxcPreviewLedgerContactNames:##Mobile)
    021 :    IF : $$IsEmpty:##ContactName
    022 :       SET : ContactName : "Ledger contact"
    023 :    END IF
    03 :    LIST ADD : HxcPreviewLedgerContactNames : ##Mobile : ##ContactName
    04 : END IF

[Function: Hxc Preview Pick Contact Name]
    Parameter : Mobile : String
    Returns : String
    Variable : Label : String
    01 : SET : Label : $$ListValue:HxcPreviewLedgerContactNames:##Mobile
    02 : IF : NOT $$IsEmpty:##Label AND ##Label <> "Ledger contact"
    03 :    RETURN : ##Label
    04 : END IF
    05 : IF : $$IsEmpty:##Mobile
    06 :    RETURN : ""
    07 : END IF
    08 : WALK COLLECTION : Hxc Preview Ledger Addresses
    09 :    IF : ($$HxcDialingDigits:$HxcPreviewMobile) = ##Mobile
    10 :       RETURN : $HxcPreviewContactLabel
    11 :    END IF
    12 : END WALK
    13 : WALK COLLECTION : Hxc Preview Ledger Primary
    14 :    IF : ($$HxcDialingDigits:$HxcPreviewMobile) = ##Mobile
    15 :       RETURN : $HxcPreviewContactLabel
    16 :    END IF
    17 : END WALK
    171 : WALK COLLECTION : Hxc Preview Ledger Mobile Contacts
    172 :    IF : ($$HxcDialingDigits:$HxcPreviewMobile) = ##Mobile
    173 :       RETURN : $HxcPreviewContactLabel
    174 :    END IF
    175 : END WALK
    18 : RETURN : ""

[Function: Hxc Append Preview Recipient]
    Parameter : Mobile : String
    Parameter : ContactName : String
    01 : IF : $$IsEmpty:##Mobile OR ##HxcPreviewRecipientCount >= 3
    02 :    RETURN
    03 : END IF
    04 : FOR TOKEN : Existing : ##HxcPreviewRecipientNumbers : ","
    05 :    IF : ##Existing = ##Mobile
    06 :       RETURN
    07 :    END IF
    08 : END FOR
    09 : SET : HxcPreviewRecipientNumbers : If $$IsEmpty:##HxcPreviewRecipientNumbers Then ##Mobile Else ##HxcPreviewRecipientNumbers + "," + ##Mobile
    10 : LIST ADD : HxcPreviewRecipientNames : ##Mobile : ##ContactName
    11 : INCREMENT : HxcPreviewRecipientCount

[Function: Hxc Preview Recipient At]
    Parameter : WantedRow : Number
    Returns : String
    Variable : Row : Number
    01 : FOR TOKEN : Mobile : ##HxcPreviewRecipientNumbers : ","
    02 :    INCREMENT : Row
    03 :    IF : ##Row = ##WantedRow
    04 :       RETURN : ##Mobile
    05 :    END IF
    06 : END FOR
    07 : RETURN : ""

[Function: Hxc Preview Address Contact Label]
    Parameter : AddressContact : String
    Parameter : ContactPerson : String
    Parameter : AddressType : String
    Returns : String
    01 : IF : $$IsEmpty:##AddressContact OR $$IsSysNameEqual:NotApplicable:##AddressContact OR ##AddressContact = "Not Applicable"
    02 :    SET : AddressContact : ##ContactPerson
    03 : END IF
    04 : RETURN : $$HxcPreviewContactLabel:##AddressContact:##AddressType

[Function: Hxc Preview Contact Label]
    Parameter : ContactName : String
    Parameter : AddressType : String
    Returns : String
    01 : IF : $$IsEmpty:##ContactName OR $$IsSysNameEqual:NotApplicable:##ContactName OR ##ContactName = "Not Applicable" OR ##ContactName = ##AddressType
    02 :    RETURN : ##AddressType
    03 : END IF
    04 : RETURN : If $$IsEmpty:##AddressType Then ##ContactName Else ($$HxcPadPreviewRecipient:##ContactName:23) + " ♦ " + ##AddressType

[Function: Hxc Preview Recipient Text]
    Parameter : Row : Number
    Returns : String
    Variable : Mobile : String
    Variable : ContactName : String
    01 : SET : Mobile : $$HxcPreviewRecipientAt:##Row
    02 : SET : ContactName : $$ListValue:HxcPreviewRecipientNames:##Mobile
    021 : IF : $$IsEmpty:##ContactName AND NOT $$IsEmpty:##Mobile
    022 :    SET : ContactName : $$HxcPreviewPickContactName:##Mobile
    023 : END IF
    03 : RETURN : If $$IsEmpty:##Mobile Then "" Else $$HxcFormatPreviewRecipient:("+" + ##Mobile):##ContactName

[Style: Hxc Preview Recipient Columns]
    Use : Hxc Send Preview Small
    Font : "Consolas"
    Bold : No

[Function: Hxc Format Preview Recipient]
    Parameter : Phone : String
    Parameter : ContactLabel : String
    Returns : String
    01 : RETURN : If $$IsEmpty:##ContactLabel OR $$IsSysNameEqual:NotApplicable:##ContactLabel Then ##Phone Else ($$HxcPadPreviewRecipient:##Phone:21) + " ♦ " + ##ContactLabel

[Function: Hxc Pad Preview Recipient]
    Parameter : Value : String
    Parameter : Width : Number
    Returns : String
    Variable : Padding : Number
    01 : SET : Padding : ##Width - $$StringLength:##Value
    02 : IF : ##Padding <= 0
    03 :    RETURN : ##Value
    04 : END IF
    05 : RETURN : ##Value + ($$StringPart:"                         ":0:##Padding)

[Function: Hxc Delete Preview Recipient]
    Parameter : Row : Number
    Variable : Removed : String
    Variable : Remaining : String
    01 : SET : Removed : $$HxcPreviewRecipientAt:##Row
    02 : IF : $$IsEmpty:##Removed
    03 :    RETURN
    04 : END IF
    05 : FOR TOKEN : Mobile : ##HxcPreviewRecipientNumbers : ","
    06 :    IF : NOT (##Mobile = ##Removed)
    07 :       SET : Remaining : If $$IsEmpty:##Remaining Then ##Mobile Else ##Remaining + "," + ##Mobile
    08 :    END IF
    09 : END FOR
    10 : SET : HxcPreviewRecipientNumbers : ##Remaining
    11 : LIST DELETE : HxcPreviewRecipientNames : ##Removed
    12 : SET : HxcPreviewRecipientCount : ##HxcPreviewRecipientCount - 1


[Variable: HxcPreviewRecipientLedger]
    Type : String

[Variable: HxcPreviewRecipientNumbers]
    Type : String

[System: Variable]
    HxcPreviewRecipientLedger : ""
    HxcPreviewRecipientNumbers : ""

[Collection: Hxc Preview Ledger Primary]
    Source Collection : Hxc Preview Primary Ledger Source
    By : HxcPreviewPrimaryParty : $Name
    Compute : HxcPreviewContactLabel : $$HxcPreviewContactLabel:$LedgerContact:"Primary"
    Compute : HxcPreviewMobile : @@HxcPreviewPrimaryLedgerMobile
    Search Key : $HxcPreviewMobile

[Collection: Hxc Preview Primary Ledger Source]
    Use : Hxc Preview Recipient Ledger
    Add : Filter : Hxc Preview Primary Ledger Has Mobile

[Collection: Hxc Preview Ledger Addresses]
    Source Collection : Hxc Preview Recipient Ledger
    Walk : LedMultiAddressList
    Fetch : AddressName, AddrTypeContactPerson, ContactPerson, CountryISDCode, AddrTypeMobileCountryCode, MobileNumber, AddrTypeMobileNumber
    Compute : HxcRecipientAddress : $AddressName
    Compute : HxcRecipientName : If NOT $$IsEmpty:$AddrTypeContactPerson Then $AddrTypeContactPerson Else If NOT $$IsEmpty:$ContactPerson Then $ContactPerson Else $AddressName
    Compute : HxcPreviewContactName : If $$IsEmpty:$AddrTypeContactPerson OR $$IsSysNameEqual:NotApplicable:$AddrTypeContactPerson OR $AddrTypeContactPerson = "Not Applicable" Then $ContactPerson Else $AddrTypeContactPerson
    Compute : HxcPreviewContactLabel : $$HxcPreviewAddressContactLabel:$AddrTypeContactPerson:$ContactPerson:$AddressName
    Compute : HxcPreviewAddressCountry : If $$IsEmpty:$AddrTypeMobileCountryCode Then $CountryISDCode Else $AddrTypeMobileCountryCode
    Compute : HxcPreviewMobile : $$HxcResolvePreviewAddressMobile:$AddrTypeMobileNumber:$MobileNumber:$HxcPreviewAddressCountry
    Search Key : $HxcPreviewMobile
    Filter : Hxc Preview Mobile Is Valid

[Collection: Hxc Preview Ledger Mobile Contact Rows]
    Source Collection : Hxc Preview Recipient Ledger
    Walk : ContactDetails
    Fetch : Name, PhoneNumber, CountryISDCode
    Compute : HxcPreviewMobile : $$HxcPreviewLedgerNumber:$PhoneNumber:$CountryISDCode
    Compute : HxcPreviewContactLabel : $Name
    Filter : Hxc Preview Mobile Is Valid

[Collection: Hxc Preview Ledger Mobile Contacts]
    Source Collection : Hxc Preview Ledger Mobile Contact Rows
    By : HxcPreviewMobile : $HxcPreviewMobile
    Compute : HxcPreviewContactLabel : $HxcPreviewContactLabel
    Search Key : $HxcPreviewMobile
    Filter : Hxc Preview Mobile Contact Is Additional

[System: Formula]
    Hxc Preview Mobile Contact Is Additional : ##HxcPreviewAddressNumbers = ($$StringFindAndReplace:##HxcPreviewAddressNumbers:("|" + $HxcPreviewMobile + "|"):"")

[Collection: Hxc Preview Recipient Ledger]
    Type : Ledger
    Fetch : Name, LedgerContact, LedgerMobile, MobileNumber, AddrTypeMobileNumber, CountryName, LedgercountryISDcode, AddrTypeMobileCountryCode, CountryISDCode, MobileCountryCode, LedgerMobileCountryCode, MobileISDCode, ISDCode, CountryCode, LedMultiAddressList, LedMultiAddressList.*, ContactDetails, ContactDetails.*
    Filter : Hxc Preview Recipient Ledger Match

[System: Formula]
    Hxc Preview Mobile Is Valid : NOT $$IsEmpty:$HxcPreviewMobile
    Hxc Preview Primary Ledger Country : If NOT $$IsEmpty:$LedgercountryISDcode Then $LedgercountryISDcode Else If NOT $$IsEmpty:$AddrTypeMobileCountryCode Then $AddrTypeMobileCountryCode Else If NOT $$IsEmpty:$CountryISDCode Then $CountryISDCode Else If NOT $$IsEmpty:$MobileCountryCode Then $MobileCountryCode Else If NOT $$IsEmpty:$LedgerMobileCountryCode Then $LedgerMobileCountryCode Else If NOT $$IsEmpty:$MobileISDCode Then $MobileISDCode Else If NOT $$IsEmpty:$ISDCode Then $ISDCode Else If NOT $$IsEmpty:$CountryCode Then $CountryCode Else If $CountryName = "India" Then "+91" Else ""
    Hxc Preview Primary Ledger Mobile : $$HxcResolvePreviewAddressMobile:$LedgerMobile:($$HxcResolvePreviewAddressMobile:$MobileNumber:$AddrTypeMobileNumber:@@HxcPreviewPrimaryLedgerCountry):@@HxcPreviewPrimaryLedgerCountry
    Hxc Preview Primary Ledger Has Mobile : NOT $$IsEmpty:@@HxcPreviewPrimaryLedgerMobile
    Hxc Preview Recipient Ledger Match : NOT $$IsEmpty:##HxcPreviewRecipientLedger AND $Name = ##HxcPreviewRecipientLedger

[Function: Hxc Preview Number Is On Main List]
    Parameter : Mobile : String
    Returns : Logical
    001 : IF : NOT $$IsEmpty:##Mobile AND ##Mobile = ##HxcPreviewReplacementMobile
    002 :    RETURN : Yes
    003 : END IF
    01 : FOR TOKEN : Existing : ##HxcPreviewExistingNumbers : ","
    02 :    IF : ##Existing = ##Mobile
    03 :       RETURN : Yes
    04 :    END IF
    05 : END FOR
    06 : RETURN : No

[Function: Hxc Preview Number Is Selected]
    Parameter : Phone : String
    Returns : Logical
    Variable : Mobile : String
    01 : SET : Mobile : $$HxcDialingDigits:##Phone
    02 : FOR TOKEN : Existing : ##HxcPreviewRecipientNumbers : ","
    03 :    IF : ##Existing = ##Mobile
    04 :       RETURN : Yes
    05 :    END IF
    06 : END FOR
    07 : RETURN : No

[Function: Hxc Resolve Preview Address Mobile]
    Parameter : AddressMobile : String
    Parameter : Mobile : String
    Parameter : Country : String
    Returns : String
    Variable : Number : String
    01 : SET : Number : $$HxcPreviewLedgerNumber:##AddressMobile:##Country
    02 : RETURN : If $$IsEmpty:##Number Then $$HxcPreviewLedgerNumber:##Mobile:##Country Else ##Number

[Function: Hxc Preview Ledger Number]
    Parameter : Mobile : String
    Parameter : Country : String
    Returns : String
    Variable : Normalized : String
    01 : IF : $$IsEmpty:##Country
    011 :    SET : Country : @@HxcCompanyDefaultCountryCode
    012 : END IF
    013 : SET : Normalized : $$HxcNormalizePreviewMobile:##Mobile:##Country
    02 : RETURN : If $$IsEmpty:##Normalized Then "" Else "+" + ##Normalized

[Function: Hxc Normalize Preview Mobile]
    Parameter : Raw : String
    Parameter : Country : String
    Returns : String
    Variable : Mobile : String
    Variable : Prefix : String
    01 : SET : Raw : $$Trim:##Raw
    02 : SET : Mobile : $$HxcDialingDigits:##Raw
    03 : IF : $$IsEmpty:##Mobile
    04 :    RETURN : ""
    05 : END IF
    06 : IF : $$StringPart:##Raw:0:1 <> "+"
    07 :    SET : Prefix : $$HxcDialingDigits:##Country
    08 :    IF : $$IsEmpty:##Prefix
    09 :       RETURN : ""
    10 :    END IF
    11 :    SET : Mobile : ##Prefix + ##Mobile
    12 : END IF
    13 : RETURN : If $$StringLength:##Mobile < 7 OR $$StringLength:##Mobile > 15 OR $$StringPart:##Mobile:0:1 = "0" Then "" Else ##Mobile

[Line: Hxc Send Preview Template]
    Fields : Medium Prompt, Hxc Send Preview Template
    Local : Field : Medium Prompt : Set as : "Template name"
    Local : Field : Medium Prompt : Style : Hxc Send Preview Details Font
    Local : Field : Medium Prompt : Width : 13
    Space Bottom : 0.20

[Field: Hxc Send Preview Template]
    Use : Name Field
    Style : Hxc Send Preview Details Font
    Set as : ##HxcSendTemplate + " (" + ##HxcSendLanguage + ")"
    Full Width : Yes
    Word Wrap : Always : None : Yes
    Skip : Yes

[Function: Hxc Resolve PDF Filename]
    Parameter : Pattern : String
    Returns : String
    Variable : Offset : Number
    Variable : LiteralStart : Number
    Variable : TokenStart : Number
    Variable : ReadingToken : Logical
    Variable : Token : String
    Variable : Resolved : String
    Variable : Output : String
    00 : SET : Pattern : $$StringFindAndReplace:##Pattern:"-":"__HXC_DASH_47__"
    01 : WHILE : ##Offset < $$StringLength:##Pattern
    02 :    IF : NOT ##ReadingToken AND $$StringPart:##Pattern:##Offset:2 = "{{"
    03 :       IF : ##Offset > ##LiteralStart
    04 :          SET : Output : ##Output + $$StringPart:##Pattern:##LiteralStart:(##Offset - ##LiteralStart)
    05 :       END IF
    06 :       SET : TokenStart : ##Offset + 2
    07 :       SET : ReadingToken : Yes
    08 :       INCREMENT : Offset
    09 :    ELSE
    10 :       IF : ##ReadingToken AND $$StringPart:##Pattern:##Offset:2 = "}}"
    11 :          SET : Token : $$StringPart:##Pattern:##TokenStart:(##Offset - ##TokenStart)
    12 :          IF : ##Token = "Contact Name"
    13 :             SET : Resolved : If $$IsSysNameEqual:NotApplicable:$HxcVoucherContactName OR $HxcVoucherContactName = "Not Applicable" Then "" Else $HxcVoucherContactName
    14 :          ELSE
    15 :             SET : Resolved : $$HxcResolveVoucherSendValue:##Token
    16 :          END IF
    17 :          SET : Output : ##Output + ##Resolved
    18 :          SET : LiteralStart : ##Offset + 2
    19 :          SET : ReadingToken : No
    20 :          INCREMENT : Offset
    21 :       END IF
    22 :    END IF
    23 :    INCREMENT : Offset
    24 : END WHILE
    25 : IF : ##ReadingToken
    26 :    RETURN : ""
    27 : END IF
    28 : IF : ##Offset > ##LiteralStart
    29 :    SET : Output : ##Output + $$StringPart:##Pattern:##LiteralStart:(##Offset - ##LiteralStart)
    30 : END IF
    31 : RETURN : ##Output

[Function: Hxc Preview PDF Name]
    Parameter : Pattern : String
    Parameter : VoucherNumber : String
    Returns : String
    Variable : Stem : String
    01 : SET : Stem : $$HxcResolvePDFFilename:##Pattern
    02 : SET : Stem : $$StringFindAndReplace:##Stem:"__HXC_DASH_47__":"-"
    03 : SET : Stem : $$Trim:##Stem
    04 : IF : $$StringLength:##Stem >= 4 AND $$Upper:($$StringPart:##Stem:(($$StringLength:##Stem) - 4):4) = ".PDF"
    05 :    SET : Stem : $$StringPart:##Stem:0:(($$StringLength:##Stem) - 4)
    06 : END IF
    07 : IF : $$IsEmpty:##Stem
    08 :    SET : Stem : ##VoucherNumber
    09 : END IF
    10 : SET : Stem : $$StringFindAndReplace:##Stem:($$StrByCharCode:32):"-"
    11 : SET : Stem : $$StringFindAndReplace:##Stem:"/":"-"
    12 : SET : Stem : $$StringFindAndReplace:##Stem:($$StrByCharCode:92):"-"
    13 : RETURN : ($$StringPart:##Stem:0:100) + ".pdf"

[Function: Hxc PDF Queue Filename]
    Parameter : Filename : String
    Returns : String
    Variable : FlatName : String
    01 : SET : FlatName : $$StringFindAndReplace:##Filename:($$StrByCharCode:13):"-"
    02 : SET : FlatName : $$StringFindAndReplace:##FlatName:($$StrByCharCode:10):"-"
    03 : RETURN : $$StringPart:##FlatName:0:180

[Function: Hxc Queue Voucher WhatsApp Send]
    Parameter : HistoryReference : String
    Returns : Logical
    Variable : RequestPath : String
    01 : SET : RequestPath : $$HxcWriteVoucherWhatsAppRequest:##HistoryReference:"":Yes
    02 : IF : $$IsEmpty:##RequestPath
    03 :    RETURN : No
    04 : END IF
    041 : SET : HxcVoucherPendingBaseline : $$HxcReadLatestWhatsAppEntryKey
    05 : CALL : Hxc Launch Voucher WhatsApp Request : ##RequestPath : ##HistoryReference : ##HxcSendTo
    06 : RETURN : Yes

[Function: Hxc Write Voucher WhatsApp Request]
    Parameter : HistoryReference : String
    Parameter : PdfName : String
    Parameter : LedgerReminder : Logical
    Returns : String
    Variable : PdfFolder : String
    Variable : VoucherNumber : String
    Variable : RequestPath : String
    Variable : Slot : Number
    Variable : QueueSlotKey : String
    Variable : AttachmentName : String
    Variable : ContactName : String
    Variable : ContactCompany : String
    Variable : ContactTag : String
    005 : IF : NOT ##LedgerReminder
    006 :    SET : ContactName : $$HxcResolveVoucherContactMetadata:($HxcVtContactNameMap:VoucherType:$VoucherTypeName)
    007 :    SET : ContactCompany : $$HxcResolveVoucherContactMetadata:($HxcVtContactCompanyMap:VoucherType:$VoucherTypeName)
    008 :    SET : ContactTag : $$HxcResolveVoucherContactMetadata:($HxcVtContactTagMap:VoucherType:$VoucherTypeName)
    009 : END IF
    01 : SET : VoucherNumber : ##HistoryReference
    02 : IF : ##HxcSendDocument AND ($$IsEmpty:##VoucherNumber OR $$IsEmpty:$MasterID)
    03 :    MSG BOX : "Helixcer WhatsApp" : "The saved voucher number is required to export and verify the PDF."
    04 :    RETURN : ""
    05 : END IF
    06 : SET : PdfFolder : @@HxcVoucherPDFFolder
    061 : IF : ##HxcSendDocument AND $$IsEmpty:##PdfFolder
    062 :    MSG BOX : "Helixcer WhatsApp" : "Set PDF Export Folder in Helixcer Chat > General Settings first."
    063 :    RETURN : ""
    064 : END IF
    08 : SET : RequestPath : @@HxcWindowsConnectorRoot + $$MakeUniqueID + ".request"
    10 : OPEN FILE : ##RequestPath : Text : Write
    11 : IF : NOT $$LastResult
    12 :    MSG BOX : "Helixcer WhatsApp" : "Could not write the local WhatsApp queue request."
    13 :    RETURN : ""
    14 : END IF
    15 : WRITE FILE LINE : (If ##HxcSendDocument Then ##PdfFolder + "\Tally.pdf" Else "HXC-TEXT")
    16 : WRITE FILE LINE : ##VoucherNumber
    17 : WRITE FILE LINE : (If ##HxcSendDocument Then ##PdfFolder + "\" + ##PdfName Else "HXC-TEXT")
    171 : WRITE FILE LINE : ##HxcSysChannelId
    172 : WRITE FILE LINE : ##HxcSendTo
    173 : WRITE FILE LINE : ##HxcSendTemplate
    174 : WRITE FILE LINE : ##HxcSendLanguage
    175 : WRITE FILE LINE : ##HxcSendReference
    176 : WRITE FILE LINE : $$String:##HxcSendMappingCount
    177 : SET : Slot : 0
    178 : WHILE : ##Slot < ##HxcSendMappingCount
    179 :    INCREMENT : Slot
    180 :    SET : QueueSlotKey : $$String:##Slot
    181 :    WRITE FILE LINE : $$ListValue:HxcSendQueuedComponents:##QueueSlotKey
    182 :    WRITE FILE LINE : $$ListValue:HxcSendQueuedKeys:##QueueSlotKey
    183 :    WRITE FILE LINE : $$ListValue:HxcSendQueuedMappings:##QueueSlotKey
    188 : END WHILE
    1881 : IF : ##HxcSendDocument
    1882 :    SET : AttachmentName : $$HxcResolvePDFFilename:($HxcVtPdfFileName:VoucherType:$VoucherTypeName)
    1883 :    IF : NOT $$IsEmpty:##AttachmentName
    1884 :       WRITE FILE LINE : ("HXC-FILENAME:" + $$HxcPDFQueueFilename:##AttachmentName)
    1885 :    END IF
    1886 : END IF
    1887 : IF : NOT ##LedgerReminder
    18871 : IF : NOT $$IsEmpty:##ContactName
    188711 :    WRITE FILE LINE : ("HXC-CONTACT-NAME:" + ($$StringFindAndReplace:##ContactName:$$NewLine:" "))
    188712 : END IF
    18872 : IF : NOT $$IsEmpty:##ContactCompany
    188721 :    WRITE FILE LINE : ("HXC-CONTACT-COMPANY:" + ($$StringFindAndReplace:##ContactCompany:$$NewLine:" "))
    188722 : END IF
    18873 : IF : NOT $$IsEmpty:##ContactTag
    188731 :    WRITE FILE LINE : ("HXC-CONTACT-TAG:" + ($$StringFindAndReplace:##ContactTag:$$NewLine:" "))
    188732 : END IF
    18874 : END IF
    189 : WRITE FILE LINE : "HXC-END"
    19 : CLOSE TARGET FILE
    20 : RETURN : ##RequestPath

[Function: Hxc Launch Voucher WhatsApp Request]
    Parameter : RequestPath : String
    Parameter : VoucherNumber : String
    Parameter : Recipient : String
    211 : SET : HxcVoucherPendingWorkspace : ##HxcSysWorkspaceId
    212 : SET : HxcVoucherPendingFooter : "Last WhatsApp  |  " + ##VoucherNumber + "  |  +" + ##Recipient + "  |  " + (If ##HxcSendDocument Then "Uploading" Else "Queued")
    22 : BrowseURL Ex : @@HxcVoucherSenderExe : (##HxcSysWorkspaceId + " " + @@HxcVoucherArgumentQuote + ##RequestPath + @@HxcVoucherArgumentQuote)

[Function: Hxc Record Voucher Message History]
    Variable : ReceiptPath : String
    Variable : HistoryStatus : String
    Variable : HistoryDetails : String
    01 : SET : HistoryStatus : "Unconfirmed"
    02 : SET : HistoryDetails : "Helixcer did not confirm a message ID. Check the inbox before retrying."
    03 : IF : NOT $$IsEmpty:##HxcSendMessageId
    04 :    SET : HistoryStatus : "Accepted"
    05 :    SET : HistoryDetails : "Helixcer accepted the send. Check the inbox for delivery."
    06 : ELSE
    07 :    IF : NOT $$IsEmpty:##HxcSendErrorCode
    08 :       SET : HistoryStatus : "Failed"
    09 :       SET : HistoryDetails : ##HxcSendErrorCode + " " + ##HxcSendErrorMessage
    10 :    END IF
    11 : END IF
    111 : IF : $$IsEmpty:@@HxcWindowsConnectorRoot OR $$FileSize:@@HxcVoucherSenderExe <= 0
    112 :    RETURN
    113 : END IF
    12 : SET : ReceiptPath : @@HxcWindowsConnectorRoot + $$MakeUniqueID + ".receipt"
    13 : OPEN FILE : ##ReceiptPath : Text : Write
    14 : IF : NOT $$LastResult
    15 :    RETURN
    16 : END IF
    17 : WRITE FILE LINE : $VoucherNumber
    18 : WRITE FILE LINE : ##HxcSendTo
    19 : WRITE FILE LINE : ##HxcSendTemplate
    20 : WRITE FILE LINE : ##HxcSendLanguage
    21 : WRITE FILE LINE : ##HistoryStatus
    22 : WRITE FILE LINE : ##HxcSendMessageId
    23 : WRITE FILE LINE : ##HistoryDetails
    24 : CLOSE TARGET FILE
    25 : BrowseURL Ex : @@HxcVoucherSenderExe : (##HxcSysWorkspaceId + " " + @@HxcVoucherArgumentQuote + ##ReceiptPath + @@HxcVoucherArgumentQuote + " record")

[Variable: HxcHistoryInitialFromDate]
    Type : Date

[Variable: HxcHistoryInitialToDate]
    Type : Date

[System: Variable]
    HxcHistoryInitialFromDate : 0
    HxcHistoryInitialToDate : 0

[Function: Hxc Open Voucher Message History]
    Variable : LatestDate : Date
    01 : WALK COLLECTION : Hxc Latest WhatsApp History
    02 :    SET : LatestDate : $$Date:(($$StringPart:$SentAt:8:2) + "-" + ($$StringPart:$SentAt:5:2) + "-" + ($$StringPart:$SentAt:0:4))
    03 :    IF : NOT $$IsEmpty:##LatestDate
    04 :       BREAK
    05 :    END IF
    06 : END WALK
    07 : SET : HxcHistoryInitialFromDate : If $$IsEmpty:##LatestDate Then ##SVCurrentDate Else ##LatestDate
    08 : SET : HxcHistoryInitialToDate : ##HxcHistoryInitialFromDate
    09 : Start Progress : 1 : "Helixcer Chat" : "Loading Message History" : "Checking message statuses"
    10 : CALL : Hxc Request History Status : ##HxcHistoryInitialFromDate : ##HxcHistoryInitialToDate : ""
    11 : End Progress
    12 : DISPLAY : Hxc Voucher Message History

[Function: Hxc Request History Status]
    Parameter : FromDate : Date
    Parameter : ToDate : Date
    Parameter : OnlyMessageId : String
    Variable : Workspace : String
    Variable : RequestPath : String
    Variable : Waited : Number
    01 : SET : Workspace : ($$HxcReadConnectorProfile:No)
    02 : IF : $$IsEmpty:##Workspace OR $$FileSize:@@HxcVoucherSenderExe <= 0 OR $$IsEmpty:##FromDate OR $$IsEmpty:##ToDate
    03 :    RETURN
    04 : END IF
    05 : SET : RequestPath : @@HxcWindowsConnectorRoot + $$MakeUniqueID + ".refresh-history"
    06 : OPEN FILE : ##RequestPath : Text : Write
    07 : IF : NOT $$LastResult
    08 :    RETURN
    09 : END IF
    10 : WRITE FILE LINE : $$String:##FromDate
    11 : WRITE FILE LINE : $$String:##ToDate
    111 : IF : NOT $$IsEmpty:##OnlyMessageId
    112 :    WRITE FILE LINE : ##OnlyMessageId
    113 : END IF
    12 : CLOSE TARGET FILE
    13 : BrowseURL Ex : @@HxcVoucherSenderExe : (##Workspace + " " + @@HxcVoucherArgumentQuote + ##RequestPath + @@HxcVoucherArgumentQuote)
    14 : WHILE : ##Waited < 2 AND $$FileSize:##RequestPath > 0
    15 :    SLEEP : 1
    16 :    INCREMENT : Waited
    17 : END WHILE
    18 : IF : NOT $$IsEmpty:##OnlyMessageId AND $$FileSize:(##RequestPath + ".xml") > 0
    19 :    SET : HxcVoucherRefreshResultPath : ##RequestPath + ".xml"
    20 :    WALK COLLECTION : Hxc Voucher Refresh Result
    21 :       SET : HxcVoucherRefreshedStatus : $RefreshedStatus
    22 :       SET : HxcVoucherRefreshedMessageId : ##OnlyMessageId
    23 :       SET : HxcVoucherRefreshedWorkspace : ##Workspace
    24 :       BREAK
    25 :    END WALK
    26 :    DELETE FILE : ##HxcVoucherRefreshResultPath
    27 :    SET : HxcVoucherRefreshResultPath : ""
    28 : END IF

[Variable: HxcVoucherRefreshResultPath]
    Type : String

[Variable: HxcVoucherRefreshedStatus]
    Type : String

[Variable: HxcVoucherRefreshedMessageId]
    Type : String

[Variable: HxcVoucherRefreshedWorkspace]
    Type : String

[System: Variable]
    HxcVoucherRefreshResultPath : ""
    HxcVoucherRefreshedStatus : ""
    HxcVoucherRefreshedMessageId : ""
    HxcVoucherRefreshedWorkspace : ""

[Collection: Hxc Voucher Refresh Result]
    Data Source : File XML : ##HxcVoucherRefreshResultPath : Unicode
    XML Object Path : Object : 1 : Collection
    Client Only : Yes

[Report: Hxc Voucher Message History]
    Title : "Message History"
    Form : Hxc Voucher Message History
    Variable : SVFromDate, SVToDate
    Set : SVFromDate : ##HxcHistoryInitialFromDate
    Set : SVToDate : ##HxcHistoryInitialToDate

[Form: Hxc Voucher Message History]
    Bottom Part : Hxc Last WhatsApp Footer
    Width : 100% Screen
    Height : 100% Screen
    Background : Hxc Vt Page
    Parts : Hxc Voucher History Period, Hxc Voucher History Heading, Hxc Voucher History Rows
    Buttons : Hxc Change History Period, Hxc Refresh History Status, Hxc Clear History Period

[Button: Hxc Change History Period]
    Title : "Period"
    Key : Alt + F2
    Action Ex : SetHistoryPeriod : Modify Variables : Change Period
    Action Ex : SyncHistoryPeriod : CALL : Hxc Request History Status : ##SVFromDate : ##SVToDate : ""
    Action Ex : ReloadPeriodStatus : Refresh Data
    Action Ex : RedrawPeriodStatus : Refresh

[Button: Hxc Refresh History Status]
    Title : "Refresh Status"
    Key : Alt + R
    Action Ex : FetchHistoryStatus : CALL : Hxc Request History Status : ##SVFromDate : ##SVToDate : ""
    Action Ex : ReloadHistoryStatus : Refresh Data
    Action Ex : RedrawHistoryStatus : Refresh

[Button: Hxc Clear History Period]
    Title : "Clear History"
    Key : Alt + Delete
    Action Ex : ClearPeriod : CALL : Hxc Clear Voucher History
    Action Ex : ReloadHistory : Refresh Data
    Action Ex : RedrawHistory : Refresh

[Part: Hxc Voucher History Period]
    Line : Hxc Voucher History Period

[Line: Hxc Voucher History Period]
    Field : Hxc Voucher History Period

[Field: Hxc Voucher History Period]
    Use : Name Field
    Set as : "Period: " + ($$String:##SVFromDate) + (If ##SVFromDate = ##SVToDate Then "" Else (" to " + ($$String:##SVToDate)))
    Full Width : Yes
    Skip : Yes

[Part: Hxc Voucher History Heading]
    Line : Hxc Voucher History Heading
    Background : Hxc Vt Section Band

[Part: Hxc Voucher History Rows]
    Lines : Hxc Voucher History Empty, Hxc Voucher History Row
    Repeat : Hxc Voucher History Row : Hxc Voucher History Entries
    Scroll : Vertical

[Line: Hxc Voucher History Empty]
    Field : Hxc Voucher History Empty
    Invisible : $$NumItems:HxcVoucherHistoryEntries > 0

[Field: Hxc Voucher History Empty]
    Use : Name Field
    Set as : "No message history for the selected period."
    Full Width : Yes
    Skip : Yes

[Collection: Hxc Voucher History File]
    Data Source : File XML : @@HxcVoucherHistoryPath : Unicode
    XML Object Path : Object : 1 : Collection
    Client Only : Yes

[Collection: Hxc Latest WhatsApp History]
    Source Collection : Hxc Voucher History File
    Fetch : SentAt, VoucherNo, Recipient, Status, MessageId
    Sort : Default : -$SentAt
    Client Only : Yes

[Part: Hxc Last WhatsApp Footer]
    Line : Hxc Last WhatsApp Footer
    Background : Hxc Vt Page
    Invisible : $$InPrintMode

[Line: Hxc Last WhatsApp Footer]
    Field : Hxc Last WhatsApp Footer
    Invisible : $$InPrintMode

[Line: Hxc Voucher Last WhatsApp Footer]
    Use : Hxc Last WhatsApp Footer
    Local : Field : Hxc Last WhatsApp Footer : Set as : $$HxcReadVoucherWhatsAppFooter
    Invisible : $$InPrintMode OR NOT ($HxcShowLastVoucherMessageStatus:Company:##SVCurrentCompany)

[Field: Hxc Last WhatsApp Footer]
    Use : Name Field
    Set as : $$HxcReadLastWhatsAppFooter
    Set Always : Yes
    Color : Hxc Recipient Dark Orange
    Style : Normal
    Full Width : Yes
    Skip : Yes

[System: Formula]
    Hxc Last WhatsApp Footer Text : "Last WhatsApp  |  " + $VoucherNo + "  |  " + $Recipient + "  |  " + ($$HxcHistoryDisplayTime:$SentAt) + "  |  " + @@HxcLastWhatsAppFooterStatus

[System: Formula]
    Hxc Voucher Refresh Lookup Key : If $$IsEmpty:$MessageId Then ("local:" + $SentAt) Else $MessageId
    Hxc Last WhatsApp Footer Status : If $Status != "Read" AND $Status != "Failed" AND @@HxcVoucherRefreshLookupKey = ##HxcVoucherRefreshedMessageId AND ##HxcVoucherRefreshedWorkspace = ($$HxcReadConnectorProfile:No) AND NOT $$IsEmpty:##HxcVoucherRefreshedStatus Then ##HxcVoucherRefreshedStatus Else $Status

[Function: Hxc Read Voucher WhatsApp Footer]
    Returns : String
    Variable : VoucherContext : String
    01 : SET : VoucherContext : ($$String:##SVVoucherType) + "|" + (@@HxcContactVoucherType) + "|" + ($$String:($$ReportObject:$GUID)) + "|" + ($$String:($$ReportObject:$VoucherNumber))
    02 : IF : ##VoucherContext != ##HxcVoucherFooterContext
    03 :    SET : HxcVoucherFooterContext : ##VoucherContext
    04 :    CALL : Hxc Refresh Last WhatsApp Status
    05 : END IF
    06 : IF : NOT $$IsEmpty:##HxcVoucherPendingFooter AND ##HxcVoucherPendingWorkspace = ($$HxcReadConnectorProfile:No)
    07 :    IF : ##HxcVoucherPendingBaseline = ($$HxcReadLatestWhatsAppEntryKey)
    08 :       RETURN : ##HxcVoucherPendingFooter
    09 :    END IF
    10 :    SET : HxcVoucherPendingFooter : ""
    11 : END IF
    12 : RETURN : $$HxcReadLastWhatsAppFooter

[Function: Hxc Read Latest WhatsApp Entry Key]
    Returns : String
    01 : WALK COLLECTION : Hxc Latest WhatsApp History
    02 :    RETURN : $SentAt + "|" + $VoucherNo + "|" + $Recipient
    03 : END WALK
    04 : RETURN : ""

[Variable: HxcVoucherPendingFooter]
    Type : String

[Variable: HxcVoucherPendingBaseline]
    Type : String

[Variable: HxcVoucherPendingWorkspace]
    Type : String

[System: Variable]
    HxcVoucherPendingFooter : ""
    HxcVoucherPendingBaseline : ""
    HxcVoucherPendingWorkspace : ""

[Function: Hxc Read Last WhatsApp Footer]
    Returns : String
    Variable : FooterText : String
    01 : WALK COLLECTION : Hxc Latest WhatsApp History
    02 :    SET : FooterText : @@HxcLastWhatsAppFooterText
    03 :    BREAK
    04 : END WALK
    05 : RETURN : ##FooterText

[Collection: Hxc Voucher History Entries]
    Source Collection : Hxc Voucher History File
    Fetch : SentAt, VoucherNo, Recipient, TemplateName, TemplateLanguage, Attachment, Status, MessageId, Details
    Filter : Hxc History Entry Within Period
    Client Only : Yes

[Function: Hxc History Entry In Period]
    Parameter : Timestamp : String
    Parameter : FromDate : Date
    Parameter : ToDate : Date
    Returns : Logical
    Variable : SentDate : Date
    01 : SET : SentDate : $$Date:(($$StringPart:##Timestamp:8:2) + "-" + ($$StringPart:##Timestamp:5:2) + "-" + ($$StringPart:##Timestamp:0:4))
    02 : RETURN : NOT $$IsEmpty:##SentDate AND ##SentDate >= ##FromDate AND ##SentDate <= ##ToDate

[Variable: HxcHistoryClearResultPath]
    Type : String

[System: Variable]
    HxcHistoryClearResultPath : ""

[Collection: Hxc History Clear Result]
    Data Source : File XML : ##HxcHistoryClearResultPath : Unicode
    XML Object Path : Object : 1 : Collection
    Client Only : Yes

[Function: Hxc Clear Voucher History]
    Variable : Workspace : String
    Variable : RequestPath : String
    Variable : Waited : Number
    Variable : ResultMessage : String
    01 : SET : Workspace : ($$HxcReadConnectorProfile:No)
    02 : IF : $$IsEmpty:##Workspace OR $$FileSize:@@HxcVoucherSenderExe <= 0
    03 :    MSG BOX : "Message History" : "The workspace and Windows sender must be configured to clear history."
    04 :    RETURN
    05 : END IF
    06 : IF : $$IsEmpty:##SVFromDate OR $$IsEmpty:##SVToDate OR ##SVFromDate > ##SVToDate
    07 :    MSG BOX : "Message History" : "Select a valid history period first."
    08 :    RETURN
    09 : END IF
    10 : QUERY BOX : ("Clear local message history from " + ($$String:##SVFromDate) + " to " + ($$String:##SVToDate) + " inclusive?") : Yes : No
    11 : IF : NOT $$LastResult
    12 :    RETURN
    13 : END IF
    14 : SET : RequestPath : @@HxcWindowsConnectorRoot + $$MakeUniqueID + ".clear-history"
    15 : OPEN FILE : ##RequestPath : Text : Write
    16 : IF : NOT $$LastResult
    17 :    MSG BOX : "Message History" : "Could not create the clear-history request."
    18 :    RETURN
    19 : END IF
    20 : WRITE FILE LINE : $$String:##SVFromDate
    21 : WRITE FILE LINE : $$String:##SVToDate
    22 : CLOSE TARGET FILE
    23 : SET : HxcHistoryClearResultPath : ##RequestPath + ".xml"
    24 : BrowseURL Ex : @@HxcVoucherSenderExe : (##Workspace + " " + @@HxcVoucherArgumentQuote + ##RequestPath + @@HxcVoucherArgumentQuote + " clear-history")
    25 : WHILE : ##Waited < 5 AND $$FileSize:##HxcHistoryClearResultPath <= 0
    26 :    SLEEP : 1
    27 :    INCREMENT : Waited
    28 : END WHILE
    29 : IF : $$FileSize:##HxcHistoryClearResultPath > 0
    30 :    WALK COLLECTION : Hxc History Clear Result
    31 :       SET : ResultMessage : $ClearResult
    32 :       BREAK
    33 :    END WALK
    34 : END IF
    35 : SET : HxcHistoryClearResultPath : ""
    36 : IF : $$IsEmpty:##ResultMessage
    37 :    SET : ResultMessage : "The sender did not confirm the clear. Reopen Message History to check the result."
    38 : END IF
    39 : MSG BOX : "Message History" : ##ResultMessage

[System: Formula]
    Hxc History Entry Within Period : $$HxcHistoryEntryInPeriod:$SentAt:##SVFromDate:##SVToDate

[System: Formula]
    Hxc Windows Connector Config Path : ($$SysInfo:ApplicationPath) + "\helixcer-connector.txt"
    Hxc Windows Connector Root : $$HxcResolveWindowsConnectorRoot
    Hxc Voucher Sender Exe : If $$IsEmpty:@@HxcWindowsConnectorRoot Then "" Else (@@HxcWindowsConnectorRoot + "HelixcerVoucherSender.exe")
    Hxc Voucher Argument Quote : $$StrByCharCode:34
    Hxc Voucher History Path : If $$IsEmpty:@@HxcWindowsConnectorRoot Then "" Else (@@HxcWindowsConnectorRoot + "history-" + ($$HxcReadConnectorProfile:No) + ".xml")

[Function: Hxc Resolve Windows Connector Root]
    Returns : String
    Variable : ConnectorRoot : String
    Variable : ConnectorUser : String
    Variable : CurrentWindowsUser : String
    01 : IF : $$FileSize:@@HxcWindowsConnectorConfigPath <= 0
    02 :    RETURN : ""
    03 : END IF
    04 : OPEN FILE : @@HxcWindowsConnectorConfigPath : Text : Read
    05 : IF : NOT $$LastResult
    06 :    RETURN : ""
    07 : END IF
    08 : SET : CurrentWindowsUser : $$Upper:($$SysInfo:WindowsUser)
    09 : WHILE : NOT $$FileIsEOF
    10 :    SET : ConnectorUser : $$FileRead:0
    11 :    IF : $$FileIsEOF
    12 :       BREAK
    13 :    END IF
    14 :    SET : ConnectorRoot : $$FileRead:0
    15 :    IF : ($$Upper:##ConnectorUser) = ##CurrentWindowsUser
    16 :       CLOSE FILE
    17 :       RETURN : ##ConnectorRoot
    18 :    END IF
    19 : END WHILE
    20 : CLOSE FILE
    21 : RETURN : ""

[Line: Hxc Voucher History Row]
    Fields : Hxc History Time, Hxc History Voucher, Hxc History Recipient, Hxc History Template, Hxc History Language, Hxc History Status, Hxc History Message ID, Hxc History Details
    Space Top : 0.25
    Space Bottom : 0.25

[Line: Hxc Voucher History Heading]
    Use : Hxc Voucher History Row
