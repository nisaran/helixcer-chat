[Function: Hxc Resolve Send Contact Map]
    Parameter : Mapping : String
    Parameter : LedgerReminder : Logical
    Returns : String
    01 : IF : $$IsEmpty:##Mapping OR $$IsSysNameEqual:NotApplicable:##Mapping OR ##Mapping = "Not Applicable"
    02 :    RETURN : ""
    03 : END IF
    04 : IF : $$StringPart:##Mapping:0:1 = "="
    05 :    RETURN : $$StringPart:##Mapping:1:(($$StringLength:##Mapping) - 1)
    06 : END IF
    07 : RETURN : If ##LedgerReminder Then $$HxcResolveReminderLedgerValue:##Mapping Else $$HxcResolveVoucherSendValue:##Mapping

[Function: Hxc Resolve Voucher Contact Metadata]
    Parameter : Mapping : String
    Returns : String
    Variable : RecipientDigits : String
    Variable : SavedMobile : String
    Variable : CountryCode : String
    Variable : RecipientName : String
    01 : IF : ##Mapping <> "Contact Name"
    02 :    RETURN : $$HxcResolveSendContactMap:##Mapping:No
    03 : END IF
    04 : SET : RecipientDigits : $$HxcDialingDigits:##HxcSendTo
    05 : IF : $$IsEmpty:##RecipientDigits OR ($$ListValue:HxcPreviewRecipientNames:##RecipientDigits) = "Custom Number"
    06 :    RETURN : ""
    07 : END IF
    08 : SET : CountryCode : If $$IsEmpty:$HxcVoucherContactCountry Then @@HxcCompanyDefaultCountryCode Else $HxcVoucherContactCountry
    09 : SET : SavedMobile : $$HxcNormalizePreviewMobile:$HxcVoucherContactMobile:##CountryCode
    10 : IF : ##SavedMobile = ##RecipientDigits
    11 :    SET : RecipientName : $$HxcResolveVoucherSendValue:"Contact Name"
    12 :    IF : NOT $$IsEmpty:##RecipientName
    13 :       RETURN : ##RecipientName
    14 :    END IF
    15 : END IF
    16 : WALK COLLECTION : Hxc Preview Ledger Primary
    17 :    IF : ($$HxcDialingDigits:$HxcPreviewMobile) = ##RecipientDigits
    18 :       RETURN : $LedgerContact:Ledger:##HxcPreviewRecipientLedger
    19 :    END IF
    20 : END WALK
    21 : WALK COLLECTION : Hxc Preview Ledger Addresses
    22 :    IF : ($$HxcDialingDigits:$HxcPreviewMobile) = ##RecipientDigits
    23 :       RETURN : $HxcPreviewContactName
    24 :    END IF
    25 : END WALK
    26 : WALK COLLECTION : Hxc Preview Ledger Mobile Contacts
    27 :    IF : ($$HxcDialingDigits:$HxcPreviewMobile) = ##RecipientDigits
    28 :       RETURN : $HxcPreviewContactLabel
    29 :    END IF
    30 : END WALK
    31 : RETURN : ""

[Function: Hxc Prepare Send Mappings]
    Parameter : VchType : String
    Parameter : EncodedMaps : String
    Parameter : LedgerReminder : Logical
    Returns : Logical
    Variable : Slot : Number
    Variable : CustomSlot : Number
    Variable : Component : String
    Variable : Key : String
    Variable : Label : String
    Variable : Rest : String
    Variable : Value : String
    Variable : Offset : Number
    01 : LIST DELETE : HxcSendValues
    02 : LIST DELETE : HxcSendKeys
    03 : LIST DELETE : HxcSendGroups
    031 : LIST DELETE : HxcSendPreviewValues
    032 : SET : HxcSendMappingCount : 0
    033 : LIST DELETE : HxcSendQueuedMappings
    034 : LIST DELETE : HxcSendQueuedComponents
    035 : LIST DELETE : HxcSendQueuedKeys
    04 : SET : Slot : 0
    05 : SET : CustomSlot : 0
    06 : FOR TOKEN : Piece : ##EncodedMaps : ";"
    07 :    IF : NOT $$IsEmpty:##Piece
    10 :    SET : Component : ""
    11 :    SET : Key : ""
    12 :    FOR TOKEN : Token : ##Piece : ":"
    13 :       SET : Component : ##Token
    14 :       BREAK
    15 :    END FOR
    16 :    SET : Offset : ($$StringLength:##Component) + 1
    17 :    SET : Rest : $$StringPart:##Piece:##Offset:(($$StringLength:##Piece) - ##Offset)
    18 :    FOR TOKEN : Token : ##Rest : "="
    19 :       SET : Key : ##Token
    20 :       BREAK
    21 :    END FOR
    22 :    SET : Offset : ($$StringLength:##Key) + 1
    23 :    SET : Label : $$StringPart:##Rest:##Offset:(($$StringLength:##Rest) - ##Offset)
    24 :    IF : $$IsEmpty:##Key OR ##Key = "component" OR ##Key = "index" OR ##Key = "buttonIndex" OR ##Key = "subType" OR ##Key = "sub_type" OR NOT (##Component = "header" OR ##Component = "body" OR ##Component = "button")
    25 :       RETURN : No
    26 :    END IF
    261 :    IF : ##Component = "button" AND NOT $$IsEmpty:($$ListValue:HxcSendGroups:"button")
    262 :       RETURN : No
    263 :    END IF
    27 :    IF : ##Component <> "header"
    28 :       INCREMENT : CustomSlot
    29 :    END IF
    30 :    IF : ##Label = @@HxcCustomValueLabel
    31 :       SET : Value : $$HxcReadSendCustomValue:##VchType:(If ##Component = "header" Then 0 Else ##CustomSlot)
    32 :    ELSE
    33 :       SET : Value : If ##LedgerReminder Then $$HxcResolveReminderLedgerValue:##Label Else $$HxcResolveVoucherSendValue:##Label
    34 :    END IF
    351 :    IF : $$IsEmpty:##Value
    352 :       SET : HxcSendMappingError : "No value for " + ##Component + " {{" + ##Key + "}} (" + ##Label + ") on this saved voucher."
    353 :       RETURN : No
    354 :    END IF
    35 :    IF : NOT $$IsEmpty:($$ListValue:HxcSendKeys:(##Component + "|" + ##Key)) OR ##Slot >= 17
    36 :       RETURN : No
    37 :    END IF
    38 :    LIST ADD : HxcSendKeys : (##Component + "|" + ##Key) : ##Key
    381 :    LIST ADD : HxcSendPreviewValues : (##Component + "|" + ##Key) : ##Value
    39 :    INCREMENT : Slot
    40 :    LIST ADD : HxcSendValues : (##Component + "|" + $$String:##Slot) : ##Value
    41 :    LIST ADD : HxcSendKeys : ("slot|" + $$String:##Slot) : ##Key
    411 :    IF : ##Component <> "header" OR NOT ##HxcSendDocument
    412 :       INCREMENT : HxcSendMappingCount
    413 :       LIST ADD : HxcSendQueuedMappings : ($$String:##HxcSendMappingCount) : ##Value
    4131 :       LIST ADD : HxcSendQueuedComponents : ($$String:##HxcSendMappingCount) : ##Component
    4132 :       LIST ADD : HxcSendQueuedKeys : ($$String:##HxcSendMappingCount) : ##Key
    414 :    END IF
    42 :    IF : $$IsEmpty:($$ListValue:HxcSendGroups:##Component)
    43 :       LIST ADD : HxcSendGroups : ##Component : ##Component
    44 :    END IF
    441 :    END IF
    45 : END FOR
    46 : RETURN : Yes

[Report: Hxc Voucher Send Request]
    Export Empty Fields : Yes
    Form : Hxc Voucher Send Request
    Plain JSON : Yes
    Export Header : "X-Workspace-Id: " + ##HxcSysWorkspaceId
    Export Header : "Content-Type: application/json"
    Export Header : "Accept: application/json"

[Form: Hxc Voucher Send Request]
    Parts : Hxc Send Payload Top, Hxc Send Payload Template, Hxc Send Payload Variables

[Part: Hxc Send Payload Top]
    Line : Hxc Send Payload Top
    Repeat : Hxc Send Payload Top : Hxc Send Payload Single Row
    Scroll : Vertical
    JSON Tag as Desc Name : No

[Line: Hxc Send Payload Top]
    Fields : Hxc Send Channel Field, Hxc Send To Field, Hxc Send Reference Field
    JSON Tag as Desc Name : No

[Collection: Hxc Send Payload Single Row]
    List Name : "request"

[Part: Hxc Send Payload Template]
    Parts : Hxc Send Payload Template Name, Hxc Send Payload Language
    JSON Tag : "template"

[Part: Hxc Send Payload Template Name]
    Line : Hxc Send Payload Template Name
    Repeat : Hxc Send Payload Template Name : Hxc Send Payload Single Row
    Scroll : Vertical
    JSON Tag as Desc Name : No

[Line: Hxc Send Payload Template Name]
    Field : Hxc Send Template Field
    JSON Tag as Desc Name : No

[Part: Hxc Send Payload Language]
    Line : Hxc Send Payload Language
    Repeat : Hxc Send Payload Language : Hxc Send Payload Single Row
    Scroll : Vertical
    JSON Tag : "language"

[Line: Hxc Send Payload Language]
    Field : Hxc Send Language Field
    JSON Tag as Desc Name : No

[Part: Hxc Send Payload Variables]
    Line : Hxc Send Payload Variable
    Repeat : Hxc Send Payload Variable : Hxc Send Payload Groups
    Scroll : Vertical
    JSON Tag as Desc Name : No
    Invisible : $$NumItems:HxcSendPayloadGroups = 0

[Collection: Hxc Send Payload Groups]
    List : "header", "body", "button"
    Filter : Hxc Send Include Group

[System: Formula]
    Hxc Send Include Group : NOT $$IsEmpty:($$ListValue:HxcSendGroups:$Name)

[Line: Hxc Send Payload Variable]
    JSON Tag : "variables"
    Fields : Hxc Send Component Field, +
             Hxc Send Map Field 1, +
             Hxc Send Map Field 2, +
             Hxc Send Map Field 3, +
             Hxc Send Map Field 4, +
             Hxc Send Map Field 5, +
             Hxc Send Map Field 6, +
             Hxc Send Map Field 7, +
             Hxc Send Map Field 8, +
             Hxc Send Map Field 9, +
             Hxc Send Map Field 10, +
             Hxc Send Map Field 11, +
             Hxc Send Map Field 12, +
             Hxc Send Map Field 13, +
             Hxc Send Map Field 14, +
             Hxc Send Map Field 15, +
             Hxc Send Map Field 16, +
             Hxc Send Map Field 17

[Field: Hxc Send Channel Field]
    JSON Tag : "channelId"
    Set as : ##HxcSysChannelId

[Field: Hxc Send To Field]
    JSON Tag : "to"
    Set as : ##HxcSendTo

[Field: Hxc Send Reference Field]
    JSON Tag : "clientReference"
    Set as : ##HxcSendReference

[Field: Hxc Send Template Field]
    JSON Tag : "name"
    Set as : ##HxcSendTemplate

[Field: Hxc Send Language Field]
    JSON Tag : "code"
    Set as : ##HxcSendLanguage

[Field: Hxc Send Component Field]
    JSON Tag : "component"
    Set as : $Name

[Field: Hxc Send Map Field 1]
    JSON Tag : $$ListValue:HxcSendKeys:"slot|1"
    Set as : $$ListValue:HxcSendValues:($Name + "|1")
    Invisible : $$IsEmpty:$$ListValue:HxcSendValues:($Name + "|1")

[Field: Hxc Send Map Field 2]
    JSON Tag : $$ListValue:HxcSendKeys:"slot|2"
    Set as : $$ListValue:HxcSendValues:($Name + "|2")
    Invisible : $$IsEmpty:$$ListValue:HxcSendValues:($Name + "|2")

[Field: Hxc Send Map Field 3]
