[Line: Hxc Vc F Media Line]
    Fields : Medium Prompt, Hxc Vc F Media
    Local  : Field : Medium Prompt : Set as : "Media Header"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc F Media]
    Use        : Name Field
    Storage    : HxcVcDraftMedia
    Set as     : If $$IsEmpty:$HxcVcDraftMedia THEN "None" ELSE $HxcVcDraftMedia
    Table      : Hxc Media Export List
    Show Table : Always
    Width      : 40
    Max        : 40

[Line: Hxc Vc F Vch Head]
    Field : Hxc Vc F Vch Head Fld

[Field: Hxc Vc F Vch Head Fld]
    Use       : Name Field
    Set as    : "— Applicable Voucher Types (add rows; leave blank to end) —"
    Style     : Bold
    FullWidth : Yes
    Skip      : Yes

[Line: Hxc Vc F Vch Data]
    Fields : Medium Prompt, Hxc Vc F Vch Name
    Local  : Field : Medium Prompt : Set as : "Voucher Type"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc F Vch Name]
