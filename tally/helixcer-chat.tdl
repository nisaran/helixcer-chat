[Function: Hxc Apply Template Response]
    ;; Proven walk (build 419) + header; body/button → FK1..16 via Set Map Slot
    Variable : I : Number
    Variable : CompType : String
    Variable : Fmt : String
    Variable : VComp : String
    Variable : VKey : String
    Variable : PreviewFooter : String
    Variable : PreviewButtons : String
    01 : SET : I : 0
    02 : CALL : Hxc Clear Fetch Vars
    03 : SET : HxcVcFetchStatus : "Template not found or empty response."
    04 : WALK COLLECTION : Hxc Connector API Response
    05 :    WALK COLLECTION : items
    501 :       SET : PreviewFooter : ""
    502 :       SET : PreviewButtons : ""
    06 :       WALK COLLECTION : components
    07 :          SET : CompType : $type
    08 :          IF : ##CompType = "header" OR ##CompType = "HEADER" OR ##CompType = "Header"
    09 :             SET : HxcVcHasHeader : Yes
    10 :             SET : Fmt : $format
    11 :             IF : $$IsEmpty:##Fmt
    12 :                SET : Fmt : "TEXT"
    13 :             END IF
    14 :             SET : HxcVcHeaderFormat : ##Fmt
    15 :             IF : ##Fmt = "IMAGE" OR ##Fmt = "VIDEO" OR ##Fmt = "DOCUMENT" OR ##Fmt = "GIF" OR ##Fmt = "image" OR ##Fmt = "video" OR ##Fmt = "document" OR ##Fmt = "gif"
    16 :                SET : HxcVcHeaderKind : "media"
    161 :                SET : HxcVcPreviewText : "[Media] " + ($$Upper:##Fmt) + " attachment" + $$NewLine + $$NewLine
    17 :             ELSE
    18 :                SET : HxcVcHeaderKind : "text"
    19 :             END IF
    20 :             IF : ##HxcVcHeaderKind = "text"
    21 :                IF : NOT $$IsEmpty:$text
    22 :                   SET : HxcVcPreviewText : "[Header] " + ($$StringFindAndReplace:$text:"__HXC_TEMPLATE_NEWLINE__":$$NewLine) + $$NewLine + $$NewLine
    23 :                END IF
    24 :             END IF
    25 :          END IF
    26 :          IF : ##CompType = "body" OR ##CompType = "BODY" OR ##CompType = "Body"
    27 :             IF : NOT $$IsEmpty:$text
    28 :                SET : HxcVcPreviewText : ##HxcVcPreviewText + ($$StringFindAndReplace:$text:"__HXC_TEMPLATE_NEWLINE__":$$NewLine)
    29 :             END IF
    30 :          END IF
    301 :          IF : ($$Upper:##CompType) = "FOOTER" AND NOT $$IsEmpty:$text
    302 :             SET : PreviewFooter : "[Footer] " + ($$StringFindAndReplace:$text:"__HXC_TEMPLATE_NEWLINE__":$$NewLine)
    303 :          END IF
    304 :          IF : ($$Upper:##CompType) = "BUTTONS"
    305 :             WALK COLLECTION : buttons
    306 :                IF : NOT $$IsEmpty:$text
    307 :                   SET : PreviewButtons : ##PreviewButtons + $$NewLine + "[Button] " + $text
    3071 :                   IF : NOT $$IsEmpty:$url
    3072 :                      SET : PreviewButtons : ##PreviewButtons + $$NewLine + "[URL] " + $url
    3073 :                   END IF
    308 :                END IF
    309 :             END WALK
    310 :          END IF
    311 :          IF : ($$Upper:##CompType) = "BUTTON" AND NOT $$IsEmpty:$text
    312 :             SET : PreviewButtons : ##PreviewButtons + $$NewLine + "[Button] " + $text
    3121 :             IF : NOT $$IsEmpty:$url
    3122 :                SET : PreviewButtons : ##PreviewButtons + $$NewLine + "[URL] " + $url
    3123 :             END IF
    313 :          END IF
    31 :       END WALK
    314 :       IF : NOT $$IsEmpty:##PreviewFooter
    315 :          SET : HxcVcPreviewText : ##HxcVcPreviewText + $$NewLine + $$NewLine + ##PreviewFooter
    316 :       END IF
    317 :       IF : NOT $$IsEmpty:##PreviewButtons
    318 :          SET : HxcVcPreviewText : ##HxcVcPreviewText + $$NewLine + ##PreviewButtons
    319 :       END IF
    32 :       WALK COLLECTION : variables
    33 :          SET : VComp : $component
    34 :          SET : VKey : $key
    35 :          IF : $$IsEmpty:##VComp
    36 :             SET : VComp : "body"
    37 :          END IF
    38 :          IF : ##VComp = "HEADER"
    39 :             SET : VComp : "header"
    40 :          END IF
    41 :          IF : ##VComp = "BODY"
    42 :             SET : VComp : "body"
    43 :          END IF
    44 :          IF : ##VComp = "BUTTON"
    45 :             SET : VComp : "button"
    46 :          END IF
    47 :          IF : NOT $$IsEmpty:##VKey
    48 :             IF : ##VComp = "header"
    49 :                IF : NOT ##HxcVcHeaderKind = "media"
    50 :                   SET : HxcVcHasHeader : Yes
    51 :                   IF : $$IsEmpty:##HxcVcHeaderKind
    52 :                      SET : HxcVcHeaderKind : "text"
    53 :                   END IF
    54 :                   SET : HxcVcHeaderKey : ##VKey
    55 :                END IF
    56 :             ELSE
    57 :                SET : I : ##I + 1
    58 :                CALL : Hxc Set Map Slot : ##I : ##VKey : ##VComp
    59 :             END IF
    60 :          END IF
    61 :       END WALK
    611 :       SET : HxcVcMoveToMapping : Yes
    62 :       SET : HxcVcFetched : Yes
    63 :       SET : HxcVcFetchStatus : "Template loaded."
    64 :    END WALK
    65 : END WALK
    66 : IF : ##HxcVcFetched
    67 :    IF : $$IsEmpty:##HxcVcPreviewText
    68 :       SET : HxcVcPreviewText : "(No body text in template)"
    69 :    END IF
    70 : END IF
    71 : RETURN : Yes

[Function: Hxc Fetch Template]
    0001 : IF : ##HxcVtEditing AND NOT ##HxcVtWhatsAppOn
    0002 :    RETURN : No
    0003 : END IF
    001 : IF : NOT ##HxcVtEditing AND NOT $$IsEmpty:#HxcVcConfigNameInput
    002 :    SET : HxcVcDraftName : #HxcVcConfigNameInput
    003 : END IF
    01 : CALL : Hxc Sync From Connector
    ;; Read the visible input first, then fall back to the accepted value.
    02 : IF : NOT ##HxcVtEditing AND NOT $$IsEmpty:#HxcVcTemplateNameInput
    021 :    SET : HxcVcFetchName : #HxcVcTemplateNameInput
    022 : ELSE
    023 :    IF : NOT $$IsEmpty:##HxcVcDraftTemplate
    024 :       SET : HxcVcFetchName : ##HxcVcDraftTemplate
    025 :    END IF
    026 : END IF
    03 : SET : HxcVcFetchLang : ##HxcVcDraftLang
    04 : IF : $$IsEmpty:##HxcVcFetchLang
    05 :    SET : HxcVcFetchLang : "en"
    06 : END IF
    07 : IF : $$IsEmpty:##HxcVcFetchName
    08 :    SET : HxcVcFetchStatus : "Enter Template Name first."
    09 :    Msg Box : "Helixcer Template" : ##HxcVcFetchStatus
    10 :    RETURN : No
    11 : END IF
    12 : CALL : Hxc Clear Fetch Vars
    18 : IF : $$IsEmpty:##HxcSysWorkspaceId OR $$IsEmpty:##HxcSysChannelId
    19 :    SET : HxcVcFetchStatus : "Configure the connection in Helixcer for TallyPrime Setup before fetching a template."
    20 :    Msg Box : "Helixcer Template" : ##HxcVcFetchStatus
    21 :    RETURN : No
    22 : END IF
    24 : SET : HxcVcFetchStatus : "Fetching..."
    25 : Start Progress : 1 : "Helixcer Chat" : "Fetching template" : ##HxcVcFetchName
    26 : CALL : Hxc Run Connector Read : "template" : ##HxcVcFetchName : ##HxcVcFetchLang
    27 : End Progress
    28 : IF : NOT ##HxcVcFetched
    29 :    IF : $$IsEmpty:##HxcVcFetchStatus OR ##HxcVcFetchStatus = "Fetching..."
    30 :       SET : HxcVcFetchStatus : "Could not fetch [" + ##HxcVcFetchName + "]. Open Helixcer Chat → Status. If Connected, check the template name on this channel."
    31 :    END IF
    32 :    Msg Box : "Helixcer Template" : ##HxcVcFetchStatus
    33 :    RETURN : No
    34 : END IF
    ;; Fresh Create: never carry prior voucher-type rows into the new config
    341 : CALL : Hxc Clear Draft Vchs
    343 : SET : HxcVcDraftAuto : No
    344 : SET : HxcVcDraftConfirm : No
    345 : SET : HxcVcAutoSendEnabled : No
    35 : SET : HxcVcDMFld1 : ""
    35 : SET : HxcVcDMFld2 : ""
    36 : SET : HxcVcDMFld3 : ""
    37 : SET : HxcVcDMFld4 : ""
    38 : SET : HxcVcDMFld5 : ""
    39 : SET : HxcVcDMFld6 : ""
    40 : SET : HxcVcDMFld7 : ""
    41 : SET : HxcVcDMFld8 : ""
    42 : SET : HxcVcDMFld9 : ""
    43 : SET : HxcVcDMFld10 : ""
    44 : SET : HxcVcDMFld11 : ""
    45 : SET : HxcVcDMFld12 : ""
    46 : SET : HxcVcDMFld13 : ""
    47 : SET : HxcVcDMFld14 : ""
    48 : SET : HxcVcDMFld15 : ""
    49 : SET : HxcVcDMFld16 : ""
    50 : SET : HxcVcDraftHeaderFld : ""
    501 : SET : HxcVcDraftCustom0 : ""
    502 : SET : HxcVcDraftCustom1 : ""
    503 : SET : HxcVcDraftCustom2 : ""
    504 : SET : HxcVcDraftCustom3 : ""
    505 : SET : HxcVcDraftCustom4 : ""
    506 : SET : HxcVcDraftCustom5 : ""
    507 : SET : HxcVcDraftCustom6 : ""
    508 : SET : HxcVcDraftCustom7 : ""
    509 : SET : HxcVcDraftCustom8 : ""
    609 : SET : HxcVcDraftCustom9 : ""
    610 : SET : HxcVcDraftCustom10 : ""
    611 : SET : HxcVcDraftCustom11 : ""
    612 : SET : HxcVcDraftCustom12 : ""
    613 : SET : HxcVcDraftCustom13 : ""
    614 : SET : HxcVcDraftCustom14 : ""
    615 : SET : HxcVcDraftCustom15 : ""
    616 : SET : HxcVcDraftCustom16 : ""
    511 : SET : HxcVcButtonField1 : ""
    512 : SET : HxcVcButtonCustom1 : ""
    513 : SET : HxcVcButtonField2 : ""
    514 : SET : HxcVcButtonCustom2 : ""
    515 : SET : HxcVcButtonField3 : ""
    516 : SET : HxcVcButtonCustom3 : ""
    517 : SET : HxcVcButtonField4 : ""
    518 : SET : HxcVcButtonCustom4 : ""
    51 : IF : ##HxcVcHeaderKind = "media"
    52 :    IF : $$IsEmpty:##HxcVcDraftMedia OR ##HxcVcDraftMedia = "None"
    53 :       SET : HxcVcDraftMedia : "Voucher PDF"
    54 :    END IF
    55 : ELSE
    56 :    SET : HxcVcDraftMedia : "None"
    57 : END IF
    571 : IF : ##HxcVtEditing
    572 :    CALL : Hxc Vt Restore Mappings
    573 : ELSE
    5731 :   IF : ##HxcReminderEditing
    5732 :      CALL : Hxc Restore Reminder Mappings
    5733 :   ELSE
    574 :       CALL : Hxc Restore Custom Mappings
    5741 :   END IF
    575 : END IF
    576 : SET : HxcVcDraftTemplate : ##HxcVcFetchName
    577 : SET : HxcVcDraftLang : ##HxcVcFetchLang
    58 : SET : HxcVcMoveToMapping : Yes
    59 : RETURN : Yes

;; ---------------------------------------------------------------------------
;; Pack helpers + commit draft → Aggregate config
;; ---------------------------------------------------------------------------

[Function: Hxc Pack Maps]
    Variable : S : String
    01 : SET : S : ""
    02 : IF : ##HxcVcHeaderKind = "text" AND NOT $$IsEmpty:##HxcVcHeaderKey
    03 :    SET : S : ##S + "header:" + ##HxcVcHeaderKey + "=" + ##HxcVcDraftHeaderFld + ";"
    04 : END IF
    05 : IF : NOT $$IsEmpty:##HxcVcFK1
    06 :    SET : S : ##S + ##HxcVcFC1 + ":" + ##HxcVcFK1 + "=" + @@HxcVcMappingField1 + ";"
    07 : END IF
    08 : IF : NOT $$IsEmpty:##HxcVcFK2
    09 :    SET : S : ##S + ##HxcVcFC2 + ":" + ##HxcVcFK2 + "=" + @@HxcVcMappingField2 + ";"
    10 : END IF
    11 : IF : NOT $$IsEmpty:##HxcVcFK3
    12 :    SET : S : ##S + ##HxcVcFC3 + ":" + ##HxcVcFK3 + "=" + @@HxcVcMappingField3 + ";"
    13 : END IF
    14 : IF : NOT $$IsEmpty:##HxcVcFK4
    15 :    SET : S : ##S + ##HxcVcFC4 + ":" + ##HxcVcFK4 + "=" + @@HxcVcMappingField4 + ";"
    16 : END IF
    17 : IF : NOT $$IsEmpty:##HxcVcFK5
    18 :    SET : S : ##S + ##HxcVcFC5 + ":" + ##HxcVcFK5 + "=" + ##HxcVcDMFld5 + ";"
    19 : END IF
    20 : IF : NOT $$IsEmpty:##HxcVcFK6
    21 :    SET : S : ##S + ##HxcVcFC6 + ":" + ##HxcVcFK6 + "=" + ##HxcVcDMFld6 + ";"
    22 : END IF
    23 : IF : NOT $$IsEmpty:##HxcVcFK7
    24 :    SET : S : ##S + ##HxcVcFC7 + ":" + ##HxcVcFK7 + "=" + ##HxcVcDMFld7 + ";"
    25 : END IF
    26 : IF : NOT $$IsEmpty:##HxcVcFK8
    27 :    SET : S : ##S + ##HxcVcFC8 + ":" + ##HxcVcFK8 + "=" + ##HxcVcDMFld8 + ";"
    28 : END IF
    29 : IF : NOT $$IsEmpty:##HxcVcFK9
    30 :    SET : S : ##S + ##HxcVcFC9 + ":" + ##HxcVcFK9 + "=" + ##HxcVcDMFld9 + ";"
    31 : END IF
    32 : IF : NOT $$IsEmpty:##HxcVcFK10
    33 :    SET : S : ##S + ##HxcVcFC10 + ":" + ##HxcVcFK10 + "=" + ##HxcVcDMFld10 + ";"
    34 : END IF
    35 : IF : NOT $$IsEmpty:##HxcVcFK11
    36 :    SET : S : ##S + ##HxcVcFC11 + ":" + ##HxcVcFK11 + "=" + ##HxcVcDMFld11 + ";"
    37 : END IF
    38 : IF : NOT $$IsEmpty:##HxcVcFK12
    39 :    SET : S : ##S + ##HxcVcFC12 + ":" + ##HxcVcFK12 + "=" + ##HxcVcDMFld12 + ";"
    40 : END IF
    41 : IF : NOT $$IsEmpty:##HxcVcFK13
    42 :    SET : S : ##S + ##HxcVcFC13 + ":" + ##HxcVcFK13 + "=" + ##HxcVcDMFld13 + ";"
    43 : END IF
    44 : IF : NOT $$IsEmpty:##HxcVcFK14
    45 :    SET : S : ##S + ##HxcVcFC14 + ":" + ##HxcVcFK14 + "=" + ##HxcVcDMFld14 + ";"
    46 : END IF
    47 : IF : NOT $$IsEmpty:##HxcVcFK15
    48 :    SET : S : ##S + ##HxcVcFC15 + ":" + ##HxcVcFK15 + "=" + ##HxcVcDMFld15 + ";"
    49 : END IF
    50 : IF : NOT $$IsEmpty:##HxcVcFK16
    51 :    SET : S : ##S + ##HxcVcFC16 + ":" + ##HxcVcFK16 + "=" + ##HxcVcDMFld16 + ";"
    52 : END IF
    53 : RETURN : ##S
[Function: Hxc Pack Vouchers]
    Variable : S : String
    Variable : Row : Number
    01 : SET : S : ""
    02 : SET : Row : 1
    03 : WHILE : ##Row <= $$ListCount:HxcVcVoucherDraft
    04 :    SET : S : ##S + ($$ListValue:HxcVcVoucherDraft:($$String:##Row)) + ","
    05 :    INCREMENT : Row
    06 : END WHILE
    07 : RETURN : ##S

[Function: Hxc Clear Draft Vchs]
    01 : LIST DELETE : HxcVcVoucherDraft
    02 : RETURN : Yes

[Function: Hxc Store Voucher Type]
    Parameter : Row : Number
    Parameter : TypeName : String
    01 : IF : ##Row < 1
    02 :    RETURN : No
    03 : END IF
    04 : IF : $$IsEmpty:##TypeName OR $$IsEndOfList:##TypeName OR ##TypeName = "End of List" OR ##TypeName = "Not Applicable"
    05 :    WHILE : $$ListCount:HxcVcVoucherDraft >= ##Row
    06 :       LIST DELETE EX : HxcVcVoucherDraft : -1
    07 :    END WHILE
    08 : ELSE
    09 :    LIST ADD : HxcVcVoucherDraft : ($$String:##Row) : ##TypeName
    10 : END IF
    11 : RETURN : Yes

[Function: Hxc Parse Types Into Draft]
    Parameter : TypesCsv : String
    Variable : Piece : String
    Variable : Counter : Number
    Variable : Row : Number
    Variable : Ch : String
    01 : CALL : Hxc Clear Draft Vchs
    02 : SET : Piece : ""
    03 : SET : Counter : 0
    04 : SET : Row : 1
    05 : WHILE : ##Counter < $$StringLength:##TypesCsv
    06 :    SET : Ch : $$StringPart:##TypesCsv:##Counter:1
    07 :    IF : ##Ch = ","
    08 :       IF : NOT $$IsEmpty:##Piece
    09 :          CALL : Hxc Store Voucher Type : ##Row : ##Piece
    10 :          INCREMENT : Row
    11 :       END IF
    12 :       SET : Piece : ""
    13 :    ELSE
    14 :       SET : Piece : ##Piece + ##Ch
    15 :    END IF
    16 :    INCREMENT : Counter
    17 : END WHILE
    18 : IF : NOT $$IsEmpty:##Piece
    19 :    CALL : Hxc Store Voucher Type : ##Row : ##Piece
    20 : END IF
    21 : RETURN : Yes

[Function: Hxc Initialize New Config]
    ;; Clear Company draft Storage for a fresh Create form.
    01 : SET : HxcVcCreateNeedsReset : No
    02 : SET : HxcVcMoveToMapping : No
    03 : SET : HxcVcMoveToConfirm : No
    04 : SET : HxcVcAutoSendEnabled : No
    05 : SET : HxcVcFetched : No
    06 : SET : HxcVcCreateBlank : No
    07 : CALL : Hxc Vc Clear Draft
    08 : RETURN : Yes

[Function: Hxc Release Create Blank]
    ;; Legacy no-op — CreateBlank paint removed; session Variables are cleared directly
    01 : SET : HxcVcCreateBlank : No
    02 : RETURN : Yes

[Function: Hxc Vc Clear Draft]
    01 : CALL : Hxc Clear Fetch Vars
    011 : SET : HxcVcFetchName : ""
    012 : SET : HxcVcFetchLang : "en"
    02 : CALL : Hxc Clear Draft Vchs
    04 : SET : HxcVcDraftName : ""
    05 : SET : HxcVcDraftTemplate : ""
    06 : SET : HxcVcDraftLang : "en"
    07 : SET : HxcVcDraftMedia : "None"
    08 : SET : HxcVcDraftAuto : No
    081 : SET : HxcVcAutoSendEnabled : No
    082 : SET : HxcVcMoveToConfirm : No
    09 : SET : HxcVcDraftConfirm : No
    10 : SET : HxcVcDraftEditKey : ""
    11 : SET : HxcVcDraftHeaderFld : ""
    12 : SET : HxcVcDMFld1 : ""
    13 : SET : HxcVcDMFld2 : ""
    14 : SET : HxcVcDMFld3 : ""
    15 : SET : HxcVcDMFld4 : ""
    16 : SET : HxcVcDMFld5 : ""
    17 : SET : HxcVcDMFld6 : ""
    18 : SET : HxcVcDMFld7 : ""
    19 : SET : HxcVcDMFld8 : ""
    20 : SET : HxcVcDMFld9 : ""
    21 : SET : HxcVcDMFld10 : ""
    22 : SET : HxcVcDMFld11 : ""
    23 : SET : HxcVcDMFld12 : ""
    24 : SET : HxcVcDMFld13 : ""
    25 : SET : HxcVcDMFld14 : ""
    26 : SET : HxcVcDMFld15 : ""
    27 : SET : HxcVcDMFld16 : ""
    30 : SET : HxcVcDraftCustom0 : ""
    31 : SET : HxcVcDraftCustom1 : ""
    32 : SET : HxcVcDraftCustom2 : ""
    33 : SET : HxcVcDraftCustom3 : ""
    34 : SET : HxcVcDraftCustom4 : ""
    35 : SET : HxcVcDraftCustom5 : ""
    36 : SET : HxcVcDraftCustom6 : ""
    37 : SET : HxcVcDraftCustom7 : ""
    38 : SET : HxcVcDraftCustom8 : ""
    609 : SET : HxcVcDraftCustom9 : ""
    610 : SET : HxcVcDraftCustom10 : ""
    611 : SET : HxcVcDraftCustom11 : ""
    612 : SET : HxcVcDraftCustom12 : ""
    613 : SET : HxcVcDraftCustom13 : ""
    614 : SET : HxcVcDraftCustom14 : ""
    615 : SET : HxcVcDraftCustom15 : ""
    616 : SET : HxcVcDraftCustom16 : ""
    39 : SET : HxcVcButtonField1 : ""
    40 : SET : HxcVcButtonCustom1 : ""
    41 : SET : HxcVcButtonField2 : ""
    42 : SET : HxcVcButtonCustom2 : ""
    43 : SET : HxcVcButtonField3 : ""
    44 : SET : HxcVcButtonCustom3 : ""
    45 : SET : HxcVcButtonField4 : ""
    46 : SET : HxcVcButtonCustom4 : ""
    47 : RETURN : Yes


[Function: Hxc Vc Commit Draft]
    Variable : Maps : String
    Variable : Vchs : String
    Variable : EditKey : String
    01 : SET : HxcVcSaveOk : No
    02 : IF : $$IsEmpty:##HxcVcDraftName
    03 :    Msg Box : "Helixcer Voucher Config" : "Config Name is required."
    04 :    RETURN : No
    05 : END IF
    06 : IF : $$IsEmpty:##HxcVcDraftTemplate
    07 :    Msg Box : "Helixcer Voucher Config" : "Template Name is required."
    08 :    RETURN : No
    09 : END IF
    10 : IF : NOT ##HxcVcFetched
    11 :    Msg Box : "Helixcer Voucher Config" : "Fetch the template first (Enter on Language)."
    12 :    RETURN : No
    13 : END IF
    131 : IF : @@HxcVcMissingCustomValue
    132 :    Msg Box : "Helixcer Voucher Config" : "Enter a value for each variable mapped to Custom Value."
    133 :    RETURN : No
    134 : END IF
    14 : SET : Maps : $$HxcPackMaps
    15 : SET : Vchs : $$HxcPackVouchers
    16 : SET : EditKey : ##HxcVcDraftEditKey
    17 : IF : NOT $$IsEmpty:##EditKey
    18 :    WALK COLLECTION : HxcVoucherConfigs
    19 :       IF : $HxcVcName = ##EditKey
    20 :          SET TARGET
    21 :          SET VALUE : HxcVcName : ##HxcVcDraftName
    22 :          SET VALUE : HxcVcTemplateName : ##HxcVcDraftTemplate
    23 :          SET VALUE : HxcVcLanguage : ##HxcVcDraftLang
    24 :          SET VALUE : HxcVcMediaExport : ##HxcVcDraftMedia
    25 :          SET VALUE : HxcVcAutoSend : ##HxcVcDraftAuto
    26 :          SET VALUE : HxcVcConfirmBeforeSend : ##HxcVcDraftConfirm
    27 :          SET VALUE : HxcVcVarMapsText : ##Maps
    271 :          SET VALUE : HxcVcCustom0 : If (##HxcVcDraftHeaderFld = @@HxcCustomValueLabel AND (##HxcVcHeaderKind = "text" AND NOT $$IsEmpty:##HxcVcHeaderKey)) THEN ##HxcVcDraftCustom0 ELSE ""
    272 :          SET VALUE : HxcVcCustom1 : If (@@HxcVcMappingField1 = @@HxcCustomValueLabel AND (NOT $$IsEmpty:##HxcVcFK1 AND (##HxcVcFC1 = "body" OR ##HxcVcFC1 = "button"))) THEN @@HxcVcMappingCustom1 ELSE ""
    273 :          SET VALUE : HxcVcCustom2 : If (@@HxcVcMappingField2 = @@HxcCustomValueLabel AND (NOT $$IsEmpty:##HxcVcFK2 AND (##HxcVcFC2 = "body" OR ##HxcVcFC2 = "button"))) THEN @@HxcVcMappingCustom2 ELSE ""
    274 :          SET VALUE : HxcVcCustom3 : If (@@HxcVcMappingField3 = @@HxcCustomValueLabel AND (NOT $$IsEmpty:##HxcVcFK3 AND (##HxcVcFC3 = "body" OR ##HxcVcFC3 = "button"))) THEN @@HxcVcMappingCustom3 ELSE ""
    275 :          SET VALUE : HxcVcCustom4 : If (@@HxcVcMappingField4 = @@HxcCustomValueLabel AND (NOT $$IsEmpty:##HxcVcFK4 AND (##HxcVcFC4 = "body" OR ##HxcVcFC4 = "button"))) THEN @@HxcVcMappingCustom4 ELSE ""
    276 :          SET VALUE : HxcVcCustom5 : If (##HxcVcDMFld5 = @@HxcCustomValueLabel AND (NOT $$IsEmpty:##HxcVcFK5 AND (##HxcVcFC5 = "body" OR ##HxcVcFC5 = "button"))) THEN ##HxcVcDraftCustom5 ELSE ""
    277 :          SET VALUE : HxcVcCustom6 : If (##HxcVcDMFld6 = @@HxcCustomValueLabel AND (NOT $$IsEmpty:##HxcVcFK6 AND (##HxcVcFC6 = "body" OR ##HxcVcFC6 = "button"))) THEN ##HxcVcDraftCustom6 ELSE ""
    278 :          SET VALUE : HxcVcCustom7 : If (##HxcVcDMFld7 = @@HxcCustomValueLabel AND (NOT $$IsEmpty:##HxcVcFK7 AND (##HxcVcFC7 = "body" OR ##HxcVcFC7 = "button"))) THEN ##HxcVcDraftCustom7 ELSE ""
    279 :          SET VALUE : HxcVcCustom8 : If (##HxcVcDMFld8 = @@HxcCustomValueLabel AND (NOT $$IsEmpty:##HxcVcFK8 AND (##HxcVcFC8 = "body" OR ##HxcVcFC8 = "button"))) THEN ##HxcVcDraftCustom8 ELSE ""
    2799 :          SET VALUE : HxcVcCustom9 : If (##HxcVcFC9 = "button" AND ##HxcVcDMFld9 = @@HxcCustomValueLabel) THEN ##HxcVcDraftCustom9 ELSE ""
    2800 :          SET VALUE : HxcVcCustom10 : If (##HxcVcFC10 = "button" AND ##HxcVcDMFld10 = @@HxcCustomValueLabel) THEN ##HxcVcDraftCustom10 ELSE ""
    2801 :          SET VALUE : HxcVcCustom11 : If (##HxcVcFC11 = "button" AND ##HxcVcDMFld11 = @@HxcCustomValueLabel) THEN ##HxcVcDraftCustom11 ELSE ""
    2802 :          SET VALUE : HxcVcCustom12 : If (##HxcVcFC12 = "button" AND ##HxcVcDMFld12 = @@HxcCustomValueLabel) THEN ##HxcVcDraftCustom12 ELSE ""
    2803 :          SET VALUE : HxcVcCustom13 : If (##HxcVcFC13 = "button" AND ##HxcVcDMFld13 = @@HxcCustomValueLabel) THEN ##HxcVcDraftCustom13 ELSE ""
    2804 :          SET VALUE : HxcVcCustom14 : If (##HxcVcFC14 = "button" AND ##HxcVcDMFld14 = @@HxcCustomValueLabel) THEN ##HxcVcDraftCustom14 ELSE ""
    2805 :          SET VALUE : HxcVcCustom15 : If (##HxcVcFC15 = "button" AND ##HxcVcDMFld15 = @@HxcCustomValueLabel) THEN ##HxcVcDraftCustom15 ELSE ""
    2806 :          SET VALUE : HxcVcCustom16 : If (##HxcVcFC16 = "button" AND ##HxcVcDMFld16 = @@HxcCustomValueLabel) THEN ##HxcVcDraftCustom16 ELSE ""
    28 :          SET VALUE : HxcVcVoucherTypes : ##Vchs
    29 :          SET TARGET : ..
    30 :       END IF
    31 :    END WALK
    32 : ELSE
    33 :    INSERT COLLECTION OBJECT : HxcVoucherConfigs
    34 :    SET VALUE : HxcVcName : ##HxcVcDraftName
    35 :    SET VALUE : HxcVcTemplateName : ##HxcVcDraftTemplate
    36 :    SET VALUE : HxcVcLanguage : ##HxcVcDraftLang
    37 :    SET VALUE : HxcVcMediaExport : ##HxcVcDraftMedia
    38 :    SET VALUE : HxcVcAutoSend : ##HxcVcDraftAuto
    39 :    SET VALUE : HxcVcConfirmBeforeSend : ##HxcVcDraftConfirm
    40 :    SET VALUE : HxcVcVarMapsText : ##Maps
    401 :    SET VALUE : HxcVcCustom0 : If (##HxcVcDraftHeaderFld = @@HxcCustomValueLabel AND (##HxcVcHeaderKind = "text" AND NOT $$IsEmpty:##HxcVcHeaderKey)) THEN ##HxcVcDraftCustom0 ELSE ""
    402 :    SET VALUE : HxcVcCustom1 : If (@@HxcVcMappingField1 = @@HxcCustomValueLabel AND (NOT $$IsEmpty:##HxcVcFK1 AND (##HxcVcFC1 = "body" OR ##HxcVcFC1 = "button"))) THEN @@HxcVcMappingCustom1 ELSE ""
    403 :    SET VALUE : HxcVcCustom2 : If (@@HxcVcMappingField2 = @@HxcCustomValueLabel AND (NOT $$IsEmpty:##HxcVcFK2 AND (##HxcVcFC2 = "body" OR ##HxcVcFC2 = "button"))) THEN @@HxcVcMappingCustom2 ELSE ""
    404 :    SET VALUE : HxcVcCustom3 : If (@@HxcVcMappingField3 = @@HxcCustomValueLabel AND (NOT $$IsEmpty:##HxcVcFK3 AND (##HxcVcFC3 = "body" OR ##HxcVcFC3 = "button"))) THEN @@HxcVcMappingCustom3 ELSE ""
    405 :    SET VALUE : HxcVcCustom4 : If (@@HxcVcMappingField4 = @@HxcCustomValueLabel AND (NOT $$IsEmpty:##HxcVcFK4 AND (##HxcVcFC4 = "body" OR ##HxcVcFC4 = "button"))) THEN @@HxcVcMappingCustom4 ELSE ""
    406 :    SET VALUE : HxcVcCustom5 : If (##HxcVcDMFld5 = @@HxcCustomValueLabel AND (NOT $$IsEmpty:##HxcVcFK5 AND (##HxcVcFC5 = "body" OR ##HxcVcFC5 = "button"))) THEN ##HxcVcDraftCustom5 ELSE ""
    407 :    SET VALUE : HxcVcCustom6 : If (##HxcVcDMFld6 = @@HxcCustomValueLabel AND (NOT $$IsEmpty:##HxcVcFK6 AND (##HxcVcFC6 = "body" OR ##HxcVcFC6 = "button"))) THEN ##HxcVcDraftCustom6 ELSE ""
    408 :    SET VALUE : HxcVcCustom7 : If (##HxcVcDMFld7 = @@HxcCustomValueLabel AND (NOT $$IsEmpty:##HxcVcFK7 AND (##HxcVcFC7 = "body" OR ##HxcVcFC7 = "button"))) THEN ##HxcVcDraftCustom7 ELSE ""
    409 :    SET VALUE : HxcVcCustom8 : If (##HxcVcDMFld8 = @@HxcCustomValueLabel AND (NOT $$IsEmpty:##HxcVcFK8 AND (##HxcVcFC8 = "body" OR ##HxcVcFC8 = "button"))) THEN ##HxcVcDraftCustom8 ELSE ""
    4099 :    SET VALUE : HxcVcCustom9 : If (##HxcVcFC9 = "button" AND ##HxcVcDMFld9 = @@HxcCustomValueLabel) THEN ##HxcVcDraftCustom9 ELSE ""
    4100 :    SET VALUE : HxcVcCustom10 : If (##HxcVcFC10 = "button" AND ##HxcVcDMFld10 = @@HxcCustomValueLabel) THEN ##HxcVcDraftCustom10 ELSE ""
    4101 :    SET VALUE : HxcVcCustom11 : If (##HxcVcFC11 = "button" AND ##HxcVcDMFld11 = @@HxcCustomValueLabel) THEN ##HxcVcDraftCustom11 ELSE ""
    4102 :    SET VALUE : HxcVcCustom12 : If (##HxcVcFC12 = "button" AND ##HxcVcDMFld12 = @@HxcCustomValueLabel) THEN ##HxcVcDraftCustom12 ELSE ""
    4103 :    SET VALUE : HxcVcCustom13 : If (##HxcVcFC13 = "button" AND ##HxcVcDMFld13 = @@HxcCustomValueLabel) THEN ##HxcVcDraftCustom13 ELSE ""
    4104 :    SET VALUE : HxcVcCustom14 : If (##HxcVcFC14 = "button" AND ##HxcVcDMFld14 = @@HxcCustomValueLabel) THEN ##HxcVcDraftCustom14 ELSE ""
    4105 :    SET VALUE : HxcVcCustom15 : If (##HxcVcFC15 = "button" AND ##HxcVcDMFld15 = @@HxcCustomValueLabel) THEN ##HxcVcDraftCustom15 ELSE ""
    4106 :    SET VALUE : HxcVcCustom16 : If (##HxcVcFC16 = "button" AND ##HxcVcDMFld16 = @@HxcCustomValueLabel) THEN ##HxcVcDraftCustom16 ELSE ""
    41 :    SET VALUE : HxcVcVoucherTypes : ##Vchs
    42 :    SET TARGET : ..
    43 : END IF
    44 : CALL : Hxc Vc Clear Draft
    45 : SET : HxcVcSaveOk : Yes
    46 : Msg Box : "Helixcer Voucher Config" : "Config saved."
    47 : RETURN : Yes

;; ---------------------------------------------------------------------------
;; Menu
;; ---------------------------------------------------------------------------

[#Menu: Gateway of Tally]
    Add : Key Item : Before : @@LOCQuit : Helixcer Chat : H : Menu : Helixcer Chat Menu
    Option : Hxc Gateway Receivable Menu : @@HxcShowGatewayReceivable

[!Menu: Hxc Gateway Receivable Menu]
    Add : Key Item : After : Helixcer Chat : Party Receivable : R : Call : Hxc Open Party Receivable

[Menu: Helixcer Chat Menu]
    Title    : "Helixcer Chat"
    Key Item : General Settings : G : Alter : Hxc General Settings
    Key Item : Status         : T : Call  : Hxc Show Status
    Key Item : WhatsApp Templates : W : Menu : Hxc WhatsApp Templates
    Key Item : Message History : V : CALL : Hxc Open Voucher Message History
    Key Item : About          : A : Display : Helixcer Chat About
    Key Item : Back           : B

[Menu: Helixcer Voucher Config Menu]
    Title    : "Voucher Config"
    Key Item : Create Config : C : Alter : Helixcer Voucher Config Create
    Key Item : Alter Config  : A : Alter : Helixcer Voucher Config Alter
    Key Item : List Configs  : L : Alter : Helixcer Voucher Config List
    Key Item : Back          : B

;; ---------------------------------------------------------------------------
;; API Settings
;; ---------------------------------------------------------------------------

[Report: Hxc General Settings]
    Form : Hxc General Settings
    Title : "General Settings"
    Object : Company

[Form: Hxc General Settings]
    Height : 100% Screen
    Width : 100% Screen
    Background : Hxc Vt Page
    Part : Hxc General Settings Layout
    Button : Form Accept, Form Cancel

[Part: Hxc General Settings Layout]
    Parts : Hxc General Settings Left Space, Hxc General Settings
    Horizontal : Yes
    Space Top : 32% Screen

[Part: Hxc General Settings Left Space]
    Width : 27% Screen
    Line : Hxc General Settings Space

[Line: Hxc General Settings Space]
    Field : Hxc General Settings Space

[Field: Hxc General Settings Space]
    Use : Name Field
    Set as : ""
    Skip : Yes

[Part: Hxc General Settings]
    Width : 46% Screen
    Horizontal Align : Centre
    Space Top : 1
    Space Bottom : 1
    Space Left : 1.5
    Space Right : 1.5
    Background : Hxc Vt Panel
    Border : Hxc Vt Panel Border
    Lines : Hxc Default Country Code Line, Hxc Voucher Export Folder, Hxc Show Last Voucher Status Line, Hxc Gateway Receivable Setting

[Line: Hxc Show Last Voucher Status Line]
    Fields : Medium Prompt, Hxc Show Last Voucher Status Input
    Local : Field : Medium Prompt : Set as : "Show last message status in voucher screen"
    Local : Field : Medium Prompt : Width : 39
    Space Top : 0.25
    Space Bottom : 0.25

[Field: Hxc Show Last Voucher Status Input]
    Use : Logical Field
    Storage : HxcShowLastVoucherMessageStatus
    Set as : $HxcShowLastVoucherMessageStatus
    Width : 5

[Line: Hxc Default Country Code Line]
    Fields : Medium Prompt, Hxc Default Country Code Input
    Local : Field : Medium Prompt : Set as : "Default Country Code"
    Local : Field : Medium Prompt : Width : 39
    Space Top : 0.25
    Space Bottom : 0.25

[Field: Hxc Default Country Code Input]
    Use : MobileCountryCode
    Show Table : On First Key
    Delete : Set By Condition
    Skip Forward : No
    Storage : HxcDefaultCountryCode
    Set as : $HxcDefaultCountryCode
    Validate : $$IsEmpty:$$Value OR $$HxcValidDialingCode:$$Value
    Align : Left
    Width : 10

[Line: Hxc Voucher Export Folder]
    Fields : Medium Prompt, Hxc Voucher Export Folder Input
    Local : Field : Medium Prompt : Set as : "PDF Export Folder"
    Local : Field : Medium Prompt : Width : 39
    Space Top : 0.25
    Space Bottom : 0.25

[Field: Hxc Voucher Export Folder Input]
    Use : Name Field
    Storage : HxcVoucherPDFExportFolder
    Set as : $HxcVoucherPDFExportFolder
    Width : 31

[System: Formula]
    Hxc Voucher PDF Folder : $HxcVoucherPDFExportFolder:Company:##SVCurrentCompany

;; ---------------------------------------------------------------------------
;; Shared Create/Alter form body — layout only (functions unchanged)
;; Sections: Template | Mapping+Preview (side-by-side) | Voucher Rules | Settings
;; ---------------------------------------------------------------------------

;; Template card
[Part: Hxc Vc Form Template Part]
    On : Focus : ##HxcVcCreateNeedsReset : CALL : Hxc Initialize New Config
    Lines  : Hxc Vc F Template Sect, +
             Hxc Vc F Name Line, Hxc Vc F Template Line, Hxc Vc F Lang Line, +
             Hxc Vc F Fetch Status Line

;; Mapping (left) + Message Preview (right) — single-line preview
;; Mapping LEFT + Preview RIGHT (no Height on Mid Row — Height/% broke Horizontal)
[Part: Hxc Vc Form Mid Row]
    Parts      : Hxc Vc Form Left Col, Hxc Vc Form Preview Part
    Horizontal : Yes

[Part: Hxc Vc Form Left Col]
    Lines  : Hxc Vc F Map Sect, +
             Hxc Vc F Hdr Media Line, Hxc Vt PDF Filename Line, Hxc Vt PDF Filename Help, Hxc Vc F Hdr Col Head, Hxc Vc F Hdr Text Line, +
             Hxc Vc F Body Sect, Hxc Vc F Body Col Head, +
             Hxc Vc F Body1, +
             Hxc Vc F Body2, +
             Hxc Vc F Body3, +
             Hxc Vc F Body4, +
             Hxc Vc F Body5, +
             Hxc Vc F Body6, +
             Hxc Vc F Body7, +
             Hxc Vc F Body8, +
             Hxc Vc F Btn Sect, Hxc Vc F Btn Col Head, +
             Hxc Vc F Btn1, +
             Hxc Vc F Btn2, +
             Hxc Vc F Btn3, +
             Hxc Vc F Btn4, +
             Hxc Vc F Btn5, Hxc Vc F Btn6, Hxc Vc F Btn7, Hxc Vc F Btn8, +
             Hxc Vc F Btn9, Hxc Vc F Btn10, Hxc Vc F Btn11, Hxc Vc F Btn12, +
             Hxc Vc F Btn13, Hxc Vc F Btn14, Hxc Vc F Btn15, Hxc Vc F Btn16
    Scroll : Vertical
    Width  : 55% Screen

[Part: Hxc Vc Form Preview Part]
    Parts : Hxc Vc Preview Heading, Hxc Vc Preview Document, Hxc Vc Preview Body
    Vertical : Yes
    Width : 45% Screen

[Part: Hxc Vc Preview Heading]
    Line : Hxc Vc F Prev Head

[Part: Hxc Vc Preview Document]
    Invisible : NOT @@HxcVtShowMappings OR NOT @@HxcSettingsPreviewHasDocument
    Background : Hxc Preview Header Fill
    Space Top : 0.5
    Space Bottom : 0.5
    Line : Hxc Vc Preview Document

[Line: Hxc Vc Preview Document]
    Field : Hxc Vc Preview Document

[Field: Hxc Vc Preview Document]
    Use : Name Field
    Set as : "Document Header"
    Align : Centre
    Color : Hxc Preview Header Ink
    Full Width : Yes
    Skip : Yes

[Part: Hxc Vc Preview Body]
    Line : Hxc Vc F Prev Body
    Repeat : Hxc Vc F Prev Body
    Set : If @@HxcVtShowMappings Then $$HxcPreviewLineCount Else 1
    Scroll : Vertical


;; Voucher Rules
[Part: Hxc Vc Form Vch Part]
    Lines    : Hxc Vc F Vch Sect, Hxc Vc F Vch Head, Hxc Vc F Vch Data
    Repeat   : Hxc Vc F Vch Data
    Break On : $$IsEmpty:#HxcVcVoucherTypeInput OR $$IsEndOfList:#HxcVcVoucherTypeInput
    Scroll   : Vertical

[Part: Hxc Vc Form Settings Part]
    Lines    : Hxc Vc F Auto Line, Hxc Vc F Confirm Line

;; --- Template fields ---

[Line: Hxc Vc F Template Sect]
    Field : Hxc Vc F Template Sect Fld

[Field: Hxc Vc F Template Sect Fld]
    Option : Hxc Vt Section Heading Style : ##HxcVtEditing
    Use       : Name Field
    Set as    : "Template"
    Style     : Bold
    Color     : Dark Green
    FullWidth : Yes
    Skip      : Yes

[Line: Hxc Vc F Name Line]
    Fields : Medium Prompt, HxcVcConfigNameInput
    Local  : Field : Medium Prompt : Set as : "Config Name"
    Local  : Field : Medium Prompt : Width  : 22

[Field: HxcVcConfigNameInput]
    Skip     : ##HxcVcMoveToConfirm OR ##HxcVcMoveToMapping
    Use      : Name Field
    Set as   : ##HxcVcDraftName
    Modifies : HxcVcDraftName
    Width    : 40
    Max      : 60
    On       : Accept : Yes : SET : HxcVcDraftName : $$Value
    On       : Accept : Yes : Field Accept

[Line: Hxc Vc F Template Line]
    Fields : Medium Prompt, HxcVcTemplateNameInput
    Local  : Field : Medium Prompt : Set as : "Template Name"
    Local  : Field : Medium Prompt : Width  : 22

[Field: HxcVcTemplateNameInput]
    Skip     : ##HxcVcMoveToConfirm OR ##HxcVcMoveToMapping
    Use      : Name Field
    Set as   : ##HxcVcDraftTemplate
    Modifies : HxcVcDraftTemplate
    Width    : 40
    Max      : 80
    ;; Modifies writes the INPUT field into ##HxcVcDraftTemplate; also lock FetchName from $Value
    On       : Accept : Yes : CALL : Hxc Clear Fetch Vars
    On       : Accept : Yes : SET : HxcVcDraftTemplate : $$Value
    On       : Accept : Yes : SET : HxcVcFetchName : $$Value
    On       : Accept : Yes : Field Accept

[Line: Hxc Vc F Lang Line]
    Fields : Medium Prompt, Hxc Vc F Lang
    Local  : Field : Medium Prompt : Set as : "Language"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc F Lang]
    Skip     : ##HxcVcMoveToConfirm OR (##HxcVcFetched AND ##HxcVcMoveToMapping)
    Use      : Name Field
    Set as   : If $$IsEmpty:##HxcVcDraftLang THEN "en" ELSE ##HxcVcDraftLang
    Modifies : HxcVcDraftLang
    Width    : 16
    Max      : 16
    On       : Accept : Yes : SET : HxcVcDraftLang : If $$IsEmpty:$$Value Then "en" Else If ##HxcReminderEditing Then $$Value Else $$Trim:$$Value
    On       : Accept : Yes : SET : HxcVcFetchLang : ##HxcVcDraftLang
    ;; Prefer draft Variable (Modifies from Template input); else keep FetchName set on Template Accept
    On       : Accept : NOT $$IsEmpty:##HxcVcDraftTemplate : SET : HxcVcFetchName : ##HxcVcDraftTemplate
    On       : Accept : Yes : CALL : Hxc Fetch Template
    On       : Accept : ##HxcVcFetched : Field Accept

[Line: Hxc Vc F Fetch Status Line]
    Field : Hxc Vc F Fetch Status

[Field: Hxc Vc F Fetch Status]
    Use        : Name Field
    Set as     : If @@HxcVtShowingSavedRows THEN "Saved mappings. Fetch Template (Enter on Language / Alt+F) to refresh or edit." ELSE If NOT ##HxcVcFetched THEN "Enter Language, then Fetch Template (Enter / Alt+F)" ELSE If $$IsEmpty:##HxcVcFetchStatus THEN "Template loaded." ELSE ##HxcVcFetchStatus
    Set Always : Yes
    Color      : Dark Green
    FullWidth  : Yes
    Skip       : Yes

;; --- Mapping + header ---

[Line: Hxc Vc F Map Sect]
    Field : Hxc Vc F Map Sect Fld

[Field: Hxc Vc F Map Sect Fld]
    Option : Hxc Vt Section Heading Style : ##HxcVtEditing
    Use       : Name Field
    Set as    : "Variable Mapping"
    Style     : Bold
    Color     : Dark Green
    FullWidth : Yes
    Skip      : Yes
    Inactive  : NOT @@HxcVtShowMappings

[Line: Hxc Vc F Hdr Media Line]
    Fields : Medium Prompt, Hxc Vc F Media
    Local  : Field : Medium Prompt : Set as : "Media Header"
    Local  : Field : Medium Prompt : Width  : 22
    Local  : Field : Medium Prompt : Inactive : NOT @@HxcVtShowMappings OR NOT ##HxcVcHeaderKind = "media"

[Field: Hxc Vc F Media]
    Skip : @@HxcVtShowingSavedRows OR (##HxcVcMoveToConfirm)
    Use        : Name Field
    Modifies    : HxcVcDraftMedia
    Set as     : If $$IsEmpty:##HxcVcDraftMedia THEN "None" ELSE ##HxcVcDraftMedia
    Table      : Hxc Media Export List
    Show Table : Always
    Width      : 40
    Max        : 40
    Inactive   : NOT @@HxcVtShowMappings OR NOT ##HxcVcHeaderKind = "media"
    On : Accept : Yes : SET : HxcVcDraftMedia : $$Value
    On : Accept : ##HxcVcMoveToMapping : SET : HxcVcMoveToMapping : No
    On : Accept : Yes : Field Accept

[Line: Hxc Vt PDF Filename Line]
    Invisible : NOT ##HxcVtEditing OR NOT @@HxcVtShowMappings OR NOT (##HxcVcHeaderKind = "media")
    Fields : Medium Prompt, Hxc Vt PDF Filename
    Local : Field : Medium Prompt : Set as : "PDF File Name"
    Local : Field : Medium Prompt : Width : 22

[Field: Hxc Vt PDF Filename]
    Use : Name Field
    Storage : HxcVtPdfFileName
    Set as : $HxcVtPdfFileName
    Width : 60
    Max : 180

[Line: Hxc Vt PDF Filename Help]
    Invisible : NOT ##HxcVtEditing OR NOT @@HxcVtShowMappings OR NOT (##HxcVcHeaderKind = "media")
    Field : Hxc Vt PDF Filename Help

[Field: Hxc Vt PDF Filename Help]
    Use : Name Field
    Set as : "Example: Invoice-{{Voucher Number}}-{{Contact Name}}"
    Style : Hxc Vt Mapping Value Small
    Skip : Yes
    Full Width : Yes
    Word Wrap : Always : None : Yes

[Line: Hxc Vc F Hdr Col Head]
