;; Helixcer Chat — TallyPrime TDL
;; BUILD: 376-body-btn-repeat
;; Title must show "(build 376)".
;;
;; Create Config flow:
;;   Config Name → Template → Language Enter (fetch) →
;;   Preview → Header (only if template has header) → Body maps (dynamic count) →
;;   Voucher types → Settings → Ctrl+A

;; ---------------------------------------------------------------------------
;; Company UDFs
;; ---------------------------------------------------------------------------

[System: UDF]
    HxcWorkspaceIdUDF : String : 25101
    HxcChannelIdUDF   : String : 25102
    HxcApiKeyUDF      : String : 25103
    ;; Saved configs
    HxcVoucherConfigs      : Aggregate : 25110
    HxcVcName              : String    : 25111
    HxcVcTemplateName      : String    : 25112
    HxcVcLanguage          : String    : 25113
    HxcVcVoucherTypes      : String    : 25114
    HxcVcMediaExport       : String    : 25115
    HxcVcAutoSend          : Logical   : 25116
    HxcVcConfirmBeforeSend : Logical   : 25117
    HxcVcVarMapsText       : String    : 25118
    ;; Create/Alter draft buffer (one form, not a repeating name list)
    HxcVcDraftName     : String  : 25120
    HxcVcDraftTemplate : String  : 25121
    HxcVcDraftLang     : String  : 25122
    HxcVcDraftMedia    : String  : 25123
    HxcVcDraftAuto     : Logical : 25124
    HxcVcDraftConfirm  : Logical : 25125
    HxcVcDraftEditKey    : String  : 25126
    HxcVcDraftHeaderFld  : String  : 25127
    HxcVcDMFld1 : String : 25132
    HxcVcDMFld2 : String : 25133
    HxcVcDMFld3 : String : 25134
    HxcVcDMFld4 : String : 25135
    HxcVcDMFld5 : String : 25136
    HxcVcDMFld6 : String : 25137
    HxcVcDMFld7 : String : 25138
    HxcVcDMFld8 : String : 25139
    HxcVcDMFld9 : String : 25140
    HxcVcDMFld10 : String : 25141
    HxcVcDMFld11 : String : 25142
    HxcVcDMFld12 : String : 25143
    HxcVcDMFld13 : String : 25144
    HxcVcDMFld14 : String : 25145
    HxcVcDMFld15 : String : 25146
    HxcVcDMFld16 : String : 25147
    ;; Dynamic voucher-type picker
    HxcVcDraftVchs    : Aggregate : 25150
    HxcVcDraftVchName : String    : 25151
    ;; Body/Button mapping rows (UI Repeat only)
    HxcVcBodyMaps     : Aggregate : 25160
    HxcVcBodyMapKey   : String    : 25161
    HxcVcBodyMapSlot  : Number    : 25162
    HxcVcBodyMapFld   : String    : 25163
    HxcVcBtnMaps      : Aggregate : 25170
    HxcVcBtnMapKey    : String    : 25171
    HxcVcBtnMapSlot   : Number    : 25172
    HxcVcBtnMapFld    : String    : 25173

;; ---------------------------------------------------------------------------
;; Status mirrors + save flag
;; ---------------------------------------------------------------------------

