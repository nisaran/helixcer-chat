[System: Variable]
    HxcSysWorkspaceId   : ""
    HxcSysChannelId     : ""
    HxcSysApiKey        : ""
    HxcWorkspaceName    : ""
    HxcChannelName      : ""
    HxcConnectionStatus : ""
    HxcVcSaveOk         : No
    HxcVcHasBodyMaps    : No
    HxcVcHasBtnMaps     : No
    HxcVcFetched        : No
    HxcVcPreviewText    : ""
    HxcVcFetchStatus    : ""
    HxcVcFetchLang      : "en"
    HxcVcFetchName      : ""
    HxcVcMapsCsv        : ""
    HxcVcHasHeader      : No
    HxcVcHeaderKind     : ""
    HxcVcHeaderFormat   : ""
    HxcVcHeaderKey      : ""
    HxcVcFK1            : ""
    HxcVcFK2            : ""
    HxcVcFK3            : ""
    HxcVcFK4            : ""
    HxcVcFK5            : ""
    HxcVcFK6            : ""
    HxcVcFK7            : ""
    HxcVcFK8            : ""
