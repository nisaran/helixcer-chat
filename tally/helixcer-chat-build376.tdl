[Function: Hxc Set Map Slot]
    Parameter : Idx : Number
    Parameter : Key : String
    Parameter : Comp : String
    01 : IF : ##Idx = 1
    02 :    SET : HxcVcFK1 : ##Key
    03 :    SET : HxcVcFC1 : ##Comp
    04 : END IF
    05 : IF : ##Idx = 2
    06 :    SET : HxcVcFK2 : ##Key
    07 :    SET : HxcVcFC2 : ##Comp
    08 : END IF
    09 : IF : ##Idx = 3
    10 :    SET : HxcVcFK3 : ##Key
    11 :    SET : HxcVcFC3 : ##Comp
    12 : END IF
    13 : IF : ##Idx = 4
    14 :    SET : HxcVcFK4 : ##Key
    15 :    SET : HxcVcFC4 : ##Comp
    16 : END IF
    17 : IF : ##Idx = 5
    18 :    SET : HxcVcFK5 : ##Key
    19 :    SET : HxcVcFC5 : ##Comp
    20 : END IF
    21 : IF : ##Idx = 6
    22 :    SET : HxcVcFK6 : ##Key
    23 :    SET : HxcVcFC6 : ##Comp
    24 : END IF
    25 : IF : ##Idx = 7
    26 :    SET : HxcVcFK7 : ##Key
    27 :    SET : HxcVcFC7 : ##Comp
    28 : END IF
    29 : IF : ##Idx = 8
    30 :    SET : HxcVcFK8 : ##Key
    31 :    SET : HxcVcFC8 : ##Comp
    32 : END IF
    33 : IF : ##Idx = 9
    34 :    SET : HxcVcFK9 : ##Key
    35 :    SET : HxcVcFC9 : ##Comp
    36 : END IF
    37 : IF : ##Idx = 10
    38 :    SET : HxcVcFK10 : ##Key
    39 :    SET : HxcVcFC10 : ##Comp
    40 : END IF
    41 : IF : ##Idx = 11
    42 :    SET : HxcVcFK11 : ##Key
    43 :    SET : HxcVcFC11 : ##Comp
    44 : END IF
    45 : IF : ##Idx = 12
    46 :    SET : HxcVcFK12 : ##Key
    47 :    SET : HxcVcFC12 : ##Comp
    48 : END IF
    49 : IF : ##Idx = 13
    50 :    SET : HxcVcFK13 : ##Key
    51 :    SET : HxcVcFC13 : ##Comp
    52 : END IF
    53 : IF : ##Idx = 14
    54 :    SET : HxcVcFK14 : ##Key
    55 :    SET : HxcVcFC14 : ##Comp
    56 : END IF
    57 : IF : ##Idx = 15
    58 :    SET : HxcVcFK15 : ##Key
    59 :    SET : HxcVcFC15 : ##Comp
    60 : END IF
    61 : IF : ##Idx = 16
    62 :    SET : HxcVcFK16 : ##Key
    63 :    SET : HxcVcFC16 : ##Comp
    64 : END IF
    65 : RETURN : Yes


[Function: Hxc Clear Body Map Rows]
    01 : WALK COLLECTION : HxcVcBodyMaps
    02 :    DELETE OBJECT
    03 : END WALK
    04 : SET : HxcVcHasBodyMaps : No
    05 : RETURN : Yes

[Function: Hxc Clear Btn Map Rows]
    01 : WALK COLLECTION : HxcVcBtnMaps
    02 :    DELETE OBJECT
    03 : END WALK
    04 : SET : HxcVcHasBtnMaps : No
    05 : RETURN : Yes

[Function: Hxc Write Slot Fld]
    Parameter : Slot : Number
    Parameter : Val : String
    01 : IF : ##Slot = 1
    02 :    SET VALUE : HxcVcDMFld1 : ##Val
    03 : END IF
    04 : IF : ##Slot = 2
    05 :    SET VALUE : HxcVcDMFld2 : ##Val
    06 : END IF
    07 : IF : ##Slot = 3
    08 :    SET VALUE : HxcVcDMFld3 : ##Val
    09 : END IF
    10 : IF : ##Slot = 4
    11 :    SET VALUE : HxcVcDMFld4 : ##Val
    12 : END IF
    13 : IF : ##Slot = 5
    14 :    SET VALUE : HxcVcDMFld5 : ##Val
    15 : END IF
    16 : IF : ##Slot = 6
    17 :    SET VALUE : HxcVcDMFld6 : ##Val
    18 : END IF
    19 : IF : ##Slot = 7
    20 :    SET VALUE : HxcVcDMFld7 : ##Val
    21 : END IF
    22 : IF : ##Slot = 8
    23 :    SET VALUE : HxcVcDMFld8 : ##Val
    24 : END IF
    25 : IF : ##Slot = 9
    26 :    SET VALUE : HxcVcDMFld9 : ##Val
    27 : END IF
    28 : IF : ##Slot = 10
    29 :    SET VALUE : HxcVcDMFld10 : ##Val
    30 : END IF
    31 : IF : ##Slot = 11
    32 :    SET VALUE : HxcVcDMFld11 : ##Val
    33 : END IF
    34 : IF : ##Slot = 12
    35 :    SET VALUE : HxcVcDMFld12 : ##Val
    36 : END IF
    37 : IF : ##Slot = 13
    38 :    SET VALUE : HxcVcDMFld13 : ##Val
    39 : END IF
    40 : IF : ##Slot = 14
    41 :    SET VALUE : HxcVcDMFld14 : ##Val
    42 : END IF
    43 : IF : ##Slot = 15
    44 :    SET VALUE : HxcVcDMFld15 : ##Val
    45 : END IF
    46 : IF : ##Slot = 16
    47 :    SET VALUE : HxcVcDMFld16 : ##Val
    48 : END IF
    49 : RETURN : Yes

[Function: Hxc Sync Map Rows From Slots]
    Variable : Fld : String
    01 : CALL : Hxc Clear Body Map Rows
    02 : CALL : Hxc Clear Btn Map Rows
    03 : IF : NOT $$IsEmpty:##HxcVcFK1
    04 :    IF : ##HxcVcFC1 = "body"
    05 :       SET : Fld : $HxcVcDMFld1
    06 :       INSERT COLLECTION OBJECT : HxcVcBodyMaps
    07 :       SET VALUE : HxcVcBodyMapKey : ##HxcVcFK1
    08 :       SET VALUE : HxcVcBodyMapSlot : 1
    09 :       SET VALUE : HxcVcBodyMapFld : ##Fld
    10 :       SET TARGET : ..
    11 :       SET : HxcVcHasBodyMaps : Yes
    12 :    END IF
    13 :    IF : ##HxcVcFC1 = "button"
    14 :       SET : Fld : $HxcVcDMFld1
    15 :       INSERT COLLECTION OBJECT : HxcVcBtnMaps
    16 :       SET VALUE : HxcVcBtnMapKey : ##HxcVcFK1
    17 :       SET VALUE : HxcVcBtnMapSlot : 1
    18 :       SET VALUE : HxcVcBtnMapFld : ##Fld
    19 :       SET TARGET : ..
    20 :       SET : HxcVcHasBtnMaps : Yes
    21 :    END IF
    22 : END IF
    23 : IF : NOT $$IsEmpty:##HxcVcFK2
    24 :    IF : ##HxcVcFC2 = "body"
    25 :       SET : Fld : $HxcVcDMFld2
    26 :       INSERT COLLECTION OBJECT : HxcVcBodyMaps
    27 :       SET VALUE : HxcVcBodyMapKey : ##HxcVcFK2
    28 :       SET VALUE : HxcVcBodyMapSlot : 2
    29 :       SET VALUE : HxcVcBodyMapFld : ##Fld
    30 :       SET TARGET : ..
    31 :       SET : HxcVcHasBodyMaps : Yes
    32 :    END IF
    33 :    IF : ##HxcVcFC2 = "button"
    34 :       SET : Fld : $HxcVcDMFld2
    35 :       INSERT COLLECTION OBJECT : HxcVcBtnMaps
    36 :       SET VALUE : HxcVcBtnMapKey : ##HxcVcFK2
    37 :       SET VALUE : HxcVcBtnMapSlot : 2
    38 :       SET VALUE : HxcVcBtnMapFld : ##Fld
    39 :       SET TARGET : ..
    40 :       SET : HxcVcHasBtnMaps : Yes
    41 :    END IF
    42 : END IF
    43 : IF : NOT $$IsEmpty:##HxcVcFK3
    44 :    IF : ##HxcVcFC3 = "body"
    45 :       SET : Fld : $HxcVcDMFld3
    46 :       INSERT COLLECTION OBJECT : HxcVcBodyMaps
    47 :       SET VALUE : HxcVcBodyMapKey : ##HxcVcFK3
    48 :       SET VALUE : HxcVcBodyMapSlot : 3
    49 :       SET VALUE : HxcVcBodyMapFld : ##Fld
    50 :       SET TARGET : ..
    51 :       SET : HxcVcHasBodyMaps : Yes
    52 :    END IF
    53 :    IF : ##HxcVcFC3 = "button"
    54 :       SET : Fld : $HxcVcDMFld3
    55 :       INSERT COLLECTION OBJECT : HxcVcBtnMaps
    56 :       SET VALUE : HxcVcBtnMapKey : ##HxcVcFK3
    57 :       SET VALUE : HxcVcBtnMapSlot : 3
    58 :       SET VALUE : HxcVcBtnMapFld : ##Fld
    59 :       SET TARGET : ..
    60 :       SET : HxcVcHasBtnMaps : Yes
    61 :    END IF
    62 : END IF
    63 : IF : NOT $$IsEmpty:##HxcVcFK4
    64 :    IF : ##HxcVcFC4 = "body"
    65 :       SET : Fld : $HxcVcDMFld4
    66 :       INSERT COLLECTION OBJECT : HxcVcBodyMaps
    67 :       SET VALUE : HxcVcBodyMapKey : ##HxcVcFK4
    68 :       SET VALUE : HxcVcBodyMapSlot : 4
    69 :       SET VALUE : HxcVcBodyMapFld : ##Fld
    70 :       SET TARGET : ..
    71 :       SET : HxcVcHasBodyMaps : Yes
    72 :    END IF
    73 :    IF : ##HxcVcFC4 = "button"
    74 :       SET : Fld : $HxcVcDMFld4
    75 :       INSERT COLLECTION OBJECT : HxcVcBtnMaps
    76 :       SET VALUE : HxcVcBtnMapKey : ##HxcVcFK4
    77 :       SET VALUE : HxcVcBtnMapSlot : 4
    78 :       SET VALUE : HxcVcBtnMapFld : ##Fld
    79 :       SET TARGET : ..
    80 :       SET : HxcVcHasBtnMaps : Yes
    81 :    END IF
    82 : END IF
