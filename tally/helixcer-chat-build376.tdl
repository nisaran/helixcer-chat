[Function: Hxc Apply Template Response]
    ;; Proven walk (build 347) + header; body/button → FK1..16 via Set Map Slot
    Variable : I : Number
    Variable : CompType : String
    Variable : Fmt : String
    Variable : VComp : String
    Variable : VKey : String
    01 : SET : I : 0
    02 : CALL : Hxc Clear Fetch Vars
    03 : SET : HxcVcFetchStatus : "Template not found or empty response."
    04 : WALK COLLECTION : Parameter Collection
    05 :    WALK COLLECTION : items
    06 :       WALK COLLECTION : components
    07 :          SET : CompType : $type
    08 :          IF : ##CompType = "header" OR ##CompType = "HEADER" OR ##CompType = "Header"
    09 :             SET : HxcVcHasHeader : Yes
    10 :             SET : Fmt : $format
    11 :             IF : $$IsEmpty:##Fmt
    12 :                SET : Fmt : "TEXT"
    13 :             END IF
    14 :             SET : HxcVcHeaderFormat : ##Fmt
    15 :             IF : ##Fmt = "IMAGE" OR ##Fmt = "VIDEO" OR ##Fmt = "DOCUMENT" OR ##Fmt = "GIF" OR ##Fmt = "image" OR ##Fmt = "video" OR ##Fmt = "document" OR ##Fmt = "gif"
    16 :                SET : HxcVcHeaderKind : "media"
    17 :             ELSE
    18 :                SET : HxcVcHeaderKind : "text"
    19 :             END IF
    20 :             IF : ##HxcVcHeaderKind = "text"
    21 :                IF : NOT $$IsEmpty:$text
    22 :                   SET : HxcVcPreviewText : "[Header] " + $text + " | "
    23 :                END IF
    24 :             END IF
    25 :          END IF
    26 :          IF : ##CompType = "body" OR ##CompType = "BODY" OR ##CompType = "Body"
    27 :             IF : NOT $$IsEmpty:$text
    28 :                SET : HxcVcPreviewText : ##HxcVcPreviewText + $text
    29 :             END IF
    30 :          END IF
    31 :       END WALK
    32 :       WALK COLLECTION : variables
    33 :          SET : VComp : $component
    34 :          SET : VKey : $key
    35 :          IF : $$IsEmpty:##VComp
    36 :             SET : VComp : "body"
    37 :          END IF
    38 :          IF : ##VComp = "HEADER"
    39 :             SET : VComp : "header"
    40 :          END IF
    41 :          IF : ##VComp = "BODY"
    42 :             SET : VComp : "body"
    43 :          END IF
    44 :          IF : ##VComp = "BUTTON"
    45 :             SET : VComp : "button"
    46 :          END IF
    47 :          IF : NOT $$IsEmpty:##VKey
    48 :             IF : ##VComp = "header"
    49 :                IF : NOT ##HxcVcHeaderKind = "media"
    50 :                   SET : HxcVcHasHeader : Yes
    51 :                   IF : $$IsEmpty:##HxcVcHeaderKind
    52 :                      SET : HxcVcHeaderKind : "text"
    53 :                   END IF
    54 :                   SET : HxcVcHeaderKey : ##VKey
    55 :                END IF
    56 :             ELSE
    57 :                SET : I : ##I + 1
    58 :                CALL : Hxc Set Map Slot : ##I : ##VKey : ##VComp
    59 :             END IF
    60 :          END IF
    61 :       END WALK
    62 :       SET : HxcVcFetched : Yes
    63 :       SET : HxcVcFetchStatus : "Template loaded."
    64 :    END WALK
    65 : END WALK
    66 : IF : ##HxcVcFetched
    67 :    IF : $$IsEmpty:##HxcVcPreviewText
    68 :       SET : HxcVcPreviewText : "(No body text in template)"
    69 :    END IF
    70 : END IF
    71 : RETURN : Yes

[Function: Hxc Fetch Template]
    01 : CALL : Hxc Sync From Company
    02 : CALL : Hxc Clear Fetch Vars
    03 : IF : $$IsEmpty:##HxcSysWorkspaceId OR $$IsEmpty:##HxcSysChannelId OR $$IsEmpty:##HxcSysApiKey
    04 :    SET : HxcVcFetchStatus : "Save API Settings (Ctrl+A) before fetching a template."
    05 :    Msg Box : "Helixcer Template" : ##HxcVcFetchStatus
    06 :    RETURN : No
    07 : END IF
    08 : SET : HxcVcFetchName : $HxcVcDraftTemplate
    09 : IF : $$IsEmpty:##HxcVcFetchName
    10 :    SET : HxcVcFetchName : $HxcVcDraftTemplate:Company:##SVCurrentCompany
    11 : END IF
    12 : IF : $$IsEmpty:##HxcVcFetchLang
    13 :    SET : HxcVcFetchLang : $HxcVcDraftLang
    14 : END IF
    15 : IF : $$IsEmpty:##HxcVcFetchLang
    16 :    SET : HxcVcFetchLang : "en"
    17 : END IF
    18 : IF : $$IsEmpty:##HxcVcFetchName
    19 :    SET : HxcVcFetchStatus : "Enter Template Name first."
    20 :    Msg Box : "Helixcer Template" : ##HxcVcFetchStatus
    21 :    RETURN : No
    22 : END IF
    23 : SET : HxcVcFetchStatus : "Fetching..."
    24 : Start Progress : 1 : "Helixcer Chat" : "Template" : "Fetching template details"
    25 : HTTP Request : @@HxcTemplateUrl : GET : JSON : UTF8 : Hxc Connection Request : Hxc Apply Template Response
    26 : End Progress
    27 : IF : NOT ##HxcVcFetched
    28 :    IF : $$IsEmpty:##HxcVcFetchStatus OR ##HxcVcFetchStatus = "Fetching..."
    29 :       SET : HxcVcFetchStatus : "Could not fetch [" + ##HxcVcFetchName + "]. Open Helixcer Chat → Status. If Connected, check the template name on this channel."
    30 :    END IF
    31 :    Msg Box : "Helixcer Template" : ##HxcVcFetchStatus
    32 :    RETURN : No
    33 : END IF
    34 : SET VALUE : HxcVcDMFld1 : ""
    35 : SET VALUE : HxcVcDMFld2 : ""
    36 : SET VALUE : HxcVcDMFld3 : ""
    37 : SET VALUE : HxcVcDMFld4 : ""
    38 : SET VALUE : HxcVcDMFld5 : ""
    39 : SET VALUE : HxcVcDMFld6 : ""
    40 : SET VALUE : HxcVcDMFld7 : ""
    41 : SET VALUE : HxcVcDMFld8 : ""
    42 : SET VALUE : HxcVcDMFld9 : ""
    43 : SET VALUE : HxcVcDMFld10 : ""
    44 : SET VALUE : HxcVcDMFld11 : ""
    45 : SET VALUE : HxcVcDMFld12 : ""
    46 : SET VALUE : HxcVcDMFld13 : ""
    47 : SET VALUE : HxcVcDMFld14 : ""
    48 : SET VALUE : HxcVcDMFld15 : ""
    49 : SET VALUE : HxcVcDMFld16 : ""
    50 : SET VALUE : HxcVcDraftHeaderFld : ""
    51 : IF : ##HxcVcHeaderKind = "media"
    52 :    IF : $$IsEmpty:$HxcVcDraftMedia OR $HxcVcDraftMedia = "None"
    53 :       SET VALUE : HxcVcDraftMedia : "Voucher PDF"
    54 :    END IF
    55 : ELSE
    56 :    SET VALUE : HxcVcDraftMedia : "None"
    57 : END IF
    58 : Msg Box : "Helixcer Template" : ##HxcVcFetchStatus
    59 : CALL : Hxc Sync Map Rows From Slots
    60 : RETURN : Yes

;; ---------------------------------------------------------------------------
;; Pack helpers + commit draft → Aggregate config
;; ---------------------------------------------------------------------------

[Function: Hxc Pack Maps]
    Variable : S : String
    01 : SET : S : ""
    02 : IF : ##HxcVcHeaderKind = "text" AND NOT $$IsEmpty:##HxcVcHeaderKey
    03 :    SET : S : ##S + "header:" + ##HxcVcHeaderKey + "=" + $HxcVcDraftHeaderFld + ";"
    04 : END IF
    05 : IF : NOT $$IsEmpty:##HxcVcFK1
    06 :    SET : S : ##S + ##HxcVcFC1 + ":" + ##HxcVcFK1 + "=" + $HxcVcDMFld1 + ";"
