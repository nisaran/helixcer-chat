    Type       : String
    Persistent : Yes

[Variable: HxcSysChannelId]
    Type       : String
    Persistent : Yes

[Variable: HxcSysApiKey]
    Type       : String
    Persistent : Yes

[Variable: HxcWorkspaceName]
    Type       : String
    Persistent : Yes

[Variable: HxcChannelName]
    Type       : String
