;; ---------------------------------------------------------------------------

[Report: Helixcer Chat About]
    Form : Helixcer Chat About

[Form: Helixcer Chat About]
    Part : Helixcer Chat About

[Part: Helixcer Chat About]
    Lines : Helixcer Chat About Title, Helixcer Chat About Body, Helixcer Chat About Status

[Line: Helixcer Chat About Title]
    Field : Helixcer Chat About Title

[Field: Helixcer Chat About Title]
    Use       : Name Field
    Set as    : "Helixcer Chat (build 397)"
    Style     : Bold
    Align     : Centre
    FullWidth : Yes

[Line: Helixcer Chat About Body]
    Field : Helixcer Chat About Body

[Field: Helixcer Chat About Body]
    Use       : Name Field
    Set as    : "Create: enter template+language → fetch → preview + mapping."
    Align     : Centre
    FullWidth : Yes

[Line: Helixcer Chat About Status]
    Field : Helixcer Chat About Status

[Field: Helixcer Chat About Status]
    Use       : Name Field
    Set as    : @@HxcSysSummary
    Align     : Centre
    FullWidth : Yes
[System: Formula]
    HxcCustomValueLabel : "♦ Custom Value"
    HxcVcMissingCustomValue :     (##HxcVcHeaderKind = "text" AND NOT $$IsEmpty:##HxcVcHeaderKey AND ##HxcVcDraftHeaderFld = @@HxcCustomValueLabel AND $$IsEmpty:##HxcVcDraftCustom0) OR +
        (NOT $$IsEmpty:##HxcVcFK1 AND (##HxcVcFC1 = "body" OR ##HxcVcFC1 = "button") AND @@HxcVcMappingField1 = @@HxcCustomValueLabel AND $$IsEmpty:@@HxcVcMappingCustom1) OR +
        (NOT $$IsEmpty:##HxcVcFK2 AND (##HxcVcFC2 = "body" OR ##HxcVcFC2 = "button") AND @@HxcVcMappingField2 = @@HxcCustomValueLabel AND $$IsEmpty:@@HxcVcMappingCustom2) OR +
        (NOT $$IsEmpty:##HxcVcFK3 AND (##HxcVcFC3 = "body" OR ##HxcVcFC3 = "button") AND @@HxcVcMappingField3 = @@HxcCustomValueLabel AND $$IsEmpty:@@HxcVcMappingCustom3) OR +
        (NOT $$IsEmpty:##HxcVcFK4 AND (##HxcVcFC4 = "body" OR ##HxcVcFC4 = "button") AND @@HxcVcMappingField4 = @@HxcCustomValueLabel AND $$IsEmpty:@@HxcVcMappingCustom4) OR +
        (NOT $$IsEmpty:##HxcVcFK5 AND (##HxcVcFC5 = "body") AND ##HxcVcDMFld5 = @@HxcCustomValueLabel AND $$IsEmpty:##HxcVcDraftCustom5) OR +
        (NOT $$IsEmpty:##HxcVcFK6 AND (##HxcVcFC6 = "body") AND ##HxcVcDMFld6 = @@HxcCustomValueLabel AND $$IsEmpty:##HxcVcDraftCustom6) OR +
        (NOT $$IsEmpty:##HxcVcFK7 AND (##HxcVcFC7 = "body") AND ##HxcVcDMFld7 = @@HxcCustomValueLabel AND $$IsEmpty:##HxcVcDraftCustom7) OR +
        (NOT $$IsEmpty:##HxcVcFK8 AND (##HxcVcFC8 = "body") AND ##HxcVcDMFld8 = @@HxcCustomValueLabel AND $$IsEmpty:##HxcVcDraftCustom8)
    HxcVoucherMappingSort : If $Name = @@HxcCustomValueLabel THEN "0" ELSE $Name
    HxcVcMappingField1 : If ##HxcVcFC1 = "button" THEN ##HxcVcButtonField1 ELSE ##HxcVcDMFld1
    HxcVcMappingCustom1 : If ##HxcVcFC1 = "button" THEN ##HxcVcButtonCustom1 ELSE ##HxcVcDraftCustom1
    HxcVcMappingField2 : If ##HxcVcFC2 = "button" THEN ##HxcVcButtonField2 ELSE ##HxcVcDMFld2
    HxcVcMappingCustom2 : If ##HxcVcFC2 = "button" THEN ##HxcVcButtonCustom2 ELSE ##HxcVcDraftCustom2
    HxcVcMappingField3 : If ##HxcVcFC3 = "button" THEN ##HxcVcButtonField3 ELSE ##HxcVcDMFld3
    HxcVcMappingCustom3 : If ##HxcVcFC3 = "button" THEN ##HxcVcButtonCustom3 ELSE ##HxcVcDraftCustom3
    HxcVcMappingField4 : If ##HxcVcFC4 = "button" THEN ##HxcVcButtonField4 ELSE ##HxcVcDMFld4
    HxcVcMappingCustom4 : If ##HxcVcFC4 = "button" THEN ##HxcVcButtonCustom4 ELSE ##HxcVcDraftCustom4

[Function: Hxc Restore Custom Mappings]
    Variable : EditKey : String
    01 : SET : EditKey : ##HxcVcDraftEditKey
    02 : IF : $$IsEmpty:##EditKey
    03 :    RETURN : Yes
    04 : END IF
    05 : WALK COLLECTION : Hxc Voucher Config Names
    06 :    IF : $HxcVcName = ##EditKey AND $HxcVcTemplateName = ##HxcVcFetchName AND $HxcVcLanguage = ##HxcVcFetchLang
    10 :       IF : (##HxcVcHeaderKind = "text" AND NOT $$IsEmpty:##HxcVcHeaderKey) AND NOT $$IsEmpty:$HxcVcCustom0
    11 :          SET : HxcVcDraftHeaderFld : @@HxcCustomValueLabel
    12 :          SET : HxcVcDraftCustom0 : $HxcVcCustom0
    13 :       END IF
    14 :       IF : (NOT $$IsEmpty:##HxcVcFK1 AND (##HxcVcFC1 = "body" OR ##HxcVcFC1 = "button")) AND NOT $$IsEmpty:$HxcVcCustom1
    15 :          IF : ##HxcVcFC1 = "button"
    151 :             SET : HxcVcButtonField1 : @@HxcCustomValueLabel
    152 :             SET : HxcVcButtonCustom1 : $HxcVcCustom1
    153 :          ELSE
    154 :             SET : HxcVcDMFld1 : @@HxcCustomValueLabel
    155 :             SET : HxcVcDraftCustom1 : $HxcVcCustom1
    16 :          END IF
    17 :       END IF
    18 :       IF : (NOT $$IsEmpty:##HxcVcFK2 AND (##HxcVcFC2 = "body" OR ##HxcVcFC2 = "button")) AND NOT $$IsEmpty:$HxcVcCustom2
    19 :          IF : ##HxcVcFC2 = "button"
    191 :             SET : HxcVcButtonField2 : @@HxcCustomValueLabel
    192 :             SET : HxcVcButtonCustom2 : $HxcVcCustom2
    193 :          ELSE
    194 :             SET : HxcVcDMFld2 : @@HxcCustomValueLabel
    195 :             SET : HxcVcDraftCustom2 : $HxcVcCustom2
    20 :          END IF
    21 :       END IF
    22 :       IF : (NOT $$IsEmpty:##HxcVcFK3 AND (##HxcVcFC3 = "body" OR ##HxcVcFC3 = "button")) AND NOT $$IsEmpty:$HxcVcCustom3
    23 :          IF : ##HxcVcFC3 = "button"
    231 :             SET : HxcVcButtonField3 : @@HxcCustomValueLabel
    232 :             SET : HxcVcButtonCustom3 : $HxcVcCustom3
    233 :          ELSE
    234 :             SET : HxcVcDMFld3 : @@HxcCustomValueLabel
    235 :             SET : HxcVcDraftCustom3 : $HxcVcCustom3
    24 :          END IF
    25 :       END IF
    26 :       IF : (NOT $$IsEmpty:##HxcVcFK4 AND (##HxcVcFC4 = "body" OR ##HxcVcFC4 = "button")) AND NOT $$IsEmpty:$HxcVcCustom4
    27 :          IF : ##HxcVcFC4 = "button"
    271 :             SET : HxcVcButtonField4 : @@HxcCustomValueLabel
    272 :             SET : HxcVcButtonCustom4 : $HxcVcCustom4
    273 :          ELSE
    274 :             SET : HxcVcDMFld4 : @@HxcCustomValueLabel
    275 :             SET : HxcVcDraftCustom4 : $HxcVcCustom4
    28 :          END IF
    29 :       END IF
    30 :       IF : (NOT $$IsEmpty:##HxcVcFK5 AND (##HxcVcFC5 = "body")) AND NOT $$IsEmpty:$HxcVcCustom5
    31 :          SET : HxcVcDMFld5 : @@HxcCustomValueLabel
    32 :          SET : HxcVcDraftCustom5 : $HxcVcCustom5
    33 :       END IF
    34 :       IF : (NOT $$IsEmpty:##HxcVcFK6 AND (##HxcVcFC6 = "body")) AND NOT $$IsEmpty:$HxcVcCustom6
    35 :          SET : HxcVcDMFld6 : @@HxcCustomValueLabel
    36 :          SET : HxcVcDraftCustom6 : $HxcVcCustom6
    37 :       END IF
    38 :       IF : (NOT $$IsEmpty:##HxcVcFK7 AND (##HxcVcFC7 = "body")) AND NOT $$IsEmpty:$HxcVcCustom7
    39 :          SET : HxcVcDMFld7 : @@HxcCustomValueLabel
    40 :          SET : HxcVcDraftCustom7 : $HxcVcCustom7
    41 :       END IF
    42 :       IF : (NOT $$IsEmpty:##HxcVcFK8 AND (##HxcVcFC8 = "body")) AND NOT $$IsEmpty:$HxcVcCustom8
    43 :          SET : HxcVcDMFld8 : @@HxcCustomValueLabel
    44 :          SET : HxcVcDraftCustom8 : $HxcVcCustom8
    45 :       END IF
    46 :    END IF
    47 : END WALK
    48 : RETURN : Yes

[Field: Hxc Vc Custom Mapping Input]
    Use : Name Field
    Width : 24
    Max : 200

[Field: HxcVcHdrCustomInput]
    Use : Hxc Vc Custom Mapping Input
    Variable : HxcVcDraftCustom0
    Set as : If ##HxcVcDraftHeaderFld = @@HxcCustomValueLabel THEN ##HxcVcDraftCustom0 ELSE ""
    Skip   : ##HxcVcMoveToConfirm OR (NOT (##HxcVcDraftHeaderFld = @@HxcCustomValueLabel))

[Field: HxcVcBody1CustomInput]
    Use : Hxc Vc Custom Mapping Input
    Variable : HxcVcDraftCustom1
