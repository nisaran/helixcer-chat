[Line: Hxc Vc F Btn Col Head]
    Fields : Hxc Vc F Btn Col Key, Hxc Vc F Btn Col Fld

[Field: Hxc Vc F Btn Col Key]
    Use       : Name Field
    Set as    : "Button variable"
    Style     : Bold
    Color     : Dark Green
    Skip      : Yes
    Width     : 28
    Inactive  : NOT ##HxcVcFetched OR NOT ##HxcVcHasBtnMaps

[Field: Hxc Vc F Btn Col Fld]
    Use       : Name Field
    Set as    : "Voucher field"
    Style     : Bold
    Color     : Dark Green
    Skip      : Yes
    Width     : 28
    Inactive  : NOT ##HxcVcFetched OR NOT ##HxcVcHasBtnMaps

[Line: Hxc Vc F Btn1]
    Invisible : NOT ##HxcVcFetched OR $$IsEmpty:##HxcVcFK1 OR NOT ##HxcVcFC1 = "button"
    Fields : Hxc Vc F Btn1 MK, HxcVcBtn1Mapping, HxcVcBtn1CustomInput

[Field: Hxc Vc F Btn1 MK]
    Use        : Name Field
    Set as     : "{{" + ##HxcVcFK1 + "}}"
    Set Always : Yes
    Skip       : Yes
    Width      : 28
    Inactive   : NOT ##HxcVcFetched OR $$IsEmpty:##HxcVcFK1 OR NOT ##HxcVcFC1 = "button"

[Field: HxcVcBtn1Mapping]
    Use        : Name Field
    Variable    : HxcVcButtonField1
    Set as     : ##HxcVcButtonField1
    Table      : Hxc Voucher Field List, Not Applicable
    Show Table : Always
    Width      : 28
    Max        : 40
    Color      : Black
    Inactive   : NOT ##HxcVcFetched OR $$IsEmpty:##HxcVcFK1 OR NOT ##HxcVcFC1 = "button"
    On         : Accept : Yes : SET : HxcVcButtonField1 : $Value
    On         : Accept : ##HxcVcMoveToMapping : SET : HxcVcMoveToMapping : No
    On         : Accept : Yes : Field Accept
    Skip : ##HxcVcMoveToConfirm

[Line: Hxc Vc F Btn2]
    Invisible : NOT ##HxcVcFetched OR $$IsEmpty:##HxcVcFK2 OR NOT ##HxcVcFC2 = "button"
    Fields : Hxc Vc F Btn2 MK, HxcVcBtn2Mapping, HxcVcBtn2CustomInput

