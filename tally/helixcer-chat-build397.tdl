    11 :    SET : HxcVcDMFld4 : ##Val
    12 : END IF
    13 : IF : ##Slot = 5
    14 :    SET : HxcVcDMFld5 : ##Val
    15 : END IF
    16 : IF : ##Slot = 6
    17 :    SET : HxcVcDMFld6 : ##Val
    18 : END IF
    19 : IF : ##Slot = 7
    20 :    SET : HxcVcDMFld7 : ##Val
