    49 : RETURN : Yes

[Function: Hxc Apply Template Response]
    ;; Proven walk (build 347) + header; body/button → FK1..16 via Set Map Slot
    Variable : I : Number
    Variable : CompType : String
    Variable : Fmt : String
    Variable : VComp : String
    Variable : VKey : String
    01 : SET : I : 0
    02 : CALL : Hxc Clear Fetch Vars
    03 : SET : HxcVcFetchStatus : "Template not found or empty response."
    04 : WALK COLLECTION : Parameter Collection
    05 :    WALK COLLECTION : items
    06 :       WALK COLLECTION : components
    07 :          SET : CompType : $type
    08 :          IF : ##CompType = "header" OR ##CompType = "HEADER" OR ##CompType = "Header"
    09 :             SET : HxcVcHasHeader : Yes
    10 :             SET : Fmt : $format
    11 :             IF : $$IsEmpty:##Fmt
    12 :                SET : Fmt : "TEXT"
    13 :             END IF
    14 :             SET : HxcVcHeaderFormat : ##Fmt
    15 :             IF : ##Fmt = "IMAGE" OR ##Fmt = "VIDEO" OR ##Fmt = "DOCUMENT" OR ##Fmt = "GIF" OR ##Fmt = "image" OR ##Fmt = "video" OR ##Fmt = "document" OR ##Fmt = "gif"
    16 :                SET : HxcVcHeaderKind : "media"
    17 :             ELSE
    18 :                SET : HxcVcHeaderKind : "text"
    19 :             END IF
    20 :             IF : ##HxcVcHeaderKind = "text"
    21 :                IF : NOT $$IsEmpty:$text
    22 :                   SET : HxcVcPreviewText : "[Header] " + $text + " | "
    23 :                END IF
    24 :             END IF
    25 :          END IF
    26 :          IF : ##CompType = "body" OR ##CompType = "BODY" OR ##CompType = "Body"
    27 :             IF : NOT $$IsEmpty:$text
    28 :                SET : HxcVcPreviewText : ##HxcVcPreviewText + $text
    29 :             END IF
    30 :          END IF
    31 :       END WALK
    32 :       WALK COLLECTION : variables
    33 :          SET : VComp : $component
    34 :          SET : VKey : $key
    35 :          IF : $$IsEmpty:##VComp
    36 :             SET : VComp : "body"
    37 :          END IF
    38 :          IF : ##VComp = "HEADER"
    39 :             SET : VComp : "header"
    40 :          END IF
    41 :          IF : ##VComp = "BODY"
    42 :             SET : VComp : "body"
    43 :          END IF
    44 :          IF : ##VComp = "BUTTON"
    45 :             SET : VComp : "button"
    46 :          END IF
    47 :          IF : NOT $$IsEmpty:##VKey
    48 :             IF : ##VComp = "header"
    49 :                IF : NOT ##HxcVcHeaderKind = "media"
    50 :                   SET : HxcVcHasHeader : Yes
    51 :                   IF : $$IsEmpty:##HxcVcHeaderKind
    52 :                      SET : HxcVcHeaderKind : "text"
    53 :                   END IF
    54 :                   SET : HxcVcHeaderKey : ##VKey
    55 :                END IF
    56 :             ELSE
    57 :                SET : I : ##I + 1
    58 :                CALL : Hxc Set Map Slot : ##I : ##VKey : ##VComp
    59 :             END IF
    60 :          END IF
    61 :       END WALK
    611 :       SET : HxcVcMoveToMapping : Yes
    62 :       SET : HxcVcFetched : Yes
    63 :       SET : HxcVcFetchStatus : "Template loaded."
    64 :    END WALK
    65 : END WALK
    66 : IF : ##HxcVcFetched
    67 :    IF : $$IsEmpty:##HxcVcPreviewText
    68 :       SET : HxcVcPreviewText : "(No body text in template)"
    69 :    END IF
    70 : END IF
    71 : RETURN : Yes

[Function: Hxc Fetch Template]
    01 : CALL : Hxc Sync From Company
    02 : CALL : Hxc Clear Fetch Vars
    03 : IF : $$IsEmpty:##HxcSysWorkspaceId OR $$IsEmpty:##HxcSysChannelId OR $$IsEmpty:##HxcSysApiKey
    04 :    SET : HxcVcFetchStatus : "Save API Settings (Ctrl+A) before fetching a template."
    05 :    Msg Box : "Helixcer Template" : ##HxcVcFetchStatus
    06 :    RETURN : No
    07 : END IF
    ;; Always take template/lang from Company Storage draft UDFs
    08 : SET : HxcVcFetchName : $HxcVcDraftTemplate
    09 : IF : $$IsEmpty:##HxcVcFetchName
    10 :    SET : HxcVcFetchName : $HxcVcDraftTemplate:Company:##SVCurrentCompany
    11 : END IF
    12 : SET : HxcVcFetchLang : $HxcVcDraftLang
    13 : IF : $$IsEmpty:##HxcVcFetchLang
    14 :    SET : HxcVcFetchLang : $HxcVcDraftLang:Company:##SVCurrentCompany
    15 : END IF
    16 : IF : $$IsEmpty:##HxcVcFetchLang
    17 :    SET : HxcVcFetchLang : "en"
    18 : END IF
    19 : IF : $$IsEmpty:##HxcVcFetchName
    20 :    SET : HxcVcFetchStatus : "Enter Template Name first."
    21 :    Msg Box : "Helixcer Template" : ##HxcVcFetchStatus
    22 :    RETURN : No
    23 : END IF
    24 : SET : HxcVcFetchStatus : "Fetching..."
    25 : Start Progress : 1 : "Helixcer Chat" : "Template" : "Fetching template details"
    26 : HTTP Request : @@HxcTemplateUrl : GET : JSON : UTF8 : Hxc Connection Request : Hxc Apply Template Response
    27 : End Progress
    28 : IF : NOT ##HxcVcFetched
    29 :    IF : $$IsEmpty:##HxcVcFetchStatus OR ##HxcVcFetchStatus = "Fetching..."
    30 :       SET : HxcVcFetchStatus : "Could not fetch [" + ##HxcVcFetchName + "]. Open Helixcer Chat → Status. If Connected, check the template name on this channel."
    31 :    END IF
    32 :    Msg Box : "Helixcer Template" : ##HxcVcFetchStatus
    33 :    RETURN : No
    34 : END IF
    ;; Fresh Create: never carry prior voucher-type rows into the new config
    341 : CALL : Hxc Clear Draft Vchs
    342 : CALL : Hxc Seed Draft Vch Row
    343 : SET : HxcVcDraftAuto : No
    344 : SET : HxcVcDraftConfirm : No
    345 : SET : HxcVcAutoSendEnabled : No
    35 : SET : HxcVcDMFld1 : ""
    35 : SET : HxcVcDMFld2 : ""
    36 : SET : HxcVcDMFld3 : ""
    37 : SET : HxcVcDMFld4 : ""
    38 : SET : HxcVcDMFld5 : ""
    39 : SET : HxcVcDMFld6 : ""
    40 : SET : HxcVcDMFld7 : ""
    41 : SET : HxcVcDMFld8 : ""
    42 : SET : HxcVcDMFld9 : ""
    43 : SET : HxcVcDMFld10 : ""
    44 : SET : HxcVcDMFld11 : ""
    45 : SET : HxcVcDMFld12 : ""
    46 : SET : HxcVcDMFld13 : ""
    47 : SET : HxcVcDMFld14 : ""
    48 : SET : HxcVcDMFld15 : ""
    49 : SET : HxcVcDMFld16 : ""
    50 : SET : HxcVcDraftHeaderFld : ""
    501 : SET : HxcVcDraftCustom0 : ""
    502 : SET : HxcVcDraftCustom1 : ""
    503 : SET : HxcVcDraftCustom2 : ""
    504 : SET : HxcVcDraftCustom3 : ""
    505 : SET : HxcVcDraftCustom4 : ""
    506 : SET : HxcVcDraftCustom5 : ""
    507 : SET : HxcVcDraftCustom6 : ""
    508 : SET : HxcVcDraftCustom7 : ""
    509 : SET : HxcVcDraftCustom8 : ""
    511 : SET : HxcVcButtonField1 : ""
    512 : SET : HxcVcButtonCustom1 : ""
    513 : SET : HxcVcButtonField2 : ""
    514 : SET : HxcVcButtonCustom2 : ""
    515 : SET : HxcVcButtonField3 : ""
    516 : SET : HxcVcButtonCustom3 : ""
    517 : SET : HxcVcButtonField4 : ""
    518 : SET : HxcVcButtonCustom4 : ""
    51 : IF : ##HxcVcHeaderKind = "media"
    52 :    IF : $$IsEmpty:##HxcVcDraftMedia OR ##HxcVcDraftMedia = "None"
    53 :       SET : HxcVcDraftMedia : "Voucher PDF"
    54 :    END IF
    55 : ELSE
    56 :    SET : HxcVcDraftMedia : "None"
    57 : END IF
    571 : CALL : Hxc Restore Custom Mappings
    58 : SET : HxcVcMoveToMapping : Yes
    59 : RETURN : Yes

;; ---------------------------------------------------------------------------
;; Pack helpers + commit draft → Aggregate config
;; ---------------------------------------------------------------------------

[Function: Hxc Pack Maps]
    Variable : S : String
    01 : SET : S : ""
    02 : IF : ##HxcVcHeaderKind = "text" AND NOT $$IsEmpty:##HxcVcHeaderKey
    03 :    SET : S : ##S + "header:" + ##HxcVcHeaderKey + "=" + ##HxcVcDraftHeaderFld + ";"
    04 : END IF
    05 : IF : NOT $$IsEmpty:##HxcVcFK1
    06 :    SET : S : ##S + ##HxcVcFC1 + ":" + ##HxcVcFK1 + "=" + @@HxcVcMappingField1 + ";"
    07 : END IF
    08 : IF : NOT $$IsEmpty:##HxcVcFK2
    09 :    SET : S : ##S + ##HxcVcFC2 + ":" + ##HxcVcFK2 + "=" + @@HxcVcMappingField2 + ";"
    10 : END IF
    11 : IF : NOT $$IsEmpty:##HxcVcFK3
    12 :    SET : S : ##S + ##HxcVcFC3 + ":" + ##HxcVcFK3 + "=" + @@HxcVcMappingField3 + ";"
    13 : END IF
    14 : IF : NOT $$IsEmpty:##HxcVcFK4
    15 :    SET : S : ##S + ##HxcVcFC4 + ":" + ##HxcVcFK4 + "=" + @@HxcVcMappingField4 + ";"
    16 : END IF
    17 : IF : NOT $$IsEmpty:##HxcVcFK5
    18 :    SET : S : ##S + ##HxcVcFC5 + ":" + ##HxcVcFK5 + "=" + ##HxcVcDMFld5 + ";"
    19 : END IF
    20 : IF : NOT $$IsEmpty:##HxcVcFK6
    21 :    SET : S : ##S + ##HxcVcFC6 + ":" + ##HxcVcFK6 + "=" + ##HxcVcDMFld6 + ";"
    22 : END IF
    23 : IF : NOT $$IsEmpty:##HxcVcFK7
    24 :    SET : S : ##S + ##HxcVcFC7 + ":" + ##HxcVcFK7 + "=" + ##HxcVcDMFld7 + ";"
    25 : END IF
    26 : IF : NOT $$IsEmpty:##HxcVcFK8
    27 :    SET : S : ##S + ##HxcVcFC8 + ":" + ##HxcVcFK8 + "=" + ##HxcVcDMFld8 + ";"
    28 : END IF
    29 : IF : NOT $$IsEmpty:##HxcVcFK9
    30 :    SET : S : ##S + ##HxcVcFC9 + ":" + ##HxcVcFK9 + "=" + ##HxcVcDMFld9 + ";"
    31 : END IF
    32 : IF : NOT $$IsEmpty:##HxcVcFK10
    33 :    SET : S : ##S + ##HxcVcFC10 + ":" + ##HxcVcFK10 + "=" + ##HxcVcDMFld10 + ";"
    34 : END IF
    35 : IF : NOT $$IsEmpty:##HxcVcFK11
    36 :    SET : S : ##S + ##HxcVcFC11 + ":" + ##HxcVcFK11 + "=" + ##HxcVcDMFld11 + ";"
    37 : END IF
    38 : IF : NOT $$IsEmpty:##HxcVcFK12
    39 :    SET : S : ##S + ##HxcVcFC12 + ":" + ##HxcVcFK12 + "=" + ##HxcVcDMFld12 + ";"
    40 : END IF
    41 : IF : NOT $$IsEmpty:##HxcVcFK13
    42 :    SET : S : ##S + ##HxcVcFC13 + ":" + ##HxcVcFK13 + "=" + ##HxcVcDMFld13 + ";"
    43 : END IF
    44 : IF : NOT $$IsEmpty:##HxcVcFK14
    45 :    SET : S : ##S + ##HxcVcFC14 + ":" + ##HxcVcFK14 + "=" + ##HxcVcDMFld14 + ";"
    46 : END IF
    47 : IF : NOT $$IsEmpty:##HxcVcFK15
    48 :    SET : S : ##S + ##HxcVcFC15 + ":" + ##HxcVcFK15 + "=" + ##HxcVcDMFld15 + ";"
    49 : END IF
    50 : IF : NOT $$IsEmpty:##HxcVcFK16
    51 :    SET : S : ##S + ##HxcVcFC16 + ":" + ##HxcVcFK16 + "=" + ##HxcVcDMFld16 + ";"
    52 : END IF
    53 : RETURN : ##S
[Function: Hxc Pack Vouchers]
    Variable : S : String
    01 : SET : S : ""
    02 : IF : NOT $$IsEmpty:##HxcVcVchType1 AND NOT ##HxcVcVchType1 = "End of List" AND NOT ##HxcVcVchType1 = "Not Applicable"
    03 :    SET : S : ##S + ##HxcVcVchType1 + ","
    04 : END IF
    05 : IF : NOT $$IsEmpty:##HxcVcVchType2 AND NOT ##HxcVcVchType2 = "End of List" AND NOT ##HxcVcVchType2 = "Not Applicable"
    06 :    SET : S : ##S + ##HxcVcVchType2 + ","
    07 : END IF
    08 : IF : NOT $$IsEmpty:##HxcVcVchType3 AND NOT ##HxcVcVchType3 = "End of List" AND NOT ##HxcVcVchType3 = "Not Applicable"
    09 :    SET : S : ##S + ##HxcVcVchType3 + ","
    10 : END IF
    11 : IF : NOT $$IsEmpty:##HxcVcVchType4 AND NOT ##HxcVcVchType4 = "End of List" AND NOT ##HxcVcVchType4 = "Not Applicable"
    12 :    SET : S : ##S + ##HxcVcVchType4 + ","
    13 : END IF
    14 : IF : NOT $$IsEmpty:##HxcVcVchType5 AND NOT ##HxcVcVchType5 = "End of List" AND NOT ##HxcVcVchType5 = "Not Applicable"
    15 :    SET : S : ##S + ##HxcVcVchType5 + ","
    16 : END IF
    17 : IF : NOT $$IsEmpty:##HxcVcVchType6 AND NOT ##HxcVcVchType6 = "End of List" AND NOT ##HxcVcVchType6 = "Not Applicable"
    18 :    SET : S : ##S + ##HxcVcVchType6 + ","
    19 : END IF
    20 : RETURN : ##S

[Function: Hxc Clear Draft Vchs]
    ;; Session voucher-type slots (Company aggregate clear never stuck on Create)
    01 : SET : HxcVcVchType1 : ""
    02 : SET : HxcVcVchType2 : ""
    03 : SET : HxcVcVchType3 : ""
    04 : SET : HxcVcVchType4 : ""
    05 : SET : HxcVcVchType5 : ""
    06 : SET : HxcVcVchType6 : ""
    07 : RETURN : Yes

[Function: Hxc Seed Draft Vch Row]
    ;; No-op — slot 1 is the blank editable row
    01 : RETURN : Yes

[Function: Hxc Parse Types Into Draft]
    ;; Split saved CSV into session voucher-type slots
    Parameter : TypesCsv : String
    Variable  : Piece : String
    Variable  : Counter : Number
    Variable  : ExpLen : Number
    Variable  : Ch : String
    Variable  : Slot : Number
    01 : CALL : Hxc Clear Draft Vchs
    02 : SET : Piece : ""
    03 : SET : Counter : 0
    04 : SET : Slot : 1
    05 : SET : ExpLen : $$StringLength:##TypesCsv
    06 : WHILE : ##Counter < ##ExpLen
    07 :    SET : Ch : $$StringPart:##TypesCsv:##Counter:1
    08 :    IF : ##Ch = ","
    09 :       IF : NOT $$IsEmpty:##Piece AND ##Slot <= 6
    10 :          IF : ##Slot = 1
    11 :             SET : HxcVcVchType1 : ##Piece
    12 :          END IF
    13 :          IF : ##Slot = 2
    14 :             SET : HxcVcVchType2 : ##Piece
    15 :          END IF
    16 :          IF : ##Slot = 3
    17 :             SET : HxcVcVchType3 : ##Piece
    18 :          END IF
    19 :          IF : ##Slot = 4
    20 :             SET : HxcVcVchType4 : ##Piece
    21 :          END IF
    22 :          IF : ##Slot = 5
    23 :             SET : HxcVcVchType5 : ##Piece
    24 :          END IF
    25 :          IF : ##Slot = 6
    26 :             SET : HxcVcVchType6 : ##Piece
    27 :          END IF
    28 :          SET : Slot : ##Slot + 1
    29 :       END IF
    30 :       SET : Piece : ""
    31 :    ELSE
    32 :       SET : Piece : ##Piece + ##Ch
    33 :    END IF
    34 :    SET : Counter : ##Counter + 1
    35 : END WHILE
    36 : IF : NOT $$IsEmpty:##Piece AND ##Slot <= 6
    37 :    IF : ##Slot = 1
    38 :       SET : HxcVcVchType1 : ##Piece
    39 :    END IF
    40 :    IF : ##Slot = 2
    41 :       SET : HxcVcVchType2 : ##Piece
    42 :    END IF
    43 :    IF : ##Slot = 3
    44 :       SET : HxcVcVchType3 : ##Piece
    45 :    END IF
    46 :    IF : ##Slot = 4
    47 :       SET : HxcVcVchType4 : ##Piece
    48 :    END IF
    49 :    IF : ##Slot = 5
    50 :       SET : HxcVcVchType5 : ##Piece
    51 :    END IF
    52 :    IF : ##Slot = 6
    53 :       SET : HxcVcVchType6 : ##Piece
    54 :    END IF
    55 : END IF
    56 : RETURN : Yes

[Function: Hxc Initialize New Config]
    ;; Clear Company draft Storage + force blank paint via CreateBlank.
    01 : SET : HxcVcCreateNeedsReset : No
    02 : SET : HxcVcMoveToMapping : No
    03 : SET : HxcVcMoveToConfirm : No
    04 : SET : HxcVcAutoSendEnabled : No
    05 : SET : HxcVcFetched : No
    06 : CALL : Hxc Vc Clear Draft
    07 : SET : HxcVcCreateBlank : Yes
    08 : RETURN : Yes

[Function: Hxc Release Create Blank]
    ;; Storage may still hold prior values in field buffers; wipe again then allow typing.
    01 : SET VALUE : HxcVcDraftName : ""
    02 : SET VALUE : HxcVcDraftTemplate : ""
    03 : SET VALUE : HxcVcDraftLang : "en"
    04 : CALL : Hxc Clear Draft Vchs
    05 : CALL : Hxc Seed Draft Vch Row
    06 : SET : HxcVcDraftAuto : No
    07 : SET : HxcVcDraftConfirm : No
    08 : SET : HxcVcAutoSendEnabled : No
    09 : SET : HxcVcCreateBlank : No
    10 : RETURN : Yes

[Function: Hxc Vc Clear Draft]
    01 : CALL : Hxc Clear Fetch Vars
    02 : CALL : Hxc Clear Draft Vchs
    03 : CALL : Hxc Seed Draft Vch Row
    04 : SET VALUE : HxcVcDraftName : ""
    05 : SET VALUE : HxcVcDraftTemplate : ""
    06 : SET VALUE : HxcVcDraftLang : "en"
    07 : SET : HxcVcDraftMedia : "None"
    08 : SET : HxcVcDraftAuto : No
    081 : SET : HxcVcAutoSendEnabled : No
    082 : SET : HxcVcMoveToConfirm : No
    09 : SET : HxcVcDraftConfirm : No
    10 : SET : HxcVcDraftEditKey : ""
    11 : SET : HxcVcDraftHeaderFld : ""
    12 : SET : HxcVcDMFld1 : ""
    13 : SET : HxcVcDMFld2 : ""
    14 : SET : HxcVcDMFld3 : ""
    15 : SET : HxcVcDMFld4 : ""
    16 : SET : HxcVcDMFld5 : ""
    17 : SET : HxcVcDMFld6 : ""
    18 : SET : HxcVcDMFld7 : ""
    19 : SET : HxcVcDMFld8 : ""
    20 : SET : HxcVcDMFld9 : ""
    21 : SET : HxcVcDMFld10 : ""
    22 : SET : HxcVcDMFld11 : ""
    23 : SET : HxcVcDMFld12 : ""
    24 : SET : HxcVcDMFld13 : ""
    25 : SET : HxcVcDMFld14 : ""
    26 : SET : HxcVcDMFld15 : ""
    27 : SET : HxcVcDMFld16 : ""
    30 : SET : HxcVcDraftCustom0 : ""
    31 : SET : HxcVcDraftCustom1 : ""
    32 : SET : HxcVcDraftCustom2 : ""
    33 : SET : HxcVcDraftCustom3 : ""
    34 : SET : HxcVcDraftCustom4 : ""
    35 : SET : HxcVcDraftCustom5 : ""
    36 : SET : HxcVcDraftCustom6 : ""
    37 : SET : HxcVcDraftCustom7 : ""
    38 : SET : HxcVcDraftCustom8 : ""
    39 : SET : HxcVcButtonField1 : ""
    40 : SET : HxcVcButtonCustom1 : ""
    41 : SET : HxcVcButtonField2 : ""
    42 : SET : HxcVcButtonCustom2 : ""
    43 : SET : HxcVcButtonField3 : ""
    44 : SET : HxcVcButtonCustom3 : ""
    45 : SET : HxcVcButtonField4 : ""
    46 : SET : HxcVcButtonCustom4 : ""
    47 : RETURN : Yes


[Function: Hxc Vc Commit Draft]
    Variable : Maps : String
    Variable : Vchs : String
    Variable : EditKey : String
    01 : SET : HxcVcSaveOk : No
    02 : IF : $$IsEmpty:$HxcVcDraftName
    03 :    Msg Box : "Helixcer Voucher Config" : "Config Name is required."
    04 :    RETURN : No
    05 : END IF
    06 : IF : $$IsEmpty:$HxcVcDraftTemplate
    07 :    Msg Box : "Helixcer Voucher Config" : "Template Name is required."
    08 :    RETURN : No
    09 : END IF
    10 : IF : NOT ##HxcVcFetched
    11 :    Msg Box : "Helixcer Voucher Config" : "Fetch the template first (Enter on Language)."
    12 :    RETURN : No
    13 : END IF
    131 : IF : @@HxcVcMissingCustomValue
    132 :    Msg Box : "Helixcer Voucher Config" : "Enter a value for each variable mapped to Custom Value."
    133 :    RETURN : No
    134 : END IF
    14 : SET : Maps : $$HxcPackMaps
    15 : SET : Vchs : $$HxcPackVouchers
    16 : SET : EditKey : ##HxcVcDraftEditKey
    17 : IF : NOT $$IsEmpty:##EditKey
    18 :    WALK COLLECTION : HxcVoucherConfigs
    19 :       IF : $HxcVcName = ##EditKey
    20 :          SET TARGET
    21 :          SET VALUE : HxcVcName : $HxcVcDraftName
    22 :          SET VALUE : HxcVcTemplateName : $HxcVcDraftTemplate
    23 :          SET VALUE : HxcVcLanguage : $HxcVcDraftLang
    24 :          SET VALUE : HxcVcMediaExport : ##HxcVcDraftMedia
    25 :          SET VALUE : HxcVcAutoSend : ##HxcVcDraftAuto
    26 :          SET VALUE : HxcVcConfirmBeforeSend : ##HxcVcDraftConfirm
    27 :          SET VALUE : HxcVcVarMapsText : ##Maps
    271 :          SET VALUE : HxcVcCustom0 : If (##HxcVcDraftHeaderFld = @@HxcCustomValueLabel AND (##HxcVcHeaderKind = "text" AND NOT $$IsEmpty:##HxcVcHeaderKey)) THEN ##HxcVcDraftCustom0 ELSE ""
    272 :          SET VALUE : HxcVcCustom1 : If (@@HxcVcMappingField1 = @@HxcCustomValueLabel AND (NOT $$IsEmpty:##HxcVcFK1 AND (##HxcVcFC1 = "body" OR ##HxcVcFC1 = "button"))) THEN @@HxcVcMappingCustom1 ELSE ""
    273 :          SET VALUE : HxcVcCustom2 : If (@@HxcVcMappingField2 = @@HxcCustomValueLabel AND (NOT $$IsEmpty:##HxcVcFK2 AND (##HxcVcFC2 = "body" OR ##HxcVcFC2 = "button"))) THEN @@HxcVcMappingCustom2 ELSE ""
    274 :          SET VALUE : HxcVcCustom3 : If (@@HxcVcMappingField3 = @@HxcCustomValueLabel AND (NOT $$IsEmpty:##HxcVcFK3 AND (##HxcVcFC3 = "body" OR ##HxcVcFC3 = "button"))) THEN @@HxcVcMappingCustom3 ELSE ""
    275 :          SET VALUE : HxcVcCustom4 : If (@@HxcVcMappingField4 = @@HxcCustomValueLabel AND (NOT $$IsEmpty:##HxcVcFK4 AND (##HxcVcFC4 = "body" OR ##HxcVcFC4 = "button"))) THEN @@HxcVcMappingCustom4 ELSE ""
    276 :          SET VALUE : HxcVcCustom5 : If (##HxcVcDMFld5 = @@HxcCustomValueLabel AND (NOT $$IsEmpty:##HxcVcFK5 AND (##HxcVcFC5 = "body"))) THEN ##HxcVcDraftCustom5 ELSE ""
    277 :          SET VALUE : HxcVcCustom6 : If (##HxcVcDMFld6 = @@HxcCustomValueLabel AND (NOT $$IsEmpty:##HxcVcFK6 AND (##HxcVcFC6 = "body"))) THEN ##HxcVcDraftCustom6 ELSE ""
    278 :          SET VALUE : HxcVcCustom7 : If (##HxcVcDMFld7 = @@HxcCustomValueLabel AND (NOT $$IsEmpty:##HxcVcFK7 AND (##HxcVcFC7 = "body"))) THEN ##HxcVcDraftCustom7 ELSE ""
    279 :          SET VALUE : HxcVcCustom8 : If (##HxcVcDMFld8 = @@HxcCustomValueLabel AND (NOT $$IsEmpty:##HxcVcFK8 AND (##HxcVcFC8 = "body"))) THEN ##HxcVcDraftCustom8 ELSE ""
    28 :          SET VALUE : HxcVcVoucherTypes : ##Vchs
    29 :          SET TARGET : ..
    30 :       END IF
    31 :    END WALK
    32 : ELSE
    33 :    INSERT COLLECTION OBJECT : HxcVoucherConfigs
    34 :    SET VALUE : HxcVcName : $HxcVcDraftName
    35 :    SET VALUE : HxcVcTemplateName : $HxcVcDraftTemplate
    36 :    SET VALUE : HxcVcLanguage : $HxcVcDraftLang
    37 :    SET VALUE : HxcVcMediaExport : ##HxcVcDraftMedia
    38 :    SET VALUE : HxcVcAutoSend : ##HxcVcDraftAuto
    39 :    SET VALUE : HxcVcConfirmBeforeSend : ##HxcVcDraftConfirm
    40 :    SET VALUE : HxcVcVarMapsText : ##Maps
    401 :    SET VALUE : HxcVcCustom0 : If (##HxcVcDraftHeaderFld = @@HxcCustomValueLabel AND (##HxcVcHeaderKind = "text" AND NOT $$IsEmpty:##HxcVcHeaderKey)) THEN ##HxcVcDraftCustom0 ELSE ""
    402 :    SET VALUE : HxcVcCustom1 : If (@@HxcVcMappingField1 = @@HxcCustomValueLabel AND (NOT $$IsEmpty:##HxcVcFK1 AND (##HxcVcFC1 = "body" OR ##HxcVcFC1 = "button"))) THEN @@HxcVcMappingCustom1 ELSE ""
    403 :    SET VALUE : HxcVcCustom2 : If (@@HxcVcMappingField2 = @@HxcCustomValueLabel AND (NOT $$IsEmpty:##HxcVcFK2 AND (##HxcVcFC2 = "body" OR ##HxcVcFC2 = "button"))) THEN @@HxcVcMappingCustom2 ELSE ""
    404 :    SET VALUE : HxcVcCustom3 : If (@@HxcVcMappingField3 = @@HxcCustomValueLabel AND (NOT $$IsEmpty:##HxcVcFK3 AND (##HxcVcFC3 = "body" OR ##HxcVcFC3 = "button"))) THEN @@HxcVcMappingCustom3 ELSE ""
    405 :    SET VALUE : HxcVcCustom4 : If (@@HxcVcMappingField4 = @@HxcCustomValueLabel AND (NOT $$IsEmpty:##HxcVcFK4 AND (##HxcVcFC4 = "body" OR ##HxcVcFC4 = "button"))) THEN @@HxcVcMappingCustom4 ELSE ""
    406 :    SET VALUE : HxcVcCustom5 : If (##HxcVcDMFld5 = @@HxcCustomValueLabel AND (NOT $$IsEmpty:##HxcVcFK5 AND (##HxcVcFC5 = "body"))) THEN ##HxcVcDraftCustom5 ELSE ""
    407 :    SET VALUE : HxcVcCustom6 : If (##HxcVcDMFld6 = @@HxcCustomValueLabel AND (NOT $$IsEmpty:##HxcVcFK6 AND (##HxcVcFC6 = "body"))) THEN ##HxcVcDraftCustom6 ELSE ""
    408 :    SET VALUE : HxcVcCustom7 : If (##HxcVcDMFld7 = @@HxcCustomValueLabel AND (NOT $$IsEmpty:##HxcVcFK7 AND (##HxcVcFC7 = "body"))) THEN ##HxcVcDraftCustom7 ELSE ""
    409 :    SET VALUE : HxcVcCustom8 : If (##HxcVcDMFld8 = @@HxcCustomValueLabel AND (NOT $$IsEmpty:##HxcVcFK8 AND (##HxcVcFC8 = "body"))) THEN ##HxcVcDraftCustom8 ELSE ""
    41 :    SET VALUE : HxcVcVoucherTypes : ##Vchs
    42 :    SET TARGET : ..
    43 : END IF
    44 : CALL : Hxc Vc Clear Draft
    45 : SET : HxcVcSaveOk : Yes
    46 : Msg Box : "Helixcer Voucher Config" : "Config saved."
    47 : RETURN : Yes

;; ---------------------------------------------------------------------------
;; Menu
;; ---------------------------------------------------------------------------

[#Menu: Gateway of Tally]
    Add : Key Item : Before : @@LOCQuit : Helixcer Chat : H : Menu : Helixcer Chat Menu

[Menu: Helixcer Chat Menu]
    Title    : "Helixcer Chat"
    Key Item : API Settings   : S : Alter : Helixcer API Settings
    Key Item : Voucher Config : V : Menu  : Helixcer Voucher Config Menu
    Key Item : Status         : T : Call  : Hxc Show Status
    Key Item : About          : A : Display : Helixcer Chat About
    Key Item : Back           : B : Menu  : Gateway of Tally

[Menu: Helixcer Voucher Config Menu]
    Title    : "Voucher Config"
    Key Item : Create Config : C : Alter : Helixcer Voucher Config Create
    Key Item : Alter Config  : A : Alter : Helixcer Voucher Config Alter
    Key Item : List Configs  : L : Alter : Helixcer Voucher Config List
    Key Item : Back          : B : Menu  : Helixcer Chat Menu

;; ---------------------------------------------------------------------------
;; API Settings
;; ---------------------------------------------------------------------------

[Report: Helixcer API Settings]
    Form   : Helixcer API Settings
    Title  : "API Settings"
    Object : Company

[Form: Helixcer API Settings]
    Part   : Helixcer API Settings
    Button : Form Accept, Form Cancel

[Part: Helixcer API Settings]
    Lines  : Hxc Api Settings Title, +
             Hxc Workspace Id Line, Hxc Channel Id Line, Hxc Api Key Line, +
             Hxc Save Hint Line
    Scroll : Vertical

[Line: Hxc Api Settings Title]
    Field : Hxc Api Settings Title

[Field: Hxc Api Settings Title]
    Use       : Name Field
    Set as    : "Helixcer Chat — API Settings (build 397)"
    Style     : Bold
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

[Line: Hxc Workspace Id Line]
    Fields : Medium Prompt, HxcWorkspaceIdFld
    Local  : Field : Medium Prompt : Set as : "Workspace ID"
    Local  : Field : Medium Prompt : Width  : 22

[Field: HxcWorkspaceIdFld]
    Use      : Name Field
    Storage  : HxcWorkspaceIdUDF
    Set as   : $HxcWorkspaceIdUDF
    Width    : 50
    Max      : 64
    On       : Accept : Yes : SET : HxcSysWorkspaceId : $Value
    On       : Accept : Yes : Field Accept

[Line: Hxc Channel Id Line]
    Fields : Medium Prompt, HxcChannelIdFld
    Local  : Field : Medium Prompt : Set as : "Channel ID"
    Local  : Field : Medium Prompt : Width  : 22

[Field: HxcChannelIdFld]
    Use      : Name Field
    Storage  : HxcChannelIdUDF
    Set as   : $HxcChannelIdUDF
    Width    : 50
    Max      : 64
    On       : Accept : Yes : SET : HxcSysChannelId : $Value
    On       : Accept : Yes : Field Accept

[Line: Hxc Api Key Line]
    Fields : Medium Prompt, HxcApiKeyFld
    Local  : Field : Medium Prompt : Set as : "API Key"
    Local  : Field : Medium Prompt : Width  : 22

[Field: HxcApiKeyFld]
    Use      : Name Field
    Storage  : HxcApiKeyUDF
    Set as   : $HxcApiKeyUDF
    Width    : 50
    Max      : 200
    On       : Accept : Yes : SET : HxcSysApiKey : $Value
    On       : Accept : Yes : Field Accept

[Line: Hxc Save Hint Line]
    Field : Hxc Save Hint

[Field: Hxc Save Hint]
    Use       : Name Field
    Set as    : "Tab all fields, then Ctrl+A to Accept."
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

;; ---------------------------------------------------------------------------
;; Shared Create/Alter form body — layout only (functions unchanged)
;; Sections: Template | Mapping+Preview (side-by-side) | Voucher Rules | Settings
;; ---------------------------------------------------------------------------

;; Template card
[Part: Hxc Vc Form Template Part]
    On : Focus : ##HxcVcCreateNeedsReset : CALL : Hxc Initialize New Config
    Lines  : Hxc Vc F Template Sect, +
             Hxc Vc F Name Line, Hxc Vc F Template Line, Hxc Vc F Lang Line, +
             Hxc Vc F Fetch Status Line

;; Mapping (left) + Message Preview (right) — single-line preview
;; Mapping LEFT + Preview RIGHT (no Height on Mid Row — Height/% broke Horizontal)
[Part: Hxc Vc Form Mid Row]
    Parts      : Hxc Vc Form Left Col, Hxc Vc Form Preview Part
    Horizontal : Yes

[Part: Hxc Vc Form Left Col]
    Lines  : Hxc Vc F Map Sect, +
             Hxc Vc F Hdr Media Line, Hxc Vc F Hdr Col Head, Hxc Vc F Hdr Text Line, +
             Hxc Vc F Body Sect, Hxc Vc F Body Col Head, +
             Hxc Vc F Body1, +
             Hxc Vc F Body2, +
             Hxc Vc F Body3, +
             Hxc Vc F Body4, +
             Hxc Vc F Body5, +
             Hxc Vc F Body6, +
             Hxc Vc F Body7, +
             Hxc Vc F Body8, +
             Hxc Vc F Btn Sect, Hxc Vc F Btn Col Head, +
             Hxc Vc F Btn1, +
             Hxc Vc F Btn2, +
             Hxc Vc F Btn3, +
             Hxc Vc F Btn4
    Scroll : Vertical
    Width  : 55% Screen

[Part: Hxc Vc Form Preview Part]
    Lines  : Hxc Vc F Prev Head, Hxc Vc F Prev Body
    Width  : 45% Screen

;; Voucher Rules
[Part: Hxc Vc Form Vch Part]
    Lines    : Hxc Vc F Vch Sect, Hxc Vc F Vch Head, +
               Hxc Vc F Vch1, Hxc Vc F Vch2, Hxc Vc F Vch3, +
               Hxc Vc F Vch4, Hxc Vc F Vch5, Hxc Vc F Vch6
    Scroll   : Vertical

[Part: Hxc Vc Form Settings Part]
    Lines    : Hxc Vc F Auto Line, Hxc Vc F Confirm Line

;; --- Template fields ---

[Line: Hxc Vc F Template Sect]
    Field : Hxc Vc F Template Sect Fld

[Field: Hxc Vc F Template Sect Fld]
    Use       : Name Field
    Set as    : "Template"
    Style     : Bold
    Color     : Dark Green
    FullWidth : Yes
    Skip      : Yes

[Line: Hxc Vc F Name Line]
    Fields : Medium Prompt, Hxc Vc F Name
    Local  : Field : Medium Prompt : Set as : "Config Name"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc F Name]
    Skip     : ##HxcVcMoveToConfirm OR (##HxcVcFetched AND ##HxcVcMoveToMapping)
    Use      : Name Field
    Storage  : HxcVcDraftName
    Set as   : If ##HxcVcCreateBlank THEN "" ELSE $HxcVcDraftName
    Set Always : ##HxcVcCreateBlank
    Width    : 40
    Max      : 60
    On       : Focus : ##HxcVcCreateBlank : CALL : Hxc Release Create Blank

[Line: Hxc Vc F Template Line]
    Fields : Medium Prompt, Hxc Vc F Template
    Local  : Field : Medium Prompt : Set as : "Template Name"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc F Template]
    Skip     : ##HxcVcMoveToConfirm OR (##HxcVcFetched AND ##HxcVcMoveToMapping)
    Use      : Name Field
    Storage  : HxcVcDraftTemplate
    Set as   : If ##HxcVcCreateBlank THEN "" ELSE $HxcVcDraftTemplate
    Set Always : ##HxcVcCreateBlank
    Width    : 40
    Max      : 80
    ;; Storage updates on Accept; then copy into FetchName for the HTTP call
    On       : Accept : Yes : CALL : Hxc Clear Fetch Vars
    On       : Accept : Yes : SET : HxcVcFetchName : $HxcVcDraftTemplate
    On       : Accept : Yes : Field Accept

[Line: Hxc Vc F Lang Line]
    Fields : Medium Prompt, Hxc Vc F Lang
    Local  : Field : Medium Prompt : Set as : "Language"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc F Lang]
    Skip     : ##HxcVcMoveToConfirm OR (##HxcVcFetched AND ##HxcVcMoveToMapping)
    Use      : Name Field
    Storage  : HxcVcDraftLang
    Set as   : If ##HxcVcCreateBlank THEN "en" ELSE If $$IsEmpty:$HxcVcDraftLang THEN "en" ELSE $HxcVcDraftLang
    Set Always : ##HxcVcCreateBlank
    Width    : 16
    Max      : 16
    On       : Accept : Yes : SET : HxcVcFetchLang : $Value
    On       : Accept : Yes : SET : HxcVcFetchName : $HxcVcDraftTemplate
    On       : Accept : Yes : CALL : Hxc Fetch Template
    On       : Accept : ##HxcVcFetched : Field Accept

[Line: Hxc Vc F Fetch Status Line]
    Field : Hxc Vc F Fetch Status

[Field: Hxc Vc F Fetch Status]
    Use        : Name Field
    Set as     : If NOT ##HxcVcFetched THEN "Enter Language, then Fetch Template (Enter / Alt+F)" ELSE If $$IsEmpty:##HxcVcFetchStatus THEN "Template loaded." ELSE ##HxcVcFetchStatus
    Set Always : Yes
    Color      : Dark Green
    FullWidth  : Yes
    Skip       : Yes

;; --- Mapping + header ---

[Line: Hxc Vc F Map Sect]
    Field : Hxc Vc F Map Sect Fld

[Field: Hxc Vc F Map Sect Fld]
    Use       : Name Field
    Set as    : "Variable Mapping"
    Style     : Bold
    Color     : Dark Green
    FullWidth : Yes
    Skip      : Yes
    Inactive  : NOT ##HxcVcFetched

[Line: Hxc Vc F Hdr Media Line]
    Fields : Medium Prompt, Hxc Vc F Media
    Local  : Field : Medium Prompt : Set as : "Media Header"
    Local  : Field : Medium Prompt : Width  : 22
    Local  : Field : Medium Prompt : Inactive : NOT ##HxcVcFetched OR NOT ##HxcVcHeaderKind = "media"

[Field: Hxc Vc F Media]
    Skip : ##HxcVcMoveToConfirm
    Use        : Name Field
    Variable    : HxcVcDraftMedia
    Set as     : If $$IsEmpty:##HxcVcDraftMedia THEN "None" ELSE ##HxcVcDraftMedia
    Table      : Hxc Media Export List
    Show Table : Always
    Width      : 40
    Max        : 40
    Inactive   : NOT ##HxcVcFetched OR NOT ##HxcVcHeaderKind = "media"
    On : Accept : ##HxcVcMoveToMapping : SET : HxcVcMoveToMapping : No
    On : Accept : Yes : Field Accept

[Line: Hxc Vc F Hdr Col Head]
    Invisible : NOT ##HxcVcFetched OR NOT ##HxcVcHeaderKind = "text"
    Fields    : Hxc Vc F Hdr Col Key, Hxc Vc F Hdr Col Fld

[Field: Hxc Vc F Hdr Col Key]
    Use    : Name Field
    Set as : "Header variable"
    Style  : Bold
    Color  : Dark Green
    Skip   : Yes
    Width  : 28

[Field: Hxc Vc F Hdr Col Fld]
    Use    : Name Field
    Set as : "Voucher field"
    Style  : Bold
    Color  : Dark Green
    Skip   : Yes
    Width  : 28

[Line: Hxc Vc F Hdr Text Line]
    Invisible : NOT ##HxcVcFetched OR NOT ##HxcVcHeaderKind = "text"
    Fields    : Hxc Vc F Hdr MK, HxcVcHdrMapping, HxcVcHdrCustomInput

[Field: Hxc Vc F Hdr MK]
    Use        : Name Field
    Set as     : If $$IsEmpty:##HxcVcHeaderKey THEN "" ELSE ("{{" + ##HxcVcHeaderKey + "}}")
    Set Always : Yes
    Skip       : Yes
    Width      : 28
    Inactive   : NOT ##HxcVcFetched OR NOT ##HxcVcHeaderKind = "text"

[Field: HxcVcHdrMapping]
    Use        : Name Field
    Variable    : HxcVcDraftHeaderFld
    Set as     : ##HxcVcDraftHeaderFld
    Table      : Hxc Voucher Field List, Not Applicable
    Show Table : Always
    Width      : 28
    Max        : 40
    Inactive   : NOT ##HxcVcFetched OR NOT ##HxcVcHeaderKind = "text"
    On         : Accept : Yes : SET : HxcVcDraftHeaderFld : $Value
    On         : Accept : ##HxcVcMoveToMapping : SET : HxcVcMoveToMapping : No
    On         : Accept : Yes : Field Accept
    Skip : ##HxcVcMoveToConfirm

[Line: Hxc Vc F Body Sect]
    Field : Hxc Vc F Body Sect Fld

[Field: Hxc Vc F Body Sect Fld]
    Use       : Name Field
    Set as    : ""
    Style     : Bold
    Color     : Dark Green
    FullWidth : Yes
    Skip      : Yes
    Inactive  : NOT ##HxcVcFetched OR NOT ##HxcVcHasBodyMaps

[Line: Hxc Vc F Body Col Head]
    Fields : Hxc Vc F Body Col Key, Hxc Vc F Body Col Fld

[Field: Hxc Vc F Body Col Key]
    Use       : Name Field
    Set as    : "Body variable"
    Style     : Bold
    Color     : Dark Green
    Skip      : Yes
    Width     : 28
    Inactive  : NOT ##HxcVcFetched OR NOT ##HxcVcHasBodyMaps

[Field: Hxc Vc F Body Col Fld]
    Use       : Name Field
    Set as    : "Voucher field"
    Style     : Bold
    Color     : Dark Green
    Skip      : Yes
    Width     : 28
    Inactive  : NOT ##HxcVcFetched OR NOT ##HxcVcHasBodyMaps

[Line: Hxc Vc F Body1]
    Invisible : NOT ##HxcVcFetched OR $$IsEmpty:##HxcVcFK1 OR NOT ##HxcVcFC1 = "body"
    Fields : Hxc Vc F Body1 MK, HxcVcBody1Mapping, HxcVcBody1CustomInput

[Field: Hxc Vc F Body1 MK]
    Use        : Name Field
    Set as     : "{{" + ##HxcVcFK1 + "}}"
    Set Always : Yes
    Skip       : Yes
    Width      : 28
    Inactive   : NOT ##HxcVcFetched OR $$IsEmpty:##HxcVcFK1 OR NOT ##HxcVcFC1 = "body"

[Field: HxcVcBody1Mapping]
    Use        : Name Field
    Variable    : HxcVcDMFld1
    Set as     : ##HxcVcDMFld1
    Table      : Hxc Voucher Field List, Not Applicable
    Show Table : Always
    Width      : 28
    Max        : 40
    Color      : Black
    Inactive   : NOT ##HxcVcFetched OR $$IsEmpty:##HxcVcFK1 OR NOT ##HxcVcFC1 = "body"
    On         : Accept : Yes : SET : HxcVcDMFld1 : $Value
    On         : Accept : ##HxcVcMoveToMapping : SET : HxcVcMoveToMapping : No
    On         : Accept : Yes : Field Accept
    Skip : ##HxcVcMoveToConfirm

[Line: Hxc Vc F Body2]
    Invisible : NOT ##HxcVcFetched OR $$IsEmpty:##HxcVcFK2 OR NOT ##HxcVcFC2 = "body"
    Fields : Hxc Vc F Body2 MK, HxcVcBody2Mapping, HxcVcBody2CustomInput

