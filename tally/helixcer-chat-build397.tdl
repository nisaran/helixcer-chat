    Set Always : Yes
    Skip       : Yes
    Width      : 28
    Inactive   : NOT ##HxcVcFetched OR $$IsEmpty:##HxcVcFK2 OR NOT ##HxcVcFC2 = "button"

[Field: HxcVcBtn2Mapping]
