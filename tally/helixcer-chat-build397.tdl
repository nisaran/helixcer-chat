;; Helixcer Chat — TallyPrime TDL
;; BUILD: 397-all-vch-slots-visible
;; Title must show "(build 397)".
;;
;; Create Config flow:
;;   Config Name → Template → Language Enter (fetch) →
;;   Preview → Header (only if template has header) → Body maps (dynamic count) →
;;   Voucher types → Settings → Ctrl+A

;; ---------------------------------------------------------------------------
;; Company UDFs
;; ---------------------------------------------------------------------------

[System: UDF]
    HxcWorkspaceIdUDF : String : 25101
    HxcChannelIdUDF   : String : 25102
    HxcApiKeyUDF      : String : 25103
    ;; Saved configs
    HxcVoucherConfigs      : Aggregate : 25110
    HxcVcName              : String    : 25111
    HxcVcTemplateName      : String    : 25112
    HxcVcLanguage          : String    : 25113
    HxcVcVoucherTypes      : String    : 25114
    HxcVcMediaExport       : String    : 25115
    HxcVcAutoSend          : Logical   : 25116
    HxcVcConfirmBeforeSend : Logical   : 25117
    HxcVcVarMapsText       : String    : 25118
    ;; Template header draft — must be Company Storage so Fetch sees typed value
    HxcVcDraftName     : String  : 25120
    HxcVcDraftTemplate : String  : 25121
    HxcVcDraftLang     : String  : 25122
    HxcVcCustom0 : String : 25210
    HxcVcCustom1 : String : 25211
    HxcVcCustom2 : String : 25212
    HxcVcCustom3 : String : 25213
    HxcVcCustom4 : String : 25214
    HxcVcCustom5 : String : 25215
    HxcVcCustom6 : String : 25216
    HxcVcCustom7 : String : 25217
    HxcVcCustom8 : String : 25218
    ;; Dynamic voucher-type picker (collection must stay on Company)
    HxcVcDraftVchs    : Aggregate : 25150
    HxcVcDraftVchName : String    : 25151

;; ---------------------------------------------------------------------------
;; Status mirrors + save flag
;; ---------------------------------------------------------------------------

