[System: Formula]
    Hxc Connection Url : "https://api.chat.helixcer.com/api/v1/connection?channelId=" + ##HxcSysChannelId
    Hxc Sys Summary    : "WS=[" + ##HxcSysWorkspaceId + "] CH=[" + ##HxcSysChannelId + "] KeyChars=" + $$StringLength:##HxcSysApiKey
    ;; Same pattern as working build 347 Status/HTTP, but template name in ## var
    Hxc Template Url   : "https://api.chat.helixcer.com/api/v1/whatsapp/templates/" + ##HxcVcFetchName + "?channelId=" + ##HxcSysChannelId + "&language=" + ##HxcVcFetchLang

;; ---------------------------------------------------------------------------
;; Tables
;; ---------------------------------------------------------------------------

[Collection: Hxc Media Export List]
    List : "None", "Voucher PDF", "Voucher HTML", "Voucher XML", "Voucher Excel"

[Collection: Hxc Voucher Type List]
    Type   : Voucher Type
    Format : $Name, 40

;; Dynamic voucher / party / company data labels for mapping (list only)
[Collection: Hxc Voucher Field List]
    Title  : "Voucher Dynamic Data"
    Table Sort : @@HxcVoucherMappingSort
    List : "♦ Custom Value", "Not Applicable", +
           "Party Ledger Name", "Party Name", "Party Mailing Name", "Party Address", +
           "Party Address 1", "Party Address 2", "Party Address 3", +
           "Party State Name", "Party Country", "Party Pincode", "Party GSTIN/UIN", +
           "Party Mobile", "Party Email", +
           "Buyer Name", "Consignee Name", +
           "Company Name", "Company Mailing Name", "Company GSTIN", "Company State Name", +
           "Voucher Number", "Voucher Date", "Reference", "Narration", "Amount", +
           "Basic Buyer Name", "Basic Buyer Address", "Basic Order Ref", "Basic Order Terms", +
           "Basic Ship Delivery Date", "Basic Due Date", "Basic Base Value", +
           "Sales Person", "Terms of Payment", "Terms of Delivery", "Dispatch Through", +
           "Destination", "Carrier Name", "Bill of Lading", "Eway Bill Number", "IRN", +
           "Guid", "Master ID"

[Collection: Hxc Voucher Config Names]
    Type     : HxcVoucherConfigs : Company
    Child Of : ##SVCurrentCompany
    Format   : $HxcVcName, 40
    Fetch    : HxcVcName, HxcVcTemplateName, HxcVcLanguage, HxcVcVoucherTypes, +
               HxcVcMediaExport, HxcVcAutoSend, HxcVcConfirmBeforeSend, HxcVcVarMapsText, +
               HxcVcCustom0, HxcVcCustom1, HxcVcCustom2, HxcVcCustom3, HxcVcCustom4, HxcVcCustom5, HxcVcCustom6, HxcVcCustom7, HxcVcCustom8
    Title    : "Voucher Configs"

;; ---------------------------------------------------------------------------
;; HTTP (Status)
;; ---------------------------------------------------------------------------

[Report: Hxc Connection Request]
    Form          : Hxc Connection Request
    Export Header : "Authorization: Bearer " + ##HxcSysApiKey
    Export Header : "X-Workspace-Id: " + ##HxcSysWorkspaceId
    Export Header : "Accept: application/json"

[Form: Hxc Connection Request]
    Part : Hxc Connection Request

[Part: Hxc Connection Request]
    Lines : Hxc Connection Request

[Line: Hxc Connection Request]
    Fields : Hxc Connection Request

[Field: Hxc Connection Request]
    Use    : Name Field
    Set as : ""
    Skip   : Yes

[Function: Hxc Apply Connection Response]
    Variable : Platform : String
    01 : SET : HxcWorkspaceName : ""
    02 : SET : HxcChannelName : ""
    03 : SET : HxcConnectionStatus : "Could not fetch. Check IDs and API Key."
    04 : WALK COLLECTION : Parameter Collection
    05 :    IF : NOT $$IsEmpty:$workspaceName
    06 :       SET : Platform : $platformLabel
    07 :       IF : $$IsEmpty:##Platform
    08 :          SET : Platform : $connectorType
    09 :       END IF
    10 :       IF : $$IsEmpty:##Platform
    11 :          SET : Platform : "Channel"
    12 :       END IF
    13 :       SET : HxcWorkspaceName : $workspaceName
    14 :       SET : HxcChannelName : $channelName + " (" + ##Platform + ")"
    15 :       SET : HxcConnectionStatus : "Connected"
    16 :    END IF
    17 : END WALK
    18 : RETURN : Yes

[Function: Hxc Sync From Company]
    01 : IF : NOT $$IsEmpty:$HxcWorkspaceIdUDF:Company:##SVCurrentCompany
    02 :    SET : HxcSysWorkspaceId : $HxcWorkspaceIdUDF:Company:##SVCurrentCompany
    03 : END IF
    04 : IF : NOT $$IsEmpty:$HxcChannelIdUDF:Company:##SVCurrentCompany
    05 :    SET : HxcSysChannelId : $HxcChannelIdUDF:Company:##SVCurrentCompany
    06 : END IF
    07 : IF : NOT $$IsEmpty:$HxcApiKeyUDF:Company:##SVCurrentCompany
    08 :    SET : HxcSysApiKey : $HxcApiKeyUDF:Company:##SVCurrentCompany
    09 : END IF
    10 : RETURN : Yes

[Function: Hxc Fetch Connection]
    01 : CALL : Hxc Sync From Company
    02 : IF : $$IsEmpty:##HxcSysWorkspaceId OR $$IsEmpty:##HxcSysChannelId OR $$IsEmpty:##HxcSysApiKey
    03 :    SET : HxcConnectionStatus : "Not ready. " + @@HxcSysSummary + "  Accept API Settings with Ctrl+A first."
    04 :    RETURN : No
    05 : END IF
    06 : SET : HxcWorkspaceName : ""
    07 : SET : HxcChannelName : ""
    08 : SET : HxcConnectionStatus : "Checking..."
    09 : Start Progress : 1 : "Helixcer Chat" : "Connection status" : "Fetching workspace and channel"
    10 : HTTP Request : @@HxcConnectionUrl : GET : JSON : UTF8 : Hxc Connection Request : Hxc Apply Connection Response
    11 : End Progress
    12 : IF : $$IsEmpty:##HxcWorkspaceName
    13 :    IF : ##HxcConnectionStatus = "Checking..."
    14 :       SET : HxcConnectionStatus : "Could not fetch. Check IDs and API Key."
    15 :    END IF
    16 : END IF
    17 : RETURN : Yes

[Function: Hxc Show Status]
    01 : CALL : Hxc Fetch Connection
    02 : Msg Box : "Helixcer Connection Status" : ##HxcConnectionStatus
    03 : IF : NOT $$IsEmpty:##HxcWorkspaceName
    04 :    Msg Box : "Workspace" : ##HxcWorkspaceName
    05 :    Msg Box : "Channel" : ##HxcChannelName
    06 : END IF
    07 : RETURN : Yes

[Function: Hxc Clear Fetch Vars]
    00 : SET : HxcVcMoveToMapping : No
    01 : SET : HxcVcFetched : No
    02 : SET : HxcVcPreviewText : ""
    03 : SET : HxcVcFetchStatus : ""
    04 : SET : HxcVcMapsCsv : ""
    05 : SET : HxcVcHasHeader : No
    06 : SET : HxcVcHeaderKind : ""
    07 : SET : HxcVcHeaderFormat : ""
    08 : SET : HxcVcHeaderKey : ""
    09 : SET : HxcVcHasBodyMaps : No
    10 : SET : HxcVcHasBtnMaps : No
    11 : SET : HxcVcFK1 : ""
    12 : SET : HxcVcFK2 : ""
    13 : SET : HxcVcFK3 : ""
    14 : SET : HxcVcFK4 : ""
    15 : SET : HxcVcFK5 : ""
    16 : SET : HxcVcFK6 : ""
    17 : SET : HxcVcFK7 : ""
    18 : SET : HxcVcFK8 : ""
    19 : SET : HxcVcFK9 : ""
    20 : SET : HxcVcFK10 : ""
    21 : SET : HxcVcFK11 : ""
    22 : SET : HxcVcFK12 : ""
    23 : SET : HxcVcFK13 : ""
    24 : SET : HxcVcFK14 : ""
    25 : SET : HxcVcFK15 : ""
    26 : SET : HxcVcFK16 : ""
    27 : SET : HxcVcFC1 : ""
    28 : SET : HxcVcFC2 : ""
    29 : SET : HxcVcFC3 : ""
    30 : SET : HxcVcFC4 : ""
    31 : SET : HxcVcFC5 : ""
    32 : SET : HxcVcFC6 : ""
    33 : SET : HxcVcFC7 : ""
    34 : SET : HxcVcFC8 : ""
    35 : SET : HxcVcFC9 : ""
    36 : SET : HxcVcFC10 : ""
    37 : SET : HxcVcFC11 : ""
    38 : SET : HxcVcFC12 : ""
    39 : SET : HxcVcFC13 : ""
    40 : SET : HxcVcFC14 : ""
    41 : SET : HxcVcFC15 : ""
    42 : SET : HxcVcFC16 : ""
    43 : RETURN : Yes

[Function: Hxc Set Map Slot]
    Parameter : Idx : Number
    Parameter : Key : String
    Parameter : Comp : String
    01 : IF : ##Idx = 1
    02 :    SET : HxcVcFK1 : ##Key
    03 :    SET : HxcVcFC1 : ##Comp
    04 : END IF
    05 : IF : ##Idx = 2
    06 :    SET : HxcVcFK2 : ##Key
    07 :    SET : HxcVcFC2 : ##Comp
    08 : END IF
    09 : IF : ##Idx = 3
    10 :    SET : HxcVcFK3 : ##Key
    11 :    SET : HxcVcFC3 : ##Comp
    12 : END IF
    13 : IF : ##Idx = 4
    14 :    SET : HxcVcFK4 : ##Key
    15 :    SET : HxcVcFC4 : ##Comp
    16 : END IF
    17 : IF : ##Idx = 5
    18 :    SET : HxcVcFK5 : ##Key
    19 :    SET : HxcVcFC5 : ##Comp
    20 : END IF
    21 : IF : ##Idx = 6
    22 :    SET : HxcVcFK6 : ##Key
    23 :    SET : HxcVcFC6 : ##Comp
    24 : END IF
    25 : IF : ##Idx = 7
    26 :    SET : HxcVcFK7 : ##Key
    27 :    SET : HxcVcFC7 : ##Comp
    28 : END IF
    29 : IF : ##Idx = 8
    30 :    SET : HxcVcFK8 : ##Key
    31 :    SET : HxcVcFC8 : ##Comp
    32 : END IF
    33 : IF : ##Idx = 9
    34 :    SET : HxcVcFK9 : ##Key
    35 :    SET : HxcVcFC9 : ##Comp
    36 : END IF
    37 : IF : ##Idx = 10
    38 :    SET : HxcVcFK10 : ##Key
    39 :    SET : HxcVcFC10 : ##Comp
    40 : END IF
    41 : IF : ##Idx = 11
    42 :    SET : HxcVcFK11 : ##Key
    43 :    SET : HxcVcFC11 : ##Comp
    44 : END IF
    45 : IF : ##Idx = 12
    46 :    SET : HxcVcFK12 : ##Key
    47 :    SET : HxcVcFC12 : ##Comp
    48 : END IF
    49 : IF : ##Idx = 13
    50 :    SET : HxcVcFK13 : ##Key
    51 :    SET : HxcVcFC13 : ##Comp
    52 : END IF
    53 : IF : ##Idx = 14
    54 :    SET : HxcVcFK14 : ##Key
    55 :    SET : HxcVcFC14 : ##Comp
    56 : END IF
    57 : IF : ##Idx = 15
    58 :    SET : HxcVcFK15 : ##Key
    59 :    SET : HxcVcFC15 : ##Comp
    60 : END IF
    61 : IF : ##Idx = 16
    62 :    SET : HxcVcFK16 : ##Key
    63 :    SET : HxcVcFC16 : ##Comp
    64 : END IF
    65 : IF : ##Comp = "body"
    66 :    SET : HxcVcHasBodyMaps : Yes
    67 : END IF
    68 : IF : ##Comp = "button"
    69 :    SET : HxcVcHasBtnMaps : Yes
    70 : END IF
    71 : RETURN : Yes

[Function: Hxc Write Slot Fld]
    Parameter : Slot : Number
    Parameter : Val : String
    01 : IF : ##Slot = 1
    02 :    SET : HxcVcDMFld1 : ##Val
    03 : END IF
    04 : IF : ##Slot = 2
    05 :    SET : HxcVcDMFld2 : ##Val
    06 : END IF
    07 : IF : ##Slot = 3
