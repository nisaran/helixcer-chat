    26 :    SET : HxcVcDMFld9 : ##Val
    27 : END IF
    28 : IF : ##Slot = 10
    29 :    SET : HxcVcDMFld10 : ##Val
    30 : END IF
    31 : IF : ##Slot = 11
    32 :    SET : HxcVcDMFld11 : ##Val
    33 : END IF
