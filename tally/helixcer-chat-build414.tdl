[Function: Hxc Clear Draft Vchs]
    ;; Session voucher-type slots — SET empties reliably (Company Aggregate DELETE did not)
    01 : SET : HxcVcVchType1 : ""
    02 : SET : HxcVcVchType2 : ""
    03 : SET : HxcVcVchType3 : ""
    04 : SET : HxcVcVchType4 : ""
    05 : SET : HxcVcVchType5 : ""
    06 : SET : HxcVcVchType6 : ""
    07 : SET : HxcVcVchType7 : ""
    08 : SET : HxcVcVchType8 : ""
    09 : SET : HxcVcVchType9 : ""
    10 : SET : HxcVcVchType10 : ""
    11 : SET : HxcVcVchType11 : ""
    12 : SET : HxcVcVchType12 : ""
    13 : RETURN : Yes

[Function: Hxc Seed Draft Vch Row]
    ;; No-op — progressive Variable slots; slot 1 is the blank editable row
    01 : RETURN : Yes

[Function: Hxc Ensure Trailing Vch Blank]
    ;; No-op — next slot appears via Invisible when previous is filled
    01 : RETURN : Yes

[Function: Hxc Parse Types Into Draft]
    ;; Split saved CSV into session voucher-type slots
    Parameter : TypesCsv : String
    Variable  : Piece : String
    Variable  : Counter : Number
    Variable  : ExpLen : Number
    Variable  : Ch : String
    Variable  : Slot : Number
    01 : CALL : Hxc Clear Draft Vchs
    02 : SET : Piece : ""
    03 : SET : Counter : 0
    04 : SET : Slot : 1
    05 : SET : ExpLen : $$StringLength:##TypesCsv
    06 : WHILE : ##Counter < ##ExpLen
    07 :    SET : Ch : $$StringPart:##TypesCsv:##Counter:1
    08 :    IF : ##Ch = ","
    09 :       IF : NOT $$IsEmpty:##Piece AND ##Slot <= 12
    10 :          IF : ##Slot = 1
    11 :             SET : HxcVcVchType1 : ##Piece
    12 :          END IF
    13 :          IF : ##Slot = 2
    14 :             SET : HxcVcVchType2 : ##Piece
    15 :          END IF
    16 :          IF : ##Slot = 3
    17 :             SET : HxcVcVchType3 : ##Piece
    18 :          END IF
    19 :          IF : ##Slot = 4
    20 :             SET : HxcVcVchType4 : ##Piece
    21 :          END IF
    22 :          IF : ##Slot = 5
    23 :             SET : HxcVcVchType5 : ##Piece
    24 :          END IF
    25 :          IF : ##Slot = 6
    26 :             SET : HxcVcVchType6 : ##Piece
    27 :          END IF
    28 :          IF : ##Slot = 7
    29 :             SET : HxcVcVchType7 : ##Piece
    30 :          END IF
    31 :          IF : ##Slot = 8
    32 :             SET : HxcVcVchType8 : ##Piece
    33 :          END IF
    34 :          IF : ##Slot = 9
    35 :             SET : HxcVcVchType9 : ##Piece
    36 :          END IF
    37 :          IF : ##Slot = 10
    38 :             SET : HxcVcVchType10 : ##Piece
    39 :          END IF
    40 :          IF : ##Slot = 11
    41 :             SET : HxcVcVchType11 : ##Piece
    42 :          END IF
    43 :          IF : ##Slot = 12
    44 :             SET : HxcVcVchType12 : ##Piece
    45 :          END IF
    46 :          SET : Slot : ##Slot + 1
    47 :       END IF
    48 :       SET : Piece : ""
    49 :    ELSE
    50 :       SET : Piece : ##Piece + ##Ch
    51 :    END IF
    52 :    SET : Counter : ##Counter + 1
    53 : END WHILE
    54 : IF : NOT $$IsEmpty:##Piece AND ##Slot <= 12
    55 :    IF : ##Slot = 1
    56 :       SET : HxcVcVchType1 : ##Piece
    57 :    END IF
    58 :    IF : ##Slot = 2
    59 :       SET : HxcVcVchType2 : ##Piece
    60 :    END IF
    61 :    IF : ##Slot = 3
    62 :       SET : HxcVcVchType3 : ##Piece
    63 :    END IF
    64 :    IF : ##Slot = 4
    65 :       SET : HxcVcVchType4 : ##Piece
    66 :    END IF
    67 :    IF : ##Slot = 5
    68 :       SET : HxcVcVchType5 : ##Piece
    69 :    END IF
    70 :    IF : ##Slot = 6
    71 :       SET : HxcVcVchType6 : ##Piece
    72 :    END IF
    73 :    IF : ##Slot = 7
    74 :       SET : HxcVcVchType7 : ##Piece
    75 :    END IF
    76 :    IF : ##Slot = 8
    77 :       SET : HxcVcVchType8 : ##Piece
    78 :    END IF
    79 :    IF : ##Slot = 9
    80 :       SET : HxcVcVchType9 : ##Piece
    81 :    END IF
    82 :    IF : ##Slot = 10
    83 :       SET : HxcVcVchType10 : ##Piece
    84 :    END IF
    85 :    IF : ##Slot = 11
    86 :       SET : HxcVcVchType11 : ##Piece
    87 :    END IF
    88 :    IF : ##Slot = 12
    89 :       SET : HxcVcVchType12 : ##Piece
    90 :    END IF
    91 : END IF
    92 : RETURN : Yes

[Function: Hxc Initialize New Config]
    ;; Clear Company draft Storage for a fresh Create form.
    01 : SET : HxcVcCreateNeedsReset : No
    02 : SET : HxcVcMoveToMapping : No
    03 : SET : HxcVcMoveToConfirm : No
    04 : SET : HxcVcAutoSendEnabled : No
    05 : SET : HxcVcFetched : No
    06 : SET : HxcVcCreateBlank : No
    07 : CALL : Hxc Vc Clear Draft
    08 : RETURN : Yes

[Function: Hxc Release Create Blank]
    ;; Legacy no-op — CreateBlank paint removed; session Variables are cleared directly
    01 : SET : HxcVcCreateBlank : No
    02 : RETURN : Yes

