;; Helixcer Chat — TallyPrime TDL
;; BUILD: 414-vt-scoped-config
;; Title must show "(build 414)".
;;
;; Config is scoped to a Voucher Type master (not Company Aggregate create/alter).
;; Gateway → Alter → Voucher Type → "Alter Helixcer Chat? Yes" opens the config form.
;; No Config Name / voucher-type allocation — the VT name is the key.
;; Persist = Voucher Type UDF Storage + default Form Accept (no INSERT COLLECTION).
;; Fetch uses ##HxcVcDraftTemplate after Modifies / $$Value sync from inputs.
;;
;; Flow:
;;   Alter Voucher Type → Alter Helixcer Chat Yes →
;;   Template → Language Enter (fetch) → Mapping → Settings → Ctrl+A

;; ---------------------------------------------------------------------------
;; Company + Voucher Type UDFs
;; ---------------------------------------------------------------------------

[System: UDF]
    HxcWorkspaceIdUDF : String : 25101
    HxcChannelIdUDF   : String : 25102
    HxcApiKeyUDF      : String : 25103
    ;; Legacy Company Aggregate (kept for older company files; UI no longer writes here)
    HxcVoucherConfigs      : Aggregate : 25110
    HxcVcName              : String    : 25111
    HxcVcTemplateName      : String    : 25112
    HxcVcLanguage          : String    : 25113
    HxcVcVoucherTypes      : String    : 25114
    HxcVcMediaExport       : String    : 25115
    HxcVcAutoSend          : Logical   : 25116
    HxcVcConfirmBeforeSend : Logical   : 25117
    HxcVcVarMapsText       : String    : 25118
    HxcVcDraftName     : String  : 25120
    HxcVcDraftTemplate : String  : 25121
    HxcVcDraftLang     : String  : 25122
    HxcVcCustom0 : String : 25210
    HxcVcCustom1 : String : 25211
    HxcVcCustom2 : String : 25212
    HxcVcCustom3 : String : 25213
    HxcVcCustom4 : String : 25214
    HxcVcCustom5 : String : 25215
    HxcVcCustom6 : String : 25216
    HxcVcCustom7 : String : 25217
    HxcVcCustom8 : String : 25218
    HxcVcDraftVchs    : Aggregate : 25150
    HxcVcDraftVchName : String    : 25151
    ;; Voucher Type–scoped Helixcer config (primary store for build 414+)
    HxcVtEnabled           : Logical : 25301
    HxcVtTemplateName      : String  : 25302
    HxcVtLanguage          : String  : 25303
    HxcVtMediaExport       : String  : 25304
    HxcVtAutoSend          : Logical : 25305
    HxcVtConfirmBeforeSend : Logical : 25306
    HxcVtVarMapsText       : String  : 25307
    HxcVtCustom0 : String : 25310
    HxcVtCustom1 : String : 25311
    HxcVtCustom2 : String : 25312
    HxcVtCustom3 : String : 25313
    HxcVtCustom4 : String : 25314
    HxcVtCustom5 : String : 25315
    HxcVtCustom6 : String : 25316
    HxcVtCustom7 : String : 25317
    HxcVtCustom8 : String : 25318


