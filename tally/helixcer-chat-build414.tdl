    12 : SET : HxcVcDMFld1 : ""
    13 : SET : HxcVcDMFld2 : ""
    14 : SET : HxcVcDMFld3 : ""
    15 : SET : HxcVcDMFld4 : ""
    16 : SET : HxcVcDMFld5 : ""
    17 : SET : HxcVcDMFld6 : ""
    18 : SET : HxcVcDMFld7 : ""
    19 : SET : HxcVcDMFld8 : ""
