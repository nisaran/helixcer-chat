    Invisible : NOT ##HxcVcFetched OR $$IsEmpty:##HxcVcVchType11 OR ##HxcVcVchType11 = "End of List" OR ##HxcVcVchType11 = "Not Applicable"
    Fields : Medium Prompt, HxcVcVchType12Input
    Local  : Field : Medium Prompt : Set as : "Voucher Type"
    Local  : Field : Medium Prompt : Width  : 22
    Local  : Field : Medium Prompt : Inactive : NOT ##HxcVcFetched

[Field: HxcVcVchType12Input]
    Use        : Name Field
    Set as     : ##HxcVcVchType12
    Modifies   : HxcVcVchType12
    Table      : Hxc Voucher Type List, End of List
    Show Table : Always
    Width      : 40
    Max        : 80
    Inactive   : NOT ##HxcVcFetched
    Skip Sysname : Yes
    Skip : ##HxcVcMoveToConfirm
    On         : Accept : Yes : SET : HxcVcVchType12 : $Value
    On         : Accept : ##HxcVcMoveToMapping : SET : HxcVcMoveToMapping : No
    On         : Accept : Yes : Field Accept


[Line: Hxc Vc F Auto Line]
    Fields : Medium Prompt, HxcVcAutoSendInput
    Local  : Field : Medium Prompt : Set as : "Auto send after save"
    Local  : Field : Medium Prompt : Width  : 22
    Local  : Field : Medium Prompt : Inactive : NOT ##HxcVcFetched

[Field: HxcVcAutoSendInput]
    Use      : Logical Field
    Variable  : HxcVcDraftAuto
    Set as   : ##HxcVcDraftAuto
    Width    : 8
    Inactive   : NOT ##HxcVcFetched
    On       : Accept : ##HxcVcMoveToMapping : SET : HxcVcMoveToMapping : No
    On       : Accept : Yes : SET : HxcVcMoveToConfirm : $$Value
    On       : Accept : Yes : SET : HxcVcAutoSendEnabled : $$Value
    On       : Accept : Yes : SET : HxcVcDraftAuto : ##HxcVcAutoSendEnabled
    On       : Accept : Yes : Field Accept
    Skip : ##HxcVcMoveToConfirm

[Line: Hxc Vc F Confirm Line]
    Fields : Hxc Vc Confirm Prompt, Hxc Vc F Confirm

[Field: Hxc Vc Confirm Prompt]
    Use      : Medium Prompt
    Set as   : "Confirm before send"
    Width    : 22
    Inactive : NOT ##HxcVcFetched
    Option   : Hxc Vc Confirm Grey Text : NOT ##HxcVcAutoSendEnabled

[!Field: Hxc Vc Confirm Grey Text]
    Color : Hxc Confirm Grey

[Color: Hxc Confirm Grey]
    RGB : 128, 128, 128

[Field: Hxc Vc F Confirm]
    On : Focus : ##HxcVcMoveToConfirm : SET : HxcVcMoveToConfirm : No
    Use      : Logical Field
    Variable  : HxcVcDraftConfirm
    Set as   : ##HxcVcDraftConfirm
    Width    : 12
    Inactive : NOT ##HxcVcFetched
    Skip     : NOT ##HxcVcAutoSendEnabled
    Option   : Hxc Vc Confirm Grey Text : NOT ##HxcVcAutoSendEnabled


;; ---------------------------------------------------------------------------
;; Voucher Type form — Alter Helixcer Chat option
;; ---------------------------------------------------------------------------

[#Form: Voucher Type]
    Add : Part : At Beginning : Hxc Vt Option Part
    Add : Button : Hxc Vt Config Btn

[Button: Hxc Vt Config Btn]
    Key    : Alt + H
    Title  : "Helixcer Chat"
    Action : Call : Hxc Vt Open Config

[Function: Hxc Vt Open Config]
    01 : CALL : Hxc Vt Prep Open
    02 : IF : $$IsEmpty:##HxcVtCurrentName
    03 :    Msg Box : "Helixcer Chat" : "Enter / select the Voucher Type name first."
    04 :    RETURN : No
    05 : END IF
    06 : Alter : Helixcer Vt Config
    07 : RETURN : Yes

[Part: Hxc Vt Option Part]
    Lines : Hxc Vt Option Title, Hxc Vt Option Line, Hxc Vt Option Status

[Line: Hxc Vt Option Title]
    Field : Hxc Vt Option Title Fld

[Field: Hxc Vt Option Title Fld]
    Use       : Name Field
    Set as    : "Helixcer Chat"
    Style     : Bold
    Color     : Dark Green
    FullWidth : Yes
    Skip      : Yes

[Line: Hxc Vt Option Line]
    Fields : Medium Prompt, Hxc Vt Alter Opt
    Local  : Field : Medium Prompt : Set as : "Alter Helixcer Chat"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vt Alter Opt]
    Use      : Logical Field
    Set as   : No
    Width    : 8
    On       : Accept : $$Value : CALL : Hxc Vt Open Config
    On       : Accept : Yes : Field Accept

[Line: Hxc Vt Option Status]
    Field : Hxc Vt Option Status Fld

[Field: Hxc Vt Option Status Fld]
    Use        : Name Field
    Set as     : If $$IsEmpty:$HxcVtTemplateName THEN "Not configured. Set Yes to open Helixcer config." ELSE ("Configured: " + $HxcVtTemplateName + " / " + $HxcVtLanguage)
    Set Always : Yes
    Color      : Dark Green
    FullWidth  : Yes
    Skip       : Yes

[Button: Hxc Fetch Template Btn]
    Key    : Alt + F
    Action : Call : Hxc Fetch Template
    Title  : "Fetch Template"

;; ---------------------------------------------------------------------------
;; VT Config form — Template / Mapping / Settings + VT Storage flush
;; ---------------------------------------------------------------------------

[Report: Helixcer Vt Config]
    Form   : Helixcer Vt Config
    Title  : "Helixcer Chat — Voucher Type Config"
    Object : Voucher Type : ##HxcVtCurrentName
    Set    : HxcVcFetched : No
    Set    : HxcVcMoveToMapping : No
    Set    : HxcVcMoveToConfirm : No
    Set    : HxcVcPreviewText : ""
    Set    : HxcVcFetchStatus : ""
    Set    : HxcVcSaveOk : No

[Form: Helixcer Vt Config]
    Part   : Hxc Vt Cfg Title Part, Hxc Vc Form Template Part, Hxc Vc Form Mid Row, Hxc Vc Form Settings Part, Hxc Vt Storage Part, Hxc Vt Cfg Hint Part
    Button : Hxc Fetch Template Btn, Form Accept, Form Cancel
    On     : Form Create  : Yes : CALL : Hxc Vt Init Form
    On     : Form Destroy : Yes : CALL : Hxc Vc Clear Draft
    On     : Form Destroy : Yes : CALL : Hxc Clear Fetch Vars
    On     : Form Accept  : Yes : CALL : Hxc Vc Commit Draft
    On     : Form Accept  : ##HxcVcSaveOk : Form Accept
    On     : Form Accept  : ##HxcVcSaveOk : Msg Box : "Helixcer Chat" : "Saved on Voucher Type [" + ##HxcVtCurrentName + "]."

[Part: Hxc Vt Cfg Title Part]
    Lines : Hxc Vt Cfg Title Line

[Line: Hxc Vt Cfg Title Line]
    Field : Hxc Vt Cfg Title

[Field: Hxc Vt Cfg Title]
    Use       : Name Field
    Set as    : "Helixcer Chat — " + ##HxcVtCurrentName + " (build 414)"
    Style     : Bold
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

[Part: Hxc Vt Cfg Hint Part]
    Lines : Hxc Vt Cfg Hint Line

[Line: Hxc Vt Cfg Hint Line]
    Field : Hxc Vt Cfg Hint

[Field: Hxc Vt Cfg Hint]
    Use       : Name Field
    Set as    : "Fetch: Enter on Language / Alt+F.  Save to this Voucher Type: Ctrl+A."
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

;; Visible Storage bridge — flushes session drafts into Voucher Type UDFs on Form Accept
[Part: Hxc Vt Storage Part]
    Lines : Hxc Vt Store Head, Hxc Vt Store Row

[Line: Hxc Vt Store Head]
    Field : Hxc Vt Store Head Fld

[Field: Hxc Vt Store Head Fld]
    Use       : Name Field
    Set as    : "Save to Voucher Type"
    Style     : Bold
    Color     : Dark Green
    FullWidth : Yes
    Skip      : Yes

[Line: Hxc Vt Store Row]
    Fields : HxcVtStoreEnabled, HxcVtStoreTemplate, HxcVtStoreLang, HxcVtStoreMedia, +
             HxcVtStoreAuto, HxcVtStoreConfirm, HxcVtStoreMaps, +
             HxcVtStoreCustom0, HxcVtStoreCustom1, HxcVtStoreCustom2, HxcVtStoreCustom3, +
             HxcVtStoreCustom4, HxcVtStoreCustom5, HxcVtStoreCustom6, HxcVtStoreCustom7, +
             HxcVtStoreCustom8

[Field: HxcVtStoreEnabled]
    Use        : Logical Field
    Storage    : HxcVtEnabled
    Set as     : If @@HxcVtStorageReady THEN Yes ELSE $HxcVtEnabled
    Set Always : Yes
    Width      : 4

[Field: HxcVtStoreTemplate]
    Use        : Name Field
    Storage    : HxcVtTemplateName
    Set as     : If @@HxcVtStorageReady THEN ##HxcVcDraftTemplate ELSE $HxcVtTemplateName
    Set Always : Yes
    Width      : 12
    Max        : 80

[Field: HxcVtStoreLang]
    Use        : Name Field
    Storage    : HxcVtLanguage
    Set as     : If @@HxcVtStorageReady THEN ##HxcVcDraftLang ELSE $HxcVtLanguage
    Set Always : Yes
    Width      : 6
    Max        : 16

[Field: HxcVtStoreMedia]
    Use        : Name Field
    Storage    : HxcVtMediaExport
    Set as     : If @@HxcVtStorageReady THEN ##HxcVcDraftMedia ELSE $HxcVtMediaExport
    Set Always : Yes
    Width      : 10
    Max        : 40

[Field: HxcVtStoreAuto]
    Use        : Logical Field
    Storage    : HxcVtAutoSend
    Set as     : If @@HxcVtStorageReady THEN ##HxcVcDraftAuto ELSE $HxcVtAutoSend
    Set Always : Yes
    Width      : 4

[Field: HxcVtStoreConfirm]
    Use        : Logical Field
    Storage    : HxcVtConfirmBeforeSend
    Set as     : If @@HxcVtStorageReady THEN ##HxcVcDraftConfirm ELSE $HxcVtConfirmBeforeSend
    Set Always : Yes
    Width      : 4

[Field: HxcVtStoreMaps]
    Use        : Name Field
    Storage    : HxcVtVarMapsText
    Set as     : If @@HxcVtStorageReady THEN ##HxcVtMapsPacked ELSE $HxcVtVarMapsText
    Set Always : Yes
    Width      : 16
    Max        : 500

[Field: HxcVtStoreCustom0]
    Use        : Name Field
    Storage    : HxcVtCustom0
    Set as     : If @@HxcVtStorageReady THEN (If ##HxcVcDraftHeaderFld = @@HxcCustomValueLabel THEN ##HxcVcDraftCustom0 ELSE "") ELSE $HxcVtCustom0
    Set Always : Yes
    Width      : 6
    Max        : 200

[Field: HxcVtStoreCustom1]
    Use        : Name Field
    Storage    : HxcVtCustom1
    Set as     : If @@HxcVtStorageReady THEN (If @@HxcVcMappingField1 = @@HxcCustomValueLabel THEN @@HxcVcMappingCustom1 ELSE "") ELSE $HxcVtCustom1
    Set Always : Yes
    Width      : 6
    Max        : 200

[Field: HxcVtStoreCustom2]
    Use        : Name Field
    Storage    : HxcVtCustom2
    Set as     : If @@HxcVtStorageReady THEN (If @@HxcVcMappingField2 = @@HxcCustomValueLabel THEN @@HxcVcMappingCustom2 ELSE "") ELSE $HxcVtCustom2
    Set Always : Yes
    Width      : 6
    Max        : 200

[Field: HxcVtStoreCustom3]
    Use        : Name Field
    Storage    : HxcVtCustom3
    Set as     : If @@HxcVtStorageReady THEN (If @@HxcVcMappingField3 = @@HxcCustomValueLabel THEN @@HxcVcMappingCustom3 ELSE "") ELSE $HxcVtCustom3
    Set Always : Yes
    Width      : 6
    Max        : 200

[Field: HxcVtStoreCustom4]
    Use        : Name Field
    Storage    : HxcVtCustom4
    Set as     : If @@HxcVtStorageReady THEN (If @@HxcVcMappingField4 = @@HxcCustomValueLabel THEN @@HxcVcMappingCustom4 ELSE "") ELSE $HxcVtCustom4
    Set Always : Yes
    Width      : 6
    Max        : 200

[Field: HxcVtStoreCustom5]
    Use        : Name Field
    Storage    : HxcVtCustom5
    Set as     : If @@HxcVtStorageReady THEN (If ##HxcVcDMFld5 = @@HxcCustomValueLabel THEN ##HxcVcDraftCustom5 ELSE "") ELSE $HxcVtCustom5
    Set Always : Yes
    Width      : 6
    Max        : 200

[Field: HxcVtStoreCustom6]
    Use        : Name Field
    Storage    : HxcVtCustom6
    Set as     : If @@HxcVtStorageReady THEN (If ##HxcVcDMFld6 = @@HxcCustomValueLabel THEN ##HxcVcDraftCustom6 ELSE "") ELSE $HxcVtCustom6
    Set Always : Yes
    Width      : 6
    Max        : 200

[Field: HxcVtStoreCustom7]
    Use        : Name Field
    Storage    : HxcVtCustom7
    Set as     : If @@HxcVtStorageReady THEN (If ##HxcVcDMFld7 = @@HxcCustomValueLabel THEN ##HxcVcDraftCustom7 ELSE "") ELSE $HxcVtCustom7
    Set Always : Yes
    Width      : 6
    Max        : 200

[Field: HxcVtStoreCustom8]
    Use        : Name Field
    Storage    : HxcVtCustom8
    Set as     : If @@HxcVtStorageReady THEN (If ##HxcVcDMFld8 = @@HxcCustomValueLabel THEN ##HxcVcDraftCustom8 ELSE "") ELSE $HxcVtCustom8
    Set Always : Yes
    Width      : 6
    Max        : 200

;; ---------------------------------------------------------------------------
;; List configured voucher types (read-only)
;; ---------------------------------------------------------------------------

[Report: Helixcer Vt Config List]
    Form   : Helixcer Vt Config List
    Title  : "Configured Voucher Types"

[Form: Helixcer Vt Config List]
    Part   : Hxc Vt Ls Title Part, Hxc Vt Ls Part, Hxc Vt Ls Hint Part
    Button : Form Cancel

[Part: Hxc Vt Ls Title Part]
    Lines : Hxc Vt Ls Title Line

[Line: Hxc Vt Ls Title Line]
    Field : Hxc Vt Ls Title

[Field: Hxc Vt Ls Title]
    Use       : Name Field
    Set as    : "Helixcer Configured Voucher Types (build 414)"
    Style     : Bold
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

[Part: Hxc Vt Ls Part]
    Lines    : Hxc Vt Ls Header Line, Hxc Vt Ls Data Line
    Repeat   : Hxc Vt Ls Data Line : Hxc Configured Voucher Types
    Break On : $$IsEmpty:$Name
    Scroll   : Vertical

[Line: Hxc Vt Ls Header Line]
    Fields : Hxc Vt Ls H Name, Hxc Vt Ls H Template, Hxc Vt Ls H Lang, Hxc Vt Ls H Media, Hxc Vt Ls H Auto
    Local  : Field : Default : Skip  : Yes
    Local  : Field : Default : Align : Centre
    Local  : Field : Default : Style : Bold

[Field: Hxc Vt Ls H Name]
    Use    : Name Field
    Set as : "Voucher Type"
    Width  : 20

[Field: Hxc Vt Ls H Template]
    Use    : Name Field
    Set as : "Template"
    Width  : 18

[Field: Hxc Vt Ls H Lang]
    Use    : Name Field
    Set as : "Lang"
    Width  : 6

[Field: Hxc Vt Ls H Media]
    Use    : Name Field
    Set as : "Media"
    Width  : 12

[Field: Hxc Vt Ls H Auto]
    Use    : Name Field
    Set as : "Auto"
    Width  : 6

[Line: Hxc Vt Ls Data Line]
    Fields : Hxc Vt Ls D Name, Hxc Vt Ls D Template, Hxc Vt Ls D Lang, Hxc Vt Ls D Media, Hxc Vt Ls D Auto
    Local  : Field : Default : Skip : Yes

[Field: Hxc Vt Ls D Name]
    Use    : Name Field
    Set as : $Name
    Width  : 20

[Field: Hxc Vt Ls D Template]
    Use    : Name Field
    Set as : $HxcVtTemplateName
    Width  : 18

[Field: Hxc Vt Ls D Lang]
    Use    : Name Field
    Set as : $HxcVtLanguage
    Width  : 6

[Field: Hxc Vt Ls D Media]
    Use    : Name Field
    Set as : $HxcVtMediaExport
    Width  : 12

[Field: Hxc Vt Ls D Auto]
    Use    : Name Field
    Set as : If $HxcVtAutoSend THEN "Yes" ELSE "No"
    Width  : 6

[Part: Hxc Vt Ls Hint Part]
    Lines : Hxc Vt Ls Hint Line

[Line: Hxc Vt Ls Hint Line]
    Field : Hxc Vt Ls Hint

[Field: Hxc Vt Ls Hint]
    Use       : Name Field
    Set as    : "Configure from Alter → Voucher Type → Alter Helixcer Chat. Esc to leave."
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

;; ---------------------------------------------------------------------------
;; About
;; ---------------------------------------------------------------------------

[Report: Helixcer Chat About]
    Form : Helixcer Chat About

[Form: Helixcer Chat About]
    Part : Helixcer Chat About

[Part: Helixcer Chat About]
    Lines : Helixcer Chat About Title, Helixcer Chat About Body, Helixcer Chat About Status

[Line: Helixcer Chat About Title]
    Field : Helixcer Chat About Title

[Field: Helixcer Chat About Title]
    Use       : Name Field
    Set as    : "Helixcer Chat (build 414)"
    Style     : Bold
    Align     : Centre
    FullWidth : Yes

[Line: Helixcer Chat About Body]
    Field : Helixcer Chat About Body

[Field: Helixcer Chat About Body]
    Use       : Name Field
    Set as    : "Alter Voucher Type → Alter Helixcer Chat Yes → template + mapping → Ctrl+A."
    Align     : Centre
    FullWidth : Yes

[Line: Helixcer Chat About Status]
    Field : Helixcer Chat About Status

[Field: Helixcer Chat About Status]
    Use       : Name Field
    Set as    : @@HxcSysSummary
    Align     : Centre
    FullWidth : Yes
[System: Formula]
    HxcCustomValueLabel : "♦ Custom Value"
    HxcVcMissingCustomValue :     (##HxcVcHeaderKind = "text" AND NOT $$IsEmpty:##HxcVcHeaderKey AND ##HxcVcDraftHeaderFld = @@HxcCustomValueLabel AND $$IsEmpty:##HxcVcDraftCustom0) OR +
        (NOT $$IsEmpty:##HxcVcFK1 AND (##HxcVcFC1 = "body" OR ##HxcVcFC1 = "button") AND @@HxcVcMappingField1 = @@HxcCustomValueLabel AND $$IsEmpty:@@HxcVcMappingCustom1) OR +
        (NOT $$IsEmpty:##HxcVcFK2 AND (##HxcVcFC2 = "body" OR ##HxcVcFC2 = "button") AND @@HxcVcMappingField2 = @@HxcCustomValueLabel AND $$IsEmpty:@@HxcVcMappingCustom2) OR +
        (NOT $$IsEmpty:##HxcVcFK3 AND (##HxcVcFC3 = "body" OR ##HxcVcFC3 = "button") AND @@HxcVcMappingField3 = @@HxcCustomValueLabel AND $$IsEmpty:@@HxcVcMappingCustom3) OR +
        (NOT $$IsEmpty:##HxcVcFK4 AND (##HxcVcFC4 = "body" OR ##HxcVcFC4 = "button") AND @@HxcVcMappingField4 = @@HxcCustomValueLabel AND $$IsEmpty:@@HxcVcMappingCustom4) OR +
        (NOT $$IsEmpty:##HxcVcFK5 AND (##HxcVcFC5 = "body") AND ##HxcVcDMFld5 = @@HxcCustomValueLabel AND $$IsEmpty:##HxcVcDraftCustom5) OR +
        (NOT $$IsEmpty:##HxcVcFK6 AND (##HxcVcFC6 = "body") AND ##HxcVcDMFld6 = @@HxcCustomValueLabel AND $$IsEmpty:##HxcVcDraftCustom6) OR +
        (NOT $$IsEmpty:##HxcVcFK7 AND (##HxcVcFC7 = "body") AND ##HxcVcDMFld7 = @@HxcCustomValueLabel AND $$IsEmpty:##HxcVcDraftCustom7) OR +
        (NOT $$IsEmpty:##HxcVcFK8 AND (##HxcVcFC8 = "body") AND ##HxcVcDMFld8 = @@HxcCustomValueLabel AND $$IsEmpty:##HxcVcDraftCustom8)
    HxcVoucherMappingSort : If $Name = @@HxcCustomValueLabel THEN "0" ELSE $Name
    HxcVcMappingField1 : If ##HxcVcFC1 = "button" THEN ##HxcVcButtonField1 ELSE ##HxcVcDMFld1
    HxcVcMappingCustom1 : If ##HxcVcFC1 = "button" THEN ##HxcVcButtonCustom1 ELSE ##HxcVcDraftCustom1
    HxcVcMappingField2 : If ##HxcVcFC2 = "button" THEN ##HxcVcButtonField2 ELSE ##HxcVcDMFld2
    HxcVcMappingCustom2 : If ##HxcVcFC2 = "button" THEN ##HxcVcButtonCustom2 ELSE ##HxcVcDraftCustom2
    HxcVcMappingField3 : If ##HxcVcFC3 = "button" THEN ##HxcVcButtonField3 ELSE ##HxcVcDMFld3
    HxcVcMappingCustom3 : If ##HxcVcFC3 = "button" THEN ##HxcVcButtonCustom3 ELSE ##HxcVcDraftCustom3
    HxcVcMappingField4 : If ##HxcVcFC4 = "button" THEN ##HxcVcButtonField4 ELSE ##HxcVcDMFld4
    HxcVcMappingCustom4 : If ##HxcVcFC4 = "button" THEN ##HxcVcButtonCustom4 ELSE ##HxcVcDraftCustom4

[Function: Hxc Restore Custom Mappings]
    Variable : EditKey : String
    01 : SET : EditKey : ##HxcVcDraftEditKey
    02 : IF : $$IsEmpty:##EditKey
    03 :    RETURN : Yes
    04 : END IF
    05 : WALK COLLECTION : Hxc Voucher Config Names
    06 :    IF : $HxcVcName = ##EditKey AND $HxcVcTemplateName = ##HxcVcFetchName AND $HxcVcLanguage = ##HxcVcFetchLang
    10 :       IF : (##HxcVcHeaderKind = "text" AND NOT $$IsEmpty:##HxcVcHeaderKey) AND NOT $$IsEmpty:$HxcVcCustom0
    11 :          SET : HxcVcDraftHeaderFld : @@HxcCustomValueLabel
    12 :          SET : HxcVcDraftCustom0 : $HxcVcCustom0
    13 :       END IF
    14 :       IF : (NOT $$IsEmpty:##HxcVcFK1 AND (##HxcVcFC1 = "body" OR ##HxcVcFC1 = "button")) AND NOT $$IsEmpty:$HxcVcCustom1
    15 :          IF : ##HxcVcFC1 = "button"
    151 :             SET : HxcVcButtonField1 : @@HxcCustomValueLabel
    152 :             SET : HxcVcButtonCustom1 : $HxcVcCustom1
    153 :          ELSE
    154 :             SET : HxcVcDMFld1 : @@HxcCustomValueLabel
    155 :             SET : HxcVcDraftCustom1 : $HxcVcCustom1
    16 :          END IF
    17 :       END IF
    18 :       IF : (NOT $$IsEmpty:##HxcVcFK2 AND (##HxcVcFC2 = "body" OR ##HxcVcFC2 = "button")) AND NOT $$IsEmpty:$HxcVcCustom2
    19 :          IF : ##HxcVcFC2 = "button"
    191 :             SET : HxcVcButtonField2 : @@HxcCustomValueLabel
    192 :             SET : HxcVcButtonCustom2 : $HxcVcCustom2
    193 :          ELSE
    194 :             SET : HxcVcDMFld2 : @@HxcCustomValueLabel
    195 :             SET : HxcVcDraftCustom2 : $HxcVcCustom2
    20 :          END IF
    21 :       END IF
    22 :       IF : (NOT $$IsEmpty:##HxcVcFK3 AND (##HxcVcFC3 = "body" OR ##HxcVcFC3 = "button")) AND NOT $$IsEmpty:$HxcVcCustom3
    23 :          IF : ##HxcVcFC3 = "button"
    231 :             SET : HxcVcButtonField3 : @@HxcCustomValueLabel
    232 :             SET : HxcVcButtonCustom3 : $HxcVcCustom3
    233 :          ELSE
    234 :             SET : HxcVcDMFld3 : @@HxcCustomValueLabel
    235 :             SET : HxcVcDraftCustom3 : $HxcVcCustom3
    24 :          END IF
    25 :       END IF
    26 :       IF : (NOT $$IsEmpty:##HxcVcFK4 AND (##HxcVcFC4 = "body" OR ##HxcVcFC4 = "button")) AND NOT $$IsEmpty:$HxcVcCustom4
    27 :          IF : ##HxcVcFC4 = "button"
    271 :             SET : HxcVcButtonField4 : @@HxcCustomValueLabel
    272 :             SET : HxcVcButtonCustom4 : $HxcVcCustom4
    273 :          ELSE
    274 :             SET : HxcVcDMFld4 : @@HxcCustomValueLabel
    275 :             SET : HxcVcDraftCustom4 : $HxcVcCustom4
    28 :          END IF
    29 :       END IF
    30 :       IF : (NOT $$IsEmpty:##HxcVcFK5 AND (##HxcVcFC5 = "body")) AND NOT $$IsEmpty:$HxcVcCustom5
    31 :          SET : HxcVcDMFld5 : @@HxcCustomValueLabel
    32 :          SET : HxcVcDraftCustom5 : $HxcVcCustom5
    33 :       END IF
    34 :       IF : (NOT $$IsEmpty:##HxcVcFK6 AND (##HxcVcFC6 = "body")) AND NOT $$IsEmpty:$HxcVcCustom6
    35 :          SET : HxcVcDMFld6 : @@HxcCustomValueLabel
    36 :          SET : HxcVcDraftCustom6 : $HxcVcCustom6
    37 :       END IF
    38 :       IF : (NOT $$IsEmpty:##HxcVcFK7 AND (##HxcVcFC7 = "body")) AND NOT $$IsEmpty:$HxcVcCustom7
    39 :          SET : HxcVcDMFld7 : @@HxcCustomValueLabel
    40 :          SET : HxcVcDraftCustom7 : $HxcVcCustom7
    41 :       END IF
    42 :       IF : (NOT $$IsEmpty:##HxcVcFK8 AND (##HxcVcFC8 = "body")) AND NOT $$IsEmpty:$HxcVcCustom8
    43 :          SET : HxcVcDMFld8 : @@HxcCustomValueLabel
    44 :          SET : HxcVcDraftCustom8 : $HxcVcCustom8
    45 :       END IF
    46 :    END IF
    47 : END WALK
    48 : RETURN : Yes

[Field: Hxc Vc Custom Mapping Input]
    Use : Name Field
    Width : 24
    Max : 200

[Field: HxcVcHdrCustomInput]
    Use : Hxc Vc Custom Mapping Input
    Variable : HxcVcDraftCustom0
    Set as : If ##HxcVcDraftHeaderFld = @@HxcCustomValueLabel THEN ##HxcVcDraftCustom0 ELSE ""
    Skip   : ##HxcVcMoveToConfirm OR (NOT (##HxcVcDraftHeaderFld = @@HxcCustomValueLabel))

[Field: HxcVcBody1CustomInput]
    Use : Hxc Vc Custom Mapping Input
    Variable : HxcVcDraftCustom1
    Set as : If ##HxcVcDMFld1 = @@HxcCustomValueLabel THEN ##HxcVcDraftCustom1 ELSE ""
