    24 : SET : HxcVcDMFld13 : ""
    25 : SET : HxcVcDMFld14 : ""
    26 : SET : HxcVcDMFld15 : ""
    27 : SET : HxcVcDMFld16 : ""
    30 : SET : HxcVcDraftCustom0 : ""
    31 : SET : HxcVcDraftCustom1 : ""
    32 : SET : HxcVcDraftCustom2 : ""
    33 : SET : HxcVcDraftCustom3 : ""
    34 : SET : HxcVcDraftCustom4 : ""
    35 : SET : HxcVcDraftCustom5 : ""
    36 : SET : HxcVcDraftCustom6 : ""
    37 : SET : HxcVcDraftCustom7 : ""
    38 : SET : HxcVcDraftCustom8 : ""
    39 : SET : HxcVcButtonField1 : ""
    40 : SET : HxcVcButtonCustom1 : ""
    41 : SET : HxcVcButtonField2 : ""
    42 : SET : HxcVcButtonCustom2 : ""
    43 : SET : HxcVcButtonField3 : ""
    44 : SET : HxcVcButtonCustom3 : ""
    45 : SET : HxcVcButtonField4 : ""
    46 : SET : HxcVcButtonCustom4 : ""
    47 : RETURN : Yes


[Function: Hxc Vt Prep Open]
    ;; Capture current Voucher Type name before opening config form
    01 : SET : HxcVtCurrentName : $Name
    02 : SET : HxcVcDraftName : $Name
    03 : SET : HxcVcDraftEditKey : $Name
    04 : RETURN : Yes

[Function: Hxc Vt Init Form]
    ;; Load saved VT UDFs into session drafts (Object is Voucher Type)
    01 : CALL : Hxc Clear Fetch Vars
    011 : SET : HxcVcFetchName : ""
    012 : SET : HxcVcFetchLang : "en"
    02 : SET : HxcVcMoveToConfirm : No
    03 : SET : HxcVcAutoSendEnabled : No
    04 : SET : HxcVtCurrentName : $Name
    05 : SET : HxcVcDraftName : $Name
    06 : SET : HxcVcDraftEditKey : $Name
    07 : SET : HxcVcDraftTemplate : $HxcVtTemplateName
    08 : SET : HxcVcDraftLang : If $$IsEmpty:$HxcVtLanguage THEN "en" ELSE $HxcVtLanguage
    09 : SET : HxcVcDraftMedia : If $$IsEmpty:$HxcVtMediaExport THEN "None" ELSE $HxcVtMediaExport
    10 : SET : HxcVcDraftAuto : $HxcVtAutoSend
    11 : SET : HxcVcAutoSendEnabled : $HxcVtAutoSend
    12 : SET : HxcVcDraftConfirm : $HxcVtConfirmBeforeSend
    13 : SET : HxcVtMapsPacked : $HxcVtVarMapsText
    14 : SET : HxcVcDraftHeaderFld : ""
    15 : SET : HxcVcDMFld1 : ""
    16 : SET : HxcVcDMFld2 : ""
    17 : SET : HxcVcDMFld3 : ""
    18 : SET : HxcVcDMFld4 : ""
    19 : SET : HxcVcDMFld5 : ""
    20 : SET : HxcVcDMFld6 : ""
    21 : SET : HxcVcDMFld7 : ""
    22 : SET : HxcVcDMFld8 : ""
    23 : SET : HxcVcDraftCustom0 : $HxcVtCustom0
    24 : SET : HxcVcDraftCustom1 : $HxcVtCustom1
    25 : SET : HxcVcDraftCustom2 : $HxcVtCustom2
    26 : SET : HxcVcDraftCustom3 : $HxcVtCustom3
    27 : SET : HxcVcDraftCustom4 : $HxcVtCustom4
    28 : SET : HxcVcDraftCustom5 : $HxcVtCustom5
    29 : SET : HxcVcDraftCustom6 : $HxcVtCustom6
    30 : SET : HxcVcDraftCustom7 : $HxcVtCustom7
    31 : SET : HxcVcDraftCustom8 : $HxcVtCustom8
    32 : SET : HxcVcButtonField1 : ""
    33 : SET : HxcVcButtonCustom1 : ""
    34 : SET : HxcVcButtonField2 : ""
    35 : SET : HxcVcButtonCustom2 : ""
    36 : SET : HxcVcButtonField3 : ""
    37 : SET : HxcVcButtonCustom3 : ""
    38 : SET : HxcVcButtonField4 : ""
    39 : SET : HxcVcButtonCustom4 : ""
    40 : SET : HxcVcSaveOk : No
    41 : RETURN : Yes

[Function: Hxc Vc Commit Draft]
    ;; Validate only. Voucher Type Storage fields flush on Form Accept.
    01 : SET : HxcVcSaveOk : No
    011 : IF : NOT $$IsEmpty:#Hxc Vc F Template
    012 :    SET : HxcVcDraftTemplate : #Hxc Vc F Template
    013 : END IF
    014 : IF : NOT $$IsEmpty:#Hxc Vc F Lang
    015 :    SET : HxcVcDraftLang : #Hxc Vc F Lang
    016 : END IF
    02 : IF : $$IsEmpty:##HxcVcDraftTemplate
    03 :    Msg Box : "Helixcer Chat" : "Template Name is required."
    04 :    RETURN : No
    05 : END IF
    06 : IF : NOT ##HxcVcFetched
    07 :    Msg Box : "Helixcer Chat" : "Fetch the template first (Enter on Language)."
    08 :    RETURN : No
    09 : END IF
    10 : IF : @@HxcVcMissingCustomValue
    11 :    Msg Box : "Helixcer Chat" : "Enter a value for each variable mapped to Custom Value."
    12 :    RETURN : No
    13 : END IF
    14 : SET : HxcVtMapsPacked : $$HxcPackMaps
    15 : SET : HxcVcSaveOk : Yes
    16 : RETURN : Yes

[Function: Hxc Vt Restore Custom Mappings]
    ;; Customs already loaded into draft vars from VT UDFs in Init Form
    01 : IF : (##HxcVcHeaderKind = "text" AND NOT $$IsEmpty:##HxcVcHeaderKey) AND NOT $$IsEmpty:##HxcVcDraftCustom0
    02 :    SET : HxcVcDraftHeaderFld : @@HxcCustomValueLabel
    03 : END IF
    04 : IF : (NOT $$IsEmpty:##HxcVcFK1 AND ##HxcVcFC1 = "body") AND NOT $$IsEmpty:##HxcVcDraftCustom1
    05 :    SET : HxcVcDMFld1 : @@HxcCustomValueLabel
    06 : END IF
    07 : IF : (NOT $$IsEmpty:##HxcVcFK2 AND ##HxcVcFC2 = "body") AND NOT $$IsEmpty:##HxcVcDraftCustom2
    08 :    SET : HxcVcDMFld2 : @@HxcCustomValueLabel
    09 : END IF
    10 : IF : (NOT $$IsEmpty:##HxcVcFK3 AND ##HxcVcFC3 = "body") AND NOT $$IsEmpty:##HxcVcDraftCustom3
    11 :    SET : HxcVcDMFld3 : @@HxcCustomValueLabel
    12 : END IF
    13 : IF : (NOT $$IsEmpty:##HxcVcFK4 AND ##HxcVcFC4 = "body") AND NOT $$IsEmpty:##HxcVcDraftCustom4
    14 :    SET : HxcVcDMFld4 : @@HxcCustomValueLabel
    15 : END IF
    16 : IF : (NOT $$IsEmpty:##HxcVcFK5 AND ##HxcVcFC5 = "body") AND NOT $$IsEmpty:##HxcVcDraftCustom5
    17 :    SET : HxcVcDMFld5 : @@HxcCustomValueLabel
    18 : END IF
    19 : IF : (NOT $$IsEmpty:##HxcVcFK6 AND ##HxcVcFC6 = "body") AND NOT $$IsEmpty:##HxcVcDraftCustom6
    20 :    SET : HxcVcDMFld6 : @@HxcCustomValueLabel
    21 : END IF
    22 : IF : (NOT $$IsEmpty:##HxcVcFK7 AND ##HxcVcFC7 = "body") AND NOT $$IsEmpty:##HxcVcDraftCustom7
    23 :    SET : HxcVcDMFld7 : @@HxcCustomValueLabel
    24 : END IF
    25 : IF : (NOT $$IsEmpty:##HxcVcFK8 AND ##HxcVcFC8 = "body") AND NOT $$IsEmpty:##HxcVcDraftCustom8
    26 :    SET : HxcVcDMFld8 : @@HxcCustomValueLabel
    27 : END IF
    28 : IF : (NOT $$IsEmpty:##HxcVcFK1 AND ##HxcVcFC1 = "button") AND NOT $$IsEmpty:##HxcVcDraftCustom1
    29 :    SET : HxcVcButtonField1 : @@HxcCustomValueLabel
    30 :    SET : HxcVcButtonCustom1 : ##HxcVcDraftCustom1
    31 : END IF
    32 : IF : (NOT $$IsEmpty:##HxcVcFK2 AND ##HxcVcFC2 = "button") AND NOT $$IsEmpty:##HxcVcDraftCustom2
    33 :    SET : HxcVcButtonField2 : @@HxcCustomValueLabel
    34 :    SET : HxcVcButtonCustom2 : ##HxcVcDraftCustom2
    35 : END IF
    36 : IF : (NOT $$IsEmpty:##HxcVcFK3 AND ##HxcVcFC3 = "button") AND NOT $$IsEmpty:##HxcVcDraftCustom3
    37 :    SET : HxcVcButtonField3 : @@HxcCustomValueLabel
    38 :    SET : HxcVcButtonCustom3 : ##HxcVcDraftCustom3
    39 : END IF
    40 : IF : (NOT $$IsEmpty:##HxcVcFK4 AND ##HxcVcFC4 = "button") AND NOT $$IsEmpty:##HxcVcDraftCustom4
    41 :    SET : HxcVcButtonField4 : @@HxcCustomValueLabel
    42 :    SET : HxcVcButtonCustom4 : ##HxcVcDraftCustom4
    43 : END IF
    44 : RETURN : Yes

;; ---------------------------------------------------------------------------
;; Menu
;; ---------------------------------------------------------------------------

[#Menu: Gateway of Tally]
    Add : Key Item : Before : @@LOCQuit : Helixcer Chat : H : Menu : Helixcer Chat Menu

[Menu: Helixcer Chat Menu]
    Title    : "Helixcer Chat"
    Key Item : API Settings              : S : Alter   : Helixcer API Settings
    Key Item : Configured Voucher Types  : V : Display : Helixcer Vt Config List
    Key Item : Status                    : T : Call    : Hxc Show Status
    Key Item : About                     : A : Display : Helixcer Chat About
    Key Item : Back                      : B : Menu    : Gateway of Tally

;; ---------------------------------------------------------------------------
;; API Settings
;; ---------------------------------------------------------------------------

[Report: Helixcer API Settings]
    Form   : Helixcer API Settings
    Title  : "API Settings"
    Object : Company

[Form: Helixcer API Settings]
    Part   : Helixcer API Settings
    Button : Form Accept, Form Cancel

[Part: Helixcer API Settings]
    Lines  : Hxc Api Settings Title, +
             Hxc Workspace Id Line, Hxc Channel Id Line, Hxc Api Key Line, +
             Hxc Save Hint Line
    Scroll : Vertical

[Line: Hxc Api Settings Title]
    Field : Hxc Api Settings Title

[Field: Hxc Api Settings Title]
    Use       : Name Field
    Set as    : "Helixcer Chat — API Settings (build 414)"
    Style     : Bold
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

[Line: Hxc Workspace Id Line]
    Fields : Medium Prompt, HxcWorkspaceIdFld
    Local  : Field : Medium Prompt : Set as : "Workspace ID"
    Local  : Field : Medium Prompt : Width  : 22

[Field: HxcWorkspaceIdFld]
    Use      : Name Field
    Storage  : HxcWorkspaceIdUDF
    Set as   : $HxcWorkspaceIdUDF
    Width    : 50
    Max      : 64
    On       : Accept : Yes : SET : HxcSysWorkspaceId : $Value
    On       : Accept : Yes : Field Accept

[Line: Hxc Channel Id Line]
    Fields : Medium Prompt, HxcChannelIdFld
    Local  : Field : Medium Prompt : Set as : "Channel ID"
    Local  : Field : Medium Prompt : Width  : 22

[Field: HxcChannelIdFld]
    Use      : Name Field
    Storage  : HxcChannelIdUDF
    Set as   : $HxcChannelIdUDF
    Width    : 50
    Max      : 64
    On       : Accept : Yes : SET : HxcSysChannelId : $Value
    On       : Accept : Yes : Field Accept

[Line: Hxc Api Key Line]
    Fields : Medium Prompt, HxcApiKeyFld
    Local  : Field : Medium Prompt : Set as : "API Key"
    Local  : Field : Medium Prompt : Width  : 22

[Field: HxcApiKeyFld]
    Use      : Name Field
    Storage  : HxcApiKeyUDF
    Set as   : $HxcApiKeyUDF
    Width    : 50
    Max      : 200
    On       : Accept : Yes : SET : HxcSysApiKey : $Value
    On       : Accept : Yes : Field Accept

[Line: Hxc Save Hint Line]
    Field : Hxc Save Hint

[Field: Hxc Save Hint]
    Use       : Name Field
    Set as    : "Tab all fields, then Ctrl+A to Accept."
    Align     : Centre
    FullWidth : Yes
    Skip      : Yes

;; ---------------------------------------------------------------------------
;; Shared Create/Alter form body — layout only (functions unchanged)
;; Sections: Template | Mapping+Preview (side-by-side) | Voucher Rules | Settings
;; ---------------------------------------------------------------------------

;; Template card
[Part: Hxc Vc Form Template Part]
    Lines  : Hxc Vc F Template Sect, Hxc Vc F Vt Context Line, +
             Hxc Vc F Template Line, Hxc Vc F Lang Line, +
             Hxc Vc F Fetch Status Line

;; Mapping (left) + Message Preview (right) — single-line preview
;; Mapping LEFT + Preview RIGHT (no Height on Mid Row — Height/% broke Horizontal)
[Part: Hxc Vc Form Mid Row]
    Parts      : Hxc Vc Form Left Col, Hxc Vc Form Preview Part
    Horizontal : Yes

[Part: Hxc Vc Form Left Col]
    Lines  : Hxc Vc F Map Sect, +
             Hxc Vc F Hdr Media Line, Hxc Vc F Hdr Col Head, Hxc Vc F Hdr Text Line, +
             Hxc Vc F Body Sect, Hxc Vc F Body Col Head, +
             Hxc Vc F Body1, +
             Hxc Vc F Body2, +
             Hxc Vc F Body3, +
             Hxc Vc F Body4, +
             Hxc Vc F Body5, +
             Hxc Vc F Body6, +
             Hxc Vc F Body7, +
             Hxc Vc F Body8, +
             Hxc Vc F Btn Sect, Hxc Vc F Btn Col Head, +
             Hxc Vc F Btn1, +
             Hxc Vc F Btn2, +
             Hxc Vc F Btn3, +
             Hxc Vc F Btn4
    Scroll : Vertical
    Width  : 55% Screen

[Part: Hxc Vc Form Preview Part]
    Lines  : Hxc Vc F Prev Head, Hxc Vc F Prev Body
    Width  : 45% Screen

;; Voucher Rules
[Part: Hxc Vc Form Vch Part]
    Lines    : Hxc Vc F Vch Sect, Hxc Vc F Vch Head, +
               Hxc Vc F Vch1, Hxc Vc F Vch2, Hxc Vc F Vch3, Hxc Vc F Vch4, Hxc Vc F Vch5, Hxc Vc F Vch6, +
               Hxc Vc F Vch7, Hxc Vc F Vch8, Hxc Vc F Vch9, Hxc Vc F Vch10, Hxc Vc F Vch11, Hxc Vc F Vch12
    Scroll   : Vertical

[Part: Hxc Vc Form Settings Part]
    Lines    : Hxc Vc F Auto Line, Hxc Vc F Confirm Line

;; --- Template fields ---

[Line: Hxc Vc F Template Sect]
    Field : Hxc Vc F Template Sect Fld

[Field: Hxc Vc F Template Sect Fld]
    Use       : Name Field
    Set as    : "Template"
    Style     : Bold
    Color     : Dark Green
    FullWidth : Yes
    Skip      : Yes


[Line: Hxc Vc F Vt Context Line]
    Fields : Medium Prompt, Hxc Vc F Vt Context
    Local  : Field : Medium Prompt : Set as : "Voucher Type"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc F Vt Context]
    Use       : Name Field
    Set as    : ##HxcVtCurrentName
    Set Always : Yes
    Width     : 40
    Skip      : Yes
    Color     : Dark Green

[Line: Hxc Vc F Name Line]
    Fields : Medium Prompt, Hxc Vc F Name
    Local  : Field : Medium Prompt : Set as : "Config Name"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc F Name]
    Skip     : ##HxcVcMoveToConfirm
    Use      : Name Field
    Set as   : ##HxcVcDraftName
    Modifies : HxcVcDraftName
    Width    : 40
    Max      : 60
    On       : Accept : Yes : SET : HxcVcDraftName : $Value
    On       : Accept : Yes : Field Accept

[Line: Hxc Vc F Template Line]
    Fields : Medium Prompt, Hxc Vc F Template
    Local  : Field : Medium Prompt : Set as : "Template Name"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc F Template]
    Skip     : ##HxcVcMoveToConfirm
    Use      : Name Field
    Set as   : ##HxcVcDraftTemplate
    Modifies : HxcVcDraftTemplate
    Width    : 40
    Max      : 80
    On       : Accept : Yes : CALL : Hxc Clear Fetch Vars
    On       : Accept : Yes : SET : HxcVcDraftTemplate : $$Value
    On       : Accept : Yes : SET : HxcVcFetchName : $$Value
    On       : Accept : Yes : Field Accept

[Line: Hxc Vc F Lang Line]
    Fields : Medium Prompt, Hxc Vc F Lang
    Local  : Field : Medium Prompt : Set as : "Language"
    Local  : Field : Medium Prompt : Width  : 22

[Field: Hxc Vc F Lang]
    Skip     : ##HxcVcMoveToConfirm OR (##HxcVcFetched AND ##HxcVcMoveToMapping)
    Use      : Name Field
    Set as   : If $$IsEmpty:##HxcVcDraftLang THEN "en" ELSE ##HxcVcDraftLang
    Modifies : HxcVcDraftLang
    Width    : 16
    Max      : 16
    On       : Accept : Yes : SET : HxcVcDraftLang : $$Value
    On       : Accept : Yes : SET : HxcVcFetchLang : $$Value
    On       : Accept : NOT $$IsEmpty:#Hxc Vc F Template : SET : HxcVcDraftTemplate : #Hxc Vc F Template
    On       : Accept : NOT $$IsEmpty:##HxcVcDraftTemplate : SET : HxcVcFetchName : ##HxcVcDraftTemplate
    On       : Accept : Yes : CALL : Hxc Fetch Template
    On       : Accept : ##HxcVcFetched : Field Accept

[Line: Hxc Vc F Fetch Status Line]
    Field : Hxc Vc F Fetch Status

[Field: Hxc Vc F Fetch Status]
    Use        : Name Field
    Set as     : If NOT ##HxcVcFetched THEN "Enter Language, then Fetch Template (Enter / Alt+F)" ELSE If $$IsEmpty:##HxcVcFetchStatus THEN "Template loaded." ELSE ##HxcVcFetchStatus
    Set Always : Yes
    Color      : Dark Green
    FullWidth  : Yes
    Skip       : Yes

;; --- Mapping + header ---

[Line: Hxc Vc F Map Sect]
    Field : Hxc Vc F Map Sect Fld

[Field: Hxc Vc F Map Sect Fld]
    Use       : Name Field
    Set as    : "Variable Mapping"
    Style     : Bold
    Color     : Dark Green
    FullWidth : Yes
    Skip      : Yes
    Inactive  : NOT ##HxcVcFetched

[Line: Hxc Vc F Hdr Media Line]
    Fields : Medium Prompt, Hxc Vc F Media
    Local  : Field : Medium Prompt : Set as : "Media Header"
    Local  : Field : Medium Prompt : Width  : 22
    Local  : Field : Medium Prompt : Inactive : NOT ##HxcVcFetched OR NOT ##HxcVcHeaderKind = "media"

[Field: Hxc Vc F Media]
    Skip : ##HxcVcMoveToConfirm
    Use        : Name Field
    Variable    : HxcVcDraftMedia
    Set as     : If $$IsEmpty:##HxcVcDraftMedia THEN "None" ELSE ##HxcVcDraftMedia
    Table      : Hxc Media Export List
    Show Table : Always
    Width      : 40
    Max        : 40
    Inactive   : NOT ##HxcVcFetched OR NOT ##HxcVcHeaderKind = "media"
    On : Accept : ##HxcVcMoveToMapping : SET : HxcVcMoveToMapping : No
    On : Accept : Yes : Field Accept

[Line: Hxc Vc F Hdr Col Head]
    Invisible : NOT ##HxcVcFetched OR NOT ##HxcVcHeaderKind = "text"
    Fields    : Hxc Vc F Hdr Col Key, Hxc Vc F Hdr Col Fld

[Field: Hxc Vc F Hdr Col Key]
    Use    : Name Field
    Set as : "Header variable"
    Style  : Bold
    Color  : Dark Green
    Skip   : Yes
    Width  : 28

[Field: Hxc Vc F Hdr Col Fld]
    Use    : Name Field
    Set as : "Voucher field"
    Style  : Bold
    Color  : Dark Green
    Skip   : Yes
    Width  : 28

[Line: Hxc Vc F Hdr Text Line]
    Invisible : NOT ##HxcVcFetched OR NOT ##HxcVcHeaderKind = "text"
    Fields    : Hxc Vc F Hdr MK, HxcVcHdrMapping, HxcVcHdrCustomInput

[Field: Hxc Vc F Hdr MK]
    Use        : Name Field
    Set as     : If $$IsEmpty:##HxcVcHeaderKey THEN "" ELSE ("{{" + ##HxcVcHeaderKey + "}}")
    Set Always : Yes
    Skip       : Yes
    Width      : 28
    Inactive   : NOT ##HxcVcFetched OR NOT ##HxcVcHeaderKind = "text"

[Field: HxcVcHdrMapping]
    Use        : Name Field
    Variable    : HxcVcDraftHeaderFld
    Set as     : ##HxcVcDraftHeaderFld
    Table      : Hxc Voucher Field List, Not Applicable
    Show Table : Always
    Width      : 28
    Max        : 40
    Inactive   : NOT ##HxcVcFetched OR NOT ##HxcVcHeaderKind = "text"
    On         : Accept : Yes : SET : HxcVcDraftHeaderFld : $Value
    On         : Accept : ##HxcVcMoveToMapping : SET : HxcVcMoveToMapping : No
    On         : Accept : Yes : Field Accept
    Skip : ##HxcVcMoveToConfirm

[Line: Hxc Vc F Body Sect]
    Field : Hxc Vc F Body Sect Fld

[Field: Hxc Vc F Body Sect Fld]
    Use       : Name Field
    Set as    : ""
    Style     : Bold
    Color     : Dark Green
    FullWidth : Yes
    Skip      : Yes
    Inactive  : NOT ##HxcVcFetched OR NOT ##HxcVcHasBodyMaps

[Line: Hxc Vc F Body Col Head]
    Fields : Hxc Vc F Body Col Key, Hxc Vc F Body Col Fld

[Field: Hxc Vc F Body Col Key]
    Use       : Name Field
    Set as    : "Body variable"
    Style     : Bold
    Color     : Dark Green
    Skip      : Yes
    Width     : 28
    Inactive  : NOT ##HxcVcFetched OR NOT ##HxcVcHasBodyMaps

[Field: Hxc Vc F Body Col Fld]
    Use       : Name Field
    Set as    : "Voucher field"
    Style     : Bold
    Color     : Dark Green
    Skip      : Yes
    Width     : 28
    Inactive  : NOT ##HxcVcFetched OR NOT ##HxcVcHasBodyMaps

[Line: Hxc Vc F Body1]
    Invisible : NOT ##HxcVcFetched OR $$IsEmpty:##HxcVcFK1 OR NOT ##HxcVcFC1 = "body"
    Fields : Hxc Vc F Body1 MK, HxcVcBody1Mapping, HxcVcBody1CustomInput

[Field: Hxc Vc F Body1 MK]
    Use        : Name Field
    Set as     : "{{" + ##HxcVcFK1 + "}}"
    Set Always : Yes
    Skip       : Yes
    Width      : 28
    Inactive   : NOT ##HxcVcFetched OR $$IsEmpty:##HxcVcFK1 OR NOT ##HxcVcFC1 = "body"

[Field: HxcVcBody1Mapping]
    Use        : Name Field
    Variable    : HxcVcDMFld1
    Set as     : ##HxcVcDMFld1
    Table      : Hxc Voucher Field List, Not Applicable
    Show Table : Always
    Width      : 28
    Max        : 40
    Color      : Black
    Inactive   : NOT ##HxcVcFetched OR $$IsEmpty:##HxcVcFK1 OR NOT ##HxcVcFC1 = "body"
    On         : Accept : Yes : SET : HxcVcDMFld1 : $Value
    On         : Accept : ##HxcVcMoveToMapping : SET : HxcVcMoveToMapping : No
    On         : Accept : Yes : Field Accept
    Skip : ##HxcVcMoveToConfirm

[Line: Hxc Vc F Body2]
    Invisible : NOT ##HxcVcFetched OR $$IsEmpty:##HxcVcFK2 OR NOT ##HxcVcFC2 = "body"
    Fields : Hxc Vc F Body2 MK, HxcVcBody2Mapping, HxcVcBody2CustomInput

[Field: Hxc Vc F Body2 MK]
    Use        : Name Field
    Set as     : "{{" + ##HxcVcFK2 + "}}"
    Set Always : Yes
    Skip       : Yes
    Width      : 28
    Inactive   : NOT ##HxcVcFetched OR $$IsEmpty:##HxcVcFK2 OR NOT ##HxcVcFC2 = "body"

[Field: HxcVcBody2Mapping]
    Use        : Name Field
    Variable    : HxcVcDMFld2
    Set as     : ##HxcVcDMFld2
    Table      : Hxc Voucher Field List, Not Applicable
    Show Table : Always
    Width      : 28
    Max        : 40
    Color      : Black
    Inactive   : NOT ##HxcVcFetched OR $$IsEmpty:##HxcVcFK2 OR NOT ##HxcVcFC2 = "body"
    On         : Accept : Yes : SET : HxcVcDMFld2 : $Value
    On         : Accept : ##HxcVcMoveToMapping : SET : HxcVcMoveToMapping : No
    On         : Accept : Yes : Field Accept
    Skip : ##HxcVcMoveToConfirm

[Line: Hxc Vc F Body3]
    Invisible : NOT ##HxcVcFetched OR $$IsEmpty:##HxcVcFK3 OR NOT ##HxcVcFC3 = "body"
    Fields : Hxc Vc F Body3 MK, HxcVcBody3Mapping, HxcVcBody3CustomInput

[Field: Hxc Vc F Body3 MK]
    Use        : Name Field
    Set as     : "{{" + ##HxcVcFK3 + "}}"
    Set Always : Yes
    Skip       : Yes
    Width      : 28
    Inactive   : NOT ##HxcVcFetched OR $$IsEmpty:##HxcVcFK3 OR NOT ##HxcVcFC3 = "body"

[Field: HxcVcBody3Mapping]
    Use        : Name Field
    Variable    : HxcVcDMFld3
    Set as     : ##HxcVcDMFld3
    Table      : Hxc Voucher Field List, Not Applicable
    Show Table : Always
    Width      : 28
    Max        : 40
    Color      : Black
    Inactive   : NOT ##HxcVcFetched OR $$IsEmpty:##HxcVcFK3 OR NOT ##HxcVcFC3 = "body"
    On         : Accept : Yes : SET : HxcVcDMFld3 : $Value
    On         : Accept : ##HxcVcMoveToMapping : SET : HxcVcMoveToMapping : No
    On         : Accept : Yes : Field Accept
    Skip : ##HxcVcMoveToConfirm

[Line: Hxc Vc F Body4]
